// ── fjord-app · settings.slint ───────────────────────────────────────────────
//   SettingsScreen   two panes: section list (left), scrollable section content (right)
//     Left pane      sections from the parallel sect-keys/sect-labels arrays, keyed on
//                    AppState.settings-section (a string); a SERVER/CLIENT/SEERR info block
//                    pinned to the bottom ("Not encrypted (http://)" for plain-HTTP connections)
//     Right pane     Flickable; one `if` block per section (virtual rows are `if`-gated), grouped
//                    by task since 0.5.1 (row keys keep their old prefixes); rows saved per profile
//                    carry `per-profile: true` (the "Profile" tag); fixed-choice dropdowns are
//                    `choice: true; value: AppState.settings-…;` (options/labels: settings.rs CHOICES):
//       Playback     intro/recap/preview/commercial modes (+ secs for ask-timed), credits mode
//                    (+ secs), skip-fade ms; seek steps; hide controls after; trailer quality
//       Subtitles &  audio language; subtitles (+ languages, type, scale, position, ASS styling,
//        language    color, background)
//       Display      launch fullscreen; HDR passthrough, separate video surface (Wayland), tone
//                    mapping (+ per-curve description); display sync (+ screen, resolution/refresh
//                    sync, default resolution/Hz, 4K/1080p scaling, 4K odd-fps mode, HDR/WCG
//                    modes, trailers)
//       Audio        device, channels, SPDIF (+ AC3/EAC3/DTS/DTS-HD/TrueHD, passthrough device,
//                    ALSA IRQ scheduling on PipeWire, skip-fade mute); gapless, Now Playing
//                    auto-open (off / 15 s … 5 min), Now Playing background (plain / soft /
//                    strong), screensaver while music plays
//       Interface    ("ui") card size, video behind UI, text font, on-screen keyboard, message
//                    duration, scroll and animation speed; focus ring color/thickness/style, glow strength + Glow on (only
//                    when the style isn't Line), transparency, zoom
//       Profiles     launch policy (+ default profile), Manage Profiles (master account), Copy
//                    settings from… (when other profiles exist), account launch policy (+ default account), Add Account, remember login,
//                    Sign Out, Bonfire Group (master account), Bonfire Admin (server admin)
//       Integrations Seerr enabled, Connect/Disconnect, then (connected) streaming region,
//                    display/discover language, discover region, Manage Blocklist
//                    (seerr-can-manage-blocklist)
//       Key Bindings rebind rows (keybinding-focused 0..N, positional) + Reset to Defaults
//       Advanced     hwdec, vf (NVDEC only), deinterlace; video-sync, interpolation (+ tscale);
//                    early flush, latency hacks (display-resample); own 10-bit buffers (separate
//                    surface), dithering off; cache secs/MB; prewarm metadata/images; log level
//     Dialogs        Key Bindings reset + rebind-collision confirms, Copy settings confirm,
//                    Disconnect Seerr confirm
//   Row identity     every row has a stable string `key` = the constant in settings.rs (keep the
//                    two lists in sync); a mouse click goes through AppState.settings-row-focused
//                    so settings-focused-visual-index (scroll) stays right. A SettingsDropdown's
//                    mouse popup is its own PopupWindow; the keyboard dropdown overlay goes through
//                    settings.rs's open_dropdown_popup/apply_dropdown_selection.
//   Scroll           kb-y from settings-focused-visual-index or kb-row-y(i) (approximate, for
//                    scroll only), assigned from changed trackers (content-y must not be bound);
//                    _kb-fi-mirror/_kb-sf-mirror catch steps where the clamped kb-y doesn't
//                    change. Reset to Defaults scrolls from reset-btn's real geometry, and
//                    kb-content-h-override corrects the Key Bindings content height.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import {
    FocusHalo,
    FjordButton,
    ToggleSwitch,
    SectionHeader,
    SettingsDropdown,
    SettingsRow,
    PressPulse,
    ConfirmDialog,
} from "widgets.slint";

export component SettingsScreen inherits Rectangle {
    background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;

    // Approximate y of Key Bindings row i — for scroll-into-view only. The header and row
    // heights are exact (SectionHeader 28px, rows 44px); the hint text is word-wrapped, so its
    // height depends on the window width and can't be read from here (it lives inside the
    // keybindings `if` block — a dangling reference from this root function). Its estimate is
    // deliberately generous: kb-y's clamp caps an overshoot, an undershoot hid rows. The Reset
    // button (index past every row) has its own exact target — see reset-btn below.
    pure function kb-row-y(i: int) -> length {
        let n: int = AppState.keybinding-normal.length;
        76px                            // hint text (generous, up to ~4 wrapped lines) + its spacer
        + 28px                          // "NAVIGATION & GLOBAL" header (exact — SectionHeader is a fixed 28px)
        + i * 44px                      // exact — each row is a fixed 44px Rectangle
        + (i >= n ? 28px : 0px)         // "PLAYER" header, once past the normal-map rows (exact)
        + 22px                          // target the row's vertical center
    }

    // Sidebar order — must match settings.rs's ALL_SECTIONS.
    property <[string]> sect-keys:   [
        "playback",
        "language",
        "display",
        "audio",
        "ui",
        "profiles",
        "integrations",
        "keybindings",
        "advanced"
    ];
    property <[string]> sect-labels: [
        "Playback",
        "Subtitles & language",
        "Display",
        "Audio",
        "Interface",
        "Profiles",
        "Integrations",
        "Key bindings",
        "Advanced"
    ];

    HorizontalLayout {
        // ── Left pane ─────────────────────────────────────────────────────────
        left-pane := Rectangle {
            background: Theme.surface;
            // Grows with Text size so "Subtitles & language" still fits.
            width: 220px * AppState.text-scale;

            VerticalLayout {
                padding: Theme.sp-xl;
                spacing: Theme.sp-sm;
                alignment: start;

                Text {
                    text: "Settings";
                    color: Theme.text;
                    font-size: 20px * AppState.text-scale;
                    font-weight: 700;
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                // Section list — keyed on sect-keys[i]; sect-labels[i] is the display text.
                for label[i] in sect-labels: Rectangle {
                    // Keyboard focus is on this section (left pane), not just "selected".
                    property <bool> sect-kb: AppState.settings-section == sect-keys[i]
                        && (sect-keys[i] == "keybindings" ? AppState.keybinding-focused < 0 : AppState.settings-focused == "");
                    height: 44px;
                    border-radius: Theme.radius;
                    background: {
                        let hov = sect-ta.has-hover;
                        AppState.settings-section == sect-keys[i]
                            ? (sect-keys[i] == "keybindings"
                            ? (AppState.keybinding-focused < 0 ? Theme.accent : Theme.accent-muted)
                            : (AppState.settings-focused == "" ? Theme.accent : Theme.accent-muted))
                            : (hov ? Theme.surface-raised : transparent)
                    };
                    border-width: AppState.ring-width(sect-pulse.active, sect-ta.pressed || sect-pulse.pulsing);
                    border-color: AppState.focus-color;
                    animate border-width {
                        duration: 90ms * AppState.settings-animation-speed;
                        easing: ease-out-expo;
                    }
                    FocusHalo {
                        glowing: sect-pulse.active;
                        radius: Theme.radius;
                    }

                    sect-pulse := PressPulse {
                        trigger: AppState.kb-activate-pulse;
                        active: sect-kb;
                    }

                    sect-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            AppState.settings-section = sect-keys[i];
                            AppState.settings-focused = "";
                            // Leave Key Bindings focus: keys.rs checks keybinding-focused before settings-section, so
                            // a stale index kept routing keys to the invisible rebind dispatcher.
                            AppState.keybinding-focused = -1;
                            AppState.keybinding-rebinding = false;
                            AppState.refocus();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        alignment: start;
                        Text {
                            text: label;
                            color: Theme.text;
                            font-size: 14px * AppState.text-scale;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                // ── Server / Seerr / Client info block — pinned to the bottom.
                // Seerr sits right after Server (both are "servers" Fjord
                // connects to), before Client (Fjord itself) — moved here
                // per explicit request, was originally after Client.
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                Text {
                    text: "SERVER";
                    color: Theme.text-muted;
                    font-size: 10px * AppState.text-scale;
                    font-weight: 700;
                }

                Text {
                    text: AppState.server-name != "" ? AppState.server-name : "—";
                    color: Theme.text;
                    font-size: 13px * AppState.text-scale;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: AppState.server-version != "" ? AppState.server-version : "";
                    color: Theme.text-muted;
                    font-size: 11px * AppState.text-scale;
                    overflow: elide;
                }
                // Plain http:// (2026-10-09 security review): shown, not nagged about.
                if AppState.server-unencrypted: Text {
                    text: "Not encrypted (http://)";
                    color: Theme.error;
                    font-size: 11px * AppState.text-scale;
                    overflow: elide;
                }

                // Same 3-line shape as SERVER/CLIENT — header + bold primary
                // name line + muted secondary version line.
                if AppState.seerr-connected: Text {
                    text: "SEERR";
                    color: Theme.text-muted;
                    font-size: 10px * AppState.text-scale;
                    font-weight: 700;
                }
                if AppState.seerr-connected: Text {
                    text: "Seerr";
                    color: Theme.text;
                    font-size: 13px * AppState.text-scale;
                    font-weight: 600;
                    overflow: elide;
                }
                if AppState.seerr-connected && AppState.seerr-version != "": Text {
                    text: AppState.seerr-version;
                    color: Theme.text-muted;
                    font-size: 11px * AppState.text-scale;
                    overflow: elide;
                }
                if AppState.seerr-unencrypted: Text {
                    text: "Not encrypted (http://)";
                    color: Theme.error;
                    font-size: 11px * AppState.text-scale;
                    overflow: elide;
                }

                Text {
                    text: "CLIENT";
                    color: Theme.text-muted;
                    font-size: 10px * AppState.text-scale;
                    font-weight: 700;
                }

                Text {
                    text: "FJORD";
                    color: Theme.text;
                    font-size: 13px * AppState.text-scale;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: AppState.client-version != "" ? AppState.client-version : "—";
                    color: Theme.text-muted;
                    font-size: 11px * AppState.text-scale;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        // ── Right pane ────────────────────────────────────────────────────────
        right-pane := Rectangle {
            horizontal-stretch: 1;
            // kb-content-h-override: right-inner.preferred-height under-reports the Key Bindings
            // content by about the Reset button's height, and Flickable clamps every content-y
            // assignment to content-height — so even an exact scroll target came out short. The Key
            // Bindings section pushes its real measured height here on every focus change (see
            // `changed _reset-fi-mirror`); right-vp-h takes the larger value, only while that section
            // shows (a stale measurement must not add scroll space to other sections).
            property <length> kb-content-h-override: 0px;
            property <length> right-vp-h: (AppState.settings-section == "keybindings"
                ? max(right-inner.preferred-height, kb-content-h-override)
                : right-inner.preferred-height) + Theme.sp-xl * 2;
            // Reset to Defaults (keybinding-focused == kb-total, past every row) is the last thing in
            // the section and is scrolled to from its own real geometry, not kb-row-y.
            property <int> kb-total: AppState.keybinding-normal.length + AppState.keybinding-player.length;
            // kb-y covers every real row (0..kb-total-1) and the general settings rows. Reset's target
            // is set inside the Key Bindings section, where reset-btn is in scope; both changed
            // handlers exclude that case so content-y has one writer for it.
            property <length> kb-y: AppState.keybinding-focused >= 0 && AppState.keybinding-focused < kb-total
                ? clamp(-(kb-row-y(AppState.keybinding-focused) - self.height / 2),
                         min(0px, self.height - right-vp-h), 0px)
                : AppState.settings-focused == "" ? 0px
                : clamp(-(Theme.sp-xl + 30px + AppState.settings-focused-visual-index * (32px + 32px * AppState.text-scale) + 28px
                - self.height / 2),
                         min(0px, self.height - right-vp-h), 0px);
            changed kb-y => { if AppState.keybinding-focused < kb-total { right-fl.content-y = kb-y; } }
            // `changed kb-y` alone misses a real class of navigation step:
            // kb-y's own clamp() means many DIFFERENT focus positions near
            // the top or bottom of a long list resolve to the IDENTICAL
            // pixel value — a ChangeTracker only fires when the tracked
            // value actually differs from its previous evaluation, so
            // moving between two such positions left content-y
            // un-reassigned even though it was legitimately supposed to
            // fire again. `kb-y` itself can't be observed reliably at
            // every step for this reason; mirror the raw navigation state
            // instead (which always changes on every keypress) and
            // re-read `kb-y`'s current value from there.
            property <int> _kb-fi-mirror: AppState.keybinding-focused;
            property <string> _kb-sf-mirror: AppState.settings-focused;
            changed _kb-fi-mirror => { if AppState.keybinding-focused < kb-total { right-fl.content-y = kb-y; } }
            changed _kb-sf-mirror => { right-fl.content-y = kb-y; }

            // ── Keyboard dropdown overlay props ───────────────────────────────
            property <length> kbdd-content-h: AppState.settings-dropdown-model.length * 32px + 8px;
            property <length> kbdd-h:         min(kbdd-content-h, 320px);
            property <length> kbdd-w:         min(max(300px, kbdd-vl.preferred-width + 8px), self.width - Theme.sp-xl * 2);

            right-fl := Flickable {
                content-height: right-pane.right-vp-h;

                right-inner := VerticalLayout {
                    y: Theme.sp-xl;
                    width: parent.width - Theme.sp-xl * 2;
                    // Its own height, not the Flickable's: content-height comes from this layout's
                    // measurement (right-vp-h / the Key Bindings kb-content-h-override), so filling the
                    // viewport stretched the section, pushed Reset down, raised the next measurement —
                    // the rows crept 64px per focus step and the scroll fell behind.
                    height: self.preferred-height;
                    x: Theme.sp-xl;

                    // ── Playback section ────────────────────────────────────────────────────
                if AppState.settings-section == "playback": VerticalLayout {
                        spacing: Theme.sp-sm;

                        SectionHeader {
                            text: "SKIPPING";
                        }

                        SettingsRow {
                            key: "player.intro_mode";
                            choice: true;
                            value: AppState.settings-skip-intro-mode;
                            per-profile: true;
                            title: "Intro";
                            subtitle: "What to do when an intro segment is detected";
                        }

                        if AppState.settings-skip-intro-mode == "ask-timed": SettingsRow {
                            key: "player.intro_secs";
                            choice: true;
                            value: AppState.settings-skip-intro-secs;
                            per-profile: true;
                            indent: true;
                            title: "Auto-skip after";
                            subtitle: "Seconds before the intro is skipped automatically";
                        }

                        SettingsRow {
                            key: "player.recap_mode";
                            choice: true;
                            value: AppState.settings-skip-recap-mode;
                            per-profile: true;
                            title: "Recap";
                            subtitle: "What to do when a recap segment is detected";
                        }

                        if AppState.settings-skip-recap-mode == "ask-timed": SettingsRow {
                            key: "player.recap_secs";
                            choice: true;
                            value: AppState.settings-skip-recap-secs;
                            per-profile: true;
                            indent: true;
                            title: "Auto-skip after";
                            subtitle: "Seconds before the recap is skipped automatically";
                        }

                        SettingsRow {
                            key: "player.preview_mode";
                            choice: true;
                            value: AppState.settings-skip-preview-mode;
                            per-profile: true;
                            title: "Preview";
                            subtitle: "What to do when a preview segment is detected";
                        }

                        if AppState.settings-skip-preview-mode == "ask-timed": SettingsRow {
                            key: "player.preview_secs";
                            choice: true;
                            value: AppState.settings-skip-preview-secs;
                            per-profile: true;
                            indent: true;
                            title: "Auto-skip after";
                            subtitle: "Seconds before the preview is skipped automatically";
                        }

                        SettingsRow {
                            key: "player.commercial_mode";
                            choice: true;
                            value: AppState.settings-skip-commercial-mode;
                            per-profile: true;
                            title: "Commercial";
                            subtitle: "What to do when a commercial segment is detected";
                        }

                        if AppState.settings-skip-commercial-mode == "ask-timed": SettingsRow {
                            key: "player.commercial_secs";
                            choice: true;
                            value: AppState.settings-skip-commercial-secs;
                            per-profile: true;
                            indent: true;
                            title: "Auto-skip after";
                            subtitle: "Seconds before the commercial is skipped automatically";
                        }

                        SettingsRow {
                            key: "player.credits_mode";
                            choice: true;
                            value: AppState.settings-skip-credits-mode;
                            per-profile: true;
                            title: "Credits / Up Next";
                            subtitle: "What to do when credits start; controls the Up Next auto-advance banner";
                        }

                        if AppState.settings-skip-credits-mode == "ask": SettingsRow {
                            key: "player.credits_secs";
                            choice: true;
                            value: AppState.settings-skip-credits-secs;
                            per-profile: true;
                            indent: true;
                            title: "Countdown";
                            subtitle: "Seconds shown on the Up Next banner before auto-advancing";
                        }

                        SettingsRow {
                            key: "player.skip_fade_ms";
                            choice: true;
                            per-profile: true;
                            value: AppState.settings-skip-fade-ms;
                            title: "Skip fade duration";
                            subtitle: "Fade to black around intro/recap/preview/commercial skips instead of cutting; audio fades with it";
                        }

                        SectionHeader {
                            text: "SEEKING";
                        }

                        SettingsRow {
                            key: "player.seek_step";
                            choice: true;
                            per-profile: true;
                            value: AppState.settings-seek-step-secs;
                            title: "Seek step";
                            subtitle: "Left/Right arrow seek amount during playback";
                        }

                        SettingsRow {
                            key: "player.seek_step_long";
                            choice: true;
                            per-profile: true;
                            value: AppState.settings-seek-step-long-secs;
                            title: "Long seek step";
                            subtitle: "Shift+Left/Right arrow seek amount during playback";
                        }

                        SectionHeader {
                            text: "CONTROLS";
                        }

                        SettingsRow {
                            key: "player.controls_hide_secs";
                            choice: true;
                            value: AppState.settings-controls-hide-secs;
                            per-profile: true;
                            title: "Hide controls after";
                            subtitle: "How long the player controls and the mouse pointer stay up after the last key press or mouse movement";
                        }

                        SectionHeader {
                            text: "TRAILERS";
                        }

                        // Trailer quality: caps the resolution of every YouTube trailer (Discover and the
                        // movie/series Trailer buttons) — no Seerr needed, so always visible (0.5.1; it
                        // used to sit in Integrations behind "Seerr connected").
                    SettingsRow {
                            key: "player.trailer_quality";
                            choice: true;
                            value: AppState.settings-trailer-quality;
                            per-profile: true;
                            title: "Trailer quality";
                            subtitle: "Caps the resolution of YouTube trailers (Discover and the movie/series Trailer buttons) — lower starts faster";
                        }
                    }

                    // ── Subtitles & language section ────────────────────────────────────────
                if AppState.settings-section == "language": VerticalLayout {
                        spacing: Theme.sp-sm;

                        SectionHeader {
                            text: "AUDIO";
                        }

                        SettingsRow {
                            key: "audio.lang";
                            choice: true;
                            value: AppState.settings-audio-lang;
                            per-profile: true;
                            title: "Preferred audio language";
                            subtitle: "Auto-select matching audio track when found; no preference = use video default";
                        }

                        SectionHeader {
                            text: "SUBTITLES";
                        }

                        SettingsRow {
                            key: "player.sub_enabled";
                            per-profile: true;
                            title: "Enable subtitles";
                            subtitle: "Off always disables subtitles regardless of language settings";
                            ToggleSwitch {
                                checked <=> AppState.settings-sub-enabled;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        if AppState.settings-sub-enabled: SettingsRow {
                            key: "player.sub_lang";
                            choice: true;
                            value: AppState.settings-sub-lang;
                            per-profile: true;
                            indent: true;
                            title: "Primary language";
                            subtitle: "Auto-select first matching track; no preference = use video default";
                        }

                        if AppState.settings-sub-enabled: SettingsRow {
                            key: "player.sub_lang2";
                            choice: true;
                            value: AppState.settings-sub-lang2;
                            per-profile: true;
                            indent: true;
                            title: "Fallback language";
                            subtitle: "Tried if the primary language isn't found; if this isn't found either, falls back to video default";
                        }

                        if AppState.settings-sub-enabled: SettingsRow {
                            key: "player.sub_type";
                            choice: true;
                            value: AppState.settings-sub-type;
                            per-profile: true;
                            indent: true;
                            title: "Subtitle type";
                            subtitle: "Prefer Normal (no tags), Forced (foreign lines only), or Hearing Impaired (SDH)";
                        }

                        if AppState.settings-sub-enabled: SettingsRow {
                            key: "player.sub_scale";
                            choice: true;
                            value: AppState.settings-sub-scale-pct;
                            per-profile: true;
                            indent: true;
                            title: "Subtitle size";
                            subtitle: "Applies to both plain and styled (ASS) subtitles";
                        }

                        if AppState.settings-sub-enabled: SettingsRow {
                            key: "player.sub_pos";
                            choice: true;
                            value: AppState.settings-sub-pos-pct;
                            per-profile: true;
                            indent: true;
                            title: "Subtitle position";
                            subtitle: "100 = mpv's default bottom position; higher pushes it lower still (may clip text/ASS subs)";
                        }

                        if AppState.settings-sub-enabled: SettingsRow {
                            key: "player.sub_respect_ass";
                            per-profile: true;
                            indent: true;
                            title: "Respect subtitle's own styling (ASS)";
                            subtitle: "Off lets Color/Background below also apply to styled subtitles — may render some files incorrectly";
                            ToggleSwitch {
                                checked <=> AppState.settings-sub-respect-ass-styling;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        if AppState.settings-sub-enabled && !AppState.settings-sub-respect-ass-styling: SettingsRow {
                            key: "player.sub_color";
                            choice: true;
                            value: AppState.settings-sub-color;
                            per-profile: true;
                            indent: true;
                            title: "Subtitle color";
                            subtitle: "Only affects plain subtitles unless styling above is not respected";
                        }

                        if AppState.settings-sub-enabled && !AppState.settings-sub-respect-ass-styling: SettingsRow {
                            key: "player.sub_background_pct";
                            choice: true;
                            value: AppState.settings-sub-background-pct;
                            per-profile: true;
                            indent: true;
                            title: "Subtitle background box";
                            subtitle: "A box behind subtitle text — Light, Medium and Dark let the picture show through, Solid doesn't";
                        }
                    }

                    // ── Display section ─────────────────────────────────────────────────────
                if AppState.settings-section == "display": VerticalLayout {
                        spacing: Theme.sp-sm;

                        SectionHeader {
                            text: "WINDOW";
                        }

                        SettingsRow {
                            key: "general.launch_fullscreen";
                            title: "Launch in fullscreen";
                            subtitle: "Start Fjord in fullscreen mode";
                            ToggleSwitch {
                                checked <=> AppState.settings-launch-fullscreen;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        SectionHeader {
                            text: "HDR";
                        }

                        SettingsRow {
                            key: "video.target_colorspace";
                            title: "HDR passthrough";
                            subtitle: "Send HDR metadata to the TV for real HDR; if it isn't accepted, the Tone mapping curve below is used";
                            ToggleSwitch {
                                checked <=> AppState.settings-target-colorspace-hint;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        // HDR Stage 5 (2026-10-05) — Wayland only (settings::section_row_keys mirrors this).
                    if AppState.is-wayland: SettingsRow {
                            key: "video.separate_video_surface";
                            title: "Separate video surface";
                            subtitle: "Keeps menus in the right colors during HDR. Turn off if video stutters. Applies from the next video";
                            ToggleSwitch {
                                checked <=> AppState.settings-separate-video-surface;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        // Per-curve description, a ternary over settings-tone-mapping (one source of truth with
                        // the dropdown). Some curves fail to compile on NVIDIA's GLSL compiler, so "auto" isn't
                        // always safe (DEVLOG → HDR tone-mapping shader compile failure).
                        //
                        // Not gated on the colorspace hint: mpv's target-colorspace-hint-strict falls back to this
                        // curve when the compositor refuses HDR passthrough, so the curve must stay choosable.
                    SettingsRow {
                            key: "video.tone_mapping";
                            choice: true;
                            value: AppState.settings-tone-mapping;
                            title: "Tone mapping";
                            subtitle: AppState.settings-tone-mapping == "auto" ? "Lets mpv pick a curve automatically — usually fine, but if HDR playback hangs or shows a black screen, try a specific mode below instead" :
                                AppState.settings-tone-mapping == "bt.2390" ? "The ITU-R BT.2390 standard curve — mpv's own modern reference algorithm; a solid, neutral pick if 'auto' misbehaves" :
                                AppState.settings-tone-mapping == "hable" ? "Filmic curve (the one popularized by Uncharted 2) — favors punchy contrast; a common 'cinematic' look" :
                                AppState.settings-tone-mapping == "mobius" ? "Smoothly compresses only the out-of-range highlights, leaving darker tones mostly untouched" :
                                AppState.settings-tone-mapping == "reinhard" ? "Simple, gentle compression curve — safe and predictable, but can look slightly flat/desaturated in bright scenes" :
                                AppState.settings-tone-mapping == "clip" ? "No real tone mapping — anything brighter than the display's range is just crushed to solid white, losing highlight detail" :
                                AppState.settings-tone-mapping == "gamma" ? "Rescales brightness with a gamma curve, similar to simulating a lower-dynamic-range display" :
                                AppState.settings-tone-mapping == "linear" ? "Linearly stretches the whole brightness range to fit the display — simple, but can look washed out on very bright content" :
                                "HDR → SDR algorithm";
                            indent: true;
                        }

                        SectionHeader {
                            text: "DISPLAY SYNC";
                        }

                        // Display sync — resolution/refresh-rate/HDR matching to the source via kscreen-doctor
                        // (KDE Plasma Wayland only); see display_sync.rs.
                    SettingsRow {
                            key: "video.display_sync_enabled";
                            title: "Sync display to source";
                            subtitle: "Switch the TV's resolution, refresh rate and HDR to match the video, and back on stop (KDE Wayland only)";
                            ToggleSwitch {
                                checked <=> AppState.settings-display-sync-enabled;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        if AppState.settings-display-sync-enabled: SettingsRow {
                            key: "video.display_sync_screen";
                            title: "Output";
                            subtitle: "The output to switch (kscreen-doctor name), pre-filled when only one is connected; KDE's primary is marked";
                            indent: true;
                            SettingsDropdown {
                                model <=> AppState.settings-display-sync-screen-options;
                                current-value: AppState.settings-display-sync-screen-desc != "" ? AppState.settings-display-sync-screen-desc : "(not detected)";
                                selected(v) => { AppState.display-sync-screen-selected(v); AppState.refocus(); }
                            }
                        }

                        if AppState.settings-display-sync-enabled: SettingsRow {
                            key: "video.display_sync_sync_resolution";
                            title: "Sync resolution";
                            subtitle: "Off = resolution always stays pinned to the default below, only refresh rate varies by source";
                            indent: true;
                            ToggleSwitch {
                                checked <=> AppState.settings-display-sync-sync-resolution;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        if AppState.settings-display-sync-enabled: SettingsRow {
                            key: "video.display_sync_sync_refresh_rate";
                            title: "Sync refresh rate";
                            subtitle: "Off = refresh rate always stays pinned to the default Hz below, only resolution varies by source";
                            indent: true;
                            ToggleSwitch {
                                checked <=> AppState.settings-display-sync-sync-refresh-rate;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        if AppState.settings-display-sync-enabled: SettingsRow {
                            key: "video.display_sync_default_resolution";
                            title: "Default resolution";
                            subtitle: "Used for non-4K video and when a target mode isn't supported — the modes this output really has";
                            indent: true;
                            SettingsDropdown {
                                model <=> AppState.settings-display-sync-resolution-options;
                                current-value: AppState.settings-display-sync-default-resolution;
                                selected(v) => { AppState.display-sync-resolution-selected(v); AppState.refocus(); }
                            }
                        }

                        if AppState.settings-display-sync-enabled: SettingsRow {
                            key: "video.display_sync_default_hz";
                            title: "Default refresh rate";
                            subtitle: "Used when the video's frame rate isn't a known cadence — the rates this output really has";
                            indent: true;
                            SettingsDropdown {
                                model <=> AppState.settings-display-sync-hz-options;
                                current-value: AppState.settings-display-sync-default-hz;
                                selected(v) => { AppState.display-sync-hz-selected(v); AppState.refocus(); }
                            }
                        }

                        if AppState.settings-display-sync-enabled: SettingsRow {
                            key: "video.display_sync_scale_4k";
                            choice: true;
                            value: AppState.settings-display-sync-scale-4k;
                            title: "Desktop scale at 4K";
                            subtitle: "Applied alongside every switch to a 4K mode, matching what the proven external script this ports always did";
                            indent: true;
                        }

                        if AppState.settings-display-sync-enabled: SettingsRow {
                            key: "video.display_sync_scale_1080p";
                            choice: true;
                            value: AppState.settings-display-sync-scale-1080p;
                            title: "Desktop scale at 1080p";
                            subtitle: "Applied alongside every switch to a non-4K mode";
                            indent: true;
                        }

                        if AppState.settings-display-sync-enabled && AppState.settings-display-sync-sync-resolution: SettingsRow {
                            key: "video.display_sync_4k_odd_fps_mode";
                            choice: true;
                            value: AppState.settings-display-sync-4k-odd-fps-mode;
                            title: "4K at an unusual framerate";
                            subtitle: "4K video at an unusual frame rate (not 23.98/25/29.97): use the default resolution, or stay at 4K with the closest rate";
                            indent: true;
                        }

                        if AppState.settings-display-sync-enabled: SettingsRow {
                            key: "video.display_sync_hdr_mode";
                            choice: true;
                            value: AppState.settings-display-sync-hdr-mode;
                            title: "HDR";
                            subtitle: "Match source = enable HDR only for genuinely HDR/HLG content; Always/Never override that per-item decision entirely";
                            indent: true;
                        }

                        if AppState.settings-display-sync-enabled: SettingsRow {
                            key: "video.display_sync_wcg_mode";
                            choice: true;
                            value: AppState.settings-display-sync-wcg-mode;
                            title: "Wide color gamut";
                            subtitle: "Follow HDR (default) turns WCG on exactly when HDR is on for this item; Always/Never override that";
                            indent: true;
                        }

                        if AppState.settings-display-sync-enabled: SettingsRow {
                            key: "video.display_sync_trailers";
                            title: "Sync display for trailers";
                            subtitle: "Off = Watch Trailer plays in whatever mode the display is already in, no resolution/refresh-rate switch";
                            indent: true;
                            ToggleSwitch {
                                checked <=> AppState.settings-display-sync-trailers;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }
                    }

                    // ── Audio section ───────────────────────────────────────────────────────
                if AppState.settings-section == "audio": VerticalLayout {
                        spacing: Theme.sp-sm;

                        SectionHeader {
                            text: "OUTPUT";
                        }

                        SettingsRow {
                            key: "audio.device";
                            title: "Audio output";
                            subtitle: "mpv audio device — auto lets the system choose";
                            SettingsDropdown {
                                model <=> AppState.settings-audio-device-display;
                                current-value: AppState.settings-audio-device-desc != "" ? AppState.settings-audio-device-desc : "Autoselect device";
                                selected(v) => { AppState.audio-device-selected(v); AppState.refocus(); }
                            }
                        }

                        SettingsRow {
                            key: "audio.channels";
                            choice: true;
                            value: AppState.settings-audio-channels;
                            title: "Audio channels";
                            subtitle: "'auto-safe' may downmix 5.1 PCM to stereo on direct ALSA devices — '7.1,5.1,stereo' negotiates the best layout";
                        }

                        SectionHeader {
                            text: "PASSTHROUGH";
                        }

                        SettingsRow {
                            key: "audio.spdif";
                            title: "Audio passthrough (SPDIF)";
                            subtitle: "Bitstream audio to AV receiver — select formats below";
                            ToggleSwitch {
                                checked <=> AppState.settings-audio-spdif;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        if AppState.settings-audio-spdif: VerticalLayout {
                            SettingsRow {
                                key: "audio.spdif_ac3";
                                title: "AC3 (Dolby Digital)";
                                subtitle: "Standard Dolby 5.1";
                                indent: true;
                                ToggleSwitch {
                                    checked <=> AppState.settings-spdif-ac3;
                                    toggled => { AppState.settings-changed(); AppState.refocus(); }
                                }
                            }

                            SettingsRow {
                                key: "audio.spdif_eac3";
                                title: "EAC3 (Dolby Digital Plus)";
                                subtitle: "DD+ used on streaming and Blu-ray";
                                indent: true;
                                ToggleSwitch {
                                    checked <=> AppState.settings-spdif-eac3;
                                    toggled => { AppState.settings-changed(); AppState.refocus(); }
                                }
                            }

                            SettingsRow {
                                key: "audio.spdif_dts";
                                title: "DTS";
                                subtitle: "DTS core";
                                indent: true;
                                ToggleSwitch {
                                    checked <=> AppState.settings-spdif-dts;
                                    toggled => { AppState.settings-changed(); AppState.refocus(); }
                                }
                            }

                            SettingsRow {
                                key: "audio.spdif_dts_hd";
                                title: "DTS-HD MA";
                                subtitle: "DTS lossless / DTS:X";
                                indent: true;
                                ToggleSwitch {
                                    checked <=> AppState.settings-spdif-dts-hd;
                                    toggled => { AppState.settings-changed(); AppState.refocus(); }
                                }
                            }

                            SettingsRow {
                                key: "audio.spdif_truehd";
                                title: "TrueHD / Atmos";
                                subtitle: "Dolby lossless / Atmos object audio";
                                indent: true;
                                ToggleSwitch {
                                    checked <=> AppState.settings-spdif-truehd;
                                    toggled => { AppState.settings-changed(); AppState.refocus(); }
                                }
                            }

                            SettingsRow {
                                key: "audio.passthrough_device";
                                indent: true;
                                title: "Passthrough output";
                                subtitle: "Device used for video while SPDIF is on — music always keeps the normal output";
                                SettingsDropdown {
                                    model <=> AppState.settings-audio-device-display;
                                    current-value: AppState.settings-passthrough-device-desc != "" ? AppState.settings-passthrough-device-desc : "Same as audio output";
                                    selected(v) => { AppState.passthrough-device-selected(v); AppState.refocus(); }
                                }
                            }

                            if AppState.settings-device-is-pipewire: SettingsRow {
                                key: "audio.alsa_irq";
                                indent: true;
                                title: "PipeWire IRQ scheduling";
                                subtitle: "Use hardware IRQ wakeups instead of software timers — fixes passthrough dropout under GPU load";
                                ToggleSwitch {
                                    checked <=> AppState.settings-alsa-irq-scheduling;
                                    toggled => { AppState.settings-changed(); AppState.refocus(); }
                                }
                            }
                            SettingsRow {
                                key: "audio.skip_fade_mute";
                                indent: true;
                                title: "Mute during skip fade";
                                subtitle: "Mute during the skip fade — passthrough audio can't be faded. Off leaves it playing (the picture still fades)";
                                ToggleSwitch {
                                    checked <=> AppState.settings-skip-fade-mute-passthrough;
                                    toggled => { AppState.settings-changed(); AppState.refocus(); }
                                }
                            }
                        }

                        if AppState.settings-audio-spdif && AppState.settings-video-sync == "display-resample" && (AppState.settings-spdif-ac3 || AppState.settings-spdif-eac3 || AppState.settings-spdif-dts || AppState.settings-spdif-dts-hd || AppState.settings-spdif-truehd): Rectangle {
                            height: 24px;
                            HorizontalLayout {
                                x: 12px;
                                y: 0px;
                                height: parent.height;
                                spacing: 4px;
                                alignment: start;
                                Text {
                                    text: "⚠";
                                    font-family: "Noto Sans Symbols 2";
                                    color: Theme.error;
                                    font-size: 12px * AppState.text-scale;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "passthrough active — display-resample falls back to 'audio' sync (no display sync correction)";
                                    color: Theme.error;
                                    font-size: 12px * AppState.text-scale;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        SectionHeader {
                            text: "MUSIC";
                        }

                        SettingsRow {
                            key: "audio.gapless";
                            title: "Gapless music playback";
                            subtitle: "Preload the next track into the running player — album transitions without a gap";
                            ToggleSwitch {
                                checked <=> AppState.settings-gapless-audio;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        SettingsRow {
                            key: "audio.now_playing_auto_open_secs";
                            choice: true;
                            value: AppState.settings-now-playing-auto-open-secs;
                            per-profile: true;
                            title: "Auto-open Now Playing";
                            subtitle: "Show the fullscreen music screen after this long without a key press or mouse movement while music plays";
                        }

                        SettingsRow {
                            key: "audio.now_playing_background";
                            choice: true;
                            value: AppState.settings-now-playing-background;
                            per-profile: true;
                            title: "Now Playing background";
                            subtitle: "The song's cover, blurred, behind the Now Playing screen — Soft keeps it dark, Strong shows its colors";
                        }

                        SettingsRow {
                            key: "audio.screensaver_mins";
                            choice: true;
                            value: AppState.settings-screensaver-mins;
                            per-profile: true;
                            title: "Screensaver while music plays";
                            subtitle: "Turn the picture black after this long without a key press or mouse movement; the TV stays on — saved for this profile";
                        }
                    }

                    // ── Interface section ───────────────────────────────────────────────────
                if AppState.settings-section == "ui": VerticalLayout {
                        spacing: Theme.sp-sm;

                        SectionHeader {
                            text: "INTERFACE";
                        }

                        // Poster card size — per profile, unlike the rows below.
                    SettingsRow {
                            key: "ui.card_size";
                            choice: true;
                            value: AppState.settings-card-size;
                            per-profile: true;
                            title: "Card size";
                            subtitle: "Size of the poster cards on every screen (dashboards, libraries, Discover) — saved for this profile";
                        }

                        SettingsRow {
                            key: "ui.text_size";
                            choice: true;
                            value: AppState.settings-text-size;
                            per-profile: true;
                            title: "Text size";
                            subtitle: "Size of the text everywhere — menus, cards, settings, the player — saved for this profile";
                        }

                        SettingsRow {
                            key: "ui.dashboard_hero";
                            choice: true;
                            value: AppState.settings-dashboard-hero;
                            per-profile: true;
                            title: "Dashboard highlight";
                            subtitle: "The selected item's picture, title, details and story on the dashboards: in a band above the rows, or as the background behind them — saved for this profile";
                        }

                        SettingsRow {
                            key: "ui.dashboard_rows";
                            per-profile: true;
                            title: "Dashboard rows";
                            subtitle: "Choose which rows each dashboard shows, and in what order — saved for this profile";
                            FjordButton {
                                width: 100px * AppState.text-scale;
                                text: "Edit…";
                                clicked => { AppState.dash-rows-open(); }
                            }
                        }

                        SettingsRow {
                            key: "ui.focus_color";
                            choice: true;
                            value: AppState.settings-focus-color;
                            per-profile: true;
                            title: "Focus ring color";
                            subtitle: "Color of the ring around whatever is selected — saved for this profile";
                        }

                        SettingsRow {
                            key: "ui.focus_width";
                            choice: true;
                            value: AppState.settings-focus-width;
                            per-profile: true;
                            title: "Focus ring thickness";
                            subtitle: "How thick the ring around the selected item is — saved for this profile";
                        }

                        SettingsRow {
                            key: "ui.focus_style";
                            choice: true;
                            value: AppState.settings-focus-style;
                            per-profile: true;
                            title: "Focus ring style";
                            subtitle: "A line around the selected item, a soft glow, or both — saved for this profile";
                        }

                        if AppState.settings-focus-style != "line": SettingsRow {
                            key: "ui.focus_glow";
                            choice: true;
                            value: AppState.settings-focus-glow;
                            per-profile: true;
                            title: "Focus glow strength";
                            subtitle: "How far the glow reaches around the selected item — saved for this profile";
                        }

                        if AppState.settings-focus-style != "line": SettingsRow {
                            key: "ui.focus_glow_on";
                            choice: true;
                            value: AppState.settings-focus-glow-on;
                            per-profile: true;
                            title: "Glow on";
                            subtitle: "Pictures and buttons only, also the sidebar, or every row, field and menu too — saved for this profile";
                        }

                        SettingsRow {
                            key: "ui.focus_opacity";
                            choice: true;
                            value: AppState.settings-focus-opacity;
                            per-profile: true;
                            title: "Focus ring transparency";
                            subtitle: "Solid, or see-through so the ring is softer — saved for this profile";
                        }

                        SettingsRow {
                            key: "ui.focus_zoom";
                            choice: true;
                            value: AppState.settings-focus-zoom;
                            per-profile: true;
                            title: "Zoom on the selected picture";
                            subtitle: "How much a selected poster, cover, photo or profile tile grows — saved for this profile";
                        }

                        SettingsRow {
                            key: "general.video_behind";
                            per-profile: true;
                            title: "Video in background";
                            subtitle: "Show video behind the UI when you press Back during playback";
                            ToggleSwitch {
                                checked <=> AppState.settings-video-behind;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        // Text font (dynamic dropdown, same shape as Audio output
                    // above — fetched at startup via fc-list, main.rs)
                    SettingsRow {
                            key: "ui.font_family";
                            per-profile: true;
                            title: "Text font";
                            subtitle: "Inter is Fjord's own designed-around default — pick any font installed on this system to override it";
                            SettingsDropdown {
                                model <=> AppState.settings-font-family-display;
                                current-value: AppState.settings-font-family-desc != "" ? AppState.settings-font-family-desc : "Inter (Fjord default)";
                                selected(v) => { AppState.font-family-selected(v); AppState.refocus(); }
                            }
                        }

                        // On-screen alphanumeric keyboard (2026-08-27) — default
                    // on, since Fjord needs to stay fully usable with no
                    // physical keyboard attached (remote/D-pad only).
                    SettingsRow {
                            key: "ui.onscreen_keyboard";
                            per-profile: true;
                            title: "On-screen keyboard";
                            subtitle: "A remote-friendly keyboard for search, sign-in and name fields — turn off if you always use a real keyboard";
                            ToggleSwitch {
                                checked <=> AppState.settings-onscreen-keyboard-enabled;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        SettingsRow {
                            key: "ui.toast_secs";
                            choice: true;
                            value: AppState.settings-toast-secs;
                            per-profile: true;
                            title: "Message duration";
                            subtitle: "How long short messages — confirmations and errors — stay on screen";
                        }

                        // Scroll speed. The value is a DURATION multiplier, not a
                    // rate — bigger % = longer transition = slower, smaller % = faster.
                    // Opposite of what "speed" suggests at a glance, so the subtitle
                    // spells it out.
                    SettingsRow {
                            key: "ui.scroll_speed";
                            choice: true;
                            per-profile: true;
                            value: AppState.settings-scroll-speed-pct;
                            title: "Scroll speed";
                            subtitle: "Speed of list/page scrolling with the keyboard — lower % is faster, higher % is slower";
                        }

                        // Animation speed (same duration-multiplier caveat as above)
                    SettingsRow {
                            key: "ui.animation_speed";
                            choice: true;
                            per-profile: true;
                            value: AppState.settings-animation-speed-pct;
                            title: "Animation speed";
                            subtitle: "Speed of press feedback, fades, and other UI transitions — lower % is faster, higher % is slower, 0% = instant";
                        }
                    }

                    // ── Profiles section (Phase 0 shell — Sign Out moved here from
                // General; Phase 1 step 7 adds the launch-policy rows) ─────────
                if AppState.settings-section == "profiles": VerticalLayout {
                        spacing: Theme.sp-sm;

                        SectionHeader {
                            text: "PROFILES";
                        }

                        SettingsRow {
                            key: "profiles.launch_policy";
                            choice: true;
                            value: AppState.settings-launch-policy;
                            title: "Launch behavior";
                            subtitle: "What to do at startup when more than one profile is known on this device";
                        }

                        // Virtual — only meaningful (and only reachable, matching
                    // section_row_keys' own condition) while Launch behavior
                    // is Default Profile.
                    if AppState.settings-launch-policy == "default": SettingsRow {
                            key: "profiles.default_profile";
                            indent: true;
                            title: "Default profile";
                            subtitle: "Which known profile to sign in as automatically";
                            SettingsDropdown {
                                model <=> AppState.settings-default-profile-display;
                                current-value: AppState.settings-default-profile-desc != "" ? AppState.settings-default-profile-desc : "Not set";
                                selected(v) => { AppState.default-profile-selected(v); AppState.refocus(); }
                            }
                        }

                        // Manage Profiles: only for a master account (a sub-profile has no siblings to manage).
                    if AppState.settings-is-master-profile: Rectangle {
                            border-radius: Theme.radius;
                            background: AppState.settings-focused == "profiles.manage_profiles" ? Theme.accent-muted
                                : (manage-ta.has-hover ? Theme.surface : transparent);
                            height: 48px;
                            border-width: AppState.ring-width(manage-pulse.active, manage-ta.pressed || manage-pulse.pulsing);
                            border-color: AppState.focus-color;
                            animate border-width {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                            FocusHalo {
                                glowing: manage-pulse.active;
                                radius: Theme.radius;
                            }

                            // !show-manage-profiles: the overlay's backdrop is translucent and Enter inside it bumps
                        // the shared kb-activate-pulse, which flashed this row as if the key leaked through.
                        // settings-focused is deliberately kept — it returns focus to this row when the overlay
                        // closes.
                            manage-pulse := PressPulse {
                                trigger: AppState.kb-activate-pulse;
                                active: AppState.settings-focused == "profiles.manage_profiles" && !AppState.show-manage-profiles;
                            }

                            manage-ta := TouchArea {
                                clicked => { AppState.open-manage-profiles(); }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                alignment: start;
                                Text {
                                    text: "Manage Profiles";
                                    color: Theme.text;
                                    font-size: 14px * AppState.text-scale;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Copy settings from another profile on this device: only the rows tagged "Profile"
                        // (ProfileSettings::copy_settings_from); no PIN — these are local preferences. Picking a
                        // profile opens the confirm dialog at the bottom of this file.
                    if AppState.settings-copy-sources-display.length > 0: SettingsRow {
                            key: "profiles.copy_settings";
                            title: "Copy settings from…";
                            subtitle: "Replace this profile's settings tagged Profile with another profile's — sign-in and Seerr stay";
                            SettingsDropdown {
                                model <=> AppState.settings-copy-sources-display;
                                current-value: "Choose a profile";
                                selected(v) => {
                                    AppState.copy-settings-source-selected(v);
                                    AppState.refocus();
                                }
                            }
                        }

                        // ── Account launch policy — the same shape one tier up; only differs from "always ask"
                        // once 2+ accounts exist (see should_show_picker_at_startup).
                    SettingsRow {
                            key: "profiles.account_launch_policy";
                            choice: true;
                            value: AppState.settings-account-launch-policy;
                            title: "Account launch behavior";
                            subtitle: "What to do at startup when more than one ACCOUNT is known on this device (a plain login, or a whole Bonfire household)";
                        }

                        if AppState.settings-account-launch-policy == "default": SettingsRow {
                            key: "profiles.default_account";
                            indent: true;
                            title: "Default account";
                            subtitle: "Which known account to sign in as automatically";
                            SettingsDropdown {
                                model <=> AppState.settings-default-account-display;
                                current-value: AppState.settings-default-account-desc != "" ? AppState.settings-default-account-desc : "Not set";
                                selected(v) => { AppState.default-account-selected(v); AppState.refocus(); }
                            }
                        }

                        // Always visible: the picker's "+ Add Account" tile only shows once there are two
                        // accounts, so this is the way to add the second.
                    Rectangle {
                            border-radius: Theme.radius;
                            background: AppState.settings-focused == "profiles.add_account" ? Theme.accent-muted
                                : (addacct-ta.has-hover ? Theme.surface : transparent);
                            height: 48px;
                            border-width: AppState.ring-width(addacct-pulse.active, addacct-ta.pressed || addacct-pulse.pulsing);
                            border-color: AppState.focus-color;
                            animate border-width {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                            FocusHalo {
                                glowing: addacct-pulse.active;
                                radius: Theme.radius;
                            }

                            addacct-pulse := PressPulse {
                                trigger: AppState.kb-activate-pulse;
                                active: AppState.settings-focused == "profiles.add_account";
                            }

                            addacct-ta := TouchArea {
                                clicked => { AppState.settings-add-account(); }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                alignment: start;
                                Text {
                                    text: "Add Account";
                                    color: Theme.text;
                                    font-size: 14px * AppState.text-scale;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Not a two-way binding: OFF applies immediately, ON opens the confirm-password modal —
                        // both keyboard and mouse go through settings_row_action (see app_state.slint's
                        // settings-remember-login).
                    SettingsRow {
                            key: "profiles.remember_login";
                            title: "Remember this login";
                            subtitle: "Off requires a password next launch; turning it back on needs a quick password check";
                            ToggleSwitch {
                                checked: AppState.settings-remember-login;
                                toggled => { AppState.settings-remember-login-toggle(); AppState.refocus(); }
                            }
                        }

                        Rectangle {
                            border-radius: Theme.radius;
                            background: AppState.settings-focused == "profiles.sign_out" ? Theme.accent-muted
                                : (signout-ta.has-hover ? Theme.surface : transparent);
                            height: 48px;
                            border-width: AppState.ring-width(signout-pulse.active, signout-ta.pressed || signout-pulse.pulsing);
                            border-color: AppState.focus-color;
                            animate border-width {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                            FocusHalo {
                                glowing: signout-pulse.active;
                                radius: Theme.radius;
                            }

                            signout-pulse := PressPulse {
                                trigger: AppState.kb-activate-pulse;
                                active: AppState.settings-focused == "profiles.sign_out";
                            }

                            signout-ta := TouchArea {
                                clicked => {
                                    AppState.sign-out-confirm-focused = 0;
                                    AppState.show-sign-out-confirm = true;
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                alignment: start;
                                Text {
                                    text: "Sign Out";
                                    color: Theme.error;
                                    font-size: 14px * AppState.text-scale;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Bonfire Group: master accounts only, like Manage Profiles.
                    if AppState.settings-is-master-profile: Rectangle {
                            border-radius: Theme.radius;
                            background: AppState.settings-focused == "profiles.bonfire_group" ? Theme.accent-muted
                                : (bonfire-group-ta.has-hover ? Theme.surface : transparent);
                            height: 48px;
                            border-width: AppState.ring-width(bonfire-group-pulse.active, bonfire-group-ta.pressed || bonfire-group-pulse.pulsing);
                            border-color: AppState.focus-color;
                            animate border-width {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                            FocusHalo {
                                glowing: bonfire-group-pulse.active;
                                radius: Theme.radius;
                            }

                            // !show-bonfire-group — same fix, same reasoning, as
                        // manage-pulse's own doc comment above (found from the
                        // live report this bug was originally caught by).
                            bonfire-group-pulse := PressPulse {
                                trigger: AppState.kb-activate-pulse;
                                active: AppState.settings-focused == "profiles.bonfire_group" && !AppState.show-bonfire-group;
                            }

                            bonfire-group-ta := TouchArea {
                                clicked => { AppState.open-bonfire-group(); }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                alignment: start;
                                Text {
                                    text: "Bonfire Group";
                                    color: Theme.text;
                                    font-size: 14px * AppState.text-scale;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Bonfire Admin: gated on jellyfin-is-server-admin, not settings-is-master-profile — the
                        // plugin's admin endpoints authorize against Jellyfin's Policy.IsAdministrator (see
                        // settings.rs's PROF_BONFIRE_ADMIN).
                    if AppState.jellyfin-is-server-admin: Rectangle {
                            border-radius: Theme.radius;
                            background: AppState.settings-focused == "profiles.bonfire_admin" ? Theme.accent-muted
                                : (bonfire-admin-ta.has-hover ? Theme.surface : transparent);
                            height: 48px;
                            border-width: AppState.ring-width(bonfire-admin-pulse.active, bonfire-admin-ta.pressed || bonfire-admin-pulse.pulsing);
                            border-color: AppState.focus-color;
                            animate border-width {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                            FocusHalo {
                                glowing: bonfire-admin-pulse.active;
                                radius: Theme.radius;
                            }

                            // !show-bonfire-admin — same fix, same reasoning, as
                        // manage-pulse's/bonfire-group-pulse's own doc comments above.
                            bonfire-admin-pulse := PressPulse {
                                trigger: AppState.kb-activate-pulse;
                                active: AppState.settings-focused == "profiles.bonfire_admin" && !AppState.show-bonfire-admin;
                            }

                            bonfire-admin-ta := TouchArea {
                                clicked => { AppState.open-bonfire-admin(); }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                alignment: start;
                                Text {
                                    text: "Bonfire Admin";
                                    color: Theme.text;
                                    font-size: 14px * AppState.text-scale;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // ── Key Bindings section ──────────────────────────────────────
                if AppState.settings-section == "keybindings": VerticalLayout {
                        spacing: 0;

                        // Spell out that Enter captures the very next key as the new binding.
                    Text {
                            text: "Enter rebinds the focused action — press any key to set it, or Escape to cancel";
                            color: Theme.text-muted;
                            font-size: 12px * AppState.text-scale;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 8px;
                        }

                        SectionHeader {
                            text: "NAVIGATION & GLOBAL";
                        }

                        for kb[i] in AppState.keybinding-normal: Rectangle {
                            height: 44px;
                            border-radius: Theme.radius;
                            background: AppState.keybinding-focused == i
                                ? (AppState.keybinding-rebinding ? Theme.accent : Theme.accent-muted)
                                : (kb-ta.has-hover ? Theme.surface : transparent);
                            border-width: AppState.ring-width(kb-pulse.active, kb-ta.pressed || kb-pulse.pulsing);
                            border-color: AppState.focus-color;
                            animate border-width {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                            FocusHalo {
                                glowing: kb-pulse.active;
                                radius: Theme.radius;
                            }

                            kb-pulse := PressPulse {
                                trigger: AppState.kb-activate-pulse;
                                active: AppState.keybinding-focused == i;
                            }

                            kb-ta := TouchArea {
                                clicked => { AppState.keybinding-focused = i; }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: space-between;
                                Text {
                                    text: kb.action;
                                    color: Theme.text;
                                    font-size: 13px * AppState.text-scale;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: AppState.keybinding-focused == i && AppState.keybinding-rebinding
                                        ? "Press a key…" : kb.key;
                                    color: AppState.keybinding-focused == i && AppState.keybinding-rebinding
                                        ? Theme.bg : Theme.text-muted;
                                    font-size: 12px * AppState.text-scale;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        SectionHeader {
                            text: "PLAYER";
                        }

                        for kb[i] in AppState.keybinding-player: Rectangle {
                            height: 44px;
                            border-radius: Theme.radius;
                            background: AppState.keybinding-focused == i + AppState.keybinding-normal.length
                                ? (AppState.keybinding-rebinding ? Theme.accent : Theme.accent-muted)
                                : (kb-player-ta.has-hover ? Theme.surface : transparent);
                            border-width: AppState.ring-width(kb-player-pulse.active, kb-player-ta.pressed || kb-player-pulse.pulsing);
                            border-color: AppState.focus-color;
                            animate border-width {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                            FocusHalo {
                                glowing: kb-player-pulse.active;
                                radius: Theme.radius;
                            }

                            kb-player-pulse := PressPulse {
                                trigger: AppState.kb-activate-pulse;
                                active: AppState.keybinding-focused == i + AppState.keybinding-normal.length;
                            }

                            kb-player-ta := TouchArea {
                                clicked => { AppState.keybinding-focused = i + AppState.keybinding-normal.length; }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: space-between;
                                Text {
                                    text: kb.action;
                                    color: Theme.text;
                                    font-size: 13px * AppState.text-scale;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: AppState.keybinding-focused == i + AppState.keybinding-normal.length
                                        && AppState.keybinding-rebinding ? "Press a key…" : kb.key;
                                    color: AppState.keybinding-focused == i + AppState.keybinding-normal.length
                                        && AppState.keybinding-rebinding ? Theme.bg : Theme.text-muted;
                                    font-size: 12px * AppState.text-scale;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // kbd-focused uses the same condition as keys.rs's dispatch_keybinding_nav (fi == total).
                        // Click/Confirm opens the confirm dialog below instead of resetting directly.
                    reset-btn := FjordButton {
                            text: "Reset to Defaults";
                            kbd-focused: AppState.keybinding-focused == AppState.keybinding-normal.length + AppState.keybinding-player.length;
                            clicked => {
                                AppState.keybinding-focused = AppState.keybinding-normal.length + AppState.keybinding-player.length;
                                AppState.keybinding-reset-confirm-focused = 0;
                                AppState.show-keybinding-reset-confirm = true;
                            }
                        }

                        // Exact Reset-row scroll: reads reset-btn's real layout position (estimates kept coming
                        // up short). Declared here because reset-btn only exists while this section is mounted;
                        // right-fl/right-pane are unconditional ancestors, safe to reach from here.
                    property <int> _reset-fi-mirror: AppState.keybinding-focused;
                        changed _reset-fi-mirror => {
                        // Push the real content height to right-pane on every focus change (see its
                        // kb-content-h-override) so Flickable can't clamp the target short.
                        right-pane.kb-content-h-override = reset-btn.y + reset-btn.height;
                            if AppState.keybinding-focused >= AppState.keybinding-normal.length + AppState.keybinding-player.length {
                                right-fl.content-y = min(0px,
                                right-pane.height - (Theme.sp-xl * 2 + reset-btn.y + reset-btn.height));
                            }
                        }
                    }

                    // ── Integrations section ────────────────────────────────────
                if AppState.settings-section == "integrations": VerticalLayout {
                        spacing: Theme.sp-sm;

                        SectionHeader {
                            text: "INTEGRATIONS";
                        }

                        // Enable Seerr (gates the Discover sidebar tab AND
                    // everything below this row — Connect/Disconnect through
                    // Discover Region all require settings-seerr-enabled now,
                    // not just seerr-connected; see main.rs's
                    // on_settings_changed + seerr_auth::push_seerr_status.
                    // Toggling off does NOT forget the saved connection — see
                    // the property doc comment in app_state.slint — so
                    // re-enabling reconnects instantly)
                    SettingsRow {
                            key: "integrations.seerr_enabled";
                            title: "Seerr";
                            subtitle: "Search and request movies/shows not yet in your library";
                            ToggleSwitch {
                                checked <=> AppState.settings-seerr-enabled;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        // Connect / Disconnect (bespoke Rectangle, same pattern as
                    // the Profiles section's Sign Out row — a plain action
                    // row, not a SettingsRow + control pair). Only rendered
                    // while seerr-enabled.
                    if AppState.settings-seerr-enabled: Rectangle {
                            border-radius: Theme.radius;
                            background: AppState.settings-focused == "integrations.seerr_connect" ? Theme.accent-muted
                                : (int-connect-ta.has-hover ? Theme.surface : transparent);
                            height: 48px;
                            border-width: AppState.ring-width(int-connect-pulse.active, int-connect-ta.pressed || int-connect-pulse.pulsing);
                            border-color: AppState.focus-color;
                            animate border-width {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                            FocusHalo {
                                glowing: int-connect-pulse.active;
                                radius: Theme.radius;
                            }

                            int-connect-pulse := PressPulse {
                                trigger: AppState.kb-activate-pulse;
                                active: AppState.settings-focused == "integrations.seerr_connect";
                            }

                            int-connect-ta := TouchArea {
                                clicked => {
                                // Confirmation dialog, 2026-08-22 — see
                                // show-seerr-disconnect-confirm's own doc
                                // comment in app_state.slint.
                                if AppState.seerr-connected {
                                        AppState.seerr-disconnect-confirm-focused = 0;
                                        AppState.show-seerr-disconnect-confirm = true;
                                    } else {
                                        AppState.open-connect-seerr();
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                alignment: start;
                                spacing: 2px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: AppState.seerr-connected ? "Disconnect" : "Connect Seerr";
                                        color: AppState.seerr-connected ? Theme.error : Theme.text;
                                        font-size: 14px * AppState.text-scale;
                                        font-weight: 600;
                                    }

                                    Text {
                                        text: AppState.seerr-connected-label;
                                        color: Theme.text-muted;
                                        font-size: 12px * AppState.text-scale;
                                    }
                                }
                            }
                        }

                        // Streaming Region (dynamic dropdown, same shape as Text
                    // font above — fetched from Seerr instead of fc-list,
                    // once per connection rather than at startup; only
                    // reachable/rendered while connected)
                    if AppState.seerr-connected: SettingsRow {
                            key: "integrations.streaming_region";
                            title: "Streaming region";
                            subtitle: "Which region's providers show in \"Currently Streaming On\" on Discover";
                            SettingsDropdown {
                                model <=> AppState.settings-streaming-region-display;
                                current-value: AppState.settings-streaming-region-desc != "" ? AppState.settings-streaming-region-desc : "United States (US)";
                                selected(v) => { AppState.streaming-region-selected(v); AppState.refocus(); }
                            }
                        }

                        // Display Language: Seerr's default TMDB `language` for every Discover call (translated
                        // titles/overviews); Jellyfin library metadata follows Jellyfin's own library settings.
                    if AppState.seerr-connected: SettingsRow {
                            key: "integrations.display_language";
                            title: "Display language";
                            subtitle: "Language for Discover titles/overviews (independent of Jellyfin's own library language)";
                            SettingsDropdown {
                                model <=> AppState.settings-display-language-display;
                                current-value: AppState.settings-display-language-desc != "" ? AppState.settings-display-language-desc : "Default (English)";
                                selected(v) => { AppState.display-language-selected(v); AppState.refocus(); }
                            }
                        }

                        // Discover Language (dynamic dropdown, same shape) —
                    // filters Discover/trending/search results by TMDB
                    // original language.
                    if AppState.seerr-connected: SettingsRow {
                            key: "integrations.discover_language";
                            title: "Discover language";
                            subtitle: "Filter Discover results by original language";
                            SettingsDropdown {
                                model <=> AppState.settings-discover-language-display;
                                current-value: AppState.settings-discover-language-desc != "" ? AppState.settings-discover-language-desc : "Default (All Languages)";
                                selected(v) => { AppState.discover-language-selected(v); AppState.refocus(); }
                            }
                        }

                        // Discover Region — same dynamic dropdown shape as
                    // Streaming Region, reusing its own already-fetched
                    // region list (settings-streaming-region-display) since
                    // both settings share one region catalog, just a
                    // different desc value.
                    if AppState.seerr-connected: SettingsRow {
                            key: "integrations.discover_region";
                            title: "Discover region";
                            subtitle: "Which region's theatrical/digital/physical release dates show on Discover items";
                            SettingsDropdown {
                                model <=> AppState.settings-streaming-region-display;
                                current-value: AppState.settings-discover-region-desc != "" ? AppState.settings-discover-region-desc : "United States (US)";
                                selected(v) => { AppState.discover-region-selected(v); AppState.refocus(); }
                            }
                        }

                        // Manage Blocklist — bespoke Rectangle button row, same
                    // pattern as Connect/Disconnect above, not a SettingsRow
                    // + control pair since it opens a screen rather than
                    // editing a value. Only reachable while connected AND the
                    // account has MANAGE_BLOCKLIST — a permission genuinely
                    // separate from admin/MANAGE_REQUESTS, see
                    // seerr-can-manage-blocklist's own doc comment in
                    // app_state.slint.
                    if AppState.seerr-connected && AppState.seerr-can-manage-blocklist: Rectangle {
                            border-radius: Theme.radius;
                            background: AppState.settings-focused == "integrations.manage_blocklist" ? Theme.accent-muted
                                : (int-blocklist-ta.has-hover ? Theme.surface : transparent);
                            height: 48px;
                            border-width: AppState.ring-width(int-blocklist-pulse.active, int-blocklist-ta.pressed || int-blocklist-pulse.pulsing);
                            border-color: AppState.focus-color;
                            animate border-width {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                            FocusHalo {
                                glowing: int-blocklist-pulse.active;
                                radius: Theme.radius;
                            }

                            int-blocklist-pulse := PressPulse {
                                trigger: AppState.kb-activate-pulse;
                                active: AppState.settings-focused == "integrations.manage_blocklist";
                            }

                            int-blocklist-ta := TouchArea {
                                clicked => { AppState.open-blocklist(); }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                alignment: start;
                                spacing: 2px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "Manage Blocklist";
                                        color: Theme.text;
                                        font-size: 14px * AppState.text-scale;
                                        font-weight: 600;
                                    }

                                    Text {
                                        text: "Movies and shows blocked from being requested";
                                        color: Theme.text-muted;
                                        font-size: 12px * AppState.text-scale;
                                    }
                                }
                            }
                        }
                    }

                    // ── Advanced section ────────────────────────────────────────────────────
                if AppState.settings-section == "advanced": VerticalLayout {
                        spacing: Theme.sp-sm;

                        SectionHeader {
                            text: "DECODE";
                        }

                        SettingsRow {
                            key: "video.hwdec";
                            choice: true;
                            value: AppState.settings-hwdec;
                            title: "Hardware decode (hwdec)";
                            subtitle: "AMD: vulkan (native) or vulkan-copy · NVIDIA legacy: nvdec-copy + set vf below";
                        }

                        // Only with NVDEC selected explicitly (works around NVDEC's stride corruption, see
                        // CLAUDE.md) — hidden for every other hwdec, including "auto".
                    if AppState.settings-hwdec == "nvdec" || AppState.settings-hwdec == "nvdec-copy": SettingsRow {
                            key: "video.vf";
                            choice: true;
                            value: AppState.settings-vf;
                            title: "Video filter (vf)";
                            subtitle: "auto: nv12/p010 = no fix · auto: yuv420p = NVIDIA stride fix for the source's bit depth · format=… forces that output";
                        }

                        SettingsRow {
                            key: "video.deinterlace";
                            choice: true;
                            value: AppState.settings-deinterlace;
                            title: "Deinterlace";
                            subtitle: "auto: only deinterlaces content flagged as interlaced · yes: always on (DVD / broadcast)";
                        }

                        SectionHeader {
                            text: "SYNCHRONIZATION";
                        }

                        SettingsRow {
                            key: "video.video_sync";
                            choice: true;
                            value: AppState.settings-video-sync;
                            title: "Video sync";
                            subtitle: "display-resample: smooth sync · desync: no A/V correction (debug)";
                        }

                        if AppState.settings-audio-spdif && AppState.settings-video-sync == "display-resample" && (AppState.settings-spdif-ac3 || AppState.settings-spdif-eac3 || AppState.settings-spdif-dts || AppState.settings-spdif-dts-hd || AppState.settings-spdif-truehd): Rectangle {
                            height: 24px;
                            HorizontalLayout {
                                x: 12px;
                                y: 0px;
                                height: parent.height;
                                spacing: 4px;
                                alignment: start;
                                Text {
                                    text: "⚠";
                                    font-family: "Noto Sans Symbols 2";
                                    color: Theme.error;
                                    font-size: 12px * AppState.text-scale;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "passthrough active — display-resample falls back to 'audio' sync (no display sync correction)";
                                    color: Theme.error;
                                    font-size: 12px * AppState.text-scale;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        SettingsRow {
                            key: "video.interpolation";
                            title: "Motion interpolation";
                            subtitle: "Temporal interpolation between frames (best with display-resample)";
                            ToggleSwitch {
                                checked <=> AppState.settings-interpolation;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        if AppState.settings-interpolation: SettingsRow {
                            key: "video.tscale";
                            choice: true;
                            value: AppState.settings-tscale;
                            title: "Temporal scaler (tscale)";
                            subtitle: "Algorithm used for motion interpolation";
                        }

                        SectionHeader {
                            text: "NVIDIA WAYLAND";
                        }

                        SettingsRow {
                            key: "video.opengl_early_flush";
                            title: "OpenGL early flush";
                            subtitle: "Flush after every frame — can reduce jitter on NVIDIA Wayland; off by default in mpv as it hurts some other setups";
                            ToggleSwitch {
                                checked <=> AppState.settings-opengl-early-flush;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        if AppState.settings-video-sync == "display-resample": SettingsRow {
                            key: "video.video_latency_hacks";
                            title: "Video latency hacks";
                            subtitle: "Works around imprecise vsync timestamps (NVIDIA legacy on Wayland); breaks interpolation — only if you need it";
                            indent: true;
                            ToggleSwitch {
                                checked <=> AppState.settings-video-latency-hacks;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        SectionHeader {
                            text: "10-BIT VIDEO (TESTS)";
                        }

                        // 10-bit video plane (2026-10-08) — same gate in settings::section_row_keys.
                    if AppState.is-wayland && AppState.settings-separate-video-surface: SettingsRow {
                            key: "video.video_own_buffers";
                            title: "Use Fjord's own 10-bit buffers";
                            subtitle: "10-bit video where the driver only offers 8-bit windows (e.g. NVIDIA); only helps if it then sends 10-bit. Applies after a restart";
                            indent: false;
                            ToggleSwitch {
                                checked <=> AppState.settings-video-own-buffers;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        // Test aid (2026-10-08) — always listed (settings::section_row_keys mirrors this).
                    SettingsRow {
                            key: "video.video_dither_off";
                            title: "Turn off dithering (test)";
                            subtitle: "Test for comparing 8-bit and 10-bit: without dithering, 8-bit shows steps in gradients. Leave off normally";
                            ToggleSwitch {
                                checked <=> AppState.settings-video-dither-off;
                                toggled => { AppState.settings-changed(); AppState.refocus(); }
                            }
                        }

                        SectionHeader {
                            text: "BUFFERING";
                        }

                        SettingsRow {
                            key: "player.cache_secs";
                            choice: true;
                            value: AppState.settings-cache-secs;
                            title: "Cache duration (seconds)";
                            subtitle: "Seconds of video to buffer ahead, to ride out short network drops. Unlimited = as much as the size limit below allows";
                        }

                        SettingsRow {
                            key: "player.cache_max_mb";
                            choice: true;
                            value: AppState.settings-cache-max-mb;
                            title: "Max cache size (MiB)";
                            subtitle: "Memory limit for that buffer — raise it for long buffers on high-bitrate 4K. Unlimited = no limit";
                        }

                        SectionHeader {
                            text: "STARTUP & LOGS";
                        }

                        SettingsRow {
                            key: "general.prewarm_metadata";
                            title: "Prewarm library metadata";
                            subtitle: AppState.prewarm-metadata-running
                                ? "Running… \{AppState.prewarm-metadata-done} of \{AppState.prewarm-metadata-total}"
                                : (AppState.prewarm-metadata-summary != "" ? AppState.prewarm-metadata-summary
                                : "Fetch detail/cast/related-items for your whole library once, so opening anything is instant");
                            FjordButton {
                                width: 100px * AppState.text-scale;
                                text: AppState.prewarm-metadata-running ? "Running…" : "Prewarm";
                                enabled: !AppState.prewarm-metadata-running;
                                clicked => { AppState.prewarm-metadata(); }
                            }
                        }

                        SettingsRow {
                            key: "general.prewarm_images";
                            title: "Prewarm library images";
                            subtitle: AppState.prewarm-image-running
                                ? "Running… \{AppState.prewarm-image-done} of \{AppState.prewarm-image-total}"
                                : (AppState.prewarm-image-summary != "" ? AppState.prewarm-image-summary
                                : "Fetch backdrops + cast portraits for whatever's already in the metadata cache");
                            FjordButton {
                                width: 100px * AppState.text-scale;
                                text: AppState.prewarm-image-running ? "Running…" : "Prewarm";
                                enabled: !AppState.prewarm-image-running;
                                clicked => { AppState.prewarm-images(); }
                            }
                        }

                        SettingsRow {
                            key: "general.log_level";
                            choice: true;
                            value: AppState.settings-log-level;
                            title: "Log level";
                            subtitle: "Verbosity of ~/.cache/fjord/fjord.log — applies on next launch";
                        }
                    }
                }
            }

            // ── Keyboard dropdown overlay ─────────────────────────────────────
            // Shown when a dropdown row is opened via Enter. The FocusScope keeps
            // focus so Rust continues to receive all key events. Up/Down move the
            // cursor; Enter confirms; Escape/Left closes without changing.
            // Always in tree (visible: not if:) so kbdd-vl.preferred-width is readable for kbdd-w.
            Rectangle {
                visible: AppState.settings-dropdown-open;
                z: 20;
                width: right-pane.kbdd-w;
                height: right-pane.kbdd-h;
                x: right-pane.width - self.width - Theme.sp-xl;
                y: Theme.sp-xl;
                background: Theme.surface-raised;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 12px;
                drop-shadow-color: Theme.shadow;
                clip: true;

                kbdd-fl := Flickable {
                    content-height: right-pane.kbdd-content-h;

                    // Scroll to keep cursor centred in the overlay panel.
                    property <length> kbdd-scroll: AppState.settings-dropdown-cursor >= 0
                        ? clamp(-(AppState.settings-dropdown-cursor * 32px + 16px - right-pane.kbdd-h / 2),
                                min(0px, right-pane.kbdd-h - right-pane.kbdd-content-h), 0px)
                        : 0px;
                    changed kbdd-scroll => { kbdd-fl.content-y = kbdd-scroll; }
                    init => { kbdd-fl.content-y = kbdd-scroll; }

                    kbdd-vl := VerticalLayout {
                        padding: 4px;
                        for opt[i] in AppState.settings-dropdown-model: Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            preferred-width: kbdd-txt.preferred-width + 24px;
                            background: i == AppState.settings-dropdown-cursor
                                ? Theme.accent-muted
                                : (kbdd-item-ta.has-hover ? Theme.surface-overlay : transparent);
                            border-width: AppState.ring-width(kbdd-pulse.active, kbdd-item-ta.pressed || kbdd-pulse.pulsing);
                            border-color: AppState.focus-color;
                            animate border-width {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                            FocusHalo {
                                glowing: kbdd-pulse.active;
                                radius: 4px;
                            }

                            kbdd-pulse := PressPulse {
                                trigger: AppState.kb-activate-pulse;
                                active: i == AppState.settings-dropdown-cursor;
                            }

                            kbdd-txt := Text {
                                x: 12px;
                                text: opt;
                                color: opt == AppState.settings-dropdown-display
                                    ? Theme.accent : Theme.text;
                                font-size: 13px * AppState.text-scale;
                                font-weight: opt == AppState.settings-dropdown-display ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            kbdd-item-ta := TouchArea {
                                clicked => {
                                    AppState.settings-dropdown-cursor = i;
                                    AppState.dropdown-pick();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Reset Key Bindings confirm dialog — declared last so it renders on
    // top of everything else on this screen (including the sidebar/left
    // pane), same z-order convention as every other overlay-on-a-screen in
    // this app (see e.g. collection.slint's own bulk-blocklist confirm).
    // Keyboard (Left/Right/Confirm/Back) is handled by
    // keys.rs::dispatch_keybinding_nav, not here — ConfirmDialog itself is
    // keyboard-dumb by design.
    if AppState.show-keybinding-reset-confirm: ConfirmDialog {
        title: "Reset Key Bindings?";
        message: "This resets every key binding back to Fjord's defaults. This can't be undone.";
        confirm-label: "Reset";
        focused: AppState.keybinding-reset-confirm-focused;
        confirmed => {
            AppState.keybinding-reset-defaults();
            AppState.show-keybinding-reset-confirm = false;
            AppState.refocus();
        }
        cancelled => {
            AppState.show-keybinding-reset-confirm = false;
            AppState.refocus();
        }
    }

    // Rebind-collision confirm. Apply/discard happens in Rust (keys::apply_rebind via
    // on_keybinding_collision_confirmed/-cancelled); mouse and keyboard
    // (keys.rs's dispatch_keybinding_nav) both go through those callbacks.
    if AppState.show-keybinding-collision-confirm: ConfirmDialog {
        title: "Key Already Bound";
        message: AppState.keybinding-collision-message;
        confirm-label: "Reassign";
        focused: AppState.keybinding-collision-confirm-focused;
        confirmed => {
            AppState.keybinding-collision-confirmed();
            AppState.refocus();
        }
        cancelled => {
            AppState.keybinding-collision-cancelled();
            AppState.refocus();
        }
    }

    // Disconnect Seerr confirm (see show-seerr-disconnect-confirm in app_state.slint). Declared
    // last so it draws on top. Keyboard is handled in settings.rs's dispatch_settings —
    // ConfirmDialog has no key handling of its own.
    // "Copy settings from…" confirm (see show-copy-settings-confirm in app_state.slint); keyboard in
    // settings.rs's dispatch_settings, like Disconnect Seerr below.
    if AppState.show-copy-settings-confirm: ConfirmDialog {
        title: "Copy Settings from " + AppState.copy-settings-source-label + "?";
        message: "Replaces this profile's subtitle, audio language, skip, trailer, Now Playing and card size settings (the ones tagged Profile). Sign-in, Seerr and this device's settings stay as they are.";
        confirm-label: "Copy";
        focused: AppState.copy-settings-confirm-focused;
        confirmed => {
            AppState.copy-settings-confirmed();
            AppState.show-copy-settings-confirm = false;
        }
        cancelled => {
            AppState.show-copy-settings-confirm = false;
        }
    }

    if AppState.show-seerr-disconnect-confirm: ConfirmDialog {
        title: "Disconnect Seerr?";
        message: "Fjord will forget the saved connection — reconnecting means re-entering your credentials.";
        confirm-label: "Disconnect";
        focused: AppState.seerr-disconnect-confirm-focused;
        confirmed => {
            AppState.seerr-disconnect();
            AppState.show-seerr-disconnect-confirm = false;
        }
        cancelled => {
            AppState.show-seerr-disconnect-confirm = false;
        }
    }
}
