// ── fjord-app · settings.slint ───────────────────────────────────────────────
//   SettingsScreen   two-pane layout: left section list, right scrollable content
//     Left pane      "General" / "Profiles" / "Video" / "Audio" / "Player" / "Key Bindings" /
//                    "UI" / "Integrations" — a parallel (key, label) array pair (sect-keys/
//                    sect-labels below), keyed on AppState.settings-section (a string, Phase 0
//                    2026-08-07 — was an int position; see settings.rs's own module doc comment
//                    for the full "why" — a section can now be inserted anywhere in the array
//                    without renumbering anything that follows it); below the section list, a
//                    vertical-stretch:1 spacer pins a SERVER/CLIENT/SEERR info block to the
//                    bottom of the pane — SEERR only rendered when AppState.seerr-connected
//     Right pane     Flickable; shows section content based on settings-section (string key)
//       General      launch-in-fullscreen, video-behind, log-level, prewarm-metadata,
//                    prewarm-images — Sign Out moved to the new Profiles section below
//       Profiles     sign-out (Phase 0 shell — Phase 1 adds Bonfire profile switching/
//                    launch-policy rows here; see the Bonfire integration plan)
//       Video        hwdec, vf, deinterlace, video-sync, interpolation, tscale (virtual —
//                    only while interpolation is on), tone-mapping (virtual — only while HDR
//                    passthrough is off), target-colorspace, opengl-early-flush,
//                    video-latency-hacks (virtual — only while video-sync == display-resample)
//       Audio        audio-device, audio-channels, SPDIF, AC3, EAC3, DTS, DTS-HD, TrueHD,
//                    passthrough-device (hidden when SPDIF off), alsa-irq-scheduling (virtual,
//                    hidden when SPDIF off or non-PipeWire device), audio-lang, gapless-audio,
//                    now-playing-auto-open
//       Player       sub-enabled, sub-lang/-lang2/-type/-scale/-pos/-respect-ass-styling
//                    (all hidden while sub-enabled is off), sub-color/sub-background (virtual —
//                    only while sub-enabled and !respect-ass-styling), cache-secs/cache-max-mb;
//                    INTRO SKIPPER: intro/recap/preview/commercial mode + *-secs (virtual,
//                    only while that mode == ask-timed); CREDITS: credits-mode + credits-secs
//                    (virtual, only while credits-mode == ask); SEEKING: seek-step,
//                    seek-step-long — appended at the end, always visible
//       Key Bindings keybinding-focused 0..N rows, Reset button — unchanged by Phase 0 (a
//                    different, inherently positional data shape — see settings.rs)
//       UI           scroll-speed, animation-speed (percentage multipliers driving ~119
//                    animate blocks + LoadingSpinner's cycle Timer across all other .slint
//                    files, see settings-scroll-speed/settings-animation-speed in
//                    app_state.slint), text-font (dynamic dropdown — fc-list at startup)
//       Integrations seerr-enabled (toggle — gates the Discover sidebar tab AND every row
//                    below it), seerr-connect (bespoke Rectangle like Sign Out —
//                    "Connect Seerr"/"Disconnect"; only rendered while seerr-enabled),
//                    streaming-region/trailer-quality/display-language/discover-language/
//                    discover-region (dynamic or static dropdowns, only rendered while
//                    connected), manage-blocklist (bespoke Rectangle, gated on connected AND
//                    seerr-can-manage-blocklist)
//   Row identity     every SettingsRow/bespoke-action-row takes a stable string `key` (Phase 0)
//                    matching the constant of the same name in settings.rs's module doc comment
//                    — NOT a positional row-index/section pair anymore. Mouse click on a row's
//                    background routes through AppState.settings-row-focused(key) so
//                    settings-focused-visual-index (used for scroll-to-view) stays correct;
//                    SettingsDropdown's own inline mouse popup is a separate, pre-existing,
//                    self-contained mechanism (Slint's native PopupWindow) untouched by any of
//                    this — only the KEYBOARD-driven overlay at the bottom of this file goes
//                    through settings.rs's open_dropdown_popup/apply_dropdown_selection.
//   Row highlight    handled by SettingsRow component (TouchArea lower z, children higher z)
//   Scroll           viewport-y tracks settings-focused-visual-index (≈64px/row for
//                    Video/Audio/Player/Integrations, ≈48px for General/Profiles/UI — see kb-y);
//                    keybinding scroll ≈base + index*44px. viewport-y is only ever assigned
//                    imperatively from a changed-tracker (native mouse-wheel needs viewport-y
//                    NOT to be a live binding) — since kb-y's own clamp() means different focus
//                    positions near a list's edges can share the identical computed value,
//                    `changed kb-y` alone can silently miss a real transition; two local mirror
//                    properties (_kb-fi-mirror/_kb-sf-mirror, tracking the raw keybinding-focused/
//                    settings-focused navigation state instead of the derived+clamped value)
//                    back it up so the reassignment can't be skipped (2026-08-08). The Reset row
//                    itself is NOT covered by kb-y/kb-row-y at all (both explicitly exclude it,
//                    `keybinding-focused < kb-total`) — after 3 estimate-based attempts still left
//                    it cut off, its own scroll target is computed directly from reset-btn's real
//                    resolved y/height (see the Key Bindings section body, near reset-btn) instead
//                    of being approximated from an ancestor's preferred-height.
//   kb-row-y(i)      approximate: i*44px + 22px  (used for scroll only; never used for Reset itself)
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import { FjordButton, ToggleSwitch, SectionHeader, SettingsDropdown, SettingsRow, PressPulse, ConfirmDialog } from "widgets.slint";

export component SettingsScreen inherits Rectangle {
    background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;

    // Approximate — used for scroll-into-view only, not exact pixel
    // positioning (same "used for scroll only" framing this doc already
    // established for this function). Fixed 2026-08-08: this used to be a
    // bare `i * 44px`, which only held when every row was a uniform 44px
    // starting right at the top of the content — true before the "Enter
    // rebinds..." hint text was added above the row list, and never true
    // at all for rows after the "PLAYER" SectionHeader or for the Reset
    // button (index == keybinding-normal.length + keybinding-player.length,
    // past every real row), which is exactly why Reset never scrolled into
    // view (fixed separately, see reset-btn below — pinned to its own real
    // resolved geometry instead of an estimate).
    //
    // Code review, 2026-08-08: re-examined whether the two `28px`
    // SectionHeader terms and the row stride (`i * 44px`) are themselves
    // estimates too. They're not — `SectionHeader` (widgets.slint) has an
    // explicit fixed `height: 28px`, and each row Rectangle below has an
    // explicit fixed `height: 44px`, so both are exact, not approximations.
    // The ONE genuinely-approximate term is the hint `Text`'s own height —
    // it's `wrap: word-wrap` with no fixed height, so its real rendered
    // height depends on the pane's actual width (window size) and can
    // exceed a narrow estimate on a narrow window. Reading it directly
    // (the same technique reset-btn below uses) isn't available to this
    // function specifically: `kb-row-y` is a `pure function` on
    // `SettingsScreen`'s own root, called from `kb-y` regardless of which
    // section is active, but the hint `Text` only exists inside the
    // `if settings-section == "keybindings":` block — referencing it from
    // here would be exactly the dangling-reference hazard documented in
    // CLAUDE.md's Slint gotchas (an element inside a conditional isn't a
    // valid reference from outside that conditional's own scope), unlike
    // reset-btn's own tracker, which lives INSIDE that same block. Widened
    // the constant instead — kb-y's own clamp caps any overshoot at the
    // true bottom of the content either way, so erring generous remains
    // the safe direction; erring short is what caused the original bug.
    pure function kb-row-y(i: int) -> length {
        let n: int = AppState.keybinding-normal.length;
        76px                            // hint text (generous, up to ~4 wrapped lines) + its spacer
        + 28px                          // "NAVIGATION & GLOBAL" header (exact — SectionHeader is a fixed 28px)
        + i * 44px                      // exact — each row is a fixed 44px Rectangle
        + (i >= n ? 28px : 0px)         // "PLAYER" header, once past the normal-map rows (exact)
        + 22px                          // target the row's vertical center
    }

    property <[string]> sect-keys:   ["general", "profiles", "video", "audio", "player", "keybindings", "ui", "integrations"];
    property <[string]> sect-labels: ["General", "Profiles", "Video", "Audio", "Player", "Key Bindings", "UI", "Integrations"];

    HorizontalLayout {
        // ── Left pane ─────────────────────────────────────────────────────────
        left-pane := Rectangle {
            background: Theme.surface;
            width: 220px;

            VerticalLayout {
                padding: Theme.sp-xl;
                spacing: Theme.sp-sm;
                alignment: start;

                Text {
                    text: "Settings";
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 700;
                }

                Rectangle { height: 1px; background: Theme.border; }

                // Section list — keyed on sect-keys[i]; sect-labels[i] is the display text.
                for label[i] in sect-labels: Rectangle {
                    height: 44px;
                    border-radius: Theme.radius;
                    background: {
                        let hov = sect-ta.has-hover;
                        AppState.settings-section == sect-keys[i]
                            ? (sect-keys[i] == "keybindings"
                                ? (AppState.keybinding-focused < 0 ? Theme.accent : Theme.accent-muted)
                                : (AppState.settings-focused == "" ? Theme.accent : Theme.accent-muted))
                            : (hov ? Theme.surface-raised : transparent)
                    };
                    border-width:  (sect-ta.pressed || sect-pulse.pulsing) ? 3px : 0px;
                    border-color:  Theme.accent;
                    animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                    sect-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.settings-section == sect-keys[i]; }
                    sect-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            AppState.settings-section = sect-keys[i];
                            AppState.settings-focused = "";
                            // Code review, 2026-08-08: this never reset
                            // keybinding-focused, so a section switch while
                            // it was still >= 0 (from earlier keyboard/mouse
                            // navigation into Key Bindings) left EVERY
                            // subsequent keypress routed to the invisible
                            // keybinding dispatcher (keys.rs checks
                            // keybinding-focused before settings-section) —
                            // Enter could silently arm rebind-capture on
                            // whatever action that stale index pointed at.
                            AppState.keybinding-focused = -1;
                            AppState.keybinding-rebinding = false;
                            AppState.refocus();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        alignment: start;
                        Text {
                            text: label;
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // ── Server / Seerr / Client info block — pinned to the bottom.
                // Seerr sits right after Server (both are "servers" Fjord
                // connects to), before Client (Fjord itself) — moved here
                // per explicit request, was originally after Client.
                Rectangle { height: 1px; background: Theme.border; }

                Text { text: "SERVER"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
                Text {
                    text:      AppState.server-name != "" ? AppState.server-name : "—";
                    color:     Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    overflow:  elide;
                }
                Text {
                    text:      AppState.server-version != "" ? AppState.server-version : "";
                    color:     Theme.text-muted;
                    font-size: 11px;
                    overflow:  elide;
                }

                // Same 3-line shape as SERVER/CLIENT — header + bold primary
                // name line + muted secondary version line.
                if AppState.seerr-connected: Text { text: "SEERR"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
                if AppState.seerr-connected: Text {
                    text:      "Seerr";
                    color:     Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    overflow:  elide;
                }
                if AppState.seerr-connected && AppState.seerr-version != "": Text {
                    text:      AppState.seerr-version;
                    color:     Theme.text-muted;
                    font-size: 11px;
                    overflow:  elide;
                }

                Text { text: "CLIENT"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
                Text {
                    text:      "FJORD";
                    color:     Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    overflow:  elide;
                }
                Text {
                    text:      AppState.client-version != "" ? AppState.client-version : "—";
                    color:     Theme.text-muted;
                    font-size: 11px;
                    overflow:  elide;
                }
            }
        }

        Rectangle { width: 1px; background: Theme.border; }

        // ── Right pane ────────────────────────────────────────────────────────
        right-pane := Rectangle {
            horizontal-stretch: 1;
            // `kb-content-h-override`, code review follow-up (2026-08-08,
            // 5th live report — "still only see the top of the reset to
            // default"): attempt 4 (reset-btn's own real y/height) computed
            // a mathematically-correct scroll target, re-derived by hand —
            // but STILL undershot in practice, which only makes sense if
            // Flickable re-clamps a programmatic `viewport-y` assignment
            // against its own `viewport-height` binding (`right-fl`'s
            // `viewport-height: right-pane.right-vp-h;`), same as it
            // already clamps drag/wheel input — meaning the real bug was
            // never the TARGET value, it was `right-vp-h` itself
            // (ultimately `right-inner.preferred-height`) under-reporting
            // the true content height by roughly the button's own size,
            // silently truncating even a provably-correct target back down.
            // `right-pane` can't read `reset-btn` directly (dangling
            // reference risk whenever another section is showing — same
            // reasoning as reset-btn's own tracker below) — so the Key
            // Bindings section itself pushes its own real measured height
            // UP into this property whenever keybinding-focused changes
            // (see `changed _reset-fi-mirror` below), and `right-vp-h`
            // takes whichever of the estimate or the real measurement is
            // larger, gated to only apply while that section is actually
            // showing so a stale measurement can't inflate scroll space in
            // every OTHER section after Key Bindings has been visited once.
            property <length> kb-content-h-override: 0px;
            property <length> right-vp-h: (AppState.settings-section == "keybindings"
                ? max(right-inner.preferred-height, kb-content-h-override)
                : right-inner.preferred-height) + Theme.sp-xl * 2;
            // Reset to Defaults (keybinding-focused == the past-the-end
            // index, one past every real row) is pinned to the exact
            // bottom of the content rather than routed through
            // kb-row-y's own per-row approximation (2026-08-08 — the
            // approximation alone still left Reset out of view; still worth
            // keeping accurate for actual rows, but Reset itself doesn't
            // need an estimate at all, since it's provably the very last
            // thing in the section — scrolling all the way down always
            // reveals it, with no approximation error possible).
            property <int> kb-total: AppState.keybinding-normal.length + AppState.keybinding-player.length;
            // Reset to Defaults' OWN scroll target is computed separately,
            // directly against `reset-btn`'s real resolved geometry (see
            // below, inside the Key Bindings section itself, where that
            // element is actually in scope) — not here. Three straight
            // attempts at ESTIMATING it (a bare row offset, then a
            // preferred-height-based "exact bottom" formula) each still
            // left it short: `right-inner.preferred-height` did not
            // reliably equal the sum this formula assumed, so the computed
            // bottom was short by close to the button's own height in
            // practice — "only the top of the button visible" is exactly
            // what an undershoot that size produces. `kb-y` below covers
            // every OTHER row (0..kb-total-1) plus the general-settings-row
            // case; the reset-fi-focused case is deliberately excluded from
            // both changed handlers so there is exactly one writer of
            // `viewport-y` for that specific transition, not two disagreeing
            // estimates racing each other.
            property <length> kb-y: AppState.keybinding-focused >= 0 && AppState.keybinding-focused < kb-total
                ? clamp(-(kb-row-y(AppState.keybinding-focused) - self.height / 2),
                         min(0px, self.height - right-vp-h), 0px)
                : AppState.settings-focused == "" ? 0px
                : clamp(-(Theme.sp-xl + 30px + AppState.settings-focused-visual-index * 64px + 28px
                          - self.height / 2),
                         min(0px, self.height - right-vp-h), 0px);
            changed kb-y => { if AppState.keybinding-focused < kb-total { right-fl.viewport-y = kb-y; } }
            // `changed kb-y` alone misses a real class of navigation step:
            // kb-y's own clamp() means many DIFFERENT focus positions near
            // the top or bottom of a long list resolve to the IDENTICAL
            // pixel value — a ChangeTracker only fires when the tracked
            // value actually differs from its previous evaluation, so
            // moving between two such positions left viewport-y
            // un-reassigned even though it was legitimately supposed to
            // fire again. `kb-y` itself can't be observed reliably at
            // every step for this reason; mirror the raw navigation state
            // instead (which always changes on every keypress) and
            // re-read `kb-y`'s current value from there.
            property <int>    _kb-fi-mirror: AppState.keybinding-focused;
            property <string> _kb-sf-mirror: AppState.settings-focused;
            changed _kb-fi-mirror => { if AppState.keybinding-focused < kb-total { right-fl.viewport-y = kb-y; } }
            changed _kb-sf-mirror => { right-fl.viewport-y = kb-y; }

            // ── Keyboard dropdown overlay props ───────────────────────────────
            property <length> kbdd-content-h: AppState.settings-dropdown-model.length * 32px + 8px;
            property <length> kbdd-h:         min(kbdd-content-h, 320px);
            property <length> kbdd-w:         min(max(300px, kbdd-vl.preferred-width + 8px), self.width - Theme.sp-xl * 2);

            right-fl := Flickable {
                viewport-height: right-pane.right-vp-h;

            right-inner := VerticalLayout {
                y: Theme.sp-xl;
                width: parent.width - Theme.sp-xl * 2;
                x: Theme.sp-xl;

                // ── General section ───────────────────────────────────────────
                if AppState.settings-section == "general": VerticalLayout {
                    spacing: Theme.sp-sm;

                    SectionHeader { text: "GENERAL"; }

                    SettingsRow { key: "general.launch_fullscreen"; title: "Launch in fullscreen"; subtitle: "Start Fjord in fullscreen mode";
                        ToggleSwitch { checked <=> AppState.settings-launch-fullscreen; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }

                    SettingsRow { key: "general.video_behind"; title: "Video in background"; subtitle: "Show video behind the UI when you press Back during playback";
                        ToggleSwitch { checked <=> AppState.settings-video-behind; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }

                    SettingsRow { key: "general.log_level"; title: "Log level"; subtitle: "Verbosity of ~/.cache/fjord/fjord.log — applies on next launch";
                        SettingsDropdown {
                            model: ["error","warn","info","debug"];
                            current-value: AppState.settings-log-level;
                            selected(v) => { AppState.settings-log-level = v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    SettingsRow { key: "general.prewarm_metadata"; title: "Prewarm library metadata";
                        subtitle: AppState.prewarm-metadata-running
                            ? "Running… \{AppState.prewarm-metadata-done} of \{AppState.prewarm-metadata-total}"
                            : (AppState.prewarm-metadata-summary != "" ? AppState.prewarm-metadata-summary
                               : "Fetch detail/cast/related-items for your whole library once, so opening anything is instant");
                        FjordButton {
                            width: 100px;
                            text: AppState.prewarm-metadata-running ? "Running…" : "Prewarm";
                            enabled: !AppState.prewarm-metadata-running;
                            clicked => { AppState.prewarm-metadata(); }
                        }
                    }

                    SettingsRow { key: "general.prewarm_images"; title: "Prewarm library images";
                        subtitle: AppState.prewarm-image-running
                            ? "Running… \{AppState.prewarm-image-done} of \{AppState.prewarm-image-total}"
                            : (AppState.prewarm-image-summary != "" ? AppState.prewarm-image-summary
                               : "Fetch backdrops + cast portraits for whatever's already in the metadata cache");
                        FjordButton {
                            width: 100px;
                            text: AppState.prewarm-image-running ? "Running…" : "Prewarm";
                            enabled: !AppState.prewarm-image-running;
                            clicked => { AppState.prewarm-images(); }
                        }
                    }
                }

                // ── Profiles section (Phase 0 shell — Sign Out moved here from
                // General; Phase 1 adds Bonfire profile switching/launch-policy
                // rows) ──────────────────────────────────────────────────────
                if AppState.settings-section == "profiles": VerticalLayout {
                    spacing: Theme.sp-sm;

                    SectionHeader { text: "PROFILES"; }

                    Rectangle {
                        border-radius: Theme.radius;
                        background: AppState.settings-focused == "profiles.sign_out" ? Theme.accent-muted
                                  : (signout-ta.has-hover ? Theme.surface : transparent);
                        height: 48px;
                        border-width:  (signout-ta.pressed || signout-pulse.pulsing) ? 3px : 0px;
                        border-color:  Theme.accent;
                        animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                        signout-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.settings-focused == "profiles.sign_out"; }
                        signout-ta := TouchArea {
                            clicked => { AppState.sign-out(); }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            alignment: start;
                            Text {
                                text: "Sign Out";
                                color: Theme.error;
                                font-size: 14px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ── Video section ─────────────────────────────────────────────
                if AppState.settings-section == "video": VerticalLayout {
                    spacing: Theme.sp-sm;

                    SectionHeader { text: "DECODE"; }

                    SettingsRow { key: "video.hwdec"; title: "Hardware decode (hwdec)"; subtitle: "AMD: vulkan (native) or vulkan-copy · NVIDIA legacy: nvdec-copy + set vf below";
                        SettingsDropdown {
                            model: ["auto","vulkan","vulkan-copy","nvdec","nvdec-copy","vaapi","vaapi-copy","vdpau","vdpau-copy","none"];
                            current-value: AppState.settings-hwdec;
                            selected(v) => { AppState.settings-hwdec = v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    // Only meaningful with NVDEC actually decoding (fixes
                    // NVDEC's own stride-corruption bug — see CLAUDE.md) —
                    // hidden for every other hwdec, including "auto" (2026-08-08,
                    // direct choice: auto is treated as "not committed to
                    // NVDEC" rather than shown just in case it resolves to
                    // nvdec at runtime).
                    if AppState.settings-hwdec == "nvdec" || AppState.settings-hwdec == "nvdec-copy": SettingsRow { key: "video.vf"; title: "Video filter (vf)"; subtitle: "auto: nv12/p010 = native decoder output, no fix · auto: yuv420p = NVIDIA stride fix matching source bit depth · format=... forces that exact output regardless of source";
                        SettingsDropdown {
                            model: ["auto: nv12/p010","auto: yuv420p/yuv420p10le","format=yuv420p","format=yuv420p10le","format=nv12","format=p010"];
                            current-value: AppState.settings-vf;
                            selected(v) => { AppState.settings-vf = v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    SettingsRow { key: "video.deinterlace"; title: "Deinterlace"; subtitle: "auto: only deinterlaces content flagged as interlaced · yes: always on (DVD / broadcast)";
                        SettingsDropdown {
                            model: ["no","auto","yes"];
                            current-value: AppState.settings-deinterlace;
                            selected(v) => { AppState.settings-deinterlace = v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    SectionHeader { text: "SYNCHRONISATION"; }

                    SettingsRow { key: "video.video_sync"; title: "Video sync"; subtitle: "display-resample: smooth sync · desync: no A/V correction (debug)";
                        SettingsDropdown {
                            model: ["audio","display-resample","display-vdrop","display-adrop","desync"];
                            current-value: AppState.settings-video-sync;
                            selected(v) => { AppState.settings-video-sync = v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }
                    if AppState.settings-audio-spdif && AppState.settings-video-sync == "display-resample" && (AppState.settings-spdif-ac3 || AppState.settings-spdif-eac3 || AppState.settings-spdif-dts || AppState.settings-spdif-dts-hd || AppState.settings-spdif-truehd): Rectangle {
                        height: 24px;
                        HorizontalLayout {
                            x: 12px; y: 0px; height: parent.height;
                            spacing: 4px; alignment: start;
                            Text {
                                text: "⚠";
                                font-family: "Noto Sans Symbols 2";
                                color: Theme.error; font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "passthrough active — display-resample falls back to 'audio' sync (no display sync correction)";
                                color: Theme.error; font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    SettingsRow { key: "video.interpolation"; title: "Motion interpolation"; subtitle: "Temporal interpolation between frames (best with display-resample)";
                        ToggleSwitch { checked <=> AppState.settings-interpolation; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }

                    if AppState.settings-interpolation: SettingsRow { key: "video.tscale"; title: "Temporal scaler (tscale)"; subtitle: "Algorithm used for motion interpolation";
                        SettingsDropdown {
                            model: ["oversample","catmull_rom","mitchell","gaussian","bicubic"];
                            current-value: AppState.settings-tscale;
                            selected(v) => { AppState.settings-tscale = v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    SectionHeader { text: "HDR"; }

                    SettingsRow { key: "video.target_colorspace"; title: "HDR passthrough"; subtitle: "Pass HDR metadata to compositor for native HDR output (compositor handles tone mapping)";
                        ToggleSwitch { checked <=> AppState.settings-target-colorspace-hint; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }

                    if !AppState.settings-target-colorspace-hint: SettingsRow { key: "video.tone_mapping"; title: "Tone mapping"; subtitle: "HDR → SDR algorithm — auto is usually correct"; indent: true;
                        SettingsDropdown {
                            model: ["auto","hable","bt.2390","reinhard","mobius","clip","gamma","linear"];
                            current-value: AppState.settings-tone-mapping;
                            selected(v) => { AppState.settings-tone-mapping = v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    SectionHeader { text: "NVIDIA WAYLAND"; }

                    SettingsRow { key: "video.opengl_early_flush"; title: "OpenGL early flush"; subtitle: "Flush GL after each frame — may reduce jitter on NVIDIA Wayland; mpv defaults this off since it can cause issues on some other platforms";
                        ToggleSwitch { checked <=> AppState.settings-opengl-early-flush; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }

                    if AppState.settings-video-sync == "display-resample": SettingsRow { key: "video.video_latency_hacks"; title: "Video latency hacks"; subtitle: "Compensate for imprecise Wayland vsync timestamps (NVIDIA 5xx legacy) — mpv's own manual: known to break other options such as interpolation, not recommended unless you need it"; indent: true;
                        ToggleSwitch { checked <=> AppState.settings-video-latency-hacks; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }
                }

                // ── Audio section ─────────────────────────────────────────────
                if AppState.settings-section == "audio": VerticalLayout {
                    spacing: Theme.sp-sm;

                    SectionHeader { text: "OUTPUT"; }

                    SettingsRow { key: "audio.device"; title: "Audio output"; subtitle: "mpv audio device — auto lets the system choose";
                        SettingsDropdown {
                            model <=> AppState.settings-audio-device-display;
                            current-value: AppState.settings-audio-device-desc != "" ? AppState.settings-audio-device-desc : "Autoselect device";
                            selected(v) => { AppState.audio-device-selected(v); AppState.refocus(); }
                        }
                    }

                    SettingsRow { key: "audio.channels"; title: "Audio channels"; subtitle: "'auto-safe' may downmix 5.1 PCM to stereo on direct ALSA devices — '7.1,5.1,stereo' negotiates the best layout";
                        SettingsDropdown {
                            model: ["auto-safe","auto","stereo","5.1","7.1","7.1,5.1,stereo"];
                            current-value: AppState.settings-audio-channels;
                            selected(v) => { AppState.settings-audio-channels = v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    SectionHeader { text: "PASSTHROUGH"; }

                    SettingsRow { key: "audio.spdif"; title: "Audio passthrough (SPDIF)"; subtitle: "Bitstream audio to AV receiver — select formats below";
                        ToggleSwitch { checked <=> AppState.settings-audio-spdif; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }

                    if AppState.settings-audio-spdif: VerticalLayout {
                        SettingsRow { key: "audio.spdif_ac3"; title: "AC3 (Dolby Digital)";         subtitle: "Standard Dolby 5.1"; indent: true;
                            ToggleSwitch { checked <=> AppState.settings-spdif-ac3;    toggled => { AppState.settings-changed(); AppState.refocus(); } }
                        }
                        SettingsRow { key: "audio.spdif_eac3"; title: "EAC3 (Dolby Digital Plus)";   subtitle: "DD+ used on streaming and Blu-ray"; indent: true;
                            ToggleSwitch { checked <=> AppState.settings-spdif-eac3;   toggled => { AppState.settings-changed(); AppState.refocus(); } }
                        }
                        SettingsRow { key: "audio.spdif_dts"; title: "DTS";                         subtitle: "DTS core"; indent: true;
                            ToggleSwitch { checked <=> AppState.settings-spdif-dts;    toggled => { AppState.settings-changed(); AppState.refocus(); } }
                        }
                        SettingsRow { key: "audio.spdif_dts_hd"; title: "DTS-HD MA";                   subtitle: "DTS lossless / DTS:X"; indent: true;
                            ToggleSwitch { checked <=> AppState.settings-spdif-dts-hd; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                        }
                        SettingsRow { key: "audio.spdif_truehd"; title: "TrueHD / Atmos";              subtitle: "Dolby lossless / Atmos object audio"; indent: true;
                            ToggleSwitch { checked <=> AppState.settings-spdif-truehd; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                        }
                        SettingsRow { key: "audio.passthrough_device"; indent: true;
                            title: "Passthrough output";
                            subtitle: "Device used for video while SPDIF is on — music always keeps the normal output";
                            SettingsDropdown {
                                model <=> AppState.settings-audio-device-display;
                                current-value: AppState.settings-passthrough-device-desc != "" ? AppState.settings-passthrough-device-desc : "Same as audio output";
                                selected(v) => { AppState.passthrough-device-selected(v); AppState.refocus(); }
                            }
                        }
                        if AppState.settings-device-is-pipewire: SettingsRow { key: "audio.alsa_irq"; indent: true;
                            title: "PipeWire IRQ scheduling";
                            subtitle: "Use hardware IRQ wakeups instead of software timers — fixes passthrough dropout under GPU load";
                            ToggleSwitch { checked <=> AppState.settings-alsa-irq-scheduling; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                        }
                    }

                    if AppState.settings-audio-spdif && AppState.settings-video-sync == "display-resample" && (AppState.settings-spdif-ac3 || AppState.settings-spdif-eac3 || AppState.settings-spdif-dts || AppState.settings-spdif-dts-hd || AppState.settings-spdif-truehd): Rectangle {
                        height: 24px;
                        HorizontalLayout {
                            x: 12px; y: 0px; height: parent.height;
                            spacing: 4px; alignment: start;
                            Text {
                                text: "⚠";
                                font-family: "Noto Sans Symbols 2";
                                color: Theme.error; font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "passthrough active — display-resample falls back to 'audio' sync (no display sync correction)";
                                color: Theme.error; font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    SectionHeader { text: "LANGUAGE"; }

                    SettingsRow { key: "audio.lang"; title: "Preferred audio language"; subtitle: "Auto-select matching audio track when found; no preference = use video default";
                        SettingsDropdown {
                            model: ["Default","English","German","French","Japanese","Spanish","Italian","Portuguese","Russian","Korean","Chinese","Dutch","Swedish","Polish","Czech","Arabic","Turkish","Finnish","Danish","Norwegian"];
                            current-value: AppState.settings-audio-lang == "" ? "Default" : AppState.settings-audio-lang;
                            selected(v) => { AppState.settings-audio-lang = v == "Default" ? "" : v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    SectionHeader { text: "MUSIC"; }

                    SettingsRow { key: "audio.gapless"; title: "Gapless music playback"; subtitle: "Preload the next track into the running player — album transitions without a gap";
                        ToggleSwitch { checked <=> AppState.settings-gapless-audio; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }

                    SettingsRow { key: "audio.now_playing_auto_open"; title: "Auto-open Now Playing"; subtitle: "Show the fullscreen music screen after ~30s idle while music plays";
                        ToggleSwitch { checked <=> AppState.settings-now-playing-auto-open; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }
                }

                // ── Player section ────────────────────────────────────────────
                if AppState.settings-section == "player": VerticalLayout {
                    spacing: Theme.sp-sm;

                    SectionHeader { text: "SUBTITLES"; }

                    SettingsRow { key: "player.sub_enabled"; title: "Enable subtitles"; subtitle: "Off always disables subtitles regardless of language settings";
                        ToggleSwitch { checked <=> AppState.settings-sub-enabled; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }

                    if AppState.settings-sub-enabled: SettingsRow { key: "player.sub_lang"; indent: true; title: "Primary language"; subtitle: "Auto-select first matching track; no preference = use video default";
                        SettingsDropdown {
                            model: ["Default","English","German","French","Japanese","Spanish","Italian","Portuguese","Russian","Korean","Chinese","Dutch","Swedish","Polish","Czech","Arabic","Turkish","Finnish","Danish","Norwegian"];
                            current-value: AppState.settings-sub-lang == "" ? "Default" : AppState.settings-sub-lang;
                            selected(v) => { AppState.settings-sub-lang = v == "Default" ? "" : v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    if AppState.settings-sub-enabled: SettingsRow { key: "player.sub_lang2"; indent: true; title: "Fallback language"; subtitle: "Tried if the primary language isn't found; if this isn't found either, falls back to video default";
                        SettingsDropdown {
                            model: ["Default","English","German","French","Japanese","Spanish","Italian","Portuguese","Russian","Korean","Chinese","Dutch","Swedish","Polish","Czech","Arabic","Turkish","Finnish","Danish","Norwegian"];
                            current-value: AppState.settings-sub-lang2 == "" ? "Default" : AppState.settings-sub-lang2;
                            selected(v) => { AppState.settings-sub-lang2 = v == "Default" ? "" : v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    if AppState.settings-sub-enabled: SettingsRow { key: "player.sub_type"; indent: true; title: "Subtitle type"; subtitle: "Prefer Normal (no tags), Forced (foreign lines only), or Hearing Impaired (SDH)";
                        SettingsDropdown {
                            model: ["Any","Normal","Forced","Hearing Impaired"];
                            current-value: AppState.settings-sub-type == "" ? "Any" : AppState.settings-sub-type;
                            selected(v) => { AppState.settings-sub-type = v == "Any" ? "" : v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    if AppState.settings-sub-enabled: SettingsRow { key: "player.sub_scale"; indent: true; title: "Subtitle size"; subtitle: "Applies to both plain and styled (ASS) subtitles";
                        SettingsDropdown {
                            model: ["50","75","100","125","150","175","200"];
                            current-value: AppState.settings-sub-scale-pct == 50  ? "50"
                                         : AppState.settings-sub-scale-pct == 75  ? "75"
                                         : AppState.settings-sub-scale-pct == 125 ? "125"
                                         : AppState.settings-sub-scale-pct == 150 ? "150"
                                         : AppState.settings-sub-scale-pct == 175 ? "175"
                                         : AppState.settings-sub-scale-pct == 200 ? "200" : "100";
                            selected(v) => {
                                AppState.settings-sub-scale-pct = v == "50"  ? 50
                                                                 : v == "75"  ? 75
                                                                 : v == "125" ? 125
                                                                 : v == "150" ? 150
                                                                 : v == "175" ? 175
                                                                 : v == "200" ? 200 : 100;
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    if AppState.settings-sub-enabled: SettingsRow { key: "player.sub_pos"; indent: true; title: "Subtitle position"; subtitle: "100 = mpv's default bottom position; higher pushes it lower still (may clip text/ASS subs)";
                        SettingsDropdown {
                            model: ["50","60","70","80","90","95","100","110","120","130","140","150"];
                            current-value: AppState.settings-sub-pos-pct == 50 ? "50"
                                         : AppState.settings-sub-pos-pct == 60 ? "60"
                                         : AppState.settings-sub-pos-pct == 70 ? "70"
                                         : AppState.settings-sub-pos-pct == 80 ? "80"
                                         : AppState.settings-sub-pos-pct == 90 ? "90"
                                         : AppState.settings-sub-pos-pct == 95 ? "95"
                                         : AppState.settings-sub-pos-pct == 110 ? "110"
                                         : AppState.settings-sub-pos-pct == 120 ? "120"
                                         : AppState.settings-sub-pos-pct == 130 ? "130"
                                         : AppState.settings-sub-pos-pct == 140 ? "140"
                                         : AppState.settings-sub-pos-pct == 150 ? "150" : "100";
                            selected(v) => {
                                AppState.settings-sub-pos-pct = v == "50" ? 50
                                                               : v == "60" ? 60
                                                               : v == "70" ? 70
                                                               : v == "80" ? 80
                                                               : v == "90" ? 90
                                                               : v == "95" ? 95
                                                               : v == "110" ? 110
                                                               : v == "120" ? 120
                                                               : v == "130" ? 130
                                                               : v == "140" ? 140
                                                               : v == "150" ? 150 : 100;
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    if AppState.settings-sub-enabled: SettingsRow { key: "player.sub_respect_ass"; indent: true; title: "Respect subtitle's own styling (ASS)"; subtitle: "Off lets Color/Background below also apply to styled subtitles — may render some files incorrectly";
                        ToggleSwitch { checked <=> AppState.settings-sub-respect-ass-styling; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }

                    if AppState.settings-sub-enabled && !AppState.settings-sub-respect-ass-styling: SettingsRow { key: "player.sub_color"; indent: true; title: "Subtitle color"; subtitle: "Only affects plain subtitles unless styling above is not respected";
                        SettingsDropdown {
                            model: ["Default","White","Yellow","Cyan","Green"];
                            current-value: AppState.settings-sub-color == "" ? "Default" : AppState.settings-sub-color;
                            selected(v) => { AppState.settings-sub-color = v == "Default" ? "" : v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    if AppState.settings-sub-enabled && !AppState.settings-sub-respect-ass-styling: SettingsRow { key: "player.sub_background"; indent: true; title: "Subtitle background box"; subtitle: "Draw a solid box behind subtitle text";
                        ToggleSwitch { checked <=> AppState.settings-sub-background; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }

                    SectionHeader { text: "BUFFERING"; }

                    SettingsRow { key: "player.cache_secs"; title: "Cache duration (seconds)"; subtitle: "How many seconds of video to buffer ahead — absorbs brief network drops without a visible stall. \"Unlimited\" buffers as much as the size limit below allows.";
                        SettingsDropdown {
                            model: ["Unlimited","10","30","60","120","300"];
                            current-value: AppState.settings-cache-secs == 0   ? "Unlimited"
                                         : AppState.settings-cache-secs == 10  ? "10"
                                         : AppState.settings-cache-secs == 30  ? "30"
                                         : AppState.settings-cache-secs == 60  ? "60"
                                         : AppState.settings-cache-secs == 120 ? "120" : "300";
                            selected(v) => {
                                AppState.settings-cache-secs = v == "Unlimited" ? 0
                                                              : v == "10"       ? 10
                                                              : v == "30"       ? 30
                                                              : v == "60"       ? 60
                                                              : v == "120"      ? 120 : 300;
                                AppState.settings-changed();
                                AppState.refocus();
                            }
                        }
                    }

                    SettingsRow { key: "player.cache_max_mb"; title: "Max cache size (MiB)"; subtitle: "Memory ceiling for the buffer above — raise if you increase the duration for high-bitrate 4K content. \"Unlimited\" removes the ceiling so the duration above is always what you set, regardless of bitrate.";
                        SettingsDropdown {
                            model: ["Unlimited","150","300","500","1000","2000"];
                            current-value: AppState.settings-cache-max-mb == 0    ? "Unlimited"
                                         : AppState.settings-cache-max-mb == 150  ? "150"
                                         : AppState.settings-cache-max-mb == 300  ? "300"
                                         : AppState.settings-cache-max-mb == 500  ? "500"
                                         : AppState.settings-cache-max-mb == 1000 ? "1000" : "2000";
                            selected(v) => {
                                AppState.settings-cache-max-mb = v == "Unlimited" ? 0
                                                                : v == "150"       ? 150
                                                                : v == "300"       ? 300
                                                                : v == "500"       ? 500
                                                                : v == "1000"      ? 1000 : 2000;
                                AppState.settings-changed();
                                AppState.refocus();
                            }
                        }
                    }

                    SectionHeader { text: "INTRO SKIPPER"; }

                    SettingsRow { key: "player.intro_mode"; title: "Intro"; subtitle: "What to do when an intro segment is detected";
                        SettingsDropdown {
                            model: ["Always skip", "Ask", "Ask (timed)", "Never skip"];
                            current-value: AppState.settings-skip-intro-mode == "always-skip" ? "Always skip"
                                         : AppState.settings-skip-intro-mode == "ask-timed"   ? "Ask (timed)"
                                         : AppState.settings-skip-intro-mode == "never-skip"  ? "Never skip" : "Ask";
                            selected(v) => {
                                AppState.settings-skip-intro-mode = v == "Always skip" ? "always-skip"
                                                                  : v == "Ask (timed)" ? "ask-timed"
                                                                  : v == "Never skip"  ? "never-skip" : "ask";
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    if AppState.settings-skip-intro-mode == "ask-timed": SettingsRow { key: "player.intro_secs"; indent: true; title: "Auto-skip after"; subtitle: "Seconds before the intro is skipped automatically";
                        SettingsDropdown {
                            model: ["3","5","8","10","15","20","30"];
                            current-value: AppState.settings-skip-intro-secs == 3  ? "3"
                                         : AppState.settings-skip-intro-secs == 5  ? "5"
                                         : AppState.settings-skip-intro-secs == 10 ? "10"
                                         : AppState.settings-skip-intro-secs == 15 ? "15"
                                         : AppState.settings-skip-intro-secs == 20 ? "20"
                                         : AppState.settings-skip-intro-secs == 30 ? "30" : "8";
                            selected(v) => {
                                AppState.settings-skip-intro-secs = v == "3"  ? 3 : v == "5"  ? 5
                                    : v == "10" ? 10 : v == "15" ? 15 : v == "20" ? 20 : v == "30" ? 30 : 8;
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    SettingsRow { key: "player.recap_mode"; title: "Recap"; subtitle: "What to do when a recap segment is detected";
                        SettingsDropdown {
                            model: ["Always skip", "Ask", "Ask (timed)", "Never skip"];
                            current-value: AppState.settings-skip-recap-mode == "always-skip" ? "Always skip"
                                         : AppState.settings-skip-recap-mode == "ask-timed"   ? "Ask (timed)"
                                         : AppState.settings-skip-recap-mode == "never-skip"  ? "Never skip" : "Ask";
                            selected(v) => {
                                AppState.settings-skip-recap-mode = v == "Always skip" ? "always-skip"
                                                                  : v == "Ask (timed)" ? "ask-timed"
                                                                  : v == "Never skip"  ? "never-skip" : "ask";
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    if AppState.settings-skip-recap-mode == "ask-timed": SettingsRow { key: "player.recap_secs"; indent: true; title: "Auto-skip after"; subtitle: "Seconds before the recap is skipped automatically";
                        SettingsDropdown {
                            model: ["3","5","8","10","15","20","30"];
                            current-value: AppState.settings-skip-recap-secs == 3  ? "3"
                                         : AppState.settings-skip-recap-secs == 5  ? "5"
                                         : AppState.settings-skip-recap-secs == 10 ? "10"
                                         : AppState.settings-skip-recap-secs == 15 ? "15"
                                         : AppState.settings-skip-recap-secs == 20 ? "20"
                                         : AppState.settings-skip-recap-secs == 30 ? "30" : "8";
                            selected(v) => {
                                AppState.settings-skip-recap-secs = v == "3"  ? 3 : v == "5"  ? 5
                                    : v == "10" ? 10 : v == "15" ? 15 : v == "20" ? 20 : v == "30" ? 30 : 8;
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    SettingsRow { key: "player.preview_mode"; title: "Preview"; subtitle: "What to do when a preview segment is detected";
                        SettingsDropdown {
                            model: ["Always skip", "Ask", "Ask (timed)", "Never skip"];
                            current-value: AppState.settings-skip-preview-mode == "always-skip" ? "Always skip"
                                         : AppState.settings-skip-preview-mode == "ask-timed"   ? "Ask (timed)"
                                         : AppState.settings-skip-preview-mode == "never-skip"  ? "Never skip" : "Ask";
                            selected(v) => {
                                AppState.settings-skip-preview-mode = v == "Always skip" ? "always-skip"
                                                                    : v == "Ask (timed)" ? "ask-timed"
                                                                    : v == "Never skip"  ? "never-skip" : "ask";
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    if AppState.settings-skip-preview-mode == "ask-timed": SettingsRow { key: "player.preview_secs"; indent: true; title: "Auto-skip after"; subtitle: "Seconds before the preview is skipped automatically";
                        SettingsDropdown {
                            model: ["3","5","8","10","15","20","30"];
                            current-value: AppState.settings-skip-preview-secs == 3  ? "3"
                                         : AppState.settings-skip-preview-secs == 5  ? "5"
                                         : AppState.settings-skip-preview-secs == 10 ? "10"
                                         : AppState.settings-skip-preview-secs == 15 ? "15"
                                         : AppState.settings-skip-preview-secs == 20 ? "20"
                                         : AppState.settings-skip-preview-secs == 30 ? "30" : "8";
                            selected(v) => {
                                AppState.settings-skip-preview-secs = v == "3"  ? 3 : v == "5"  ? 5
                                    : v == "10" ? 10 : v == "15" ? 15 : v == "20" ? 20 : v == "30" ? 30 : 8;
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    SettingsRow { key: "player.commercial_mode"; title: "Commercial"; subtitle: "What to do when a commercial segment is detected";
                        SettingsDropdown {
                            model: ["Always skip", "Ask", "Ask (timed)", "Never skip"];
                            current-value: AppState.settings-skip-commercial-mode == "always-skip" ? "Always skip"
                                         : AppState.settings-skip-commercial-mode == "ask-timed"   ? "Ask (timed)"
                                         : AppState.settings-skip-commercial-mode == "never-skip"  ? "Never skip" : "Ask";
                            selected(v) => {
                                AppState.settings-skip-commercial-mode = v == "Always skip" ? "always-skip"
                                                                       : v == "Ask (timed)" ? "ask-timed"
                                                                       : v == "Never skip"  ? "never-skip" : "ask";
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    if AppState.settings-skip-commercial-mode == "ask-timed": SettingsRow { key: "player.commercial_secs"; indent: true; title: "Auto-skip after"; subtitle: "Seconds before the commercial is skipped automatically";
                        SettingsDropdown {
                            model: ["3","5","8","10","15","20","30"];
                            current-value: AppState.settings-skip-commercial-secs == 3  ? "3"
                                         : AppState.settings-skip-commercial-secs == 5  ? "5"
                                         : AppState.settings-skip-commercial-secs == 10 ? "10"
                                         : AppState.settings-skip-commercial-secs == 15 ? "15"
                                         : AppState.settings-skip-commercial-secs == 20 ? "20"
                                         : AppState.settings-skip-commercial-secs == 30 ? "30" : "8";
                            selected(v) => {
                                AppState.settings-skip-commercial-secs = v == "3"  ? 3 : v == "5"  ? 5
                                    : v == "10" ? 10 : v == "15" ? 15 : v == "20" ? 20 : v == "30" ? 30 : 8;
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    SectionHeader { text: "CREDITS / UP NEXT"; }

                    SettingsRow { key: "player.credits_mode"; title: "Credits / Up Next"; subtitle: "What to do when credits start; controls the Up Next auto-advance banner";
                        SettingsDropdown {
                            model: ["Always skip", "Ask", "Never skip"];
                            current-value: AppState.settings-skip-credits-mode == "always-skip" ? "Always skip"
                                         : AppState.settings-skip-credits-mode == "never-skip"  ? "Never skip" : "Ask";
                            selected(v) => {
                                AppState.settings-skip-credits-mode = v == "Always skip" ? "always-skip"
                                                                    : v == "Never skip"  ? "never-skip" : "ask";
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    if AppState.settings-skip-credits-mode == "ask": SettingsRow { key: "player.credits_secs"; indent: true; title: "Countdown"; subtitle: "Seconds shown on the Up Next banner before auto-advancing";
                        SettingsDropdown {
                            model: ["10","15","20","30","45","60"];
                            current-value: AppState.settings-skip-credits-secs == 10 ? "10"
                                         : AppState.settings-skip-credits-secs == 15 ? "15"
                                         : AppState.settings-skip-credits-secs == 20 ? "20"
                                         : AppState.settings-skip-credits-secs == 45 ? "45"
                                         : AppState.settings-skip-credits-secs == 60 ? "60" : "30";
                            selected(v) => {
                                AppState.settings-skip-credits-secs = v == "10" ? 10 : v == "15" ? 15
                                    : v == "20" ? 20 : v == "45" ? 45 : v == "60" ? 60 : 30;
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    SectionHeader { text: "SEEKING"; }

                    SettingsRow { key: "player.seek_step"; title: "Seek step"; subtitle: "Left/Right arrow seek amount during playback";
                        SettingsDropdown {
                            model: ["5","10","15","20","30"];
                            current-value: AppState.settings-seek-step-secs == 5  ? "5"
                                         : AppState.settings-seek-step-secs == 15 ? "15"
                                         : AppState.settings-seek-step-secs == 20 ? "20"
                                         : AppState.settings-seek-step-secs == 30 ? "30" : "10";
                            selected(v) => {
                                AppState.settings-seek-step-secs = v == "5"  ? 5
                                                                  : v == "15" ? 15
                                                                  : v == "20" ? 20
                                                                  : v == "30" ? 30 : 10;
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }

                    SettingsRow { key: "player.seek_step_long"; title: "Long seek step"; subtitle: "Shift+Left/Right arrow seek amount during playback";
                        SettingsDropdown {
                            model: ["15","30","45","60","120"];
                            current-value: AppState.settings-seek-step-long-secs == 15  ? "15"
                                         : AppState.settings-seek-step-long-secs == 45  ? "45"
                                         : AppState.settings-seek-step-long-secs == 60  ? "60"
                                         : AppState.settings-seek-step-long-secs == 120 ? "120" : "30";
                            selected(v) => {
                                AppState.settings-seek-step-long-secs = v == "15"  ? 15
                                                                       : v == "45"  ? 45
                                                                       : v == "60"  ? 60
                                                                       : v == "120" ? 120 : 30;
                                AppState.settings-changed(); AppState.refocus();
                            }
                        }
                    }
                }

                // ── Key Bindings section ──────────────────────────────────────
                if AppState.settings-section == "keybindings": VerticalLayout {
                    spacing: 0;

                    // Live-tested feedback (2026-08-07): the rebind
                    // interaction (Enter starts capturing the very next
                    // keypress as the new binding, no confirmation) wasn't
                    // obvious without this spelled out up front.
                    Text {
                        text: "Enter rebinds the focused action — press any key to set it, or Escape to cancel";
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 8px; }

                    SectionHeader { text: "NAVIGATION & GLOBAL"; }

                    for kb[i] in AppState.keybinding-normal: Rectangle {
                        height: 44px;
                        border-radius: Theme.radius;
                        background: AppState.keybinding-focused == i
                                    ? (AppState.keybinding-rebinding ? Theme.accent : Theme.accent-muted)
                                    : (kb-ta.has-hover ? Theme.surface : transparent);
                        border-width:  (kb-ta.pressed || kb-pulse.pulsing) ? 3px : 0px;
                        border-color:  Theme.accent;
                        animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                        kb-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.keybinding-focused == i; }
                        kb-ta := TouchArea {
                            clicked => { AppState.keybinding-focused = i; }
                        }
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            alignment: space-between;
                            Text { text: kb.action; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: AppState.keybinding-focused == i && AppState.keybinding-rebinding
                                      ? "Press a key…" : kb.key;
                                color: AppState.keybinding-focused == i && AppState.keybinding-rebinding
                                       ? Theme.bg : Theme.text-muted;
                                font-size: 12px; vertical-alignment: center;
                            }
                        }
                    }

                    SectionHeader { text: "PLAYER"; }

                    for kb[i] in AppState.keybinding-player: Rectangle {
                        height: 44px;
                        border-radius: Theme.radius;
                        background: AppState.keybinding-focused == i + AppState.keybinding-normal.length
                                    ? (AppState.keybinding-rebinding ? Theme.accent : Theme.accent-muted)
                                    : (kb-player-ta.has-hover ? Theme.surface : transparent);
                        border-width:  (kb-player-ta.pressed || kb-player-pulse.pulsing) ? 3px : 0px;
                        border-color:  Theme.accent;
                        animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                        kb-player-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.keybinding-focused == i + AppState.keybinding-normal.length; }
                        kb-player-ta := TouchArea {
                            clicked => { AppState.keybinding-focused = i + AppState.keybinding-normal.length; }
                        }
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            alignment: space-between;
                            Text { text: kb.action; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: AppState.keybinding-focused == i + AppState.keybinding-normal.length
                                      && AppState.keybinding-rebinding ? "Press a key…" : kb.key;
                                color: AppState.keybinding-focused == i + AppState.keybinding-normal.length
                                       && AppState.keybinding-rebinding ? Theme.bg : Theme.text-muted;
                                font-size: 12px; vertical-alignment: center;
                            }
                        }
                    }

                    // kbd-focused wasn't bound to anything before (2026-08-07
                    // live-tested feedback: "no feedback... did not know it
                    // was highlighted or pressed") — this is the same
                    // condition dispatch_keybinding_nav (keys.rs) uses to
                    // decide "focus is on the Reset button" (fi == total).
                    // Reset no longer fires directly on click/Confirm — both
                    // now open the confirm dialog below instead, so an
                    // accidental press can be backed out of.
                    reset-btn := FjordButton {
                        text: "Reset to Defaults";
                        kbd-focused: AppState.keybinding-focused == AppState.keybinding-normal.length + AppState.keybinding-player.length;
                        clicked => {
                            AppState.keybinding-focused = AppState.keybinding-normal.length + AppState.keybinding-player.length;
                            AppState.keybinding-reset-confirm-focused = 0;
                            AppState.show-keybinding-reset-confirm = true;
                        }
                    }

                    // Precise Reset-row scroll (2026-08-08, 4th attempt) —
                    // every prior attempt ESTIMATED how far to scroll
                    // (a row-offset formula, then a
                    // `right-inner.preferred-height`-based "exact bottom"
                    // formula) and each still left the button's bottom cut
                    // off in practice, meaning the estimate was short by
                    // close to the button's own height. Rather than refine
                    // the estimate a fourth time, this reads `reset-btn`'s
                    // own REAL resolved position directly — `reset-btn.y`
                    // is Slint's actual layout-computed offset within this
                    // VerticalLayout (which itself sits at y:0 within
                    // right-inner, being its sole mounted child), so this
                    // is not an approximation at all. Declared here rather
                    // than on right-pane because `reset-btn` only exists
                    // while this section is mounted — referencing it from
                    // right-pane's own kb-y would be a dangling reference
                    // whenever any other section is showing; `right-fl`/
                    // `right-pane` are safe to reach from here since they
                    // are plain, unconditionally-mounted ancestors.
                    property <int> _reset-fi-mirror: AppState.keybinding-focused;
                    changed _reset-fi-mirror => {
                        // Code review follow-up, 2026-08-08 (5th report —
                        // the mathematically-correct target above was still
                        // being silently re-clamped short by Flickable's
                        // own `viewport-height` binding, which trusted
                        // `right-inner.preferred-height` and apparently
                        // shouldn't have). Push the real measured content
                        // height up to right-pane on every focus change
                        // (cheap, and this fires on every row navigation
                        // too, not just when Reset itself is focused) so
                        // `right-vp-h`/`viewport-height` can never be
                        // smaller than reality while this section is shown
                        // — see right-pane's own `kb-content-h-override`
                        // doc comment for the full reasoning.
                        right-pane.kb-content-h-override = reset-btn.y + reset-btn.height;
                        if AppState.keybinding-focused >= AppState.keybinding-normal.length + AppState.keybinding-player.length {
                            right-fl.viewport-y = min(0px,
                                right-pane.height - (Theme.sp-xl * 2 + reset-btn.y + reset-btn.height));
                        }
                    }
                }

                // ── UI section ──────────────────────────────────────────────────
                if AppState.settings-section == "ui": VerticalLayout {
                    spacing: Theme.sp-sm;

                    SectionHeader { text: "UI"; }

                    // Scroll speed. The value is a DURATION multiplier, not a
                    // rate — bigger % = longer transition = slower, smaller % = faster.
                    // Opposite of what "speed" suggests at a glance, so the subtitle
                    // spells it out.
                    SettingsRow { key: "ui.scroll_speed"; title: "Scroll speed"; subtitle: "Speed of list/page scrolling with the keyboard — lower % is faster, higher % is slower";
                        SettingsDropdown {
                            model: ["0","25","50","75","100","150","200","300","400","500"];
                            current-value: AppState.settings-scroll-speed-pct == 0   ? "0"
                                         : AppState.settings-scroll-speed-pct == 25  ? "25"
                                         : AppState.settings-scroll-speed-pct == 50  ? "50"
                                         : AppState.settings-scroll-speed-pct == 75  ? "75"
                                         : AppState.settings-scroll-speed-pct == 150 ? "150"
                                         : AppState.settings-scroll-speed-pct == 200 ? "200"
                                         : AppState.settings-scroll-speed-pct == 300 ? "300"
                                         : AppState.settings-scroll-speed-pct == 400 ? "400"
                                         : AppState.settings-scroll-speed-pct == 500 ? "500" : "100";
                            selected(v) => {
                                AppState.settings-scroll-speed-pct = v == "0"   ? 0
                                                                    : v == "25"  ? 25
                                                                    : v == "50"  ? 50
                                                                    : v == "75"  ? 75
                                                                    : v == "150" ? 150
                                                                    : v == "200" ? 200
                                                                    : v == "300" ? 300
                                                                    : v == "400" ? 400
                                                                    : v == "500" ? 500 : 100;
                                AppState.settings-scroll-speed = (v == "0"   ? 0.0
                                                                 : v == "25"  ? 0.25
                                                                 : v == "50"  ? 0.5
                                                                 : v == "75"  ? 0.75
                                                                 : v == "150" ? 1.5
                                                                 : v == "200" ? 2.0
                                                                 : v == "300" ? 3.0
                                                                 : v == "400" ? 4.0
                                                                 : v == "500" ? 5.0 : 1.0);
                                AppState.settings-changed();
                                AppState.refocus();
                            }
                        }
                    }

                    // Animation speed (same duration-multiplier caveat as above)
                    SettingsRow { key: "ui.animation_speed"; title: "Animation speed"; subtitle: "Speed of press feedback, fades, and other UI transitions — lower % is faster, higher % is slower, 0% = instant";
                        SettingsDropdown {
                            model: ["0","25","50","75","100","150","200","300","400","500"];
                            current-value: AppState.settings-animation-speed-pct == 0   ? "0"
                                         : AppState.settings-animation-speed-pct == 25  ? "25"
                                         : AppState.settings-animation-speed-pct == 50  ? "50"
                                         : AppState.settings-animation-speed-pct == 75  ? "75"
                                         : AppState.settings-animation-speed-pct == 150 ? "150"
                                         : AppState.settings-animation-speed-pct == 200 ? "200"
                                         : AppState.settings-animation-speed-pct == 300 ? "300"
                                         : AppState.settings-animation-speed-pct == 400 ? "400"
                                         : AppState.settings-animation-speed-pct == 500 ? "500" : "100";
                            selected(v) => {
                                AppState.settings-animation-speed-pct = v == "0"   ? 0
                                                                       : v == "25"  ? 25
                                                                       : v == "50"  ? 50
                                                                       : v == "75"  ? 75
                                                                       : v == "150" ? 150
                                                                       : v == "200" ? 200
                                                                       : v == "300" ? 300
                                                                       : v == "400" ? 400
                                                                       : v == "500" ? 500 : 100;
                                AppState.settings-animation-speed = (v == "0"   ? 0.0
                                                                    : v == "25"  ? 0.25
                                                                    : v == "50"  ? 0.5
                                                                    : v == "75"  ? 0.75
                                                                    : v == "150" ? 1.5
                                                                    : v == "200" ? 2.0
                                                                    : v == "300" ? 3.0
                                                                    : v == "400" ? 4.0
                                                                    : v == "500" ? 5.0 : 1.0);
                                AppState.settings-changed();
                                AppState.refocus();
                            }
                        }
                    }

                    // Text font (dynamic dropdown, same shape as Audio output
                    // above — fetched at startup via fc-list, main.rs)
                    SettingsRow { key: "ui.font_family"; title: "Text font"; subtitle: "Inter is Fjord's own designed-around default — pick any font installed on this system to override it";
                        SettingsDropdown {
                            model <=> AppState.settings-font-family-display;
                            current-value: AppState.settings-font-family-desc != "" ? AppState.settings-font-family-desc : "Inter (Fjord default)";
                            selected(v) => { AppState.font-family-selected(v); AppState.refocus(); }
                        }
                    }
                }

                // ── Integrations section ────────────────────────────────────
                if AppState.settings-section == "integrations": VerticalLayout {
                    spacing: Theme.sp-sm;

                    SectionHeader { text: "INTEGRATIONS"; }

                    // Enable Seerr (gates the Discover sidebar tab AND
                    // everything below this row — Connect/Disconnect through
                    // Discover Region all require settings-seerr-enabled now,
                    // not just seerr-connected; see main.rs's
                    // on_settings_changed + seerr_auth::push_seerr_status.
                    // Toggling off does NOT forget the saved connection — see
                    // the property doc comment in app_state.slint — so
                    // re-enabling reconnects instantly)
                    SettingsRow { key: "integrations.seerr_enabled"; title: "Seerr"; subtitle: "Search and request movies/shows not yet in your library";
                        ToggleSwitch { checked <=> AppState.settings-seerr-enabled; toggled => { AppState.settings-changed(); AppState.refocus(); } }
                    }

                    // Connect / Disconnect (bespoke Rectangle, same pattern as
                    // the Profiles section's Sign Out row — a plain action
                    // row, not a SettingsRow + control pair). Only rendered
                    // while seerr-enabled.
                    if AppState.settings-seerr-enabled: Rectangle {
                        border-radius: Theme.radius;
                        background: AppState.settings-focused == "integrations.seerr_connect" ? Theme.accent-muted
                                  : (int-connect-ta.has-hover ? Theme.surface : transparent);
                        height: 48px;
                        border-width:  (int-connect-ta.pressed || int-connect-pulse.pulsing) ? 3px : 0px;
                        border-color:  Theme.accent;
                        animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                        int-connect-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.settings-focused == "integrations.seerr_connect"; }
                        int-connect-ta := TouchArea {
                            clicked => {
                                if AppState.seerr-connected { AppState.seerr-disconnect(); } else { AppState.open-connect-seerr(); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            alignment: start;
                            spacing: 2px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: AppState.seerr-connected ? "Disconnect" : "Connect Seerr";
                                    color: AppState.seerr-connected ? Theme.error : Theme.text;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: AppState.seerr-connected-label;
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                }
                            }
                        }
                    }

                    // Streaming Region (dynamic dropdown, same shape as Text
                    // font above — fetched from Seerr instead of fc-list,
                    // once per connection rather than at startup; only
                    // reachable/rendered while connected)
                    if AppState.seerr-connected: SettingsRow { key: "integrations.streaming_region"; title: "Streaming Region"; subtitle: "Which region's providers show in \"Currently Streaming On\" on Discover";
                        SettingsDropdown {
                            model <=> AppState.settings-streaming-region-display;
                            current-value: AppState.settings-streaming-region-desc != "" ? AppState.settings-streaming-region-desc : "United States (US)";
                            selected(v) => { AppState.streaming-region-selected(v); AppState.refocus(); }
                        }
                    }

                    // Trailer Quality (plain static dropdown, unlike Streaming
                    // Region above — the option list is fixed, no async
                    // fetch, same shape as e.g. hwdec; same visibility gate
                    // as Streaming Region since watching a trailer at all
                    // needs a live connection)
                    if AppState.seerr-connected: SettingsRow { key: "integrations.trailer_quality"; title: "Trailer Quality"; subtitle: "Caps resolution for Watch Trailer playback on Discover — lower is faster to start";
                        SettingsDropdown {
                            model: ["Best", "1080p", "720p", "480p"];
                            current-value: AppState.settings-trailer-quality;
                            selected(v) => { AppState.settings-trailer-quality = v; AppState.settings-changed(); AppState.refocus(); }
                        }
                    }

                    // Display Language (dynamic dropdown, same shape as
                    // Streaming Region — Seerr's own "Display Language": its
                    // real effect for Fjord is the default TMDB `language`
                    // query param on every Discover movie/tv/search call,
                    // translating titles/overviews; it does NOT affect
                    // Jellyfin library metadata, which follows Jellyfin's own
                    // separate per-library language config)
                    if AppState.seerr-connected: SettingsRow { key: "integrations.display_language"; title: "Display Language"; subtitle: "Language for Discover titles/overviews (independent of Jellyfin's own library language)";
                        SettingsDropdown {
                            model <=> AppState.settings-display-language-display;
                            current-value: AppState.settings-display-language-desc != "" ? AppState.settings-display-language-desc : "Default (English)";
                            selected(v) => { AppState.display-language-selected(v); AppState.refocus(); }
                        }
                    }

                    // Discover Language (dynamic dropdown, same shape) —
                    // filters Discover/trending/search results by TMDB
                    // original language.
                    if AppState.seerr-connected: SettingsRow { key: "integrations.discover_language"; title: "Discover Language"; subtitle: "Filter Discover results by original language";
                        SettingsDropdown {
                            model <=> AppState.settings-discover-language-display;
                            current-value: AppState.settings-discover-language-desc != "" ? AppState.settings-discover-language-desc : "Default (All Languages)";
                            selected(v) => { AppState.discover-language-selected(v); AppState.refocus(); }
                        }
                    }

                    // Discover Region — same dynamic dropdown shape as
                    // Streaming Region, reusing its own already-fetched
                    // region list (settings-streaming-region-display) since
                    // both settings share one region catalog, just a
                    // different desc value.
                    if AppState.seerr-connected: SettingsRow { key: "integrations.discover_region"; title: "Discover Region"; subtitle: "Which region's theatrical/digital/physical release dates show on Discover items";
                        SettingsDropdown {
                            model <=> AppState.settings-streaming-region-display;
                            current-value: AppState.settings-discover-region-desc != "" ? AppState.settings-discover-region-desc : "United States (US)";
                            selected(v) => { AppState.discover-region-selected(v); AppState.refocus(); }
                        }
                    }

                    // Manage Blocklist — bespoke Rectangle button row, same
                    // pattern as Connect/Disconnect above, not a SettingsRow
                    // + control pair since it opens a screen rather than
                    // editing a value. Only reachable while connected AND the
                    // account has MANAGE_BLOCKLIST — a permission genuinely
                    // separate from admin/MANAGE_REQUESTS, see
                    // seerr-can-manage-blocklist's own doc comment in
                    // app_state.slint.
                    if AppState.seerr-connected && AppState.seerr-can-manage-blocklist: Rectangle {
                        border-radius: Theme.radius;
                        background: AppState.settings-focused == "integrations.manage_blocklist" ? Theme.accent-muted
                                  : (int-blocklist-ta.has-hover ? Theme.surface : transparent);
                        height: 48px;
                        border-width:  (int-blocklist-ta.pressed || int-blocklist-pulse.pulsing) ? 3px : 0px;
                        border-color:  Theme.accent;
                        animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                        int-blocklist-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.settings-focused == "integrations.manage_blocklist"; }
                        int-blocklist-ta := TouchArea {
                            clicked => { AppState.open-blocklist(); }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            alignment: start;
                            spacing: 2px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "Manage Blocklist";
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Movies and shows blocked from being requested";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                }
                            }
                        }
                    }
                }
            }
            }

            // ── Keyboard dropdown overlay ─────────────────────────────────────
            // Shown when a dropdown row is opened via Enter. The FocusScope keeps
            // focus so Rust continues to receive all key events. Up/Down move the
            // cursor; Enter confirms; Escape/Left closes without changing.
            // Always in tree (visible: not if:) so kbdd-vl.preferred-width is readable for kbdd-w.
            Rectangle {
                visible:       AppState.settings-dropdown-open;
                z:             20;
                width:         right-pane.kbdd-w;
                height:        right-pane.kbdd-h;
                x:             right-pane.width - self.width - Theme.sp-xl;
                y:             Theme.sp-xl;
                background:    Theme.surface-raised;
                border-radius: 8px;
                border-width:  1px;
                border-color:  Theme.border;
                drop-shadow-blur:  12px;
                drop-shadow-color: #00000080;
                clip:          true;

                kbdd-fl := Flickable {
                    viewport-height: right-pane.kbdd-content-h;

                    // Scroll to keep cursor centred in the overlay panel.
                    property <length> kbdd-scroll: AppState.settings-dropdown-cursor >= 0
                        ? clamp(-(AppState.settings-dropdown-cursor * 32px + 16px - right-pane.kbdd-h / 2),
                                min(0px, right-pane.kbdd-h - right-pane.kbdd-content-h), 0px)
                        : 0px;
                    changed kbdd-scroll => { kbdd-fl.viewport-y = kbdd-scroll; }
                    init    => { kbdd-fl.viewport-y = kbdd-scroll; }

                    kbdd-vl := VerticalLayout {
                        padding: 4px;
                        for opt[i] in AppState.settings-dropdown-model: Rectangle {
                            height:          32px;
                            border-radius:   4px;
                            preferred-width: kbdd-txt.preferred-width + 24px;
                            background:      i == AppState.settings-dropdown-cursor
                                             ? Theme.accent-muted
                                             : (kbdd-item-ta.has-hover ? Theme.surface-overlay : transparent);
                            border-width:  (kbdd-item-ta.pressed || kbdd-pulse.pulsing) ? 3px : 0px;
                            border-color:  Theme.accent;
                            animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                            kbdd-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: i == AppState.settings-dropdown-cursor; }
                            kbdd-txt := Text {
                                x:                  12px;
                                text:               opt;
                                color:              opt == AppState.settings-dropdown-display
                                                    ? Theme.accent : Theme.text;
                                font-size:          13px;
                                font-weight:        opt == AppState.settings-dropdown-display ? 600 : 400;
                                vertical-alignment: center;
                                overflow:           elide;
                            }
                            kbdd-item-ta := TouchArea {
                                clicked => {
                                    AppState.settings-dropdown-cursor = i;
                                    AppState.dropdown-pick();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Reset Key Bindings confirm dialog — declared last so it renders on
    // top of everything else on this screen (including the sidebar/left
    // pane), same z-order convention as every other overlay-on-a-screen in
    // this app (see e.g. collection.slint's own bulk-blocklist confirm).
    // Keyboard (Left/Right/Confirm/Back) is handled by
    // keys.rs::dispatch_keybinding_nav, not here — ConfirmDialog itself is
    // keyboard-dumb by design.
    if AppState.show-keybinding-reset-confirm: ConfirmDialog {
        title:         "Reset Key Bindings?";
        message:       "This resets every key binding back to Fjord's defaults. This can't be undone.";
        confirm-label: "Reset";
        focused:       AppState.keybinding-reset-confirm-focused;
        confirmed => {
            AppState.keybinding-reset-defaults();
            AppState.show-keybinding-reset-confirm = false;
            AppState.refocus();
        }
        cancelled => {
            AppState.show-keybinding-reset-confirm = false;
            AppState.refocus();
        }
    }

    // Rebind-collision confirm dialog (2026-08-08) — same shape as the
    // Reset dialog above, declared after it so a (structurally impossible,
    // but just in case) simultaneous show still renders this on top. The
    // actual apply/discard is done in Rust (keys::apply_rebind via
    // main.rs's on_keybinding_collision_confirmed/-cancelled), not here —
    // this dialog's own confirmed/cancelled just forward to those same
    // callbacks so mouse and keyboard (keys.rs::dispatch_keybinding_nav)
    // can never diverge on what Confirm/Cancel actually does.
    if AppState.show-keybinding-collision-confirm: ConfirmDialog {
        title:         "Key Already Bound";
        message:       AppState.keybinding-collision-message;
        confirm-label: "Reassign";
        focused:       AppState.keybinding-collision-confirm-focused;
        confirmed => {
            AppState.keybinding-collision-confirmed();
            AppState.refocus();
        }
        cancelled => {
            AppState.keybinding-collision-cancelled();
            AppState.refocus();
        }
    }
}
