// ── fjord-app · main.slint ───────────────────────────────────────────────────
//   MainWindow    window root: sync-layout (grid/card sizes from the width), the Up Next banner
//                 (gate29, outside the fullscreen player), the one FocusScope `fs` →
//                 AppState.handle-key() → keys.rs
//   bar layout    MusicPlayerBar (72px, is-audio-playing) above MiniPlayerBar (108/56px,
//                 has-background-player && !is-playing); content fills
//                 height = parent.height - total-bar-h
//   video behind UI  layer 1 below AppShell (dashboard gaps show the video), layer 2 above it
//                 while a Detail/Series/… screen is open. HDR Stage 5: the window is transparent
//                 while video-surface-active — layer 1 gets a VideoSpot, layer 2 isn't mounted,
//                 and _video-covers-content hides AppShell + the permanently-mounted screens
//                 under the player / layer 2 instead
//   startup tier  ConnectingScreen / OfflineScreen (connectivity gate) / LoginScreen /
//                 ProfilePickerScreen (gate35) / AccountPickerScreen (gate40, above it)
//   AppShell      dashboards in its content slot (nav 0 Home, 1 TV, 2 Movies, 3 Collections,
//                 4 Music, 5 Browse All, 6 Discover if Seerr is enabled, 10 Settings): switched
//                 sequentially by shown-nav/nav-fade (fade out, swap, fade in — never two mounted)
//   BrowseScreen / LibraryGrid / DiscoverScreen  permanently-mounted siblings outside the content
//                 slot (big lists built once; `*-ever-shown` latches, then `visible` toggles);
//                 LibraryGrid serves navs 1–4
//   _osk-open     resets AppState.onscreen-keyboard-caret when the on-screen keyboard opens
//   overlays (bottom → top)  PlayerScreen; Series, Season, Artist, Collection, Album, Detail,
//                 RequestDetail, RequestOptions, Calendar, Blocklist, Person (last — covers the
//                 screens it opens from); NowPlaying, ContextMenu, PlaylistPicker,
//                 SidebarProfileMenu, ConnectSeerr, ManageProfiles, ProfileEdit,
//                 RememberLoginConfirm, BonfireGroup, BonfireAdmin, Sign Out confirm, Cancel
//                 Request confirm, QueuePanel, LyricsView, VolumeOverlay, Toast (4 s)
//   fades         free-floating overlays mount through `gateN := FadeGate` (fade in and out);
//                 the permanently-mounted screens use FadeInTrigger once; PlayerScreen and the
//                 bars don't fade (start latency; bars change the layout height). All scale
//                 with settings-animation-speed. Overlays over content get a !is-playing guard.
//   bundled fonts  imported for their side effect (Slint registers every imported .ttf as an
//                 app-wide fallback): Noto Sans Symbols 2 + Math (symbol glyphs some systems
//                 lack), Inter (default text font, MainWindow.font-family), Adwaita Sans (♥ ✓,
//                 pinned on those icons whatever the text font)
// ─────────────────────────────────────────────────────────────────────────────
import "../../../assets/fonts/NotoSansSymbols2-Regular.ttf";
import "../../../assets/fonts/NotoSansMath-Regular.ttf";
import "../../../assets/fonts/Inter-Regular.ttf";
import "../../../assets/fonts/Inter-Bold.ttf";
import "../../../assets/fonts/AdwaitaSans-Regular.ttf";
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import {
    FjordButton,
    LoadingSpinner,
    MiniPlayerBar,
    VideoSpot,
    MusicPlayerBar,
    ToastNotification,
    QueuePanel,
    LyricsView,
    VolumeOverlay,
    FadeGate,
    FadeInTrigger,
    SidebarProfileMenu,
    ConfirmDialog,
} from "widgets.slint";
import { NowPlayingScreen } from "now_playing.slint";
import {
    SectionRow,
    LibraryGrid,
    HomeScreen,
    DashboardScreen,
    MusicDashboard,
    CollectionsDashboard,
} from "home.slint";
import { BrowseScreen } from "browse.slint";
import { SettingsScreen } from "settings.slint";
import { LoginScreen } from "login.slint";
import { ConnectingScreen, OfflineScreen } from "connect.slint";
import { ProfilePickerScreen } from "profile_picker.slint";
import { AccountPickerScreen } from "account_picker.slint";
import { ManageProfilesScreen } from "manage_profiles.slint";
import { ProfileEditScreen } from "profile_edit.slint";
import { RememberLoginConfirmOverlay } from "remember_login_confirm.slint";
import { BonfireGroupScreen } from "bonfire_group.slint";
import { BonfireAdminScreen } from "bonfire_admin.slint";
import { PlayerScreen } from "player.slint";
import { SeriesScreen } from "series.slint";
import { SeasonScreen } from "season.slint";
import { DetailPage } from "detail.slint";
import { AppShell } from "layout.slint";
import { PersonScreen } from "person.slint";
import { ContextMenu, PlaylistPicker } from "context_menu.slint";
import { CollectionScreen } from "collection.slint";
import { AlbumScreen } from "album.slint";
import { ArtistScreen } from "artist.slint";
import { ConnectSeerrScreen } from "connect_seerr.slint";
import { DiscoverScreen } from "discover.slint";
import {
    RequestDetailScreen,
    RequestOptionsOverlay,
} from "request_detail.slint";
import { CalendarScreen } from "calendar.slint";
import { BlocklistScreen } from "blocklist.slint";

export { AppState }
export component MainWindow inherits Window {
    title: "FJORD";
    // Transparent while the video is drawn on the subsurface below the
    // window (HDR Stage 5, 2026-10-05) — Slint's UI composites on top of it;
    // the subsurface fills everything outside the video with Theme.bg.
    background: AppState.video-surface-active ? transparent : Theme.bg;
    // Settings → UI → Text font. `default-font-family` (not `font-family` —
    // Window doesn't expose that one) is Slint's purpose-built window-wide
    // default: every Text element without its own explicit font-family uses
    // this, while the icon Text elements throughout the app (hard-pinned to
    // Adwaita Sans / Noto Sans Symbols2, see widgets.slint's IconCircleButton/
    // FjordButton) keep their own more-specific binding regardless. Set
    // synchronously from Config at launch — see apply_settings_to_window in
    // main.rs — so this never renders blank or with a placeholder font on
    // the first frame.
    default-font-family: AppState.settings-font-family;
    min-width: 900px;
    min-height: 520px;
    preferred-width: 1280px;
    preferred-height: 720px;

    callback grab-keyboard-focus;
    grab-keyboard-focus => { fs.focus(); }

    pure function grid-cols() -> int {
        if self.width < 852px { return 3; }
        if self.width < 1011px { return 4; }
        if self.width < 1170px { return 5; }
        if self.width < 1329px { return 6; }
        if self.width < 1488px { return 7; }
        if self.width < 1647px { return 8; }
        if self.width < 1806px { return 9; }
        return 10;
    }
    pure function dash-card-w() -> length {
        if self.width < 900px { return 115px; }
        if self.width < 1300px { return 140px; }
        if self.width < 1700px { return 165px; }
        return 190px;
    }
    pure function dash-card-h() -> length {
        if self.width < 900px { return 184px; }
        if self.width < 1300px { return 224px; }
        if self.width < 1700px { return 264px; }
        return 304px;
    }

    function sync-layout() {
        AppState.library-cols = self.grid-cols();
        AppState.dash-cw = self.dash-card-w();
        AppState.dash-ch = self.dash-card-h();
    }
    init => { self.sync-layout(); }
    changed width => { self.sync-layout(); }

    // Auto-advance countdown banner — only shown outside the fullscreen player
    // (player.slint has its own banner with Play Now + Skip buttons).
    gate29 := FadeGate {
        show: AppState.show-next-ep-banner && !AppState.is-playing;
    }

    if gate29.mounted: Rectangle {
        x: root.width - 300px - 20px;
        y: root.height - 110px - 20px;
        width: 300px;
        height: 110px;
        border-radius: Theme.radius-lg;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000066;
        drop-shadow-offset-y: 4px;
        opacity: gate29.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }

        VerticalLayout {
            padding: 14px;
            spacing: 8px;

            Text {
                text: "Up Next in \{AppState.next-ep-secs}s";
                color: Theme.text-muted;
                font-size: 11px;
            }

            Text {
                text: AppState.next-ep-title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }

            HorizontalLayout {
                alignment: end;
                FjordButton {
                    text: "Cancel";
                    width: 70px;
                    clicked => { AppState.cancel-auto-advance(); }
                }
            }
        }
    }

    fs := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            AppState.handle-key(event.text, event.modifiers.shift, event.modifiers.control, event.repeat) ? accept : reject
        }
    }

    // Height reserved for bars at the bottom (0 when not active or player is open)
    property <length> bar-h:       (AppState.has-background-player && !AppState.is-playing)
        ? (AppState.video-behind-ui ? 56px : 108px) : 0px;
    property <length> music-bar-h: AppState.is-audio-playing ? 72px : 0px;
    property <length> total-bar-h: bar-h + music-bar-h;

    // Browse All's list is a plain `for` over AppState.media-items (~800 items, no
    // virtualization): rebuilding it on every sidebar pass through nav 5 caused hitches. So it
    // lives outside AppShell's content slot, permanently mounted once first shown
    // (browse-ever-shown latches) and toggled with `visible` (which also removes it from
    // hit-testing). The local mirror is needed because `changed` only watches this component's
    // properties.
    property <bool> _browse-vis: AppState.show-browse;
    property <bool> browse-ever-shown: false;
    changed _browse-vis => { if _browse-vis { browse-ever-shown = true; } }

    // LibraryGrid — same fix: home.slint's grid is a plain `for` over library-display (up to
    // ~600 MediaCards, each heavier than a BrowseItem). Navs 1–4 all show the same
    // library-display, so one permanently-mounted instance serves them all.
    property <bool> _library-vis: !AppState.show-browse && AppState.show-library &&
        (AppState.active-nav == 1 || AppState.active-nav == 2 || AppState.active-nav == 3 || AppState.active-nav == 4);
    property <bool> library-ever-shown: false;
    changed _library-vis => { if _library-vis { library-ever-shown = true; } }

    // HDR Stage 5: with the window transparent over the video subsurface, what an opaque
    // video used to cover would show through — the fullscreen player, and layer 2 below
    // (video behind an open Detail/Series/… screen). Those hide AppShell and the three
    // permanently-mounted screens instead.
    property <bool> _layer2-shown: AppState.video-behind-ui && AppState.has-background-player && !AppState.is-playing
        && (AppState.show-detail || AppState.show-series || AppState.show-season || AppState.show-person || AppState.show-collection || AppState.show-album || AppState.show-artist);
    property <bool> _video-covers-content: AppState.video-surface-active && (AppState.is-playing || _layer2-shown);

    // The on-screen keyboard's caret for LineEdit targets starts at the end of the field every
    // time it opens (◀ ▶ keys, see AppState.onscreen-keyboard-edit) — one tracker here instead
    // of a reset at each place that opens the keyboard.
    property <bool> _osk-open: AppState.show-onscreen-keyboard;
    changed _osk-open => { if _osk-open { AppState.onscreen-keyboard-caret = -1; } }

    // DiscoverScreen — same fix again: its grid grows with pagination
    // (maybe_autofill_grid has no cap). It has no lifecycle-dependent state (no init =>).
    property <bool> _discover-vis: !AppState.show-browse && AppState.active-nav == 6;
    property <bool> discover-ever-shown: false;
    changed _discover-vis => { if _discover-vis { discover-ever-shown = true; } }

    // Video-behind-UI — TWO layers:
    //   Layer 1 (here, z=1): always shown below AppShell; content screens have transparent roots
    //     so the video peeks through gaps between cards on the dashboard/library.
    //   Layer 2 (after AppShell, z=3): only when an overlay screen is open; covers AppShell so
    //     the library/dashboard card elements don't ghost through the transparent overlay roots.
    if AppState.video-behind-ui && AppState.has-background-player && !AppState.is-playing: Rectangle {
        y: 0;
        height: parent.height - total-bar-h;
        background: AppState.video-surface-active ? transparent : #000000;
        Image {
            source: AppState.video-frame;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
            visible: !AppState.video-surface-active;
        }

        VideoSpot {
            which: 1;
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            background: #00000044;
        }
    }

    gate1 := FadeGate {
        show: AppState.show-connecting;
    }

    if gate1.mounted: ConnectingScreen {
        opacity: gate1.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
    gate2 := FadeGate {
        show: AppState.show-offline;
    }

    if gate2.mounted: OfflineScreen {
        opacity: gate2.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
    gate3 := FadeGate {
        show: !AppState.show-connecting && !AppState.show-offline && !AppState.show-profile-picker && !AppState.show-account-picker && AppState.show-login;
    }

    if gate3.mounted: LoginScreen {
        opacity: gate3.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
    gate35 := FadeGate {
        show: !AppState.show-connecting && !AppState.show-offline && !AppState.show-account-picker && AppState.show-profile-picker;
    }

    if gate35.mounted: ProfilePickerScreen {
        opacity: gate35.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
    // Account tier — same shape as gate35, above it: account-picker-select hides
    // show-account-picker before opening ProfilePickerScreen, so the two are never both true.
    gate40 := FadeGate {
        show: !AppState.show-connecting && !AppState.show-offline && AppState.show-account-picker;
    }

    if gate40.mounted: AccountPickerScreen {
        opacity: gate40.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Dashboard tab switch: sequential fade-out → switch → fade-in. The 6 content-slot screens
    // share AppShell's one HorizontalLayout slot (horizontal-stretch: 1) and must never be
    // mounted together — a simultaneous crossfade split the space between two screens — and a
    // hard cut followed by a fade-in looked jarring.
    //
    // `shown-nav` lags `active-nav`: the conditions below use shown-nav, so the old screen keeps
    // rendering while nav-fade takes it to 0, then the swap happens while invisible and the new
    // one fades in. Fade-out 100 ms, fade-in 200 ms (base, × animation speed). Holding an arrow
    // key through several tabs: a running fade-out timer isn't restarted (Timer.running = true
    // is a no-op while running), so it settles on whatever tab is active when it fires;
    // `animate` retargets smoothly mid-flight.
    property <int> shown-nav: AppState.active-nav;
    property <float> nav-fade:  1;

    // `changed` only observes a property declared on THIS component, not a
    // dotted path into an imported global (same limitation this file's own
    // _browse-vis/_toast-vis mirrors already work around) — hence the local
    // mirror rather than `changed active-nav` directly.
    property <int> _active-nav-mirror: AppState.active-nav;
    changed _active-nav-mirror => {
        if AppState.active-nav != shown-nav {
            nav-fade = 0;
            nav-fadeout-timer.running = true;
        }
    }

    nav-fadeout-timer := Timer {
        interval: max(16ms, 100ms * AppState.settings-animation-speed);
        running: false;
        triggered => {
            self.running = false;
            shown-nav = AppState.active-nav;
            nav-fadein-kick.running = true;
        }
    }

    // Bump nav-fade a frame after mounting so `animate opacity` has a real 0→1 transition (the
    // FadeGate kick trick). Guarded on active-nav == shown-nav: a second nav change inside
    // these 16 ms would otherwise force nav-fade back to 1 while it is fading out again.
    nav-fadein-kick := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            if AppState.active-nav == shown-nav {
                nav-fade = 1;
            }
        }
    }

    if !AppState.show-connecting && !AppState.show-offline && !AppState.show-login && !AppState.show-profile-picker && !AppState.show-account-picker: AppShell {
        y: 0;
        height: parent.height - total-bar-h;
        visible: !_video-covers-content; // HDR Stage 5 — see _video-covers-content

        if !AppState.show-browse && shown-nav == 0: HomeScreen {
            horizontal-stretch: 1;
            continue-watching: AppState.continue-watching;
            next-up: AppState.next-up;
            recently-added: AppState.recently-added;
            recently-added-movies: AppState.recently-added-movies;
            recently-added-albums: AppState.recently-added-albums;
            watchlist: AppState.discover-watchlist-mixed;
            coming-up: AppState.discover-coming-up-mixed;
            opacity: nav-fade;
            animate opacity {
                duration: 200ms * AppState.settings-animation-speed;
                easing: ease-out-expo;
            }
        }
        if !AppState.show-browse && shown-nav == 1 && !AppState.show-library: DashboardScreen {
            horizontal-stretch: 1;
            screen-title: "TV Shows";
            continue-watching: AppState.continue-watching-tv;
            next-up: AppState.next-up;
            recently-added: AppState.recently-added-tv;
            not-watched: AppState.not-watched-tv;
            favorites: AppState.favorite-series;
            watchlist: AppState.discover-watchlist-tv;
            coming-up: AppState.discover-coming-up-tv;
            opacity: nav-fade;
            animate opacity {
                duration: 200ms * AppState.settings-animation-speed;
                easing: ease-out-expo;
            }
        }
        if !AppState.show-browse && shown-nav == 2 && !AppState.show-library: DashboardScreen {
            horizontal-stretch: 1;
            screen-title: "Movies";
            continue-watching: AppState.continue-watching-movies;
            recently-added: AppState.recently-added-movies;
            not-watched: AppState.not-watched-movies;
            favorites: AppState.favorite-movies;
            watchlist: AppState.discover-watchlist-movies;
            coming-up: AppState.discover-coming-up-movies;
            opacity: nav-fade;
            animate opacity {
                duration: 200ms * AppState.settings-animation-speed;
                easing: ease-out-expo;
            }
        }
        if !AppState.show-browse && shown-nav == 3 && !AppState.show-library: CollectionsDashboard {
            horizontal-stretch: 1;
            recently-added: AppState.recently-added-collections;
            unwatched: AppState.unwatched-collections;
            opacity: nav-fade;
            animate opacity {
                duration: 200ms * AppState.settings-animation-speed;
                easing: ease-out-expo;
            }
        }
        if !AppState.show-browse && shown-nav == 4 && !AppState.show-library: MusicDashboard {
            horizontal-stretch: 1;
            recently-added: AppState.recently-added-albums;
            recently-played: AppState.recently-played-albums;
            favorites: AppState.favorite-albums;
            playlists: AppState.music-playlists;
            opacity: nav-fade;
            animate opacity {
                duration: 200ms * AppState.settings-animation-speed;
                easing: ease-out-expo;
            }
        }
        if !AppState.show-browse && shown-nav == 10: SettingsScreen {
            horizontal-stretch: 1;
            opacity: nav-fade;
            animate opacity {
                duration: 200ms * AppState.settings-animation-speed;
                easing: ease-out-expo;
            }
        }
    }

    // Browse All — permanently-mounted sibling, not an AppShell content slot
    // (see browse-ever-shown's doc comment above for why). Positioned to
    // match exactly what AppShell would have given it as a stretch:1 child:
    // full remaining width right of the fixed-width sidebar, same y/height
    // as AppShell itself. `visible` (not opacity) both hides it and, per
    // this codebase's own documented Slint gotcha, removes it from hit-
    // testing — so a hidden BrowseItem's TouchArea can't intercept clicks
    // meant for whatever AppShell tab is actually showing underneath.
    if !AppState.show-connecting && !AppState.show-offline && !AppState.show-login && !AppState.show-profile-picker && !AppState.show-account-picker
        && (AppState.show-browse || browse-ever-shown): BrowseScreen {
        x: Theme.sidebar-width;
        y: 0;
        width: parent.width - Theme.sidebar-width;
        height: parent.height - total-bar-h;
        visible: AppState.show-browse && !_video-covers-content;
        opacity: fade4.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
        fade4 := FadeInTrigger { }
    }

    // LibraryGrid — permanently-mounted sibling, one instance shared across
    // nav 1/2/3/4 (see library-ever-shown's doc comment above). Same
    // geometry as Browse's own sibling; `grid-title` reproduces the 4
    // literal per-nav strings the old separate instantiations used.
    if !AppState.show-connecting && !AppState.show-offline && !AppState.show-login && !AppState.show-profile-picker && !AppState.show-account-picker
        && (_library-vis || library-ever-shown): LibraryGrid {
        x: Theme.sidebar-width;
        y: 0;
        width: parent.width - Theme.sidebar-width;
        height: parent.height - total-bar-h;
        visible: _library-vis && !_video-covers-content;
        grid-title: AppState.active-nav == 1 ? "All Shows" :
            AppState.active-nav == 2 ? "All Movies" :
            AppState.active-nav == 3 ? "Collections" :
            "All Artists";
        opacity: fade-lib.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
        fade-lib := FadeInTrigger { }
    }

    // DiscoverScreen — permanently-mounted sibling (see discover-ever-shown's
    // doc comment above). Same geometry as Browse's/LibraryGrid's own.
    if !AppState.show-connecting && !AppState.show-offline && !AppState.show-login && !AppState.show-profile-picker && !AppState.show-account-picker
        && (_discover-vis || discover-ever-shown): DiscoverScreen {
        x: Theme.sidebar-width;
        y: 0;
        width: parent.width - Theme.sidebar-width;
        height: parent.height - total-bar-h;
        visible: _discover-vis && !_video-covers-content;
        opacity: fade-disc.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
        fade-disc := FadeInTrigger { }
    }

    // Second video layer — declared AFTER AppShell so it covers it when an overlay is open.
    // Without this, the library/dashboard cards (solid elements inside the transparent-rooted
    // AppShell) would ghost through the transparent overlay screens. This layer acts as an
    // opaque video cover that hides AppShell content when a full-screen overlay is open.
    // Not mounted while the video is on the subsurface (HDR Stage 5): its own
    // dim would stack on layer 1's; _video-covers-content hides AppShell instead.
    if _layer2-shown && !AppState.video-surface-active: Rectangle {
        y: 0;
        height: parent.height - total-bar-h;
        background: #000000;
        Image {
            source: AppState.video-frame;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }

        Rectangle {
            background: #00000044;
        }
    }

    // Full-screen overlays — content area only (bars remain visible at bottom).
    // PlayerScreen is exempt from the fade: total-bar-h==0 when is-playing, so it always
    // gets full height, and video start latency is too perception-sensitive for an
    // artificial opacity ramp on top of it.
    if AppState.is-playing:                          PlayerScreen { }
    gate15 := FadeGate {
        show: AppState.show-series;
    }

    if gate15.mounted: SeriesScreen {
        y: 0;
        height: parent.height - total-bar-h;
        background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;
        opacity: gate15.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
    gate16 := FadeGate {
        show: AppState.show-season;
    }

    if gate16.mounted: SeasonScreen {
        y: 0;
        height: parent.height - total-bar-h;
        background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;
        opacity: gate16.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
    gate17 := FadeGate {
        show: AppState.show-artist && !AppState.is-playing;
    }

    if gate17.mounted: ArtistScreen {
        y: 0;
        height: parent.height - total-bar-h;
        background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;
        opacity: gate17.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
    gate18 := FadeGate {
        show: AppState.show-collection && !AppState.is-playing;
    }

    if gate18.mounted: CollectionScreen {
        y: 0;
        height: parent.height - total-bar-h;
        background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;
        opacity: gate18.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
    gate19 := FadeGate {
        show: AppState.show-album && !AppState.is-playing;
    }

    if gate19.mounted: AlbumScreen {
        y: 0;
        height: parent.height - total-bar-h;
        background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;
        opacity: gate19.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
    gate20 := FadeGate {
        show: AppState.show-detail && !AppState.is-playing;
    }

    if gate20.mounted: DetailPage {
        y: 0;
        height: parent.height - total-bar-h;
        background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;
        opacity: gate20.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
    gate31 := FadeGate {
        show: AppState.show-request-detail && !AppState.is-playing;
    }

    if gate31.mounted: RequestDetailScreen {
        y: 0;
        height: parent.height - total-bar-h;
        opacity: gate31.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Request Options modal — above RequestDetailScreen (opened from its Request button)
    gate32 := FadeGate {
        show: AppState.show-request-options && !AppState.is-playing;
    }

    if gate32.mounted: RequestOptionsOverlay {
        width: parent.width;
        height: parent.height;
        opacity: gate32.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Calendar (from Discover's "Coming Up" row). Like every overlay, guarded by !is-playing.
    gate33 := FadeGate {
        show: AppState.show-calendar && !AppState.is-playing;
    }

    if gate33.mounted: CalendarScreen {
        y: 0;
        height: parent.height - total-bar-h;
        opacity: gate33.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Manage Blocklist (Settings → Integrations). !is-playing, and hidden under the pickers
    // (otherwise an idle lock left it painted over the PIN pad — see reset_session_state).
    gate34 := FadeGate {
        show: AppState.show-blocklist && !AppState.is-playing && !AppState.show-profile-picker && !AppState.show-account-picker;
    }

    if gate34.mounted: BlocklistScreen {
        y: 0;
        height: parent.height - total-bar-h;
        opacity: gate34.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // PersonScreen stays the LAST overlay here: the screens it opens from (Detail, Series, …,
    // RequestDetail) don't clear their own show-X flags — Person covers them by z-order. Keep
    // any new sibling overlay above this one.
    gate21 := FadeGate {
        show: AppState.show-person;
    }

    if gate21.mounted: PersonScreen {
        y: 0;
        height: parent.height - total-bar-h;
        background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;
        opacity: gate21.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Loading overlay — covers content area only; bars remain visible at bottom
    if AppState.app-content-loading: Rectangle {
        y: 0;
        height: parent.height - total-bar-h;
        background: #000000c0;
        VerticalLayout {
            alignment: center;
            spacing: 28px;

            LoadingSpinner { }

            // Progress bar — 0.0 → 1.0 as milestones are hit
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 320px;
                    height: 6px;
                    border-radius: 3px;
                    background: #ffffff28;
                    Rectangle {
                        x: 0;
                        width: parent.width * AppState.app-loading-progress;
                        height: parent.height;
                        border-radius: 3px;
                        background: Theme.accent;
                        animate width {
                            duration: 400ms * AppState.settings-animation-speed;
                            easing: ease-out-expo;
                        }
                    }
                }
            }
        }
    }

    // ── Bottom bars (video mini-player above music bar) ───────────────────────
    // MiniPlayerBar: video paused in background (above music bar)
    if AppState.has-background-player && !AppState.is-playing: MiniPlayerBar {
        y: parent.height - bar-h - music-bar-h;
        width: parent.width;
    }
    // MusicPlayerBar: audio-only playback
    if AppState.is-audio-playing: MusicPlayerBar {
        y: parent.height - music-bar-h;
        width: parent.width;
    }

    // Now Playing: fullscreen music view (covers the music bar). Opened by
    // clicking the bar's art/title zone, the M key, or idle auto-open.
    gate22 := FadeGate {
        show: AppState.show-now-playing && AppState.is-audio-playing;
    }

    if gate22.mounted: NowPlayingScreen {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        opacity: gate22.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    gate23 := FadeGate {
        show: AppState.show-context-menu;
    }

    if gate23.mounted: ContextMenu {
        opacity: gate23.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Add-to-playlist picker (above ContextMenu — the menu closes when it opens)
    // Bonfire Phase 4 review, 2026-08-29 — same fix as gate34/Blocklist
    // above, identical reasoning.
    gate24 := FadeGate {
        show: AppState.show-playlist-picker && !AppState.show-profile-picker && !AppState.show-account-picker;
    }

    if gate24.mounted: PlaylistPicker {
        opacity: gate24.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Sidebar profile quick-menu. The sidebar can't be reached during playback, but
    // !is-playing anyway, as for every free-floating overlay.
    gate38 := FadeGate {
        show: AppState.show-sidebar-profile-menu && !AppState.is-playing;
    }

    if gate38.mounted: SidebarProfileMenu {
        opacity: gate38.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Connect Seerr: reached from Settings → Integrations, layers over
    // whatever screen is currently showing (same free-floating overlay shape
    // as PlaylistPicker above).
    gate30 := FadeGate {
        show: AppState.show-connect-seerr;
    }

    if gate30.mounted: ConnectSeerrScreen {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        opacity: gate30.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Manage Profiles / Profile Edit (Settings → Profiles), a free-floating overlay like
    // ConnectSeerrScreen, with the !is-playing guard.
    gate36 := FadeGate {
        show: AppState.show-manage-profiles && !AppState.is-playing;
    }

    if gate36.mounted: ManageProfilesScreen {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        opacity: gate36.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
    gate37 := FadeGate {
        show: AppState.show-profile-edit && !AppState.is-playing;
    }

    if gate37.mounted: ProfileEditScreen {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        opacity: gate37.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
    gate41 := FadeGate {
        show: AppState.show-remember-login-confirm && !AppState.is-playing;
    }

    if gate41.mounted: RememberLoginConfirmOverlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        opacity: gate41.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Bonfire Group (Settings → Profiles), same overlay shape as Manage Profiles, with the
    // !is-playing guard.
    gate44 := FadeGate {
        show: AppState.show-bonfire-group && !AppState.is-playing;
    }

    if gate44.mounted: BonfireGroupScreen {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        opacity: gate44.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Bonfire Admin (Phase 6, admin actions, 2026-09-04) — same FadeGate +
    // !is-playing guard as BonfireGroupScreen right above.
    gate45 := FadeGate {
        show: AppState.show-bonfire-admin && !AppState.is-playing;
    }

    if gate45.mounted: BonfireAdminScreen {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        opacity: gate45.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Sign Out confirm (see show-sign-out-confirm in app_state.slint). Global because three
    // places open it (Settings' Profiles row, the sidebar quick-menu, OfflineScreen's Change
    // Server). Keyboard: keys.rs's pre-active_mode() raw-key tier (ConfirmDialog has none).
    gate42 := FadeGate {
        show: AppState.show-sign-out-confirm && !AppState.is-playing;
    }

    if gate42.mounted: ConfirmDialog {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        opacity: gate42.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
        title: "Sign Out?";
        message: "You'll need to sign back in to keep watching.";
        confirm-label: "Sign Out";
        focused: AppState.sign-out-confirm-focused;
        confirmed => {
            AppState.sign-out();
            AppState.show-sign-out-confirm = false;
        }
        cancelled => {
            AppState.show-sign-out-confirm = false;
        }
    }

    // Cancel-Seerr-request confirm (see show-cancel-request-confirm in app_state.slint).
    // Global: opened from the Discover context menu, also used by RequestDetailScreen's ⋮ More.
    // The DELETE happens in discover's on_cancel_request_confirmed.
    gate43 := FadeGate {
        show: AppState.show-cancel-request-confirm && !AppState.is-playing;
    }

    if gate43.mounted: ConfirmDialog {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        opacity: gate43.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
        title: "Cancel Request?";
        message: "This permanently removes the request — re-requesting starts over from scratch.";
        confirm-label: "Cancel Request";
        focused: AppState.cancel-request-confirm-focused;
        confirmed => {
            AppState.cancel-request-confirmed();
            AppState.show-cancel-request-confirm = false;
        }
        cancelled => {
            AppState.show-cancel-request-confirm = false;
        }
    }

    // Queue panel: shown above context menu when browsing with audio, or from player
    gate25 := FadeGate {
        show: AppState.show-queue-panel;
    }

    if gate25.mounted: QueuePanel {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height - total-bar-h;
        opacity: gate25.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Lyrics overlay: shown above everything except the music bar. Suppressed
    // while Now Playing is open — it already embeds its own synced lyrics
    // panel, so this would otherwise stack a redundant popup on top (CR11-8).
    gate26 := FadeGate {
        show: AppState.show-lyrics && AppState.is-audio-playing && !AppState.show-now-playing;
    }

    if gate26.mounted: LyricsView {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height - total-bar-h;
        opacity: gate26.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Volume overlay: shown over any screen (fullscreen player, music bar,
    // Now Playing) — was fullscreen-player-only before the music bar / Now
    // Playing volume buttons existed.
    gate27 := FadeGate {
        show: AppState.show-volume-overlay;
    }

    if gate27.mounted: VolumeOverlay {
        x: (parent.width - self.width) / 2;
        y: 24px;
        opacity: gate27.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }

    // Toast: highest z-order, always on top.
    // Local mirror triggers changed callback; timer auto-dismisses after 4 s.
    property <bool> _toast-vis: AppState.toast-visible;
    toast-timer := Timer {
        interval: 4000ms;
        running: false;
        triggered => {
            AppState.toast-visible = false;
            self.running = false;
        }
    }

    changed _toast-vis => {
        if _toast-vis {
            toast-timer.running = false;
            toast-timer.running = true;
        }
    }
    gate28 := FadeGate {
        show: AppState.toast-visible;
    }

    if gate28.mounted: ToastNotification {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - total-bar-h - 12px;
        width: min(460px, parent.width - 48px);
        message: AppState.toast-message;
        opacity: gate28.fade-opacity;
        animate opacity {
            duration: 200ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
}
