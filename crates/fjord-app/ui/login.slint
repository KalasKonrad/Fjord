// ── fjord-app · login.slint ──────────────────────────────────────────────────
//   LoginScreen  server + username + password → AppState.do-login(…, login-append-mode,
//                login-remember); "Remember this login" toggle (default on, stored on the
//                profile); Quit bottom-right (Ctrl+Q too); "← Back" top-left in append mode
//                (Add Account — cancel-add-account() returns to where it was opened from).
//                Server/username bind to login-server-prefill/-username-prefill (a known
//                account re-login only needs the password); init focuses the first field that
//                needs typing (deferred one tick, after main.rs's own focus grab).
//   D-pad zones  (login-zone, see app_state.slint) 0 server, 1 username, 2 password (native
//                LineEdit focus; Tab cycles them), 3 Remember, 4 Connect, 5 Back (append mode,
//                Up from Server), 6 Quit (Down from Connect). Fields hand keys back to `fs` with
//                AppState.refocus(); _zone-mirror gives a field real focus again (Rust can't call
//                .focus()). Escape/Backspace on Quit un-focuses rather than quitting.
//   Enter in a field  opens the on-screen keyboard (QwertyKeyboard, below the card). With the
//                keyboard off in Settings (open-onscreen-keyboard returns false): Server →
//                Username → Password, and Enter in Password presses Connect.
//   On-screen keyboard  a focus-ring wrapper (FieldFocusWrap) shows the target field while it's
//                open (refocus() took native focus away); keys edit at the keyboard's caret
//                (onscreen-keyboard-edit, ◀ ▶ move it); dispatch-onscreen-key routes by
//                onscreen-keyboard-target. Physical keys still type while it's open
//                (_physical-key-mirror → the same dispatch); only the arrows drive the grid.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import {
    FjordButton,
    ToggleSwitch,
    QwertyKeyboard,
    FieldFocusWrap,
} from "widgets.slint";
import { LineEdit } from "std-widgets.slint";

export component LoginScreen inherits Rectangle {
    background: Theme.bg;

    // Put real focus into the field the user needs: Password when server and username are
    // prefilled (a re-login), else Server. Deferred to a one-shot Timer: gate3 is a FadeGate and
    // show-login defaults to true, so on a cold start this init runs inside MainWindow::new() —
    // and main.rs's later invoke_grab_keyboard_focus() (the global `fs`) would override a
    // direct .focus(); keys.rs's show_login tier leaves zones 0–2 to the LineEdit, so keys went
    // nowhere. The timer fires only once the event loop runs, after that grab.
    init => {
        AppState.login-zone = 0;
        if AppState.login-server-prefill != "" && AppState.login-username-prefill != "" {
            AppState.login-zone = 2;
        }
        // On-screen keyboard resets, as in reset_session_state (session.rs) — a cold start never
        // runs that function.
        AppState.show-onscreen-keyboard = false;
        AppState.onscreen-keyboard-target = "";
        AppState.onscreen-keyboard-cursor = 0;
        focus-kick-timer.running = true;
    }
    focus-kick-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            focus-kick-timer.running = false;
            if AppState.login-zone == 2 {
                pass-input.focus();
            } else {
                server-input.focus();
            }
        }
    }

    card := Rectangle {
        width: min(420px, parent.width - 48px);
        height: inner.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 24px;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        drop-shadow-blur: 28px;
        drop-shadow-color: #00000070;

        inner := VerticalLayout {
            padding: Theme.sp-xl;
            spacing: Theme.sp;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "FJORD";
                    color: Theme.accent;
                    font-size: 38px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Jellyfin media player";
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }

            Rectangle {
                height: 6px;
            }

            // Zone 0 — a bordered wrapper (LineEdit has no border of its own), shown only while the
            // on-screen keyboard is open; otherwise native LineEdit focus shows itself. Shared
            // FieldFocusWrap, like its 2 siblings below.
            server-field-wrap := FieldFocusWrap {
                focused: AppState.show-onscreen-keyboard && AppState.login-zone == 0;
                server-input := LineEdit {
                    // A bare host/IP works (https, then http — see auth.rs); the example keeps a scheme because
                    // typing http:// for a local IP:port saves the failed https attempt.
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    placeholder-text: "Server (e.g. jellyfin.example.com or 192.168.1.10:8096)";
                    text: AppState.login-server-prefill;
                    changed has-focus => {
                        if self.has-focus {
                            AppState.login-zone = 0;
                            // Retarget the open keyboard to this field, so a mouse click on another field moves the
                            // typing along with the focus ring.
                            if AppState.show-onscreen-keyboard {
                                AppState.onscreen-keyboard-target = "login-server";
                                AppState.onscreen-keyboard-cursor = 0;
                            }
                        }
                    }
                    key-pressed(event) => {
                        if event.text == "\u{1b}" && AppState.login-append-mode {
                            AppState.cancel-add-account();
                            return accept;
                        }
                        // Down leaves the field entirely (native focus moves to
                        // user-input, which itself picks up login-zone=1 via its
                        // own changed has-focus above).
                        if event.text == "\u{F701}" {
                            user-input.focus();
                            return accept;
                        }
                        // Up → zone 5 (Back, top-left above this field) in append mode; leaves native focus like
                        // pass-input's Down (AppState.refocus() hands keys back to `fs`). Nothing above Server
                        // otherwise.
                        if event.text == "\u{F700}" && AppState.login-append-mode {
                            AppState.login-zone = 5;
                            AppState.refocus();
                            return accept;
                        }
                        // Enter opens the on-screen keyboard (see the header for the keyboard-off behaviour).
                        if event.text == "\u{000a}" {
                            // On-screen keyboard off in Settings: Enter moves on to Username.
                            if !AppState.open-onscreen-keyboard("login-server") {
                                user-input.focus();
                            }
                            return accept;
                        }
                        return reject;
                    }
                }
            }

            user-field-wrap := FieldFocusWrap {
                focused: AppState.show-onscreen-keyboard && AppState.login-zone == 1;
                user-input := LineEdit {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    placeholder-text: "Username";
                    text: AppState.login-username-prefill;
                    changed has-focus => {
                        if self.has-focus {
                            AppState.login-zone = 1;
                            // See server-input's own identical handler above.
                            if AppState.show-onscreen-keyboard {
                                AppState.onscreen-keyboard-target = "login-username";
                                AppState.onscreen-keyboard-cursor = 0;
                            }
                        }
                    }
                    key-pressed(event) => {
                        if event.text == "\u{1b}" && AppState.login-append-mode {
                            AppState.cancel-add-account();
                            return accept;
                        }
                        if event.text == "\u{F700}" {
                            server-input.focus();
                            return accept;
                        }
                        if event.text == "\u{F701}" {
                            pass-input.focus();
                            return accept;
                        }
                        if event.text == "\u{000a}" {
                            // On-screen keyboard off in Settings: Enter moves on to Password.
                            if !AppState.open-onscreen-keyboard("login-username") {
                                pass-input.focus();
                            }
                            return accept;
                        }
                        return reject;
                    }
                }
            }

            pass-field-wrap := FieldFocusWrap {
                focused: AppState.show-onscreen-keyboard && AppState.login-zone == 2;
                pass-input := LineEdit {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    placeholder-text: "Password";
                    input-type: password;
                    // No `accepted =>`: the Enter branch in key-pressed below returns accept first, so it would
                    // never fire. Enter opens the on-screen keyboard, or with it off presses Connect.
                    changed has-focus => {
                        if self.has-focus {
                            AppState.login-zone = 2;
                            // See server-input's own identical handler above.
                            if AppState.show-onscreen-keyboard {
                                AppState.onscreen-keyboard-target = "login-password";
                                AppState.onscreen-keyboard-cursor = 0;
                            }
                        }
                    }
                    key-pressed(event) => {
                        if event.text == "\u{1b}" && AppState.login-append-mode {
                            AppState.cancel-add-account();
                            return accept;
                        }
                        if event.text == "\u{F700}" {
                            user-input.focus();
                            return accept;
                        }
                        // Down leaves native LineEdit focus entirely — hands off
                        // to the zone 3/4 raw-key tier in keys.rs, which can only
                        // ever see keys once nothing holds real Slint focus (the
                        // global fs FocusScope is a sibling of this screen, not
                        // an ancestor — see app_state.slint's login-zone doc
                        // comment). AppState.refocus() re-grabs it.
                        if event.text == "\u{F701}" {
                            AppState.login-zone = 3;
                            AppState.refocus();
                            return accept;
                        }
                        // Enter opens the on-screen keyboard like the other two fields.
                        if event.text == "\u{000a}" {
                            // On-screen keyboard off in Settings: Enter presses Connect.
                            if !AppState.open-onscreen-keyboard("login-password") {
                                AppState.do-login(server-input.text, user-input.text, pass-input.text, AppState.login-append-mode, AppState.login-remember);
                            }
                            return accept;
                        }
                        return reject;
                    }
                }
            }

            remember-row := Rectangle {
                // Explicit x/y for both children instead of a HorizontalLayout (padding tweaks never
                // aligned it) — the same fix as ProfileEditScreen's "Skip PIN on this network" row.
                height: 36px;
                border-radius: Theme.radius;
                border-width: AppState.login-zone == 3 ? 2px : 0px;
                border-color: Theme.focus-border;
                animate border-width {
                    duration: 90ms * AppState.settings-animation-speed;
                    easing: ease-out-expo;
                }
                Text {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    text: "Remember this login";
                    color: Theme.text-muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                ToggleSwitch {
                    x: parent.width - self.width - 12px;
                    y: (parent.height - self.height) / 2;
                    checked: AppState.login-remember;
                    toggled => {
                        AppState.login-zone = 3;
                        AppState.login-remember = !AppState.login-remember;
                    }
                }
            }

            connect-btn := FjordButton {
                text: "Connect";
                kbd-focused: AppState.login-zone == 4;
                clicked => {
                    AppState.login-zone = 4;
                    AppState.do-login(server-input.text, user-input.text, pass-input.text, AppState.login-append-mode, AppState.login-remember);
                }
            }

            if AppState.status != "": Text {
                text: AppState.status;
                color: Theme.text-muted;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    FjordButton {
        text: "Quit";
        width: 90px;
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        // Zone 6, 2026-08-21 — see this file's own header doc comment.
        kbd-focused: AppState.login-zone == 6;
        clicked => {
            AppState.login-zone = 6;
            AppState.quit();
        }
    }

    if AppState.login-append-mode: FjordButton {
        // Just "Back": it always undoes this Add Account attempt and returns to wherever it was
        // opened from, so naming a destination could only drift out of date.
        text: "← Back";
        width: 110px;
        x: 16px;
        y: 16px;
        // Zone 5, 2026-08-21 — see this file's own header doc comment.
        kbd-focused: AppState.login-zone == 5;
        clicked => {
            AppState.login-zone = 5;
            AppState.cancel-add-account();
        }
    }

    // On-screen alphanumeric keyboard, positioned below the card so the field stays visible.
    // Dispatches on onscreen-keyboard-target; this per-field chain is the screen-specific glue
    // (other screens have their own). A named function so physical keystrokes
    // (_physical-key-mirror below) share it.
    function dispatch-onscreen-key(k: string) {
        if k == "done" {
            AppState.show-onscreen-keyboard = false;
        } else if AppState.onscreen-keyboard-target == "login-server" {
            // At the keyboard's own caret (◀ ▶ move it, 2026-10-05).
            let r = AppState.onscreen-keyboard-edit(server-input.text, AppState.onscreen-keyboard-caret, k);
            server-input.text = r.text;
            AppState.onscreen-keyboard-caret = r.caret;
            server-input.set-selection-offsets(r.byte, r.byte);
        } else if AppState.onscreen-keyboard-target == "login-username" {
            // At the keyboard's own caret (◀ ▶ move it, 2026-10-05).
            let r = AppState.onscreen-keyboard-edit(user-input.text, AppState.onscreen-keyboard-caret, k);
            user-input.text = r.text;
            AppState.onscreen-keyboard-caret = r.caret;
            user-input.set-selection-offsets(r.byte, r.byte);
        } else if AppState.onscreen-keyboard-target == "login-password" {
            // Masking follows .text however it was set. Edits at the keyboard's caret (◀ ▶ move it).
            let r = AppState.onscreen-keyboard-edit(pass-input.text, AppState.onscreen-keyboard-caret, k);
            pass-input.text = r.text;
            AppState.onscreen-keyboard-caret = r.caret;
            pass-input.set-selection-offsets(r.byte, r.byte);
        }
    }

    if AppState.show-onscreen-keyboard && AppState.settings-onscreen-keyboard-enabled: QwertyKeyboard {
        x: (parent.width - self.width) / 2;
        y: card.y + card.height + 16px;
        cursor: AppState.onscreen-keyboard-cursor;
        active: AppState.show-onscreen-keyboard;
        key-pressed(k) => { root.dispatch-onscreen-key(k); }
    }

    // Restores real native focus to the right field the instant the
    // keyboard closes (Done). login-zone itself doesn't change while the
    // keyboard is open, so _zone-mirror's own `changed` wouldn't refire
    // here — this needs its own tracker on show-onscreen-keyboard instead.
    property <bool> _kb-close-mirror: AppState.show-onscreen-keyboard;
    changed _kb-close-mirror => {
        if !_kb-close-mirror {
            if AppState.login-zone == 0 { server-input.focus(); }
            else if AppState.login-zone == 1 { user-input.focus(); }
            else if AppState.login-zone == 2 { pass-input.focus(); }
        }
    }

    // Physical-keyboard passthrough: keys.rs forwards printable keys and Backspace while the
    // keyboard is open (onscreen-keyboard-physical-key/-seq); mirrored here (`changed` only sees
    // this component's properties) into the same dispatch-onscreen-key the mouse and the grid
    // use.
    property <int> _physical-key-mirror: AppState.onscreen-keyboard-physical-key-seq;
    changed _physical-key-mirror => {
        if AppState.show-onscreen-keyboard {
            root.dispatch-onscreen-key(AppState.onscreen-keyboard-physical-key);
        }
    }

    // Zones 0-2's own native LineEdit focus is entered via .focus() calls
    // Rust can't make directly (it can only *set* login-zone) — this local
    // mirror + changed tracker performs the call whenever Rust sets the
    // zone back down into 0/1/2 (the Up-from-Remember path in keys.rs).
    // Same idiom as ProfileEditScreen's own _text-editing-mirror.
    property <int> _zone-mirror: AppState.login-zone;
    changed _zone-mirror => {
        if _zone-mirror == 0 { server-input.focus(); }
        else if _zone-mirror == 1 { user-input.focus(); }
        else if _zone-mirror == 2 { pass-input.focus(); }
    }

    // Zone 4's D-pad Enter (keys.rs) bumps kb-activate-pulse instead of calling do-login —
    // Rust can't read the live LineEdit.text. Same idiom as ProfileEditScreen's _pulse-mirror.
    property <int> _pulse-mirror: AppState.kb-activate-pulse;
    changed _pulse-mirror => {
        if AppState.show-login && AppState.login-zone == 4 {
            AppState.do-login(server-input.text, user-input.text, pass-input.text, AppState.login-append-mode, AppState.login-remember);
        }
    }
}
