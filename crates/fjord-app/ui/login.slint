// ── fjord-app · login.slint ──────────────────────────────────────────────────
//   LoginScreen  server URL + username + password fields; submits via AppState.do-login
//                (4th bool arg is login-append-mode, 5th is login-remember — see
//                app_state.slint); a "Remember this login" toggle (2026-08-14, the
//                account/profile redesign — persisted onto the resulting profile's
//                remember_login) defaults checked, matching today's existing implicit
//                behavior; small Quit button bottom-right corner (Ctrl+Q also works,
//                keys.rs); a floating "← Back"/"Cancel" corner button shows whenever
//                login-append-mode is set (label depends on login-append-source — see
//                that property's own doc comment) — cancel-add-account() closes
//                LoginScreen and returns to wherever it came from without touching any
//                already-signed-in profile. server-input.text/user-input.text bind to
//                login-server-prefill/login-username-prefill (2026-08-14/2026-08-15, the
//                RequireLogin StartupGate outcome pre-fills a known account's own server
//                address AND username — only the password genuinely needs re-entry).
//                init => grabs native focus into server-input (or pass-input, on a
//                RequireLogin re-prompt where the first two are already known) so
//                typing works immediately.
//
//   Full D-pad keyboard navigation, 2026-08-19 — live pushback ("why?") on a prior
//   claim that "no D-pad path to the Remember-toggle/Connect button" was an accepted
//   scope boundary; the exact zone-based pattern already proven this session for
//   ProfileEditScreen (see app_state.slint's login-zone doc comment for the full
//   design) is reused here now that the marginal cost is low. 5 zones: 0=server
//   1=username 2=password (native LineEdit focus, Tab already cycles these 3) then
//   3=Remember toggle 4=Connect button (no native focus — reached via each field's
//   own key-pressed hook calling AppState.refocus() + setting login-zone, and
//   returned-to via the _zone-mirror tracker below calling the right field's own
//   .focus() — Rust can't call a named Slint element's method directly). The header
//   "← Back"/"Cancel" button and Quit are deliberately NOT zones — Escape/Ctrl+Q
//   already reach them from any zone, matching ProfileEditScreen's own precedent for
//   not zoning its header ✕ either.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import { FjordButton, ToggleSwitch } from "widgets.slint";
import { LineEdit } from "std-widgets.slint";

export component LoginScreen inherits Rectangle {
    background: Theme.bg;

    // Real gap, live-reported 2026-08-14 ("login screen dont have keybord
    // nav"): nothing ever grabbed native keyboard focus into the first
    // field when this screen appeared, so typing/Tab did nothing at all
    // until the user first clicked into a field with the mouse. `init =>`
    // runs once when the element is created — which for this screen is
    // exactly "whenever it's shown", since it's an AppShell-sibling
    // instant-mount/unmount screen (see CLAUDE.md's FadeGate-safety note:
    // Login is one of the sites deliberately left on plain instant
    // mount/unmount, not FadeGate, so `init` fires fresh on every show).
    //
    // Real bug, live-reported 2026-08-17: "when trying to connect to the
    // accaunt you are focused on the server not the password so you first
    // need to navigate to the password to fill it in" — a RequireLogin
    // re-prompt (server + username both already known/pre-filled, only the
    // password genuinely needs retyping) still unconditionally focused
    // Server first, forcing an unnecessary Tab through two already-correct
    // fields. Focus now lands on whichever field the user actually needs
    // to type into.
    init => {
        AppState.login-zone = 0;
        if AppState.login-server-prefill != "" && AppState.login-username-prefill != "" {
            AppState.login-zone = 2;
            pass-input.focus();
        } else {
            server-input.focus();
        }
    }

    card := Rectangle {
        width:         min(420px, parent.width - 48px);
        height:        inner.preferred-height;
        x:             (parent.width  - self.width)  / 2;
        y:             (parent.height - self.height) / 2 - 24px;
        background:    Theme.surface;
        border-radius: Theme.radius-lg;
        drop-shadow-blur:  28px;
        drop-shadow-color: #00000070;

        inner := VerticalLayout {
            padding: Theme.sp-xl;
            spacing: Theme.sp;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text:                 "FJORD";
                    color:                Theme.accent;
                    font-size:            38px;
                    font-weight:          700;
                    horizontal-alignment: center;
                }
                Text {
                    text:                 "Jellyfin media player";
                    color:                Theme.text-muted;
                    font-size:            13px;
                    horizontal-alignment: center;
                }
            }

            Rectangle { height: 6px; }

            server-input := LineEdit {
                // A bare host/IP (no scheme) works now too — do_login tries
                // https then http automatically, live-reported 2026-08-14.
                // Still shown with a scheme in the example since a raw IP:port
                // is the one case (a local server with no real TLS cert) where
                // typing http:// explicitly saves the wasted first attempt.
                placeholder-text: "Server (e.g. jellyfin.example.com or 192.168.1.10:8096)";
                text: AppState.login-server-prefill;
                height: 40px;
                changed has-focus => {
                    if self.has-focus { AppState.login-zone = 0; }
                }
                key-pressed(event) => {
                    if event.text == "\u{1b}" && AppState.login-append-mode {
                        AppState.cancel-add-account();
                        return accept;
                    }
                    // Down leaves the field entirely (native focus moves to
                    // user-input, which itself picks up login-zone=1 via its
                    // own changed has-focus above) — Up has nowhere to go
                    // from the very first field, left unhandled (falls
                    // through to Slint's own native LineEdit behavior, a
                    // no-op for Up in a single-line field).
                    if event.text == "\u{F701}" {
                        user-input.focus();
                        return accept;
                    }
                    return reject;
                }
            }
            user-input := LineEdit {
                placeholder-text: "Username";
                text: AppState.login-username-prefill;
                height: 40px;
                changed has-focus => {
                    if self.has-focus { AppState.login-zone = 1; }
                }
                key-pressed(event) => {
                    if event.text == "\u{1b}" && AppState.login-append-mode {
                        AppState.cancel-add-account();
                        return accept;
                    }
                    if event.text == "\u{F700}" {
                        server-input.focus();
                        return accept;
                    }
                    if event.text == "\u{F701}" {
                        pass-input.focus();
                        return accept;
                    }
                    return reject;
                }
            }
            pass-input := LineEdit {
                placeholder-text: "Password";
                input-type:       password;
                height:           40px;
                accepted => {
                    AppState.do-login(server-input.text, user-input.text, pass-input.text, AppState.login-append-mode, AppState.login-remember);
                }
                changed has-focus => {
                    if self.has-focus { AppState.login-zone = 2; }
                }
                key-pressed(event) => {
                    if event.text == "\u{1b}" && AppState.login-append-mode {
                        AppState.cancel-add-account();
                        return accept;
                    }
                    if event.text == "\u{F700}" {
                        user-input.focus();
                        return accept;
                    }
                    // Down leaves native LineEdit focus entirely — hands off
                    // to the zone 3/4 raw-key tier in keys.rs, which can only
                    // ever see keys once nothing holds real Slint focus (the
                    // global fs FocusScope is a sibling of this screen, not
                    // an ancestor — see app_state.slint's login-zone doc
                    // comment). AppState.refocus() re-grabs it.
                    if event.text == "\u{F701}" {
                        AppState.login-zone = 3;
                        AppState.refocus();
                        return accept;
                    }
                    return reject;
                }
            }

            remember-row := Rectangle {
                height: 36px;
                border-radius: Theme.radius;
                border-width: AppState.login-zone == 3 ? 2px : 0px;
                border-color: Theme.focus-border;
                animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: Theme.sp;
                    Text {
                        text:               "Remember this login";
                        color:              Theme.text-muted;
                        font-size:          13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    ToggleSwitch {
                        checked: AppState.login-remember;
                        toggled => {
                            AppState.login-zone = 3;
                            AppState.login-remember = !AppState.login-remember;
                        }
                    }
                }
            }

            connect-btn := FjordButton {
                text: "Connect";
                kbd-focused: AppState.login-zone == 4;
                clicked => {
                    AppState.login-zone = 4;
                    AppState.do-login(server-input.text, user-input.text, pass-input.text, AppState.login-append-mode, AppState.login-remember);
                }
            }

            if AppState.status != "": Text {
                text:                 AppState.status;
                color:                Theme.text-muted;
                font-size:            13px;
                horizontal-alignment: center;
                wrap:                 word-wrap;
            }
        }
    }

    FjordButton {
        text:   "Quit";
        width:  90px;
        x:      parent.width  - self.width  - 16px;
        y:      parent.height - self.height - 16px;
        clicked => { AppState.quit(); }
    }

    if AppState.login-append-mode: FjordButton {
        // Real bug, live-reported 2026-08-18: the label used to name the
        // actual destination ("← Back to Profiles" when opened from the
        // account picker) — but on_cancel_add_account's own real behavior
        // for that source is to reopen the ACCOUNT picker, not the
        // profile-tier one, so the label was flatly wrong. Per the user's
        // own suggestion: don't name a destination at all, just say
        // "Back" — the button always does exactly one thing (undo this
        // Add Account attempt, return to wherever it was opened from),
        // so there's nothing destination-specific worth stating, and no
        // way for wording to drift out of sync with behavior again.
        text:   "← Back";
        width:  110px;
        x:      16px;
        y:      16px;
        clicked => { AppState.cancel-add-account(); }
    }

    // Zones 0-2's own native LineEdit focus is entered via .focus() calls
    // Rust can't make directly (it can only *set* login-zone) — this local
    // mirror + changed tracker performs the call whenever Rust sets the
    // zone back down into 0/1/2 (the Up-from-Remember path in keys.rs).
    // Same idiom as ProfileEditScreen's own _text-editing-mirror.
    property <int> _zone-mirror: AppState.login-zone;
    changed _zone-mirror => {
        if _zone-mirror == 0 { server-input.focus(); }
        else if _zone-mirror == 1 { user-input.focus(); }
        else if _zone-mirror == 2 { pass-input.focus(); }
    }

    // Zone 4's own D-pad Enter (keys.rs's zone 3/4 tier) bumps the shared
    // kb-activate-pulse counter rather than calling do-login directly —
    // Rust can't read live LineEdit.text to build that call itself. Same
    // "changed on the shared pulse counter, guarded by this screen's own
    // show flag + zone" idiom as ProfileEditScreen's own _pulse-mirror.
    property <int> _pulse-mirror: AppState.kb-activate-pulse;
    changed _pulse-mirror => {
        if AppState.show-login && AppState.login-zone == 4 {
            AppState.do-login(server-input.text, user-input.text, pass-input.text, AppState.login-append-mode, AppState.login-remember);
        }
    }
}
