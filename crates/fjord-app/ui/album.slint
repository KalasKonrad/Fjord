// ── fjord-app · album.slint ───────────────────────────────────────────────────
//   AlbumScreen  MusicAlbum detail: cover art + metadata + tracklist
//                album-focused-track: int (focused track index)
//                album-back-focused: bool (Back button has focus)
//                album-btn-focused: int (-1=none, 0=▶ Play All, 1=♥, 2=bio)
//                album-overview-expanded: bool (collapsible bio below header)
//                Enter on track → play-album-track; C → open-context-menu
//                ♥/✓ buttons toggle fav/played
//                ▶ Play All button → play-album-all callback
//                Back → close-album
//                Multi-disc separators (2026-08-17): track rows are absolutely
//                positioned via each TrackItem's precomputed row-y-px (not a
//                VerticalLayout) so a variable-height "Disc N" label can sit
//                above a disc's first track; kb-track-y/tracks-content-h read
//                the model directly (O(1) index) instead of summing separator
//                heights in Slint — see TrackItem's own doc comment (theme.slint)
//                and album.rs::media_items_to_tracks for the Rust-side half.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import { FjordButton, IconCircleButton, StorylineSection, PressPulse } from "widgets.slint";

export component AlbumScreen inherits Rectangle {

    property <length> track-h: 48px;
    // Must match SectionHeader's own fixed 28px height (widgets.slint) — the
    // disc-separator label below reuses that same visual convention, and
    // album.rs::media_items_to_tracks's DISC_SEP_H_PX has to agree with this
    // literal by hand (no shared source of truth between the two files).
    property <length> sep-h: 28px;
    property <length> header-h: 240px;
    // 130px = StorylineSection collapsed (44px header + 66px preview + 20px padding)
    property <length> bio-h: AppState.album-overview != "" ? 130px : 0px;

    // Total scrollable content height, from the last track's own
    // precomputed row-y-px (2026-08-17, multi-disc separators — see
    // TrackItem's own doc comment in theme.slint) plus its row height —
    // already accounts for every disc-header's extra height above it.
    property <length> tracks-content-h: AppState.album-tracks.length > 0
        ? AppState.album-tracks[AppState.album-tracks.length - 1].row-y-px * 1px + track-h
        : 0px;
    // Single O(1) indexed read of the focused row's own precomputed
    // position — deliberately not summing separator heights in Slint on
    // every keystroke; album.rs already did that once when the model was
    // built. min(...) guards a transient focused-track index past the
    // model's current bounds (e.g. between a screen open and the first
    // model push) the same way this file's other kb-y-style clamps do.
    pure function focused-track-y() -> length {
        if AppState.album-tracks.length == 0 {
            return 0px;
        }
        return AppState.album-tracks[min(AppState.album-focused-track, AppState.album-tracks.length - 1)].row-y-px * 1px;
    }

    // Keyboard-driven scroll of the track list
    property <length> list-area-h: root.height - header-h - 54px - bio-h; // 54px = top bar
    property <length> kb-track-y: clamp(
        -focused-track-y() + list-area-h / 2 - track-h / 2,
        min(0px, list-area-h - tracks-content-h),
        0px
    );
    changed kb-track-y => { track-fl.viewport-y = kb-track-y; }

    fl := Flickable {
        width:           parent.width;
        height:          parent.height;
        viewport-height: album-content.preferred-height;
        viewport-width:  self.width;
        animate viewport-y { duration: 200ms * AppState.settings-scroll-speed; easing: ease-in-out; }

        album-content := VerticalLayout {

            // ── Top bar: Back button + title ──────────────────────────────────
            Rectangle {
                height:     54px;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left:  Theme.sp-sm;
                    padding-right: Theme.sp;
                    spacing:       Theme.sp-sm;
                    alignment:     start;
                    FjordButton {
                        text:        "← Back";
                        width:       80px;
                        kbd-focused: AppState.album-back-focused;
                        clicked => { AppState.close-album(); }
                    }
                    Text {
                        text:               AppState.album-title;
                        color:              Theme.text;
                        font-size:          17px;
                        font-weight:        700;
                        vertical-alignment: center;
                        overflow:           elide;
                        horizontal-stretch: 1;
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }

            // ── Header: cover art + metadata + buttons ────────────────────────
            Rectangle {
                height: header-h;
                background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.surface;

                HorizontalLayout {
                    padding: Theme.sp-lg;
                    spacing: Theme.sp-lg;

                    // Album cover art (square)
                    Rectangle {
                        width:         200px;
                        height:        200px;
                        border-radius: Theme.radius;
                        background:    Theme.surface-overlay;
                        clip:          true;
                        if AppState.album-has-poster: Image {
                            width:     parent.width;
                            height:    parent.height;
                            image-fit: cover;
                            source:    AppState.album-poster;
                        }
                        if !AppState.album-has-poster: Text {
                            text:                 "♫";
                            font-family:          "Noto Sans Symbols 2";
                            color:                Theme.text-subtle;
                            font-size:            64px;
                            vertical-alignment:   center;
                            horizontal-alignment: center;
                            width:                parent.width;
                            height:               parent.height;
                        }
                    }

                    // Metadata + buttons
                    VerticalLayout {
                        alignment:          start;
                        spacing:            8px;
                        vertical-stretch:   1;
                        padding-top:        8px;

                        Text {
                            text:        AppState.album-title;
                            color:       Theme.text;
                            font-size:   22px;
                            font-weight: 700;
                            overflow:    elide;
                        }
                        Text {
                            text:      AppState.album-artist;
                            color:     Theme.accent;
                            font-size: 15px;
                            overflow:  elide;
                        }
                        Text {
                            text:      AppState.album-meta;
                            color:     Theme.text-muted;
                            font-size: 13px;
                        }

                        Rectangle { vertical-stretch: 1; }

                        // ▶ Play All + ♥ action buttons
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            FjordButton {
                                icon-left:   "▶";
                                text:        "Play All";
                                height:      34px;
                                width:       110px;
                                kbd-focused: AppState.album-btn-focused == 0;
                                clicked => { AppState.play-album-all(); }
                            }
                            IconCircleButton {
                                icon:        "❤";
                                active:      AppState.album-is-favorite;
                                kbd-focused: AppState.album-btn-focused == 1;
                                clicked => { AppState.toggle-album-fav(); }
                            }
                        }
                    }
                }
            }

            // ── Overview / bio (collapsible) ──────────────────────────────────
            if AppState.album-overview != "": StorylineSection {
                text:        AppState.album-overview;
                expanded <=> AppState.album-overview-expanded;
                kbd-focused: AppState.album-btn-focused == 2;
            }

            // ── Track list ────────────────────────────────────────────────────
            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Rectangle {
                height: list-area-h - 1px;

                track-fl := Flickable {
                    width:           parent.width;
                    height:          parent.height;
                    viewport-height: max(parent.height, tracks-content-h);
                    viewport-width:  self.width;
                    animate viewport-y { duration: 150ms * AppState.settings-scroll-speed; easing: ease-out-expo; }

                    // Absolutely positioned via each row's own precomputed
                    // row-y-px (2026-08-17, multi-disc separators) instead of
                    // a VerticalLayout's automatic uniform-height stacking —
                    // rows aren't all the same height once a disc-header
                    // label is involved, so the layout can't compute this
                    // for us; album.rs already did the real math once.
                    for trk[i] in AppState.album-tracks: Rectangle {
                            property <bool> focused: !AppState.album-back-focused && AppState.album-btn-focused < 0 && i == AppState.album-focused-track;
                            x:          0px;
                            y:          trk.row-y-px * 1px;
                            width:      parent.width;
                            height:     track-h;
                            background: focused ? Theme.accent-muted : (ta.has-hover ? Theme.surface : transparent);
                            border-width:  (ta.pressed || track-pulse.pulsing) ? 3px : 0px;
                            border-color:  Theme.focus-border;
                            animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                            track-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: focused; }

                            ta := TouchArea {
                                double-clicked => { AppState.play-album-track(trk.id); }
                                clicked => {
                                    AppState.album-focused-track = i;
                                    AppState.album-back-focused  = false;
                                    AppState.album-btn-focused   = -1;
                                }
                            }

                            // Disc separator — positioned relative to this
                            // row's own (already-correct) y, in the gap
                            // album.rs's own row-y-px math reserved for it.
                            if trk.disc-header != "": Rectangle {
                                x: 0px; y: -sep-h;
                                width:      parent.width;
                                // Deliberately transparent, not a solid fill
                                // — matches the ambient (unfocused/unhovered)
                                // track row background right below it, since
                                // AlbumScreen's own root has no explicit
                                // background of its own either.
                                height:     sep-h;
                                Text {
                                    x:                  16px;
                                    text:               trk.disc-header;
                                    color:              Theme.accent;
                                    font-size:          11px;
                                    font-weight:        700;
                                    vertical-alignment: center;
                                    height:             parent.height;
                                }
                            }

                            // left accent bar (focused indicator)
                            if focused: Rectangle {
                                x: 0; y: 0;
                                width:      3px;
                                height:     parent.height;
                                background: Theme.accent;
                            }
                            // bottom separator
                            Rectangle {
                                x: 0; y: parent.height - 1px;
                                height:     1px;
                                background: Theme.border;
                            }

                            HorizontalLayout {
                                padding-left:  16px;
                                padding-right: 20px;
                                spacing:       14px;
                                alignment:     start;

                                // Track number
                                Text {
                                    text:                 trk.track-number > 0 ? trk.track-number : i + 1;
                                    color:                trk.has-played ? Theme.accent : Theme.text-muted;
                                    font-size:            13px;
                                    width:                24px;
                                    vertical-alignment:   center;
                                    horizontal-alignment: right;
                                }

                                // Title + artist
                                VerticalLayout {
                                    alignment:          center;
                                    horizontal-stretch: 1;
                                    spacing:            2px;
                                    Text {
                                        text:      trk.title;
                                        color:     trk.has-played ? Theme.text-muted : Theme.text;
                                        font-size: 14px;
                                        overflow:  elide;
                                    }
                                    if trk.artist != "" && trk.artist != AppState.album-artist: Text {
                                        text:      trk.artist;
                                        color:     Theme.text-subtle;
                                        font-size: 11px;
                                        overflow:  elide;
                                    }
                                }

                                // Duration
                                Text {
                                    text:               trk.duration;
                                    color:              Theme.text-muted;
                                    font-size:          13px;
                                    vertical-alignment: center;
                                    width:              44px;
                                    horizontal-alignment: right;
                                }

                                // Favorite indicator
                                if trk.is-favorite: Text {
                                    text:               "♥";
                                    font-family:        "Adwaita Sans";
                                    color:              Theme.accent;
                                    font-size:          12px;
                                    vertical-alignment: center;
                                    width:              16px;
                                }

                                // ✕ remove entry — playlists only
                                if AppState.album-is-playlist: Rectangle {
                                    width: 26px;
                                    border-width:  x-ta.pressed ? 3px : 0px;
                                    border-color:  Theme.error;
                                    border-radius: Theme.radius;
                                    animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                                    x-ta := TouchArea {
                                        clicked => { AppState.playlist-remove-entry(i); }
                                    }
                                    Text {
                                        text:                 "✕";
                                    font-family:          "Noto Sans Symbols 2";
                                        color:                x-ta.has-hover ? Theme.error : Theme.text-subtle;
                                        font-size:            13px;
                                        vertical-alignment:   center;
                                        horizontal-alignment: center;
                                        width:                parent.width;
                                        height:               parent.height;
                                    }
                                }
                            }
                    }
                }
            }
        }
    }
}
