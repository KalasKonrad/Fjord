// ── fjord-app · album.slint ───────────────────────────────────────────────────
//   AlbumScreen  MusicAlbum detail: floating ← Back at x/y 16 (like the Artist page; no top bar —
//                the title is in the header), cover art + metadata + tracklist
//                album-focused-track: int (focused track index)
//                album-back-focused: bool (Back button has focus)
//                album-btn-focused: int (-1=none, 0=▶ Play All, 1=♥, 2=bio)
//                album-overview-expanded: bool (collapsible bio below header)
//                Enter on track → play-album-track; C → open-context-menu
//                ♥/✓ buttons toggle fav/played
//                ▶ Play All button → play-album-all callback
//                Back → close-album
//                Multi-disc separators: track rows are positioned by each TrackItem's
//                precomputed row-y-px (not a VerticalLayout) so a "Disc N" label can sit
//                above a disc's first track; kb-track-y/tracks-content-h read the model by
//                index (album.rs::media_items_to_tracks computes the values).
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import {
    StackPage,
    TrackRow,
    FjordButton,
    IconCircleButton,
    StorylineSection,
} from "widgets.slint";

export component AlbumScreen inherits StackPage {

    property <length> track-h: 48px;
    // Must match SectionHeader's own fixed 28px height (widgets.slint) — the
    // disc-separator label below reuses that same visual convention, and
    // album.rs::media_items_to_tracks's DISC_SEP_H_PX has to agree with this
    // literal by hand (no shared source of truth between the two files).
    property <length> sep-h: 28px;
    // 70px of room at the top for the floating Back (16 + 38 + 16 — where every page has it), the
    // 200px cover, 20px under it.
    property <length> header-h: 290px;
    // 130px = StorylineSection collapsed (44px header + 66px preview + 20px padding)
    property <length> bio-h: AppState.album-overview != "" ? 130px : 0px;

    // Total scrollable height: the last track's precomputed row-y-px (includes every disc header
    // above it, see TrackItem in theme.slint) plus its row height.
    property <length> tracks-content-h: AppState.album-tracks.length > 0
        ? AppState.album-tracks[AppState.album-tracks.length - 1].row-y-px * 1px + track-h
        : 0px;
    // Single O(1) indexed read of the focused row's own precomputed
    // position — deliberately not summing separator heights in Slint on
    // every keystroke; album.rs already did that once when the model was
    // built. min(...) guards a transient focused-track index past the
    // model's current bounds (e.g. between a screen open and the first
    // model push) the same way this file's other kb-y-style clamps do.
    pure function focused-track-y() -> length {
        if AppState.album-tracks.length == 0 {
            return 0px;
        }
        return AppState.album-tracks[min(AppState.album-focused-track, AppState.album-tracks.length - 1)].row-y-px * 1px;
    }

    // Keyboard-driven scroll of the track list
    property <length> list-area-h: root.height - header-h - bio-h;
    property <length> kb-track-y: clamp(
        -focused-track-y() + list-area-h / 2 - track-h / 2,
        min(0px, list-area-h - tracks-content-h),
        0px);
    changed kb-track-y => { track-fl.content-y = kb-track-y; }

    fl := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: album-content.preferred-height;
        content-width: self.width;
        animate content-y {
            duration: 200ms * AppState.settings-scroll-speed;
            easing: ease-in-out;
        }

        album-content := VerticalLayout {

            // ── Header: cover art + metadata + buttons ────────────────────────
            Rectangle {
                height: header-h;
                background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.surface;

                HorizontalLayout {
                    padding: Theme.sp-lg;
                    padding-top: 70px;
                    spacing: Theme.sp-lg;

                    // Album cover art (square)
                    Rectangle {
                        width: 200px;
                        height: 200px;
                        border-radius: Theme.radius;
                        background: Theme.surface-overlay;
                        clip: true;
                        if AppState.album-has-poster: Image {
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            source: AppState.album-poster;
                        }
                        if !AppState.album-has-poster: Text {
                            text: "♫";
                            font-family: "Noto Sans Symbols 2";
                            color: Theme.text-subtle;
                            font-size: 64px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }

                    // Metadata + buttons
                    VerticalLayout {
                        alignment: start;
                        spacing: 8px;
                        vertical-stretch: 1;
                        padding-top: 8px;

                        Text {
                            text: AppState.album-title;
                            color: Theme.text;
                            font-size: 22px * AppState.text-scale;
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            text: AppState.album-artist;
                            color: Theme.accent;
                            font-size: 15px * AppState.text-scale;
                            overflow: elide;
                        }

                        Text {
                            text: AppState.album-meta;
                            color: Theme.text-muted;
                            font-size: 13px * AppState.text-scale;
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }

                        // ▶ Play All + ♥ action buttons
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            FjordButton {
                                icon-left: "▶";
                                text: "Play All";
                                height: 34px;
                                width: 110px * AppState.text-scale;
                                kbd-focused: AppState.album-btn-focused == 0;
                                clicked => { AppState.play-album-all(); }
                            }

                            IconCircleButton {
                                icon: "❤";
                                active: AppState.album-is-favorite;
                                kbd-focused: AppState.album-btn-focused == 1;
                                clicked => { AppState.toggle-album-fav(); }
                            }
                        }
                    }
                }
            }

            // ── Overview / bio (collapsible) ──────────────────────────────────
            if AppState.album-overview != "": StorylineSection {
                text: AppState.album-overview;
                expanded <=> AppState.album-overview-expanded;
                kbd-focused: AppState.album-btn-focused == 2;
            }

            // ── Track list ────────────────────────────────────────────────────
            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Rectangle {
                height: list-area-h - 1px;

                track-fl := Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: max(parent.height, tracks-content-h);
                    content-width: self.width;
                    animate content-y {
                        duration: 150ms * AppState.settings-scroll-speed;
                        easing: ease-out-expo;
                    }

                    // Positioned by each row's precomputed row-y-px, not a VerticalLayout: rows differ in height
                    // once a disc header is involved (album.rs does the math).
                    for trk[i] in AppState.album-tracks: TrackRow {
                        x: 0px;
                        y: trk.row-y-px * 1px;
                        width: parent.width;
                        height: track-h;
                        sep-h: sep-h;
                        track: trk;
                        index: i;
                        focused: !AppState.album-back-focused && AppState.album-btn-focused < 0 && i == AppState.album-focused-track;
                        page-artist: AppState.album-artist;
                        removable: AppState.album-is-playlist;
                        clicked => {
                            AppState.album-focused-track = i;
                            AppState.album-back-focused = false;
                            AppState.album-btn-focused = -1;
                        }
                        double-clicked => { AppState.play-album-track(trk.id); }
                        remove => { AppState.playlist-remove-entry(i); }
                    }
                }
            }
        }
    }

    // Floating Back, like the Artist page's (the title is in the header next to the cover).
    FjordButton {
        x: 16px;
        y: 16px;
        text: "← Back";
        width: 88px * AppState.text-scale;
        kbd-focused: AppState.album-back-focused;
        clicked => {
            AppState.close-album();
        }
    }
}
