        Rectangle {
            height: 54px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.sp;
                padding-right: Theme.sp;
                alignment: start;
                Text {
                    text: "Collections";
                    color: Theme.text;
                    font-size: 18px * AppState.text-scale;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // Dashboard hero (hero.slint): fixed above the rows, which scroll below it.
        if AppState.hero-active && AppState.hero-target().id != "": HeroBand {
            // Band: ~38% of the screen, but always room for one whole row below it. Background: just
            // the text (title, meta line, 3 lines of story), the picture is behind everything.
            height: AppState.hero-background ? 88px + 76px * AppState.text-scale
                : max(120px, min(clamp(root.height * 0.38, 200px, 460px), root.height - 54px - AppState.row-h(AppState.dash-ch) - 2 * Theme.sp-lg));
        }

        coll-fl-container := Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            property <length> kb-y: AppState.focused-section < 0 ? 0px
                : clamp(
                      root.height / 2 - section-y(AppState.focused-section) - (AppState.row-h(AppState.dash-ch)) / 2,
                      min(0px, root.height - coll-rows.preferred-height),
                      0px);
            changed kb-y => { coll-fl.content-y = kb-y; }

            coll-fl := Flickable {
                content-width: coll-fl-container.width;
                content-height: max(coll-fl-container.height, coll-rows.preferred-height);
                animate content-y {
                    duration: 150ms * AppState.settings-scroll-speed;
                    easing: ease-out-expo;
                }

                coll-rows := VerticalLayout {
                    padding: Theme.sp-lg;
                    padding-left: 0px;
                    padding-right: 0px;
                    padding-bottom: 0px;
                    spacing: 0px;

                    for s in root.row-order: Rectangle {
                        height: row-items(s).length > 0 ? AppState.row-h(AppState.dash-ch) + Theme.sp-lg : 0px;
                        if row-items(s).length > 0: SectionRow {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            section-title: row-title(s);
                            items: row-items(s);
                            section-focused: AppState.focused-section == s;
                            focused-card: AppState.focused-card;
                            card-w: AppState.dash-cw;
                            card-h: AppState.dash-ch;
                            item-play(id, it) => {
                                if row-is-discover(s) {
                                    AppState.open-discover-item(it == "DiscoverMovie" ? "movie" : "tv", id);
                                } else {
                                    AppState.item-play(id);
                                }
                            }
                            item-context(id, hp, fav, rp, it, sid) => {
                                if !row-is-discover(s) {
                                    AppState.open-context-menu(id, hp, fav, rp, it, sid);
                                }
                            }
                            item-context-full(itm) => {
                                if row-is-discover(s) {
                                    AppState.open-context-menu-discover(itm);
                                }
                            }
                        }
                    }

                    if recently-added.length == 0 && unwatched.length == 0: LoadingSpinner {
                        height: 120px;
                    }
                }
            }
        }
    }
}
