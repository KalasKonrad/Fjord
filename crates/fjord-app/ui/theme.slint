// ── fjord-app · theme.slint ──────────────────────────────────────────────────
//   Theme           global design tokens: colors (incl. focus-border, master-ring), spacing,
//                   radius, font sizes
//   Structs shared between Rust and Slint (one line each; details on the struct):
//   VideoRect       a video spot's logical position/size (HDR Stage 5)
//   OskEdit         text/caret/byte result of one on-screen-keyboard key
//   TrackEntry      audio / video / subtitle track row for the track panels
//   TrackItem       album/playlist track row (incl. disc-header/row-y-px for multi-disc albums)
//   CastMember      cast row entry (name, role, id, photo)
//   SeasonEntry     series season tab (id, name, played, is-favorite)
//   KeyBindingEntry key-binding editor row
//   CardItem        universal poster card (Jellyfin + Discover: availability, tier badges,
//                   request-id, on-watchlist)
//   SeasonItem / TagItem / ProfileItem  Discover request options: season card, Radarr/Sonarr
//                   tag, quality profile (row 0 = synthetic "Default")
//   GenreItem / ProviderItem  Discover filter chips (genre: movie + TV id)
//   StreamingProvider  request detail's "Currently Streaming On" entry
//   QueueEntry      queue panel row
//   LyricEntry      lyric line (start-ms 0 = no timestamps)
//   BlocklistRow    Manage Blocklist row (no poster)
//   ProfileTile / ProfileSection  profile picker tile and household row
//   AccountTile     account picker tile
//   BonfireGroupMemberTile  Bonfire Group screen member
//   ToggleListItem  ProfileEditScreen checklist row (libraries, devices)
//   BonfireAdminRow / BonfireAuditRow  Bonfire Admin mappings / audit-log rows
// ─────────────────────────────────────────────────────────────────────────────
// Fjord default theme — Jellyfin-inspired dark palette.
// Swap this file (or override properties at runtime) to change the whole UI.
export global Theme {
    // ── Backgrounds ───────────────────────────────────────────────────────────
    out property <color> bg:              #0d0d0d;
    out property <color> surface:         #1a1a1c;
    out property <color> surface-raised:  #242426;
    out property <color> surface-overlay: #2c2c2e;
    out property <color> sidebar-bg:      #111113;

    // ── Accent (Jellyfin blue) ────────────────────────────────────────────────
    out property <color> accent:          #00a4dc;
    out property <color> accent-hover:    #0090c4;
    out property <color> accent-muted:    #00a4dc40;  // ~25 % alpha

    // The one keyboard-focus/press border colour, everywhere (solid accent blended into
    // accent-tinted backgrounds like a focused SettingsRow or a checked ToggleSwitch).
    out property <color> focus-border:    #ffffff99;

    // Permanent ring on the household's master tile (ProfilePickerScreen). A different colour
    // from focus-border — both can show at once; gold collides with no other meaning
    // (accent = blue, error = red).
    out property <color> master-ring:     #f0b429;

    // ── Text ─────────────────────────────────────────────────────────────────
    out property <color> text:            #f2f2f7;
    out property <color> text-muted:      #8e8e93;
    out property <color> text-subtle:     #48484a;

    // ── Borders / separators ─────────────────────────────────────────────────
    out property <color> border:          #2c2c2e;
    out property <color> border-strong:   #3a3a3c;

    // ── Feedback ─────────────────────────────────────────────────────────────
    out property <color> error:           #ff453a;

    // ── Layout ───────────────────────────────────────────────────────────────
    out property <length> sidebar-width:  200px;
    out property <length> radius:         6px;
    out property <length> radius-lg:      12px;
    out property <length> sp-xs:          4px;
    out property <length> sp-sm:          8px;
    out property <length> sp:             14px;
    out property <length> sp-lg:          20px;
    out property <length> sp-xl:          32px;
}

// Where a video spot is on screen (HDR Stage 5): absolute position + size in logical px,
// reported by widgets.slint's VideoSpot for video_surface.rs to draw the video there.
export struct VideoRect {
    x: length,
    y: length,
    w: length,
    h: length,
}

// One on-screen-keyboard key applied at a caret (text_field::osk_edit,
// 2026-10-05): new text, caret (grapheme index), caret as a UTF-8 byte offset
// for LineEdit.set-selection-offsets.
export struct OskEdit {
    text: string,
    caret: int,
    byte: int,
}

// A single entry in a track-selection list (audio / subtitle / video).
export struct TrackEntry {
    id: int,
    label: string,
}

// One row in an album or playlist tracklist.
export struct TrackItem {
    id: string,
    title: string,
    artist: string,
    duration: string,   // "3:45"
    track-number: int,
    has-played: bool,
    is-favorite: bool,
    resume-pct: float,
    entry-id: string,   // PlaylistItemId — set for playlist rows, "" for album rows
    album-id: string,   // owning album id — music-bar art for playlist rows
    // Multi-disc albums: computed in Rust (album.rs::media_items_to_tracks) so album.slint's
    // kb-track-y can read one index instead of counting the separators above a row. Always ""
    // / the plain i*track-h stride for playlists.
    disc-header: string,   // "" = no separator above this row; else "Disc N" to show
    row-y-px: float,    // precomputed absolute Y (px) for this row, already
                            // accounting for every disc-header's own extra height
}

// A cast member shown on the detail page.
export struct CastMember {
    id: string,
    name: string,
    role: string,
    photo: image,
    has-photo: bool,
}

// A season entry in the series drill-down. played/is-favorite feed the season tab's context
// menu (Mark Watched/Unwatched, Favourite, View Details).
export struct SeasonEntry {
    id: string,
    name: string,
    played: bool,
    is-favorite: bool,
}

// One row in the key-binding editor (action display name + current key label).
export struct KeyBindingEntry {
    action: string,
    key: string,
}

// Passed from Rust for every poster card on any screen.
export struct CardItem {
    id: string,
    series-id: string,   // series ID for Episode cards; empty for movies/series
    item-type: string,
    title: string,
    subtitle: string,   // second card row: "S1:E3 - Title" / "2019 - Present" / artist / year
    year: int,      // numeric year kept for library sorting
    has-played: bool,
    is-favorite: bool,
    resume-pct: float,
    has-poster: bool,
    poster: image,
    unplayed-count: int,
    // Discover (Seerr) cards only, "" elsewhere: "requested" | "processing" | "partial" |
    // "available" | "blocklisted" | "" (requestable, no badge) — one more MediaCard badge pill.
    availability: string,
    // Discover "Requested" row only. Seerr tracks 2K and 4K independently
    // (fjord_seerr::MediaInfo): `requested-4k` labels the pill ("4K Requested");
    // `other-tier-available` adds "Available in 2K/4K" when the other tier is available;
    // `other-tier-requested` adds "Also requested in 2K/4K" when both are requested and neither
    // is available. Available wins when both apply.
    requested-4k: bool,
    other-tier-available: bool,
    other-tier-requested: bool,
    // Discover "Requested" row only: the Seerr MediaRequest id (the tmdb id stays in `id`, which
    // open-discover-item needs). Drives the context menu's Edit/Cancel/Approve/Decline.
    request-id: string,
    // request-pending: MediaRequest.status == Pending (the request's own
    // approval-workflow state — a DIFFERENT thing from `availability`
    // above, which reflects the media's fulfillment status; a request can
    // be Approved but still Processing, for example). request-mine:
    // requested_by == the connected account (true by construction unless
    // this is a multi-user Seerr instance where this account can also see
    // others' requests, i.e. has REQUEST_VIEW/MANAGE_REQUESTS). Both false
    // on every non-Requested-row card. Together with `seerr-is-admin`
    // (AppState) these pick which row family the Discover context menu
    // shows for a Requested-row card — see context_menu.slint's own doc
    // comment for the exact matrix.
    request-pending: bool,
    request-mine: bool,
    // Discover cards only: the context menu's Add/Remove Watchlist label and
    // RequestDetailScreen's Watchlist button.
    on-watchlist: bool,
}

// Discover (Seerr) request-detail screen only — one row per TV season.
export struct SeasonItem {
    season-number: int,
    name: string,
    episode-count: int,
    selected: bool,
    poster: image,
    has-poster: bool,
}

// Discover (Seerr) request-detail screen only — one row per available
// Radarr/Sonarr tag on the default server (empty list when none configured).
export struct TagItem {
    id: int,
    label: string,
    selected: bool,
}

// A Radarr/Sonarr quality profile row for the request-detail Profile picker
// — radio-select (exactly one, via request-detail-selected-profile-id), not
// one bool per row like TagItem's multi-select. Row 0 is always a synthetic
// "Default" entry (id: 0) prepended in Rust, not fetched from the server.
export struct ProfileItem {
    id: int,
    name: string,
}

// Discover Genre filter chip. Movie and TV genre ids differ even for same-named genres, so a
// chip (deduped by name) keeps both ids for discover_movies_filtered/discover_tv_filtered.
// 0 = none for that type (TMDB ids are > 0).
export struct GenreItem {
    movie-id: int,
    tv-id: int,
    name: string,
    selected: bool,
}

// Discover Provider filter chip — like GenreItem/TagItem, but provider ids are per region,
// not per media type, so one id.
export struct ProviderItem {
    id: int,
    name: string,
    selected: bool,
}

// Request detail's "Currently Streaming On": one flatrate provider for the resolved
// streaming region (resolve_streaming_region), with its TMDB logo.
export struct StreamingProvider {
    id: int,
    name: string,
    logo: image,
    has-logo: bool,
}

export struct QueueEntry {
    id: string,
    index: int,       // UNDERLYING position for queue-jump/-remove (playlist idx;
                           // playlist.len()+i for queued rows; -1 = synthetic now-playing row)
    title: string,
    artist: string,    // album artist or series name; empty for video
    is-current: bool,      // true when this is the currently playing item
    is-queued: bool,      // true for context-menu queue rows (play after the playlist)
    poster-id: string,    // ID used for poster fetch (album_art_id for audio, item id for video)
    has-poster: bool,
    poster: image,
}

export struct LyricEntry {
    text: string,
    start-ms: int,   // milliseconds from track start; 0 means no timestamp info
}

// One row of Manage Blocklist — text only (Seerr's BlocklistItem has no image).
// blocklisted-by/-at are formatted in Rust; blank when the source is (a tag-blocklisted
// entry, a legacy row without createdAt).
export struct BlocklistRow {
    tmdb-id: int,
    media-type: string,   // "movie" | "tv"
    title: string,
    blocklisted-by: string,
    blocklisted-at: string,
}

// ProfilePickerScreen's avatar-grid tile (Bonfire Phase 1, 2026-08-09).
// Named ProfileTile, not ProfileItem — that name is already taken by the
// unrelated Radarr/Sonarr quality-profile picker in RequestOptionsOverlay.
export struct ProfileTile {
    user-id: string,
    display-name: string,
    // Real color type, not the raw hex string Bonfire's own avatarColor field
    // is — Slint's expression language has no string-to-color parse, so
    // Rust parses the hex (or picks a deterministic fallback for a plain,
    // non-Bonfire account) when building this struct.
    avatar-color: color,
    avatar-initial: string,
    has-pin: bool,    // display-only — "a PIN is set" (lock icon); NOT the same as
                             // requires-pin, per Bonfire's own documented distinction
                             // (bypassPinOnLocalNetwork can make requires-pin false even
                             // when has-pin is true)
    requires-pin: bool,    // whether to actually prompt for a PIN right now
    is-bonfire: bool,    // true = a Bonfire sub-profile of the currently-active master
                             // (switches via bonfire_switch_profile, no password ever again);
                             // false = an independently-remembered plain account (switches via
                             // its own stored token, or a password prompt if that's gone stale)
    is-root: bool,    // is this tile its OWN section's root/master profile (drives the
                             // permanent master-ring on ProfileTileCard) — deliberately NOT
                             // `!is-bonfire`, which is wrong for a "pure" Bonfire group account
                             // that was never independently logged into (its own is-bonfire is
                             // also true); this is profile.rs::is_true_master(p) instead.
}

// One household row on ProfilePickerScreen: section 0 is the requested account's own group,
// further sections other households linked via a Bonfire group
// (profile.rs::linked_account_roots) — each with its full member list, master included.
// `header`: "" for a sole section, else "Your Bonfire" / "{name}'s Bonfire".
export struct ProfileSection {
    header: string,
    tiles: [ProfileTile],
}

// AccountPickerScreen tile (profile.rs's AccountGroup/build_account_tile): one per account
// (a plain login, or a Bonfire household via its master), not per profile —
// profile-count gives the "N profiles" subtitle.
export struct AccountTile {
    root-id: string,
    display-name: string,
    avatar-color: color,
    avatar-initial: string,
    server-url: string,
    profile-count: int,     // 1 = a standalone account, no profile tier to descend into;
                             // Another master's account reached through a Bonfire group, not one of the user's own
                             // saved accounts — marked so the two are distinguishable.
    is-group-account: bool,
    // The root profile's has-pin, set only when profile-count == 1: only then does clicking
    // the tile prompt for the PIN directly (see build_account_tile).
    has-pin: bool,
}

// Bonfire Phase 5 — one row in the "Bonfire Group" screen's owner-only
// member list (BonfireGroupStatus.ownedMembers). Kick targets user-id.
export struct BonfireGroupMemberTile {
    user-id: string,
    username: string,
}

// ProfileEditScreen's two checklists — enabled libraries (bonfire_list_libraries) and the
// device whitelist (bonfire_list_devices). `subtitle`: the collection type or "client ·
// last seen", "" when there's nothing.
export struct ToggleListItem {
    id: string,
    name: string,
    subtitle: string,
    selected: bool,
}

// One row of the Bonfire Admin screen's Mappings tab: a flat list (small, fetched in one
// response — see bonfire_admin.rs), sub-profiles indented under their master, grouped by
// master-user-id when built.
export struct BonfireAdminRow {
    is-master: bool,   // false = a sub-profile, indented under its own master
    profile-user-id: string,
    display-name: string,
    // Color+initial only, no real avatar photo — matches every other
    // profile-tile-rendering surface in this app (Account/Profile Picker,
    // Manage Profiles), none of which render a real image either;
    // bonfire_profile_image_url (fjord-api) has zero consumers anywhere
    // in this codebase today, confirmed before deciding this, not assumed.
    avatar-color: color,
    avatar-initial: string,
    requires-pin: bool,
    max-profiles: int,    // -1 = "using the server's own default" (None on the wire);
                               // meaningless (always -1) on a sub-profile row
}

// One row in the "Bonfire Admin" screen's Audit Logs tab — read-only,
// no per-row action, matching the real plugin's own admin dashboard.
export struct BonfireAuditRow {
    timestamp: string,
    master-username: string,
    target-username: string,
    device-name: string,
    client: string,
    ip-address: string,
}
