// ── fjord-app · widgets.slint ────────────────────────────────────────────────
//   FjordButton        accent / danger push button; kbd-focused ring; optional icon-left/-right
//                      (pinned to Noto Sans Symbols 2, so the label keeps the chosen text font)
//   IconCircleButton   38px circle button, accent when active; per-icon pinned fonts (Adwaita Sans
//                      for ♥/✓, Noto Sans Symbols 2 otherwise); also Now Playing's transport row
//   NavItem            sidebar row (icon + label + one "selected" state)
//   BrowseItem         one row in the browse / search list
//   FadeInTrigger      fade-in-on-creation helper (Timer kick; the opacity animate is speed-scaled);
//                      used by player.slint's skip overlays and the permanently mounted screens
//   FadeGate           symmetric fade in/out that owns mount/unmount (`if gate.mounted: X {
//                      opacity: gate.fade-opacity; }`) — every main.slint screen/overlay uses it
//   PressPulse         keyboard half of the press animation (kb-activate-pulse → 110 ms `pulsing`);
//                      border-only, so pressing never resizes or re-weights text
//   VirtualKeyboard    numeric PIN keypad (3×4, cursor driven by Rust); VirtualKeyboardKey = its cell
//   QwertyKeyboard     on-screen alphanumeric keyboard: letters/symbols pages, sticky Shift, last row
//                      123 · ◀ · space · ▶ · Done; floating panel; key values live only here, row
//                      lengths shared via AppState.onscreen-keyboard-row-lens
//   FieldFocusWrap     focus ring around a LineEdit (which has no border of its own)
//   MediaCard          poster card for rows and grids: badges ✓ / count / ♥ / ★ watchlist / Seerr
//                      availability / cross-tier pill / progress; flush focus ring; no poster fade
//   LoadingSpinner     animated ring (speed-scaled dot rhythm)
//   StatRow / ToggleSwitch / SectionHeader / SettingsDropdown / SettingsRow (key = settings.rs row key)
//   PosterBlock        160×240 poster with badges (played, progress, unplayed count, request status)
//   MetaLine           year · runtime · rating + optional ★ community rating
//   CastRow            scrollable cast row (portrait, name, role); content-x follows focused-idx
//   StorylineSection   collapsible overview; clicked-header() lets RequestDetailScreen sync its zone
//   MiniPlayerBar      bottom bar for background video: 108px with a live thumbnail (a VideoSpot on the
//                      separate surface), 56px when the video is behind the UI; float-card-focused
//   VideoSpot          reports its absolute rect into AppState.video-rect-* (separate video surface)
//   MusicPlayerBar     72px bottom bar while audio plays: art + title/artist, transport + progress,
//                      Prev/Next/Shuffle/Repeat/Queue/Lyrics/volume
//   QueuePanel         right-side queue overlay ("Queue N of M", Clear All → ConfirmDialog)
//   LyricsView         lyrics overlay, active line highlighted and kept in view
//   ToastNotification  bottom-centre message pill (dismissed by main.slint's Timer)
//   ConfirmDialog      generic dim-backdrop confirm/cancel modal; keyboard driven by the calling screen
//   SidebarProfileMenu quick-menu from the sidebar's profile row (rows pushed by Rust)
// ─────────────────────────────────────────────────────────────────────────────
import {
    Theme,
    CardItem,
    CastMember,
    QueueEntry,
    LyricEntry,
} from "theme.slint";
import { AppState } from "app_state.slint";

// Non-visual helper: instantiate as a NAMED child (e.g. `pulse := PressPulse {
// trigger: AppState.kb-activate-pulse; active: root.kbd-focused; }`) and bind
// the host element's `border-width: (ta.pressed || pulse.pulsing) ? 4px :
// (kbd-focused ? 2px : 0px);` + `animate border-width {...}` to it — this is
// the keyboard half of the universal press/click animation (mouse gets it for
// free via TouchArea.pressed, which needs no Rust involvement). Deliberately
// border-only, not a scale/opacity change — pressing never resizes, brightens,
// or bolds the widget's own text, only a border appears/thickens (user
// feedback: a scale-based version made text look like it was growing/getting
// bolder on press, which read as gimmicky). `trigger` is bumped once by
// keys.rs::handle_key() on every Enter press; every mounted PressPulse in the
// tree sees the same bump but only plays the pulse if ITS OWN `active` input
// (the widget's pre-existing focus/selection expression) is true at that
// moment, so no per-widget identity/addressing scheme is needed. `pulsing`
// self-resets after one Timer interval — same one-shot-Timer idiom as
// FadeInTrigger below, just re-triggerable instead of fire-once. Declared
// before FjordButton (Slint requires an element be declared before use within
// the same file) since FjordButton is the first consumer.
export component PressPulse {
    in property <int> trigger;
    in property <bool> active: true;
    out property <bool> pulsing: false;

    changed trigger => {
        if root.active {
            root.pulsing = true;
            // Force a genuine stop-then-restart rather than just `= true` —
            // Slint's Timer.running is dirty-checked like any property, so
            // writing `true` when it's ALREADY true (a second trigger landing
            // within the same 110ms window, e.g. rapid double-Enter) is a
            // no-op and doesn't restart the countdown; the originally
            // scheduled `triggered` still fires ~110ms after the FIRST press,
            // cutting the second press's flash short. Both writes below are
            // real value transitions, so both are always processed.
            reset-timer.running = false;
            reset-timer.running = true;
        }
    }
    reset-timer := Timer {
        interval: 110ms;
        running: false;
        triggered => {
            root.pulsing = false;
            self.running = false;
        }
    }
}

// ── VirtualKeyboard (numeric) ────────────────────────────────────────────────
// On-screen numeric keypad for PINs: a D-pad grid like the app's other pickers — the
// caller's Rust code owns the cursor (keys flow through keys.rs; this widget captures
// nothing), the widget renders the highlight and forwards clicks and Enter (via
// kb-activate-pulse). No fixed PIN length (Bonfire documents none), so "confirm" is a
// key, not auto-submit. Nested VerticalLayout{HorizontalLayout{for}} like
// calendar.slint, not GridLayout.
component VirtualKeyboardKey inherits Rectangle {
    in property <string> label;
    in property <bool> kb-focused;
    // Optional persistent "toggled on" state (filled accent), separate from kb-focused
    // (the cursor). Default false — the PIN keys have none; QwertyKeyboard's Shift uses it.
    in property <bool> active: false;
    callback activated();

    width: 68px;
    height: 68px;
    border-radius: Theme.radius;
    background: ta.pressed ? Theme.accent-muted
        : root.active ? Theme.accent
        : kb-focused ? Theme.surface-overlay
        : Theme.surface;
    border-width: (ta.pressed || pulse.pulsing) ? 3px : (kb-focused ? 2px : 0px);
    border-color: Theme.focus-border;
    animate background, border-width {
        duration: 90ms * AppState.settings-animation-speed;
        easing: ease-out-expo;
    }

    pulse := PressPulse {
        trigger: AppState.kb-activate-pulse;
        active: root.kb-focused;
    }

    Text {
        text: root.label;
        color: root.active ? #ffffff : (root.kb-focused ? Theme.accent : Theme.text);
        font-size: 22px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    ta := TouchArea {
        clicked => { root.activated(); }
    }
}

export component VirtualKeyboard {
    in property <int> cursor: 0;  // index into the 12-key layout below, row-major

    // "0".."9" | "backspace" | "confirm" — the value at whichever key fired.
    callback key-pressed(string);

    property <[string]> vals:   ["1", "2", "3", "4", "5", "6", "7", "8", "9", "backspace", "0", "confirm"];
    property <[string]> labels: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "⌫", "0", "✓"];

    width: 3 * 68px + 2 * 10px;
    height: 4 * 68px + 3 * 10px;

    VerticalLayout {
        spacing: 10px;
        for row in 4: HorizontalLayout {
            spacing: 10px;
            for col in 3: VirtualKeyboardKey {
                property <int> idx: row * 3 + col;
                label: root.labels[self.idx];
                kb-focused: root.cursor == self.idx;
                activated => { root.key-pressed(root.vals[self.idx]); }
            }
        }
    }
}

// ── QwertyKeyboard (alphanumeric) ────────────────────────────────────────────
// Same D-pad grid idea as VirtualKeyboard (Rust owns AppState.onscreen-keyboard-cursor,
// dispatched through keys.rs), reusing VirtualKeyboardKey. Differences: an irregular
// grid whose row lengths live once on AppState.onscreen-keyboard-row-lens (read by these
// for-loops and keys.rs's cursor math); key VALUES live only here — physical Enter bumps
// kb-activate-pulse and the _activate-mirror below resolves the key.
// Shift and Letters/Symbols are sticky toggles (internal state); key-pressed(string)
// only fires with a character, " ", "backspace", "done" or "left"/"right" (◀ ▶), never
// "shift"/"page-toggle". Both pages share the same row lengths, so switching pages
// never needs the cursor clamped. (Rows whose length depends on the outer loop index
// were verified with slint-viewer before this was built.)
export component QwertyKeyboard inherits Rectangle {
    in property <int> cursor: 0;    // Rust-owned, flat row-major index
    in property <bool> active: true; // gates Enter-activation, mirrors PressPulse.active
    callback key-pressed(string);

    // The keyboard is a floating panel (Theme.surface + radius-lg + drop shadow, like the
    // app's other dialogs) — bare keys over content were unreadable on busy backgrounds.
    // kb-pad insets the keys; it's part of root's own width/height, so callers'
    // positioning math includes it.
    property <length> kb-pad: 16px;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000070;

    property <bool> shift-active: false;
    property <int> page: 0; // 0=letters, 1=symbols

    property <[[string]]> letters-vals: [
        ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
        ["a", "s", "d", "f", "g", "h", "j", "k", "l"],
        ["shift", "z", "x", "c", "v", "b", "n", "m", "backspace"],
        ["page-toggle", "left", " ", "right", "done"]
    ];
    property <[[string]]> symbols-vals: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["-", "_", "@", ".", ":", "/", "+", "#", "*"],
        ["(", ")", "[", "]", "{", "}", "!", "?", "backspace"],
        ["page-toggle", "left", " ", "right", "done"]
    ];
    property <[[string]]> vals: page == 0 ? letters-vals : symbols-vals;

    // Only meaningful for regular character keys — callers only reach this
    // once the 5 special values (shift/backspace/page-toggle/space/done)
    // have already been ruled out, so this never needs to itself guard
    // against uppercasing one of those.
    function resolved-char(row: int, col: int) -> string {
        let v = vals[row][col];
        return (page == 0 && shift-active) ? v.to-uppercase() : v;
    }
    function display-label(row: int, col: int) -> string {
        let v = vals[row][col];
        if v == "shift" { return "⇧"; }
        if v == "backspace" { return "⌫"; }
        if v == "page-toggle" { return page == 0 ? "123" : "ABC"; }
        if v == " " { return "Space"; }
        if v == "done" { return "Done"; }
        if v == "left" { return "◀"; }   // caret keys, 2026-10-05
        if v == "right" { return "▶"; }
        return resolved-char(row, col);
    }
    // One funnel for mouse (VirtualKeyboardKey.activated) and physical Enter (mirror
    // below); shift/page-toggle are handled here and never reach the caller. Checks the
    // RAW grid value, not the shift-cased label — otherwise "page-toggle"/"done" would
    // break while Shift is on.
    function handle-raw(row: int, col: int) {
        let v = vals[row][col];
        if v == "shift" { shift-active = !shift-active; }
        else if v == "page-toggle" { page = page == 0 ? 1 : 0; }
        else if v == "backspace" || v == " " || v == "done" || v == "left" || v == "right" { key-pressed(v); }
        else { key-pressed(resolved-char(row, col)); }
    }

    property <int> row1-start: AppState.onscreen-keyboard-row-lens[0];
    property <int> row2-start: row1-start + AppState.onscreen-keyboard-row-lens[1];
    property <int> row3-start: row2-start + AppState.onscreen-keyboard-row-lens[2];
    pure function row-of(idx: int) -> int {
        return idx < row1-start ? 0 : idx < row2-start ? 1 : idx < row3-start ? 2 : 3;
    }
    pure function col-of(idx: int) -> int {
        return idx - (row-of(idx) == 0 ? 0 : row-of(idx) == 1 ? row1-start : row-of(idx) == 2 ? row2-start : row3-start);
    }

    // Width/height derive from AppState.onscreen-keyboard-row-lens (the widest row), not
    // fixed numbers, so a change to the rows can't clip or mis-centre the grid. The row
    // count (4) is a static design constant here.
    pure function max-row-len() -> int {
        let lens = AppState.onscreen-keyboard-row-lens;
        return max(lens[0], max(lens[1], max(lens[2], lens[3])));
    }

    width: root.max-row-len() * 68px + (root.max-row-len() - 1) * 10px + kb-pad * 2;
    height: AppState.onscreen-keyboard-row-lens.length * 68px + (AppState.onscreen-keyboard-row-lens.length - 1) * 10px + kb-pad * 2;

    VerticalLayout {
        padding: kb-pad;
        spacing: 10px;
        for row in AppState.onscreen-keyboard-row-lens.length: HorizontalLayout {
            spacing: 10px;
            alignment: center; // shorter rows (9/9/5 keys) center under the widest (10-key) row
            for col in AppState.onscreen-keyboard-row-lens[row]: VirtualKeyboardKey {
                property <int> flat-idx: (row == 0 ? 0 : row == 1 ? row1-start : row == 2 ? row2-start : row3-start) + col;
                label: root.display-label(row, col);
                kb-focused: root.cursor == self.flat-idx;
                // Shift shows its sticky state (checked against the RAW grid value, like handle-raw).
                active: root.vals[row][col] == "shift" && root.shift-active;
                activated => { root.handle-raw(row, col); }
            }
        }
    }

    // Physical Enter: keys.rs bumps the shared kb-activate-pulse (same as
    // every other kbd-focused widget in this app); this mirror decomposes
    // the Rust-owned flat cursor and funnels through the SAME handle-raw as
    // a mouse click, so the two input paths can never diverge on what
    // Enter actually does.
    property <int> _activate-mirror: AppState.kb-activate-pulse;
    changed _activate-mirror => {
        if root.active { root.handle-raw(row-of(root.cursor), col-of(root.cursor)); }
    }
}

// ── Accent button ─────────────────────────────────────────────────────────────
export component FjordButton inherits Rectangle {
    in property <string> text;
    // Optional icon glyph(s) in their own Text pinned to Noto Sans Symbols 2 (like every
    // icon), so a button like "▶ Play" doesn't push the WORD through Noto (no Latin
    // coverage → uncontrolled fallback). icon-left/icon-right for prefix ("▶ Play") and
    // suffix ("30s ▶▶"); both empty by default.
    in property <string> icon-left:  "";
    in property <string> icon-right: "";
    in property <bool> enabled:     true;
    in property <bool> danger:      false;
    in property <bool> kbd-focused: false;
    callback clicked;

    height: 38px;
    border-radius: Theme.radius;
    border-width: (ta.pressed || pulse.pulsing) ? 4px : (kbd-focused ? 2px : 0px);
    border-color: Theme.focus-border;
    background: !enabled ? Theme.surface-raised
        : ta.has-hover ? (danger ? #c53030 : Theme.accent-hover)
        : (danger ? Theme.error : Theme.accent);
    animate border-width {
        duration: 90ms * AppState.settings-animation-speed;
        easing: ease-out-expo;
    }
    pulse := PressPulse {
        trigger: AppState.kb-activate-pulse;
        active: root.kbd-focused;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if root.icon-left != "": Text {
            text: root.icon-left;
            color: root.enabled ? #ffffff : Theme.text-subtle;
            font-size: 14px;
            font-weight: 600;
            font-family: "Noto Sans Symbols 2";
            vertical-alignment: center;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.enabled ? #ffffff : Theme.text-subtle;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.icon-right != "": Text {
            text: root.icon-right;
            color: root.enabled ? #ffffff : Theme.text-subtle;
            font-size: 14px;
            font-weight: 600;
            font-family: "Noto Sans Symbols 2";
            vertical-alignment: center;
        }
    }
}

// Generic confirm/cancel modal: dim backdrop (#00000088) + Theme.surface-raised box +
// drop shadow, the same chrome as PlaylistPicker and RequestOptionsOverlay. Cancel is
// an outlined (ghost) button, not a FjordButton, so it reads as the secondary, safe
// choice next to Confirm's solid fill.
// Keyboard-dumb on purpose: `focused` (0=Cancel, 1=Confirm) is driven by the calling
// screen's handle_key; `confirmed()`/`cancelled()` fire on the buttons, and
// `cancelled()` also on a backdrop click.
export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> confirm-label: "Confirm";
    in property <int> focused: 0; // 0=Cancel, 1=Confirm
    callback confirmed();
    callback cancelled();

    background: #00000088;

    // Close on backdrop click
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.cancelled(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 360px;
        height: content.preferred-height + 32px;
        border-radius: Theme.radius-lg;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 20px;
        drop-shadow-color: #000000aa;
        drop-shadow-offset-y: 6px;

        // Stop backdrop click from propagating through the box
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        content := VerticalLayout {
            x: 16px;
            y: 16px;
            width: parent.width - 32px;
            // Bind the layout's height to its own preferred-height: a Layout placed directly in a
            // plain Rectangle otherwise gets a default height that can disagree with the box
            // (sized from content.preferred-height), leaving the button row outside the box.
            height: self.preferred-height;
            spacing: 16px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: root.message;
                color: Theme.text-muted;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;
                cancel-btn := Rectangle {
                    width: 100px;
                    height: 38px;
                    border-radius: Theme.radius;
                    background: transparent;
                    border-width: (cancel-ta.pressed || cancel-pulse.pulsing) ? 4px : (root.focused == 0 ? 2px : 1px);
                    border-color: root.focused == 0 ? Theme.focus-border : Theme.border-strong;
                    animate border-width {
                        duration: 90ms * AppState.settings-animation-speed;
                        easing: ease-out-expo;
                    }
                    cancel-pulse := PressPulse {
                        trigger: AppState.kb-activate-pulse;
                        active: root.focused == 0;
                    }

                    cancel-ta := TouchArea {
                        clicked => { root.cancelled(); }
                    }

                    Text {
                        text: "Cancel";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                FjordButton {
                    text: root.confirm-label;
                    width: 100px;
                    kbd-focused: root.focused == 1;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}

// ── Circle icon button (♥ fav / ✓ watched) ───────────────────────────────────
export component IconCircleButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active:      false;
    in property <bool> kbd-focused: false;
    callback clicked;

    width: 38px;
    height: 38px;
    border-radius: 19px;
    border-width: (ta.pressed || pulse.pulsing) ? 4px : (kbd-focused ? 2px : 0px);
    border-color: Theme.focus-border;
    background: active ? Theme.accent
        : ta.has-hover ? Theme.surface-overlay
        : Theme.surface-raised;
    animate border-width {
        duration: 90ms * AppState.settings-animation-speed;
        easing: ease-out-expo;
    }
    pulse := PressPulse {
        trigger: AppState.kb-activate-pulse;
        active: root.kbd-focused;
    }

    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: root.icon;
        color: #ffffff;
        font-size: 20px;
        font-weight: 600;
        // Hard-pinned regardless of Settings → UI → Text font: ♥/✓ always
        // render via Adwaita Sans specifically (the deliberately-chosen
        // style for those two), every other icon this component shows
        // (the now_playing.slint transport row: ⏮▶⏸⏭⇌↺🔉🔊) always
        // via the bundled Noto Sans Symbols2 fallback font. Several
        // candidate text fonts turned out to have their own competing
        // glyphs for common icons like these — pinning explicitly means
        // icon appearance never depends on which text font is active.
        font-family: (root.icon == "❤" || root.icon == "✓") ? "Adwaita Sans" : "Noto Sans Symbols 2";
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ── Sidebar nav row ───────────────────────────────────────────────────────────
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;
    callback double-clicked;

    height: 40px;
    border-radius: Theme.radius;
    // One "selected" state for every sidebar item (no brighter tier for "the sidebar has
    // keyboard focus") — Browse All and Settings switch AppMode the moment the cursor lands
    // on them, so a two-tier look made them inconsistent with the dashboard items.
    background: active ? Theme.accent-muted
        : ta.has-hover ? Theme.surface-raised
        : #00000000;
    animate background {
        duration: 140ms * AppState.settings-animation-speed;
        easing: ease;
    }
    border-width: (ta.pressed || pulse.pulsing) ? 3px : 0px;
    border-color: Theme.focus-border;
    animate border-width {
        duration: 90ms * AppState.settings-animation-speed;
        easing: ease-out-expo;
    }
    pulse := PressPulse {
        trigger: AppState.kb-activate-pulse;
        active: root.active && AppState.sidebar-kb-active;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        spacing: 10px;
        alignment: start;

        Rectangle {
            width: 6px;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                y: (parent.height - self.height) / 2;
                background: active ? Theme.accent : Theme.text-subtle;
            }
        }

        Text {
            text: label;
            color: active ? Theme.text : Theme.text-muted;
            font-size: 14px;
            font-weight: active ? 600 : 400;
            vertical-alignment: center;
        }
    }
}

// ── Browse-screen list row ────────────────────────────────────────────────────
export component BrowseItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked;
    callback activated;
    callback right-clicked;

    height: 42px;
    border-radius: Theme.radius;
    background: { let hov = ta.has-hover; selected ? Theme.accent-muted : (hov ? Theme.surface-raised : #00000000) };
    border-width: (ta.pressed || pulse.pulsing) ? 3px : 0px;
    border-color: Theme.focus-border;
    animate border-width {
        duration: 90ms * AppState.settings-animation-speed;
        easing: ease-out-expo;
    }
    pulse := PressPulse {
        trigger: AppState.kb-activate-pulse;
        active: root.selected;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.activated(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.right-clicked();
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            width: 3px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 1.5px;
            background: selected ? Theme.accent : #00000000;
        }

        Text {
            text: root.text;
            color: selected ? Theme.text : Theme.text-muted;
            font-size: 14px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// Non-visual helper: instantiate as a NAMED child (e.g. `fade := FadeInTrigger {}`)
// and bind the host element's `opacity: fade.fade-opacity;` + `animate opacity {...}`
// to fade it in shortly after creation. Exposes fade-opacity as an out property
// rather than writing `parent.opacity` directly — `parent` from inside the Timer
// refers to FadeInTrigger itself (its immediate parent), not the host two levels
// up, so a direct `parent.opacity` write silently no-ops on the host and leaves it
// stuck invisible. Uses a Timer rather than `init =>` because the opacity write
// needs to land on a genuinely later event-loop tick — writing it in the same tick
// as the initial `opacity: 0` binding would just coalesce into a single value with
// nothing for `animate` to transition from. Used for entrance fades on `if`-gated
// elements (destroyed/recreated on every toggle, unlike an always-mounted element
// whose opacity binding can just react to a condition changing).
export component FadeInTrigger {
    out property <float> fade-opacity: 0;
    Timer {
        interval: 16ms;
        running: true;
        triggered => {
            fade-opacity = 1;
            self.running = false;
        }
    }
}

// FadeGate: symmetric fade in/out. FadeInTrigger only handles the entrance —
// the consumer's own `if condition: Element {...}` still destroys the
// element the instant `condition` goes false, so nothing ever fades out.
// FadeGate owns the mount decision itself: declare it as an always-present
// sibling (`gate := FadeGate { show: <condition>; }`), then gate the `if` on
// `gate.mounted` (not the raw condition) and bind `opacity: gate.fade-opacity;`.
// `mounted` stays true for one fade-out's worth of time after `show` goes
// false, so the element is still there to actually play that fade before
// `if gate.mounted` unmounts it. The consumer still declares its own
// `animate opacity {...}` block, same as with FadeInTrigger.
export component FadeGate {
    in property <bool> show: false;
    out property <bool> mounted: false;
    out property <float> fade-opacity: 0;

    init => {
        root.mounted = root.show;
        if root.show {
            kick-timer.running = true;
        }
    }

    changed show => {
        if root.show {
            unmount-timer.running = false;
            root.mounted = true;
            kick-timer.running = true;
        } else {
            // Cancel a pending kick-timer: if show goes true→false before its 16 ms tick, it
            // would still fire later and flash the element back to full opacity. (show-login
            // starts true before the saved-session check flips it, so this hit every cold start.)
            kick-timer.running = false;
            root.fade-opacity = 0;
            unmount-timer.running = true;
        }
    }

    // Bumps opacity 0→1 a frame after mounting, same trick as FadeInTrigger,
    // so the consumer's `animate opacity` has a real transition to interpolate.
    kick-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            root.fade-opacity = 1;
            self.running = false;
        }
    }

    // Keeps `mounted` true for exactly as long as the fade-out animation
    // takes, so `if gate.mounted` doesn't destroy the element mid-fade.
    unmount-timer := Timer {
        interval: max(16ms, 200ms * AppState.settings-animation-speed);
        running: false;
        triggered => {
            root.mounted = false;
            self.running = false;
        }
    }
}

// ── Poster card (used inside horizontal scroll rows) ──────────────────────────
export component MediaCard inherits Rectangle {
    in property <CardItem> item;
    in property <bool> focused: false;
    callback clicked;
    callback right-clicked;

    width: 140px;
    height: 224px;
    border-radius: Theme.radius;
    background: #00000000;
    pulse := PressPulse {
        trigger: AppState.kb-activate-pulse;
        active: root.focused;
    }

    // Inset 3px on every side so the focus/press ring (flush with root, declared last)
    // has a gutter and doesn't bite into the poster/title. Use `padding`, NOT explicit
    // x/y/width/height bindings on this layout: LibraryGrid gives MediaCard no explicit
    // height, so root.height comes from the row layout's cache, and a child layout
    // binding that reads root.height feeds back into it → "Recursion detected" panic
    // (seen on the HTPC; an outset ring crashed the same way). `padding` is resolved
    // inside the layout cache. See SLINT.md.
    VerticalLayout {
        padding: 3px;
        spacing: 6px;

        poster-rect := Rectangle {
            // Reserve exactly what the title+subtitle block below actually
            // needs (text-col.preferred-height, which grows with however
            // many lines a long title/subtitle wraps to — no cap, the whole
            // title is always shown) rather than a fixed budget that assumed
            // 2 lines each. max(0px, ...) keeps this well-defined (never
            // negative) even for a pathologically long title on a short
            // card: the poster just shrinks, all the way to invisible in
            // the extreme case, rather than the text overflowing past the
            // card's own bounds into whatever is below it. Reads root.height
            // (the month-stable pattern), NOT parent.height — parent is the
            // padded VerticalLayout whose height participates in layout-info
            // computation (see the recursion note above). text-col is a
            // sibling, not an ancestor, so reading its preferred-height here
            // does not create the same kind of cycle.
            height: max(0px, root.height - 12px - text-col.preferred-height);
            border-radius: Theme.radius;
            background: Theme.surface-raised;
            clip: true;

            // No fade-in on the poster: grids reveal posters one by one as their fetches finish,
            // and a per-card fade on top of that reads as continuous flashing however slow it is.
            // The poster appears at full opacity when `has-poster` flips. (Every MediaCard screen.)
            if item.has-poster: Image {
                source: item.poster;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }

            if !item.has-poster: Text {
                text: item.title;
                color: Theme.text-muted;
                font-size: 11px;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: 6px;
                width: parent.width - 12px;
            }

            // In-progress bar at bottom of poster
            if item.resume-pct > 0 && !item.has-played: Rectangle {
                y: parent.height - 3px;
                height: 3px;
                background: Theme.surface-overlay;
                Rectangle {
                    x: 0;
                    width: parent.width * item.resume-pct;
                    height: parent.height;
                    background: Theme.accent;
                }
            }

            // Favourite heart badge
            if item.is-favorite: Rectangle {
                x: 4px;
                y: 4px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.accent;
                Text {
                    text: "❤";
                    font-family: "Adwaita Sans";
                    color: #ffffff;
                    font-size: 14px;
                    font-weight: 900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Watchlist star badge, bottom-left (the only free corner: ♥ top-left, ✓/count/
            // availability top-right, the cross-tier pill bottom-right). On ANY card with
            // on-watchlist — Discover or a library item. y = height − 30px leaves a gap above the
            // 3px progress strip (a watchlisted, partly watched library item shows both).
            // Unpinned font, like the ★/☆ glyphs in context_menu.slint/request_detail.slint.
            if item.on-watchlist: Rectangle {
                x: 4px;
                y: parent.height - 30px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.accent;
                Text {
                    text: "★";
                    color: #ffffff;
                    font-size: 14px;
                    font-weight: 900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Watched checkmark badge
            if item.has-played: Rectangle {
                x: parent.width - 28px;
                y: 4px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.accent;
                Text {
                    text: "✓";
                    font-family: "Adwaita Sans";
                    color: #ffffff;
                    font-size: 18px;
                    font-weight: 900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Unseen episode count badge (series)
            if item.unplayed-count > 0 && !item.has-played: Rectangle {
                x: parent.width - 28px;
                y: 4px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.accent;
                Text {
                    text: "\{item.unplayed-count}";
                    color: #ffffff;
                    font-size: 11px;
                    font-weight: 900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Seerr availability pill (Discover cards only — "" on Jellyfin cards). Tier-prefixed
            // ("4K Requested") only for requested-4k; "blocklisted" never is (blocklisting sets
            // both tiers together server-side).
            if item.availability != "": Rectangle {
                y: 4px;
                height: 20px;
                width: avail-text.preferred-width + 14px;
                x: parent.width - self.width - 4px;
                border-radius: 10px;
                background: item.availability == "available" ? Theme.accent
                    : item.availability == "blocklisted" ? Theme.error
                    : Theme.surface-overlay;
                avail-text := Text {
                    text: item.availability == "blocklisted" ? "Blocklisted" : (item.requested-4k ? "4K " : "") + (
                        item.availability == "requested" ? "Requested"
                        : item.availability == "processing" ? "Processing"
                        : item.availability == "partial" ? "Partial"
                        : item.availability == "available" ? "In Library"
                        : "");
                    color: #ffffff;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Cross-tier pill, bottom-right — Discover "Requested" row only. Two states share it,
            // `other-tier-available` winning:
            //   - other-tier-available: the OTHER tier is already watchable — filled accent,
            //     "Available in 2K/4K".
            //   - other-tier-requested: BOTH tiers requested, neither available — muted surface,
            //     "Also requested in 2K/4K".
            // See CardItem in theme.slint.
            if item.other-tier-available || item.other-tier-requested: Rectangle {
                y: parent.height - self.height - 4px;
                height: 20px;
                width: other-tier-text.preferred-width + 14px;
                x: parent.width - self.width - 4px;
                border-radius: 10px;
                background: item.other-tier-available ? Theme.accent : Theme.surface-overlay;
                other-tier-text := Text {
                    text: item.other-tier-available
                        ? (item.requested-4k ? "Available in 2K" : "Available in 4K")
                        : (item.requested-4k ? "Also requested in 2K" : "Also requested in 4K");
                    color: #ffffff;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Hover highlight — on top of image and badges so it is visible even
            // when a poster image fills the rectangle.
            Rectangle {
                background: #ffffff1a;
                opacity: ta.has-hover ? 1.0 : 0.0;
                animate opacity {
                    duration: 120ms * AppState.settings-animation-speed;
                    easing: ease;
                }
            }
        }

        // No fixed/capped height on either Text below — both are left to
        // their natural wrap:word-wrap size, so a long title or episode name
        // is always shown in full rather than being elided after N lines.
        // poster-rect above reads this layout's preferred-height to shrink
        // and make room, so nothing here needs to know its own budget.
        // (Earlier attempts capped the title at 2 lines via a fixed height +
        // vertical-alignment:bottom to keep it flush with the subtitle; that
        // hit a real Slint 1.16.1 bug where bottom-alignment mis-measures
        // text height as soon as wrap:word-wrap produces 2+ lines, leaving a
        // stray gap — confirmed via a standalone repro. Top-aligned,
        // uncapped Text sidesteps it entirely instead of working around it.)
        text-col := VerticalLayout {
            spacing: 2px;

            Text {
                text: item.title;
                color: Theme.text;
                font-size: 12px;
                wrap: word-wrap;
            }

            if item.subtitle != "": Text {
                text: item.subtitle;
                color: Theme.text-muted;
                font-size: 10px;
                wrap: word-wrap;
            }
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.right-clicked();
            }
        }
    }

    // Focus/press ring as a last-declared transparent overlay, not root's border (which
    // could paint under the poster). Flush with root on purpose: an outset ring caused a
    // "Recursion detected" panic on hover and got clipped by the Flickable at row edges —
    // the gutter comes from the content's 3px inset instead.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: Theme.radius;
        border-width: (ta.pressed || pulse.pulsing) ? 4px : (focused ? 2px : 0px);
        border-color: Theme.focus-border;
        background: transparent;
        animate border-width {
            duration: 90ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
    }
}

// ── Loading spinner ───────────────────────────────────────────────────────────
export component LoadingSpinner inherits Rectangle {
    height: 20px;

    property <int> step: 0;

    Timer {
        // Floored at 16ms (~1 frame, same floor FadeInTrigger's own kick-tick
        // uses) rather than letting this go to a literal 0ms at
        // animation-speed=0 — unlike an `animate` block's duration (where 0ms
        // just means "jump instantly, no re-firing"), a Timer with interval
        // 0ms would re-fire continuously and spin the CPU.
        interval: max(16ms, 260ms * AppState.settings-animation-speed);
        running: true;
        triggered() => { step = step + 1 >= 3 ? 0 : step + 1; }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 16px;
        height: 100%;

        for i in [0, 1, 2]: Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: Theme.accent;
            opacity: step == i ? 1.0 : 0.15;
            animate opacity {
                duration: 180ms * AppState.settings-animation-speed;
                easing: ease-in-out;
            }
        }
    }
}

// ── Pill toggle switch ────────────────────────────────────────────────────────
export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled;

    width: 52px;
    height: 28px;

    Rectangle {
        border-radius: parent.height / 2;
        background: root.checked ? Theme.accent : Theme.surface-raised;
        border-width: ta.pressed ? 3px : 1.5px;
        border-color: root.checked ? Theme.accent : Theme.border;
        animate background {
            duration: 140ms * AppState.settings-animation-speed;
            easing: ease;
        }
        animate border-width {
            duration: 90ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }

        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: #ffffff;
            y: (parent.height - self.height) / 2;
            x: root.checked ? parent.width - self.width - 3px : 3px;
            animate x {
                duration: 140ms * AppState.settings-animation-speed;
                easing: ease-in-out;
            }
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000040;
        }
    }

    ta := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// ── Settings section divider (accent label + hairline) ────────────────────────
export component SectionHeader inherits Rectangle {
    in property <string> text;
    height: 28px;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Text {
            text: root.text;
            color: Theme.accent;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                width: parent.width;
                height: 1px;
                y: (parent.height - 1px) / 2;
                background: Theme.accent;
                opacity: 0.3;
            }
        }
    }
}

// ── Settings dropdown (auto-sizes to current value; popup right-aligns) ───────
export component SettingsDropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <string> current-value;
    callback selected(string);

    property <string> display-value: root.current-value != "" ? root.current-value : "(none)";
    // Cap popup height for long lists; Flickable handles overflow.
    property <length> pop-h: min(root.model.length * 32px + 8px, 320px);

    // Width tracks rendered text; capped so long descriptions don't overflow the settings row.
    width: min(max(80px, val.preferred-width + chevron.preferred-width + 24px), 280px);
    height: 34px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.surface-overlay : Theme.surface-raised;
    border-width: ta.pressed ? 3px : 1px;
    border-color: ta.pressed ? Theme.focus-border : Theme.border;
    animate border-width {
        duration: 90ms * AppState.settings-animation-speed;
        easing: ease-out-expo;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;
        val := Text {
            text: root.display-value;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }

        chevron := Text {
            text: "▾";
            font-family: "Noto Sans Symbols 2";
            color: Theme.text-muted;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        // Width grows to fit the widest item; right edge stays flush with the trigger.
        x: root.width - self.width;
        y: root.height + 2px;
        width: min(max(root.width, items-layout.preferred-width + 8px), 700px);
        height: root.pop-h;

        Rectangle {
            background: Theme.surface-raised;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000060;
            clip: true;

            Flickable {
                content-height: root.model.length * 32px + 8px;
                items-layout := VerticalLayout {
                    padding: 4px;
                    for opt in root.model: Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        preferred-width: opt-text.preferred-width + 20px;
                        background: opt-ta.has-hover ? Theme.accent-muted : transparent;
                        opt-text := Text {
                            x: 10px;
                            text: opt != "" ? opt : "(none)";
                            color: opt == root.current-value ? Theme.accent : Theme.text;
                            font-size: 13px;
                            font-weight: opt == root.current-value ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        opt-ta := TouchArea {
                            clicked => {
                                root.current-value = opt;
                                root.selected(opt);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// ── Settings content row ──────────────────────────────────────────────────────
// Standard two-column row: title+subtitle on the left, @children on the right.
// TouchArea (lower z) lets ToggleSwitch / SettingsDropdown children receive their
// own clicks while still tracking hover for the row highlight.
export component SettingsRow inherits Rectangle {
    // Stable string key ("general.launch_fullscreen" etc., matching settings.rs's row
    // constants). No section needed: a row only exists inside its section's
    // `if AppState.settings-section == …` block.
    in property <string> key;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> indent:   false;

    border-radius: Theme.radius;
    background: {
        let hov = ta.has-hover;
        AppState.settings-focused == root.key
            ? Theme.accent-muted
            : (hov ? Theme.surface : transparent)
    };
    border-width: (ta.pressed || pulse.pulsing) ? 3px : 0px;
    border-color: Theme.focus-border;
    animate border-width {
        duration: 90ms * AppState.settings-animation-speed;
        easing: ease-out-expo;
    }
    pulse := PressPulse {
        trigger: AppState.kb-activate-pulse;
        active: AppState.settings-focused == root.key;
    }

    ta := TouchArea {
        clicked => {
            AppState.settings-row-focused(root.key);
        }
    }

    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-right: 12px;
        padding-left: root.indent ? 28px : 12px;
        spacing: Theme.sp;
        alignment: space-between;
        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 14px;
            }

            Text {
                text: root.subtitle;
                color: Theme.text-muted;
                font-size: 12px;
                overflow: elide;
            }
        }

        @children
    }
}

// ── Field focus-ring wrapper ─────────────────────────────────────────────────
// A 2px focus ring for a text field with no border of its own (std-widgets' LineEdit),
// shown only while `focused` (login.slint shows it while the on-screen keyboard is open;
// native focus has its own highlight otherwise). @children directly on the Rectangle (no
// Layout), so a wrapped field's `x: 2px; y: 2px; width: parent.width - 4px` bindings
// resolve against this root.
export component FieldFocusWrap inherits Rectangle {
    in property <bool> focused: false;
    height: 40px;
    border-radius: Theme.radius;
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.focus-border;
    animate border-width {
        duration: 90ms * AppState.settings-animation-speed;
        easing: ease-out-expo;
    }
    @children
}

// ── Detail page shared atoms ──────────────────────────────────────────────────

export component PosterBlock inherits Rectangle {
    in property <image> source;
    in property <bool> has-image:      false;
    in property <bool> has-played:     false;
    in property <float> resume-pct:     0.0;
    in property <int> unplayed-count: 0;
    // RequestDetailScreen only — already-formatted display text (e.g. "4K
    // Needs Approval"), "" elsewhere. See the badge's own comment below.
    in property <string> request-status: "";
    width: 160px;
    height: 240px;
    border-radius: Theme.radius;
    clip: true;
    background: Theme.surface-raised;
    if has-image: Image {
        source: root.source;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }
    // progress bar (resume)
    if root.resume-pct > 0.0 && !root.has-played: Rectangle {
        x: 0;
        y: parent.height - 4px;
        width: parent.width * root.resume-pct;
        height: 4px;
        background: Theme.accent;
    }
    // ✓ played badge (top-right)
    if root.has-played: Rectangle {
        x: parent.width - 28px;
        y: 6px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: Theme.accent;
        Text {
            text: "✓";
            font-family: "Adwaita Sans";
            color: white;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
    // unplayed-count pill (top-right, when no played badge)
    if root.unplayed-count > 0 && !root.has-played: Rectangle {
        x: parent.width - 28px;
        y: 6px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: Theme.accent;
        Text {
            text: root.unplayed-count;
            color: white;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
    // Seerr request-status badge (RequestDetailScreen only — "" elsewhere). Text comes
    // formatted from the caller (e.g. "4K Needs Approval"); styled like MediaCard's
    // availability pill, in PosterBlock's corner.
    if root.request-status != "": Rectangle {
        y: 4px;
        height: 20px;
        width: request-status-text.preferred-width + 14px;
        x: parent.width - self.width - 4px;
        border-radius: 10px;
        background: root.request-status == "Available" || root.request-status == "4K Available" ? Theme.accent
            : root.request-status == "Blocklisted" || root.request-status == "4K Blocklisted" ? Theme.error
            : Theme.surface-overlay;
        request-status-text := Text {
            text: root.request-status;
            color: #ffffff;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component MetaLine inherits HorizontalLayout {
    in property <string> meta;
    in property <string> rating-label;
    spacing: 16px;
    alignment: start;
    Text {
        text: root.meta;
        color: Theme.text-muted;
        font-size: 14px;
    }

    if root.rating-label != "": Text {
        text: root.rating-label;
        color: #f5c518;
        font-size: 14px;
    }
}

export component CastRow inherits VerticalLayout {
    in property <[CastMember]> cast;
    in property <int> focused-idx: -1;
    callback item-selected(/* idx */ int);
    spacing: 12px;

    // kb-x lives on CastRow (root), not on fl itself.
    // A property on a Flickable that reads self.width / self.content-width creates
    // a dependency cycle → "Recursion detected" panic (Slint gotcha). Reading
    // fl.width from the parent element is safe (no self-reference).
    property <length> kb-x: root.focused-idx <= 0 ? 0px
        : clamp(
                    -(root.focused-idx * 116px + 50px - fl.width / 2),
                    min(0px, fl.width - hbox.preferred-width),
                    0px);
    changed kb-x => { fl.content-x = kb-x; }

    Text {
        text: "Cast & Crew";
        color: Theme.text;
        font-size: 16px;
        font-weight: 700;
    }

    // Flickable so keyboard navigation (content-x tracks focused-idx) scrolls the row.
    // Card stride = 100px width + 16px spacing = 116px.
    // kb-x drives content-x via changed callback; mouse-wheel scroll works natively.
    fl := Flickable {
        height: 162px;
        content-width: hbox.preferred-width;
        animate content-x {
            duration: 150ms * AppState.settings-scroll-speed;
            easing: ease-out-expo;
        }

        hbox := HorizontalLayout {
            spacing: 16px;
            alignment: start;

            for c[i] in root.cast: VerticalLayout {
                width: 100px;
                spacing: 4px;

                // Single Rectangle with clip + border: Slint renders border on top of children
                // so the focus ring is always visible even when the photo fills the area.
                Rectangle {
                    height: 120px;
                    border-radius: Theme.radius;
                    border-width: (ta.pressed || cast-pulse.pulsing) ? 4px : (root.focused-idx == i ? 2px : 0px);
                    border-color: Theme.focus-border;
                    background: Theme.surface-raised;
                    clip: true;
                    animate border-width {
                        duration: 90ms * AppState.settings-animation-speed;
                        easing: ease-out-expo;
                    }
                    cast-pulse := PressPulse {
                        trigger: AppState.kb-activate-pulse;
                        active: root.focused-idx == i;
                    }

                    if c.has-photo: Image {
                        source: c.photo;
                        width: parent.width;
                        height: parent.height;
                        image-fit: cover;
                    }

                    // Hover overlay — read has-hover before ternary to keep binding alive
                    Rectangle {
                        background: { let h = ta.has-hover; h ? #ffffff18 : transparent; }
                    }

                    ta := TouchArea {
                        clicked => { root.item-selected(i); }
                    }
                }

                Text {
                    text: c.name;
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: c.role;
                    color: Theme.text-muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }
    }
}

// ── Collapsible storyline section ─────────────────────────────────────────────
export component StorylineSection inherits VerticalLayout {
    in property <string> text;
    in-out property <bool> expanded:    false;
    in property <bool> kbd-focused: false;
    // Fires on every header click, alongside toggling `expanded`, so RequestDetailScreen
    // can move its keyboard zone (request-detail-zone) to where the mouse clicked —
    // otherwise the next Enter could activate the wrong element. Other callers ignore it.
    callback clicked-header();

    hdr := Rectangle {
        height: 44px;
        background: ta.has-hover ? Theme.surface : transparent;
        border-width: (ta.pressed || story-pulse.pulsing) ? 4px : (root.kbd-focused ? 2px : 0px);
        border-color: Theme.focus-border;
        border-radius: Theme.radius;
        animate border-width {
            duration: 90ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
        story-pulse := PressPulse {
            trigger: AppState.kb-activate-pulse;
            active: root.kbd-focused;
        }

        HorizontalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding-left: 48px;
            padding-right: 48px;
            spacing: 8px;
            alignment: start;
            Text {
                text: "Overview";
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                text: expanded ? "▼" : "▶";
                font-family: "Noto Sans Symbols 2";
                color: Theme.text-muted;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        ta := TouchArea {
            clicked => { expanded = !expanded; root.clicked-header(); }
        }
    }

    VerticalLayout {
        padding-left: 48px;
        padding-right: 48px;
        padding-bottom: 20px;

        // Single clipping Rectangle whose height animates between collapsed (66px)
        // and fully expanded (txt.preferred-height).  preferred-height is the text's
        // natural wrapped height at the given width — it doesn't feed into any layout
        // cycle because it reads the text content, not any allocated dimension.
        Rectangle {
            clip: true;
            height: root.expanded ? max(txt.preferred-height, 66px) : 66px;
            animate height {
                duration: 200ms * AppState.settings-animation-speed;
                easing: ease-in-out;
            }

            txt := Text {
                x: 0;
                y: 0;
                text: root.text;
                color: #cccccc;
                font-size: 15px;
                wrap: word-wrap;
                width: min(root.width - 96px, 640px);
            }
        }
    }
}

// ── Stats overlay row ─────────────────────────────────────────────────────────
export component StatRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    HorizontalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 10px;
        Text {
            text: label;
            color: #555555;
            font-size: 11px;
            font-weight: 700;
            width: 60px;
            vertical-alignment: top;
        }

        Text {
            text: value;
            color: #cccccc;
            font-size: 11px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// ── VideoSpot (HDR Stage 5) ─────────────────────────────────────────────────
// Marks where the video belongs while it's drawn on the subsurface below the
// window (video_surface.rs): reports this element's absolute position and
// size into AppState.video-rect-<which>. Draws nothing, takes no input.
// Mirrors into local properties so `changed` can watch them (Slint only
// watches the current component's own properties), using root.* geometry.
export component VideoSpot {
    in property <int> which; // 0 = PlayerScreen, 1 = video-behind-menus layer, 2 = mini-player thumbnail
    property <length> ax: root.absolute-position.x;
    property <length> ay: root.absolute-position.y;
    property <length> aw: root.width;
    property <length> ah: root.height;
    function report() {
        if root.which == 0 {
            AppState.video-rect-player = { x: root.ax, y: root.ay, w: root.aw, h: root.ah };
        } else if root.which == 1 {
            AppState.video-rect-bg = { x: root.ax, y: root.ay, w: root.aw, h: root.ah };
        } else {
            AppState.video-rect-thumb = { x: root.ax, y: root.ay, w: root.aw, h: root.ah };
        }
    }
    init => { root.report(); }
    changed ax => { root.report(); }
    changed ay => { root.report(); }
    changed aw => { root.report(); }
    changed ah => { root.report(); }
}

// ── Mini-player bar ───────────────────────────────────────────────────────────
// Full-width bar docked at the bottom by MainWindow, above the music bar.
// Mode 3 (!video-behind-ui): 108px — live video (192×108, 16:9) + title + Resume/Stop.
// Mode 2 (video-behind-ui):   56px — compact bar (no thumbnail; video fills window) + title + Resume/Stop.
// float-card-focused: -1=not focused, 0=Resume, 1=Stop. Down past a screen's last row
// focuses it (keys::focus_bar_on_down).
export component MiniPlayerBar inherits Rectangle {
    height: AppState.video-behind-ui ? 56px : 108px;
    // HDR Stage 5: with the video on the subsurface, the bar must not paint
    // under the thumbnail — its colour goes behind the info part only.
    background: AppState.video-surface-active && !AppState.video-behind-ui ? transparent : Theme.surface-raised;
    if AppState.video-surface-active && !AppState.video-behind-ui: Rectangle {
        x: 192px;
        y: 0;
        width: root.width - 192px;
        height: root.height;
        background: Theme.surface-raised;
    }

    // Focus ring
    if AppState.float-card-focused >= 0: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-width: 2px;
        border-color: Theme.focus-border;
        border-radius: 0px;
        background: transparent;
    }

    // ── Mode 3: live video + info ─────────────────────────────────────────────
    if !AppState.video-behind-ui: HorizontalLayout {
        Rectangle {
            width: 192px;
            background: AppState.video-surface-active ? transparent : #000000;
            clip: true;
            Image {
                source: AppState.video-frame;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
                visible: !AppState.video-surface-active;
            }

            VideoSpot {
                which: 2;
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }
        }

        VerticalLayout {
            padding: 12px;
            spacing: 5px;
            alignment: center;
            Text {
                text: "NOW PLAYING";
                color: Theme.accent;
                font-size: 9px;
                font-weight: 700;
            }

            Text {
                text: AppState.playing-title;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                FjordButton {
                    icon-left: "▶";
                    text: "Resume";
                    height: 28px;
                    width: 120px;
                    kbd-focused: AppState.float-card-focused == 0;
                    clicked => { AppState.float-card-focused = -1; AppState.resume-player(); }
                }

                FjordButton {
                    icon-left: "■";
                    text: "Stop";
                    height: 28px;
                    width: 80px;
                    danger: true;
                    kbd-focused: AppState.float-card-focused == 1;
                    clicked => { AppState.float-card-focused = -1; AppState.stop-playback(); }
                }
            }
        }
    }

    // ── Mode 2: compact 56px bar (video fills window; no thumbnail needed) ────
    if AppState.video-behind-ui: HorizontalLayout {
        padding: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: "NOW PLAYING";
                color: Theme.accent;
                font-size: 9px;
                font-weight: 700;
            }

            Text {
                text: AppState.playing-title;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            FjordButton {
                icon-left: "▶";
                text: "Resume";
                height: 28px;
                width: 120px;
                kbd-focused: AppState.float-card-focused == 0;
                clicked => { AppState.float-card-focused = -1; AppState.resume-player(); }
            }

            FjordButton {
                icon-left: "■";
                text: "Stop";
                height: 28px;
                width: 80px;
                danger: true;
                kbd-focused: AppState.float-card-focused == 1;
                clicked => { AppState.float-card-focused = -1; AppState.stop-playback(); }
            }
        }
    }
}

// ── Music player bar ──────────────────────────────────────────────────────────
export component MusicPlayerBar inherits Rectangle {
    height: 72px;
    background: Theme.surface-raised;
    border-color: Theme.border;
    border-width: 0px;

    // Top border line
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // ── Left zone: album art + title + artist ─────────────────────────────
        ta-left := TouchArea {
            width: 240px;
            mouse-cursor: MouseCursor.pointer;
            // Opens the fullscreen Now Playing screen — "Open Album" moved
            // inside it (Phase 66).
            clicked => { AppState.open-now-playing(); }

            Rectangle {
                border-radius: Theme.radius;
                border-width: (ta-left.pressed || left-pulse.pulsing) ? 4px : (AppState.music-bar-focused == 0 ? 2px : 0px);
                border-color: Theme.focus-border;
                background: ta-left.has-hover ? Theme.surface-overlay : transparent;
                animate border-width {
                    duration: 90ms * AppState.settings-animation-speed;
                    easing: ease-out-expo;
                }
                left-pulse := PressPulse {
                    trigger: AppState.kb-activate-pulse;
                    active: AppState.music-bar-focused == 0;
                }

                HorizontalLayout {
                    padding: 8px;
                    spacing: 10px;
                    alignment: center;

                    // Album art 60×60
                Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: Theme.radius;
                        background: Theme.surface-overlay;
                        clip: true;
                        if AppState.music-bar-has-art: Image {
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            source: AppState.music-bar-art;
                        }
                        if !AppState.music-bar-has-art: Text {
                            text: "♫";
                            font-family: "Noto Sans Symbols 2";
                            color: Theme.text-subtle;
                            font-size: 24px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text {
                            text: AppState.music-bar-title;
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: AppState.music-bar-artist;
                            color: Theme.text-muted;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                }
            } // Rectangle (focus border)
        }

        // ── Centre zone: transport + progress + time ──────────────────────────
        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 4px;
            alignment: center;

            // Transport buttons
            HorizontalLayout {
                alignment: center;
                spacing: 16px;

                // Play / Pause
                ta-pp := TouchArea {
                    width: 36px;
                    height: 36px;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { AppState.music-bar-play-pause(); }
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        border-radius: 18px;
                        border-width: (ta-pp.pressed || pp-pulse.pulsing) ? 4px : (AppState.music-bar-focused == 1 ? 2px : 0px);
                        border-color: Theme.focus-border;
                        background: ta-pp.has-hover ? Theme.surface-overlay : transparent;
                        animate border-width {
                            duration: 90ms * AppState.settings-animation-speed;
                            easing: ease-out-expo;
                        }
                        pp-pulse := PressPulse {
                            trigger: AppState.kb-activate-pulse;
                            active: AppState.music-bar-focused == 1;
                        }

                        Text {
                            text: AppState.music-bar-paused ? "▶" : "⏸";
                            font-family: "Noto Sans Symbols 2";
                            color: Theme.text;
                            font-size: 16px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }

                // Stop
                ta-stop := TouchArea {
                    width: 36px;
                    height: 36px;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { AppState.music-bar-stop(); }
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        border-radius: 18px;
                        border-width: (ta-stop.pressed || stop-pulse.pulsing) ? 4px : (AppState.music-bar-focused == 2 ? 2px : 0px);
                        border-color: Theme.focus-border;
                        background: ta-stop.has-hover ? Theme.surface-overlay : transparent;
                        animate border-width {
                            duration: 90ms * AppState.settings-animation-speed;
                            easing: ease-out-expo;
                        }
                        stop-pulse := PressPulse {
                            trigger: AppState.kb-activate-pulse;
                            active: AppState.music-bar-focused == 2;
                        }

                        Text {
                            text: "⏹";
                            font-family: "Noto Sans Symbols 2";
                            color: Theme.text-muted;
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
            }

            // Progress bar + time
            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: AppState.music-bar-elapsed;
                    color: Theme.text-muted;
                    font-size: 11px;
                    width: 36px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                // Seek bar
                progress-ta := TouchArea {
                    horizontal-stretch: 1;
                    height: 16px;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        AppState.music-bar-seek(self.mouse-x / self.width);
                    }
                    // Track — thicker + brighter when keyboard-focused (slot 3)
                    property <bool> tl-focused: AppState.music-bar-focused == 3;
                    Rectangle {
                        x: 0;
                        width: parent.width;
                        y: (parent.height - (parent.tl-focused ? 5px : 3px)) / 2;
                        height: parent.tl-focused ? 5px : 3px;
                        border-radius: parent.tl-focused ? 2.5px : 1.5px;
                        background: parent.tl-focused ? Theme.accent-muted : Theme.surface-overlay;

                        // Filled portion
                        Rectangle {
                            x: 0;
                            width: parent.width * AppState.music-bar-pos;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.accent;
                        }
                    }
                }

                Text {
                    text: AppState.music-bar-total;
                    color: Theme.text-muted;
                    font-size: 11px;
                    width: 36px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }
        }

        // ── Right zone: ⏮Prev/⏭Next/⇌Shuffle/↺Repeat/⋮Queue/♪Lyrics(cond.)/🔉/🔊 ──
        // All use IconCircleButton (38px), the same as Now Playing's transport row. The width
        // fits the worst case: 8 × 38px + 7 × 8px gaps = 360px — keep it in sync with the
        // icon count, or the last buttons get clipped at the window edge.
        HorizontalLayout {
            width: 360px;
            alignment: center;
            spacing: 8px;

            IconCircleButton {
                icon: "⏮";
                kbd-focused: AppState.music-bar-focused == 4;
                clicked => { AppState.queue-prev-track(); }
            }

            IconCircleButton {
                icon: "⏭";
                kbd-focused: AppState.music-bar-focused == 5;
                clicked => { AppState.queue-next-track(); }
            }

            IconCircleButton {
                icon: "⇌";
                active: AppState.queue-shuffle;
                kbd-focused: AppState.music-bar-focused == 6;
                clicked => { AppState.toggle-shuffle(); }
            }

            IconCircleButton {
                icon: AppState.queue-repeat-mode == 2 ? "↺¹" : "↺";
                active: AppState.queue-repeat-mode > 0;
                kbd-focused: AppState.music-bar-focused == 7;
                clicked => { AppState.cycle-repeat(); }
            }

            IconCircleButton {
                icon: "⋮";
                active: AppState.show-queue-panel;
                kbd-focused: AppState.music-bar-focused == 8;
                clicked => { AppState.open-queue-panel(); }
            }

            if AppState.lyrics-available: IconCircleButton {
                icon: "♪";
                active: AppState.show-lyrics;
                kbd-focused: AppState.music-bar-focused == 9;
                clicked => { AppState.toggle-lyrics(); }
            }
            IconCircleButton {
                icon: "🔉";
                kbd-focused: AppState.music-bar-focused == 10;
                clicked => { AppState.volume-down(); }
            }

            IconCircleButton {
                icon: "🔊";
                kbd-focused: AppState.music-bar-focused == 11;
                clicked => { AppState.volume-up(); }
            }
        }
    }
}

// ── Queue panel ───────────────────────────────────────────────────────────────
// Right-side overlay: header "Queue N of M" + "Clear All" + scrollable playlist; the
// current item has an accent background and bold title. Keys: Up/Down navigate, Enter
// jumps to the item, Delete/Back close. "Clear All" opens a ConfirmDialog
// (show-queue-clear-confirm), declared last so it's on top; dispatch in
// keys::handle_key_queue_panel.
export component QueuePanel inherits Rectangle {
    // Dim overlay behind the panel
    background: #00000088;

    TouchArea {
        // Click outside the panel closes it
        width: parent.width - 400px;
        height: parent.height;
        x: 0;
        y: 0;
        clicked => { AppState.show-queue-panel = false; }
    }

    // Panel body
    panel := Rectangle {
        x: parent.width - 400px;
        y: 0;
        width: 400px;
        height: parent.height;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // ── Header ────────────────────────────────────────────────────────
            header := Rectangle {
                height: 56px;
                background: Theme.surface-raised;
                border-width: 0px;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    alignment: space-between;
                    spacing: 0px;

                    Text {
                        text: {
                            let n = AppState.queue-items.length;
                            let c = AppState.queue-panel-cursor;
                            "Queue — " + (max(c, 0) + 1) + " of " + n
                        }
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                        height: parent.height;
                    }

                    ta-clear := TouchArea {
                        width: 72px;
                        height: parent.height;
                        mouse-cursor: MouseCursor.pointer;
                        // Confirmation dialog, 2026-08-22 — see show-queue-
                        // clear-confirm's own doc comment in app_state.slint.
                        clicked => {
                            AppState.queue-panel-cursor = -1;
                            AppState.queue-clear-confirm-focused = 0;
                            AppState.show-queue-clear-confirm = true;
                        }
                        Text {
                            // Keyboard focus: Up from the top row lands here (cursor -1)
                            text: "Clear All";
                            color: {
                                let hov = ta-clear.has-hover;
                                AppState.queue-panel-cursor == -1 ? Theme.accent
                                    : hov ? Theme.accent : Theme.text-muted
                            };
                            font-size: 13px;
                            font-weight: AppState.queue-panel-cursor == -1 ? 700 : 400;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: parent.width;
                            height: parent.height;
                        }
                        // Press feedback: underline only, text itself untouched.
                        Rectangle {
                            x: 0;
                            y: parent.height - 3px;
                            width: parent.width;
                            height: (ta-clear.pressed || clear-pulse.pulsing) ? 3px : 0px;
                            background: Theme.accent;
                            animate height {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                        }

                        clear-pulse := PressPulse {
                            trigger: AppState.kb-activate-pulse;
                            active: AppState.queue-panel-cursor == -1;
                        }
                    }
                }

                // Bottom border
                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }
            }

            // ── Scrollable list ───────────────────────────────────────────────
            list-area := Rectangle {
                height: parent.height - header.height;
                clip: true;

                fl := Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: max(parent.height, list.preferred-height);

                    property <length> kb-y: clamp(
                        -(AppState.queue-panel-cursor * 56px) + parent.height / 2 - 28px,
                        min(0px, parent.height - list.preferred-height),
                        0px);
                    changed kb-y => { fl.content-y = kb-y; }

                    list := VerticalLayout {
                        alignment: start;
                        spacing: 0px;
                        padding: 0px;

                        for entry[i] in AppState.queue-items: row-ta := TouchArea {
                            height: 56px;
                            mouse-cursor: MouseCursor.pointer;
                            double-clicked => { AppState.queue-jump(entry.index); }
                            clicked => { AppState.queue-panel-cursor = i; }

                            Rectangle {
                                height: parent.height;
                                background: entry.is-current ? #ffffff14
                                    : i == AppState.queue-panel-cursor ? Theme.surface-overlay
                                    : row-ta.has-hover ? #ffffff08
                                    : transparent;
                                border-width: (row-ta.pressed || row-pulse.pulsing) ? 3px : 0px;
                                border-color: Theme.focus-border;
                                animate border-width {
                                    duration: 90ms * AppState.settings-animation-speed;
                                    easing: ease-out-expo;
                                }
                                row-pulse := PressPulse {
                                    trigger: AppState.kb-activate-pulse;
                                    active: i == AppState.queue-panel-cursor;
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    alignment: center;

                                    // Album art thumbnail (40×40)
                                    Rectangle {
                                        width: 40px;
                                        height: 40px;
                                        border-radius: Theme.radius;
                                        background: Theme.surface-overlay;
                                        clip: true;
                                        if entry.has-poster: Image {
                                            width: parent.width;
                                            height: parent.height;
                                            image-fit: cover;
                                            source: entry.poster;
                                        }
                                        if !entry.has-poster: Text {
                                            text: "♫";
                                            font-family: "Noto Sans Symbols 2";
                                            color: Theme.text-subtle;
                                            font-size: 18px;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }

                                    // Index number
                                    Text {
                                        text: i + 1;
                                        color: entry.is-current ? Theme.accent : Theme.text-muted;
                                        font-size: 12px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        width: 22px;
                                    }

                                    // Title + artist column
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;

                                        Text {
                                            text: entry.title;
                                            color: entry.is-current ? Theme.accent : Theme.text;
                                            font-size: 14px;
                                            font-weight: entry.is-current ? 700 : 400;
                                            overflow: elide;
                                        }

                                        if entry.artist != "" || entry.is-queued: Text {
                                            text: entry.is-queued
                                                ? (entry.artist == "" ? "Queued" : entry.artist + "  ·  Queued")
                                                : entry.artist;
                                            color: entry.is-queued ? Theme.text-subtle : Theme.text-muted;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                }

                                // Bottom separator (skip last row)
                                if i < AppState.queue-items.length - 1: Rectangle {
                                    x: 10px;
                                    y: parent.height - 1px;
                                    width: parent.width - 20px;
                                    height: 1px;
                                    background: Theme.border;
                                }

                                // Focused-row left accent stripe
                                if i == AppState.queue-panel-cursor: Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 3px;
                                    height: parent.height;
                                    background: Theme.accent;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if AppState.show-queue-clear-confirm: ConfirmDialog {
        title: "Clear Queue?";
        message: "Remove every upcoming track from the queue? This can't be undone.";
        confirm-label: "Clear All";
        focused: AppState.queue-clear-confirm-focused;
        confirmed => {
            AppState.queue-clear();
            AppState.show-queue-clear-confirm = false;
        }
        cancelled => {
            AppState.show-queue-clear-confirm = false;
        }
    }
}

// ── Lyrics view ───────────────────────────────────────────────────────────────
// Full-width overlay that shows synced or unsynced lyrics.
// Active line (lyrics-active-idx) is highlighted in accent; the view auto-scrolls
// to keep it centred via the kb-y binding pattern.
export component LyricsView inherits Rectangle {
    background: #000000cc;

    // Click backdrop to dismiss
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { AppState.toggle-lyrics(); }
    }

    // Panel: full window width minus fixed side padding (was capped at a
    // narrow fixed 600px, which left large empty margins on typical HTPC
    // displays). No upper cap — each line is short and horizontally centred
    // within the column rather than flowing to fill it, so there's no
    // paragraph-readability reason to additionally cap the column itself on
    // wide screens.
    panel := Rectangle {
        x: 80px;
        y: 0;
        width: parent.width - 160px;
        height: parent.height;
        background: transparent;

        // kb-y + changed-handler (not a direct content-y binding) keeps
        // native mouse-wheel scroll working alongside the auto-follow.
        fl := Flickable {
            width: parent.width;
            height: parent.height;
            content-height: max(parent.height, lyric-list.preferred-height);

            property <length> kb-y: clamp(
                -(AppState.lyrics-active-idx * 76px) + parent.height / 2 - 38px,
                min(0px, parent.height - lyric-list.preferred-height),
                0px);
            changed kb-y => { fl.content-y = kb-y; }
            animate content-y {
                duration: 450ms * AppState.settings-scroll-speed;
                easing: ease-in-out;
            }

            lyric-list := VerticalLayout {
                alignment: start;
                spacing: 0px;
                padding: 32px;

                // min-height (not a fixed height) lets a long line wrap to 2+ lines
                // instead of being elided with "…" — Text's un-set height then
                // reports its real wrapped size upward, and the TouchArea (having
                // no height of its own) takes that size, floored at 76px so short
                // lines keep the usual single-line row rhythm. `sizer` is an
                // invisible probe always measured at the ACTIVE font/weight, so a
                // row that would need 2 lines once highlighted reserves that
                // height up front — without this, a line sitting at 1 line while
                // small would suddenly grow the whole list by a row's height the
                // instant it activates, on top of the font-size jump.
                for line[i] in AppState.lyrics-lines: TouchArea {
                    min-height: max(76px, sizer.preferred-height);
                    clicked => { AppState.toggle-lyrics(); }
                    sizer := Text {
                        visible: false;
                        height: 0px;
                        text: line.text;
                        font-size: 40px;
                        font-weight: 700;
                        width: parent.width;
                        wrap: word-wrap;
                    }

                    Text {
                        text: line.text;
                        color: i == AppState.lyrics-active-idx ? Theme.accent
                            : i == AppState.lyrics-active-idx + 1 || i == AppState.lyrics-active-idx - 1
                            ? Theme.text-muted
                            : Theme.text-subtle;
                        font-size: i == AppState.lyrics-active-idx ? 40px : 24px;
                        font-weight: i == AppState.lyrics-active-idx ? 700 : 400;
                        horizontal-alignment: center;
                        width: parent.width;
                        // Can't bind height: parent.height here — parent (the
                        // TouchArea) derives ITS height from `sizer`, not from
                        // this Text, so that's not a cycle, but this Text's own
                        // natural (unset) height is what lets a short line stay
                        // short instead of stretching to fill the reserved row;
                        // centre it manually within that taller row instead.
                        y: (parent.height - self.height) / 2;
                        wrap: word-wrap;
                        animate color, font-size {
                            duration: 350ms * AppState.settings-animation-speed;
                            easing: ease-in-out;
                        }
                    }
                }
            }
        }
    }
}

// ── Volume overlay ───────────────────────────────────────────────────────────
// Top-center toast; shows level bar + %; auto-hides after 1.5 s (Rust-driven).
// Was inline in player.slint (fullscreen video only) — shared here so the new
// music-bar / Now Playing volume buttons get the same feedback.
export component VolumeOverlay inherits Rectangle {
    width: 220px;
    height: 44px;
    border-radius: Theme.radius;
    background: #0d0d0dcc;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000055;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 0;
        padding-bottom: 0;
        spacing: 10px;
        alignment: center;

        Text {
            text: "Vol";
            color: Theme.accent;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            width: 24px;
        }

        if !AppState.audio-passthrough-active: Rectangle {
            height: 6px;
            horizontal-stretch: 1;
            background: #444444;
            border-radius: 3px;

            Rectangle {
                x: 0;
                width: parent.width * AppState.volume-level / 100;
                height: parent.height;
                background: Theme.accent;
                border-radius: 3px;
            }
        }

        if AppState.audio-passthrough-active: Text {
            text: "passthrough";
            color: Theme.text-subtle;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if !AppState.audio-passthrough-active: Text {
            text: AppState.volume-level + "%";
            color: #bbbbbb;
            font-size: 11px;
            vertical-alignment: center;
            width: 38px;
        }
    }
}

// ── Toast notification ────────────────────────────────────────────────────────
export component ToastNotification inherits Rectangle {
    in property <string> message;

    height: max(44px, txt.preferred-height + 22px);

    border-radius: Theme.radius-lg;
    background: #101012f0;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 14px;
    drop-shadow-color: #00000077;
    drop-shadow-offset-y: 4px;
    clip: true;

    // Left accent stripe
    Rectangle {
        x: 0;
        y: 0;
        width: 4px;
        height: parent.height;
        background: Theme.error;
    }

    txt := Text {
        x: 18px;
        y: 0;
        width: parent.width - 26px;
        height: parent.height;
        text: root.message;
        color: Theme.text;
        font-size: 13px;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

// ── Sidebar profile quick-menu ──────────────────────────────────────────────
// Opened from the sidebar's profile row. Same dim-backdrop + centred-box shape as
// ConfirmDialog/PlaylistPicker/ContextMenu; the row list comes from Rust
// (AppState.sidebar-profile-menu-rows ← profile::sidebar_profile_menu_rows), since
// which rows apply is dynamic.
export component SidebarProfileMenu inherits Rectangle {
    background: #00000088;

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { AppState.show-sidebar-profile-menu = false; }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 260px;
        height: menu-layout.preferred-height + 16px;
        border-radius: Theme.radius-lg;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 20px;
        drop-shadow-color: #000000aa;
        drop-shadow-offset-y: 6px;

        // Stop backdrop click from propagating through the box.
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        menu-layout := VerticalLayout {
            x: 0;
            y: 8px;
            width: parent.width;
            spacing: 2px;
            padding-left: 8px;
            padding-right: 8px;

            for label[i] in AppState.sidebar-profile-menu-rows: Rectangle {
                height: 44px;
                border-radius: Theme.radius;
                background: AppState.sidebar-profile-menu-focused == i ? Theme.accent-muted : transparent;
                border-width: (row-ta.pressed || row-pulse.pulsing) ? 3px : 0px;
                border-color: Theme.focus-border;
                animate border-width {
                    duration: 90ms * AppState.settings-animation-speed;
                    easing: ease-out-expo;
                }
                row-pulse := PressPulse {
                    trigger: AppState.kb-activate-pulse;
                    active: AppState.sidebar-profile-menu-focused == i;
                }

                Text {
                    text: label;
                    color: AppState.sidebar-profile-menu-focused == i ? Theme.text : Theme.text-muted;
                    font-size: 14px;
                    vertical-alignment: center;
                    x: 12px;
                }

                row-ta := TouchArea {
                    clicked => {
                        AppState.sidebar-profile-menu-focused = i;
                        AppState.sidebar-profile-menu-action(i);
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.move { AppState.sidebar-profile-menu-focused = i; }
                    }
                }
            }
        }
    }
}
