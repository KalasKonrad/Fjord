// ── fjord-app · profile_picker.slint ─────────────────────────────────────────
//   ProfileTileCard      avatar tile: master ring (tile.is-root, Theme.master-ring), lock badge
//                        (has-pin), focus ring
//   ProfileSectionRow    one household: optional "{name}'s Bonfire" header + its tile row
//   ProfilePickerScreen  "Who's watching?" for one account (account_picker.slint is the tier
//                        above; profile.rs's StartupGate decides): sections of tiles from that
//                        account's Config.profiles — section 0 its own household, further
//                        sections other households linked through a Bonfire group (switchable
//                        directly, no account switch). No scrolling (counts are small).
//                        Logo centered above main-block; main-block centers the tiles' midpoint.
//                        Back button by profile-picker-back-mode: "← Back to Accounts" (came from
//                        the account tier) or "← Back" (opened from a live session — closes back
//                        to the same profile); Quit bottom-right.
//                        Keyboard (keys.rs's show_profile_picker tier): profile-picker-section =
//                        row, profile-picker-cursor = column (Left/Right clamped in the row,
//                        Up/Down between sections keep the column); Up from the tiles → Back,
//                        Down → Quit.
//                        PIN entry: a layered sub-state (show-profile-pin-entry) — dim backdrop +
//                        box with VirtualKeyboard (numeric) and a Cancel button. Loading overlay
//                        (profile-picker-loading) declared last, over tiles and PIN box.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme, ProfileTile, ProfileSection } from "theme.slint";
import { AppState } from "app_state.slint";
import {
    FjordButton,
    VirtualKeyboard,
    PressPulse,
    LoadingSpinner,
} from "widgets.slint";

component ProfileTileCard inherits VerticalLayout {
    in property <ProfileTile> tile;
    in property <bool> kbd-focused;
    in property <bool> is-add-tile: false;
    callback activated();

    spacing: 8px;
    width: 132px;

    Rectangle {
        width: 108px;
        height: 108px;
        x: (parent.width - self.width) / 2;
        border-radius: self.width / 2;
        background: root.is-add-tile ? Theme.surface-overlay : root.tile.avatar-color;
        border-width: (ta.pressed || tile-pulse.pulsing) ? 4px : (root.kbd-focused ? 3px : 0px);
        border-color: Theme.focus-border;
        clip: true;
        animate border-width {
            duration: 90ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
        tile-pulse := PressPulse {
            trigger: AppState.kb-activate-pulse;
            active: root.kbd-focused;
        }

        // Master/root ring: marks the household's own master tile (Bonfire's picker shows a crown;
        // U+1F451 isn't in the bundled fonts, and ★ already means Watchlist here). `tile.is-root` =
        // profile::is_true_master — not `!tile.is-bonfire`, which is wrong for a group account
        // (see build_tile). Inside the avatar Rectangle (a sibling would become its own layout row),
        // inset so it reads as a second concentric ring next to the keyboard focus border (a
        // different colour; both can show).
        if !root.is-add-tile && root.tile.is-root: Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: self.width / 2;
            border-width: 2px;
            border-color: Theme.master-ring;
        }

        Text {
            text: root.is-add-tile ? "+" : root.tile.avatar-initial;
            color: Theme.text;
            font-size: root.is-add-tile ? 40px : 42px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }

        // Lock badge: a PIN is set (has-pin) — not necessarily "will prompt now"
        // (bypassPinOnLocalNetwork can skip it).
        if !root.is-add-tile && root.tile.has-pin: Rectangle {
            width: 30px;
            height: 30px;
            x: parent.width - self.width - 2px;
            y: parent.height - self.height - 2px;
            border-radius: self.width / 2;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-strong;
            Text {
                text: "🔒";
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        ta := TouchArea {
            clicked => { root.activated(); }
        }
    }

    Text {
        text: root.is-add-tile ? "Add Account" : root.tile.display-name;
        color: root.kbd-focused ? Theme.accent : Theme.text;
        font-size: 14px;
        font-weight: root.kbd-focused ? 700 : 400;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// One household's row: an optional "{name}'s Bonfire" header (none when it's the only
// section, "Your Bonfire" once there are two) and its tile row, master tile included.
// `section-index` (the outer loop index) is compared with AppState.profile-picker-section
// for focus — this component exists so main-block can loop over a variable number of
// households.
component ProfileSectionRow inherits VerticalLayout {
    in property <ProfileSection> section;
    in property <int> section-index;
    spacing: Theme.sp-sm;

    if section.header != "": Text {
        text: section.header;
        color: Theme.accent;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1px;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        alignment: center;
        spacing: 24px;

        for t[i] in section.tiles: ProfileTileCard {
            tile: t;
            // No tile ring while Back/Quit holds focus.
            kbd-focused: AppState.profile-picker-section == root.section-index
                && AppState.profile-picker-cursor == i
                && !AppState.profile-picker-back-focused
                && !AppState.profile-picker-quit-focused;
            activated => {
                // A mouse click must sync the same state keyboard
                // dispatch reads, so a keypress right after a click acts
                // on what was actually clicked, not stale cursor state.
                AppState.profile-picker-section = root.section-index;
                AppState.profile-picker-cursor = i;
                AppState.profile-picker-back-focused = false;
                AppState.profile-picker-quit-focused = false;
                AppState.profile-picker-select(t.user-id);
            }
        }
    }
}

export component ProfilePickerScreen inherits Rectangle {
    background: Theme.bg;

    // Logo (icon only), outside main-block: centered in the empty region above "Who's
    // watching?" — [0, main-block.y], a plain sibling read. Same app-logo-idx as the sidebar,
    // so both show the icon picked at startup.
    logo-img := Image {
        // Size doesn't affect the centering below.
        width: 180px;
        height: 180px;
        x: (parent.width - self.width) / 2;
        y: main-block.y / 2 - self.height / 2;
        source: AppState.app-logo-idx == 1 ? @image-url("../../../assets/fjord_01.svg") :
            AppState.app-logo-idx == 2 ? @image-url("../../../assets/fjord_02.svg") :
            AppState.app-logo-idx == 4 ? @image-url("../../../assets/fjord_04.svg") :
            AppState.app-logo-idx == 5 ? @image-url("../../../assets/fjord_05.svg") :
            AppState.app-logo-idx == 9 ? @image-url("../../../assets/fjord_09.svg") :
            @image-url("../../../assets/fjord_10.svg");
    }

    main-block := VerticalLayout {
        // A Layout directly in a plain Rectangle: its height must be bound to preferred-height, or
        // the rendered height disagrees with what the y formula assumes (the ConfirmDialog trap,
        // SLINT.md).
        //
        // y centers the TILES' midpoint (the title hangs above), using sections-column's
        // preferred-height — identical to the original single-row position with one section.
        // Centering the whole block instead would sit ~20–25 px lower.
        height: self.preferred-height;
        y: parent.height / 2 - watching-text.preferred-height - Theme.sp-xl - sections-column.preferred-height / 2;
        width: parent.width;
        spacing: Theme.sp-xl;

        watching-text := Text {
            text: "Who's watching?";
            color: Theme.text;
            font-size: 32px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        // One row per household (ProfileSectionRow). Plain VerticalLayout, no scrolling — counts
        // are small (Bonfire caps sub-profiles per master, and groups). No "+ Add Account" here:
        // this screen is one account's profiles; new accounts are added on the account picker or
        // in Settings → Profiles.
        sections-column := VerticalLayout {
            spacing: Theme.sp-lg;

            for section[s] in AppState.profile-picker-sections: ProfileSectionRow {
                section: section;
                section-index: s;
            }
        }

        if AppState.profile-picker-error != "": Text {
            text: AppState.profile-picker-error;
            color: Theme.error;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }

    FjordButton {
        text: "Quit";
        width: 90px;
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        // Keyboard-reachable: Down from the tile row, Up returns, Enter quits.
        kbd-focused: AppState.profile-picker-quit-focused;
        clicked => {
            AppState.profile-picker-quit-focused = false;
            AppState.quit();
        }
    }

    // profile-picker-back-mode ("accounts" | "cancel", set by profile::open_profile_picker)
    // picks one of these two buttons (see that property in app_state.slint). Both use
    // profile-picker-back-focused: keys.rs sets it on Up from the tile row and clears it on
    // Down, like every other Back button.
    if AppState.profile-picker-back-mode == "accounts": FjordButton {
        text: "← Back to Accounts";
        width: 170px;
        x: 16px;
        y: 16px;
        kbd-focused: AppState.profile-picker-back-focused;
        clicked => {
            AppState.profile-picker-back-focused = false;
            AppState.profile-picker-back-to-accounts();
        }
    }
    if AppState.profile-picker-back-mode == "cancel": FjordButton {
        // No destination named: it closes the picker and keeps the current session (same as
        // login.slint's "← Back").
        text: "← Back";
        width: 110px;
        x: 16px;
        y: 16px;
        kbd-focused: AppState.profile-picker-back-focused;
        clicked => {
            AppState.profile-picker-back-focused = false;
            AppState.profile-picker-cancel();
        }
    }

    // ── PIN entry — layered sub-state, same dim-backdrop-plus-box shape as
    // RequestOptionsOverlay/PlaylistPicker ─────────────────────────────────
    if AppState.show-profile-pin-entry: Rectangle {
        background: #00000088;

        TouchArea {
            width: parent.width;
            height: parent.height;
            // No-op click-through-blocker for the backdrop — unlike
            // RequestOptionsOverlay, cancelling out of PIN entry back to the
            // grid is a deliberate Back/Escape action (dispatch_profile_pin_entry
            // in keys.rs), not a bare backdrop click, since an accidental
            // stray click here shouldn't silently abandon a partially-typed PIN.
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 360px;
            height: pin-content.preferred-height + 32px;
            border-radius: Theme.radius-lg;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 20px;
            drop-shadow-color: #000000aa;
            drop-shadow-offset-y: 6px;

            TouchArea {
                width: parent.width;
                height: parent.height;
            }

            pin-content := VerticalLayout {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                spacing: 16px;
                alignment: center;

                Text {
                    text: "Enter PIN for " + AppState.profile-pin-target-name;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                // Masked digit dots — up to 8 shown; a PIN longer than that
                // just keeps the last 8 dots lit rather than growing the box
                // (Bonfire's own docs don't document a max PIN length).
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    for d in 8: Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: d < AppState.profile-pin-len ? Theme.accent : Theme.surface-overlay;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                    }
                }

                if AppState.profile-pin-error != "": Text {
                    text: AppState.profile-pin-error;
                    color: Theme.error;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: pad.preferred-height;
                    pad := VirtualKeyboard {
                        x: (parent.width - self.width) / 2;
                        // No grid highlight while Cancel is focused (-1), like ProfileEditScreen's PIN pads.
                        cursor: AppState.profile-pin-cancel-focused ? -1 : AppState.profile-pin-cursor;
                        key-pressed(k) => {
                            AppState.profile-pin-cancel-focused = false;
                            AppState.profile-pin-key(k);
                        }
                    }
                }

                // A real Cancel button: Down past the keypad's bottom row (keys.rs), or click.
                cancel-btn := FjordButton {
                    text: "← Cancel";
                    width: 120px;
                    x: (parent.width - self.width) / 2;
                    kbd-focused: AppState.profile-pin-cancel-focused;
                    clicked => {
                        AppState.profile-pin-cancel-focused = false;
                        AppState.show-profile-pin-entry = false;
                        AppState.profile-pin-error = "";
                    }
                }
            }
        }
    }

    // ── Loading overlay — a switch is in flight (Bonfire /switch or a plain-account
    // revalidation, then the new session's fetches). Declared last so it also covers the PIN
    // modal, which stays technically open during a PIN-confirmed switch.
    if AppState.profile-picker-loading: Rectangle {
        background: #000000c0;

        VerticalLayout {
            alignment: center;
            spacing: 20px;

            LoadingSpinner { }

            Text {
                text: "Signing in…";
                color: Theme.text;
                font-size: 15px;
                horizontal-alignment: center;
            }
        }
    }
}
