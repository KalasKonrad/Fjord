// ── fjord-app · profile_picker.slint ─────────────────────────────────────────
//   ProfilePickerScreen  Bonfire Phase 1 (2026-08-09) — shown instead of LoginScreen when
//                        the resolved ACCOUNT (2026-08-14, 2-tier redesign — see
//                        account_picker.slint's own header and profile.rs's StartupGate) has
//                        2+ profiles. Always account-scoped now: tiles come from just that one
//                        account's own Config.profiles, never the flat list. A single
//                        centered row of avatar tiles (Netflix-style; plain HorizontalLayout,
//                        no Flickable/scroll — profile counts are realistically small,
//                        Bonfire itself caps at 5 sub-profiles per master). No trailing
//                        "+ Add Account" tile anymore (2026-08-14 — that moved up to the
//                        account tier, since adding an account is an account-tier action, not
//                        a profile-tier one) — a `"← Back to Accounts"` FjordButton shows
//                        instead, only when `profile-picker-show-back-to-accounts` (2+
//                        accounts known); keyboard-focusable (2026-08-16 fix —
//                        profile-picker-back-focused, Up from the tile row to reach it, Down
//                        back to the tiles, Enter/Escape/Backspace activate it — was mouse-only
//                        before). The Quit button (bottom-right) got the identical fix the same
//                        day (profile-picker-quit-focused, Down from the tile row, Up back).
//                        PIN entry is a layered sub-state (show-profile-pin-entry), not a
//                        separate screen — same dim-backdrop-plus-centered-box shape as
//                        RequestOptionsOverlay/PlaylistPicker — embedding VirtualKeyboard
//                        (widgets.slint) for numeric-only D-pad-friendly entry. Loading
//                        overlay (2026-08-14, profile-picker-loading) declared last so it
//                        covers both the tile grid and the PIN modal while a switch is
//                        in flight — see that property's own doc comment in app_state.slint.
//                        `main-block`'s (the "Who's watching?"/tile-row block) outer
//                        VerticalLayout carries an explicit `height: self.preferred-height;`
//                        (2026-08-14, 3rd live report on the centering — see that binding's own
//                        doc comment for the root cause: a Layout element directly inside a
//                        plain Rectangle with no explicit height, the same shape
//                        ConfirmDialog/RequestOptionsOverlay already documented once).
//                        `logo-img` (2026-08-14, 4th report, this time with a screenshot) is a
//                        standalone sibling, not part of main-block — centered independently in
//                        the empty region above it ([0, main-block.y]), no "FJORD" wordmark
//                        anymore (icon only, per direct request).
// ─────────────────────────────────────────────────────────────────────────────
import { Theme, ProfileTile } from "theme.slint";
import { AppState } from "app_state.slint";
import { FjordButton, VirtualKeyboard, PressPulse, LoadingSpinner } from "widgets.slint";

component ProfileTileCard inherits VerticalLayout {
    in property <ProfileTile> tile;
    in property <bool> kbd-focused;
    in property <bool> is-add-tile: false;
    callback activated();

    spacing: 8px;
    width: 132px;

    Rectangle {
        width:  108px;
        height: 108px;
        x:      (parent.width - self.width) / 2;
        border-radius: self.width / 2;
        background: root.is-add-tile ? Theme.surface-overlay : root.tile.avatar-color;
        border-width: (ta.pressed || tile-pulse.pulsing) ? 4px : (root.kbd-focused ? 3px : 0px);
        border-color: Theme.focus-border;
        clip: true;
        animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
        tile-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: root.kbd-focused; }

        Text {
            text:                 root.is-add-tile ? "+" : root.tile.avatar-initial;
            color:                Theme.text;
            font-size:            root.is-add-tile ? 40px : 42px;
            font-weight:          700;
            horizontal-alignment: center;
            vertical-alignment:   center;
            width:                parent.width;
            height:               parent.height;
        }

        // Lock badge — bottom-right, only for a real profile (never the Add
        // tile) whose has-pin is true; mirrors requires-pin only insofar as
        // display goes — this badge means "a PIN is set", not "will prompt
        // right now" (bypassPinOnLocalNetwork can make those differ).
        if !root.is-add-tile && root.tile.has-pin: Rectangle {
            width:  30px;
            height: 30px;
            x:      parent.width - self.width - 2px;
            y:      parent.height - self.height - 2px;
            border-radius: self.width / 2;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-strong;
            Text {
                text: "🔒";
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        ta := TouchArea {
            clicked => { root.activated(); }
        }
    }

    Text {
        text:                 root.is-add-tile ? "Add Account" : root.tile.display-name;
        color:                root.kbd-focused ? Theme.accent : Theme.text;
        font-size:            14px;
        font-weight:          root.kbd-focused ? 700 : 400;
        horizontal-alignment: center;
        overflow:             elide;
    }
}

export component ProfilePickerScreen inherits Rectangle {
    background: Theme.bg;

    property <int> tile-count: AppState.profile-picker-profiles.length;

    // Standalone logo, deliberately NOT part of main-block below — live-
    // reported 2026-08-14, 4th report on this screen's layout, this time
    // with an attached screenshot marking the whole empty region above
    // "Who's watching?" and asking for the icon to sit centered within
    // IT, not just tucked directly above the text ("the fjord loggo culd
    // move to the center of the upper part"). Also dropped the "FJORD"
    // wordmark entirely per direct request ("we dont need to write
    // fjord") — icon only now. `main-block.y` (a plain sibling read, the
    // same safe pattern this file already established for `tile-row`'s
    // own centering) is where "Who's watching?" begins, so `[0,
    // main-block.y]` is exactly the empty region the screenshot marked;
    // centering within it needs no coordination with main-block's own
    // internal layout at all. Still the same `AppState.app-logo-idx`
    // ternary the sidebar uses, so both places always show the SAME
    // randomly-chosen-at-startup icon for the whole session — confirmed
    // already correct by construction, not a bug, just restated as a
    // requirement in the same report.
    logo-img := Image {
        // Grown again 120px -> 180px (2026-08-15, live-reported: "make the
        // icon/logo even bigger") — still centered independently in
        // [0, main-block.y] below, which doesn't depend on this size at all,
        // so growing it just uses more of that already-empty region.
        width:  180px;
        height: 180px;
        x:      (parent.width - self.width) / 2;
        y:      main-block.y / 2 - self.height / 2;
        source: AppState.app-logo-idx == 1  ? @image-url("../../../assets/fjord_01.svg") :
                AppState.app-logo-idx == 2  ? @image-url("../../../assets/fjord_02.svg") :
                AppState.app-logo-idx == 4  ? @image-url("../../../assets/fjord_04.svg") :
                AppState.app-logo-idx == 5  ? @image-url("../../../assets/fjord_05.svg") :
                AppState.app-logo-idx == 9  ? @image-url("../../../assets/fjord_09.svg") :
                                               @image-url("../../../assets/fjord_10.svg");
    }

    main-block := VerticalLayout {
        // Live-reported 2026-08-14, three times in a row before this:
        // first "why are the profiles o low" (fixed by anchoring the
        // WHOLE block at 35% of leftover space — still left a large gap
        // above the tiles), then "move the profise to the middel of the
        // screen ... who's watching just above them and then the fjord
        // loggo/icon abow" (fixed by re-deriving y off tile-row's own
        // midpoint instead of the block's top — algebraically correct,
        // but the real bug turned out to be one level deeper, see below),
        // then a THIRD report with an attached screenshot proving it was
        // still wrong.
        //
        // Root cause, finally: this VerticalLayout is a Layout element
        // placed directly inside a plain Rectangle (ProfilePickerScreen)
        // with no explicit `height:` — the exact same shape CLAUDE.md
        // already documents once for ConfirmDialog/RequestOptionsOverlay's
        // own once-broken button row ("a Layout element placed directly in
        // a plain Rectangle with no explicit height doesn't reliably
        // default to its own natural content height"). The y: formula
        // below was never wrong on its own terms — it's the layout's OWN
        // rendered height silently disagreeing with watching-text/tile-row's
        // combined preferred-height that threw the actual on-screen
        // position off, the identical mechanism, just one screen over.
        // Fixed the same way that bug was: force this layout's height to
        // equal its own preferred-height explicitly, so there's no
        // daylight between what the y: math assumes and what actually
        // renders.
        height: self.preferred-height;
        y:      parent.height / 2 - watching-text.preferred-height - Theme.sp-xl - tile-row.preferred-height / 2;
        width:  parent.width;
        spacing: Theme.sp-xl;

        watching-text := Text {
            text:                 "Who's watching?";
            color:                Theme.text;
            font-size:            32px;
            font-weight:          700;
            horizontal-alignment: center;
        }

        // Plain centered row, no Flickable/scroll — profile counts are
        // realistically small (Bonfire itself caps at 5 sub-profiles per
        // master, plus however many independently-remembered plain
        // accounts), so keyboard Left/Right just moves the cursor; nothing
        // to scroll into view. Simpler and safer than a Flickable's own
        // viewport-x/kb-x math for a row this short.
        // No "+ Add Account" tile here anymore (2026-08-14, the 2-tier
        // redesign) — this screen is always scoped to one already-known
        // account's own profiles now; adding a brand-new account lives on
        // the account-tier picker (or Settings → Profiles) instead. Cursor
        // range is exactly 0..tile-count-1, no trailing "+1" slot.
        tile-row := HorizontalLayout {
            alignment: center;
            spacing:   24px;

            for t[i] in AppState.profile-picker-profiles: ProfileTileCard {
                tile:        t;
                // !back-focused/!quit-focused exclude the tile ring while a
                // different zone holds focus instead — same "exclude other
                // on-screen zones from the card's own focus ring" convention
                // established for LibraryGrid/BrowseItem (CLAUDE.md).
                kbd-focused: AppState.profile-picker-cursor == i
                    && !AppState.profile-picker-back-focused
                    && !AppState.profile-picker-quit-focused;
                activated => {
                    // A mouse click must sync the same state keyboard
                    // dispatch reads, so a keypress right after a click acts
                    // on what was actually clicked, not stale cursor state.
                    AppState.profile-picker-cursor = i;
                    AppState.profile-picker-back-focused = false;
                    AppState.profile-picker-quit-focused = false;
                    AppState.profile-picker-select(t.user-id);
                }
            }
        }

        if AppState.profile-picker-error != "": Text {
            text:                 AppState.profile-picker-error;
            color:                Theme.error;
            font-size:            13px;
            horizontal-alignment: center;
        }
    }

    FjordButton {
        text:        "Quit";
        width:       90px;
        x:           parent.width  - self.width  - 16px;
        y:           parent.height - self.height - 16px;
        // 2026-08-16, same keyboard-reachability fix as "← Back to
        // Accounts" above, prompted directly ("quit it not also reacheble
        // by keybord navigation") — Down from the tile row focuses it, Up
        // returns, Enter activates.
        kbd-focused: AppState.profile-picker-quit-focused;
        clicked => {
            AppState.profile-picker-quit-focused = false;
            AppState.quit();
        }
    }

    // 2026-08-14, the 2-tier redesign — only reachable when 2+ distinct
    // accounts actually exist (profile-picker-show-back-to-accounts, set
    // in profile::open_profile_picker regardless of whether the account
    // tier was actually shown on the way here).
    if AppState.profile-picker-show-back-to-accounts: FjordButton {
        text:        "← Back to Accounts";
        width:       170px;
        x:           16px;
        y:           16px;
        // 2026-08-16, real bug: this button was mouse-only — visible and
        // clickable but with no keyboard CURSOR path onto it at all (only
        // the Escape/Backspace shortcut reached the same action). kbd-focused
        // drives FjordButton's own focus-ring + press-pulse automatically;
        // keys.rs's raw-key dispatch sets profile-picker-back-focused on Up
        // from the tile row and clears it on Down, matching every other
        // "Back button" convention in this app (Detail/Season/Collection/
        // Album/Artist).
        kbd-focused: AppState.profile-picker-back-focused;
        clicked => {
            AppState.profile-picker-back-focused = false;
            AppState.profile-picker-back-to-accounts();
        }
    }

    // ── PIN entry — layered sub-state, same dim-backdrop-plus-box shape as
    // RequestOptionsOverlay/PlaylistPicker ─────────────────────────────────
    if AppState.show-profile-pin-entry: Rectangle {
        background: #00000088;

        TouchArea {
            width: parent.width; height: parent.height;
            // No-op click-through-blocker for the backdrop — unlike
            // RequestOptionsOverlay, cancelling out of PIN entry back to the
            // grid is a deliberate Back/Escape action (dispatch_profile_pin_entry
            // in keys.rs), not a bare backdrop click, since an accidental
            // stray click here shouldn't silently abandon a partially-typed PIN.
        }

        Rectangle {
            x: (parent.width  - self.width)  / 2;
            y: (parent.height - self.height) / 2;
            width:         360px;
            height:        pin-content.preferred-height + 32px;
            border-radius: Theme.radius-lg;
            background:    Theme.surface-raised;
            border-width:  1px;
            border-color:  Theme.border-strong;
            drop-shadow-blur:     20px;
            drop-shadow-color:    #000000aa;
            drop-shadow-offset-y: 6px;

            TouchArea { width: parent.width; height: parent.height; }

            pin-content := VerticalLayout {
                x: 16px; y: 16px;
                width: parent.width - 32px;
                spacing: 16px;
                alignment: center;

                Text {
                    text:                 "Enter PIN for " + AppState.profile-pin-target-name;
                    color:                Theme.text;
                    font-size:            15px;
                    font-weight:          700;
                    horizontal-alignment: center;
                    wrap:                 word-wrap;
                }

                // Masked digit dots — up to 8 shown; a PIN longer than that
                // just keeps the last 8 dots lit rather than growing the box
                // (Bonfire's own docs don't document a max PIN length).
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    for d in 8: Rectangle {
                        width:  14px;
                        height: 14px;
                        border-radius: 7px;
                        background: d < AppState.profile-pin-len ? Theme.accent : Theme.surface-overlay;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                    }
                }

                if AppState.profile-pin-error != "": Text {
                    text:                 AppState.profile-pin-error;
                    color:                Theme.error;
                    font-size:            12px;
                    horizontal-alignment: center;
                    wrap:                 word-wrap;
                }

                Rectangle {
                    height: pad.preferred-height;
                    pad := VirtualKeyboard {
                        x: (parent.width - self.width) / 2;
                        cursor: AppState.profile-pin-cursor;
                        key-pressed(k) => {
                            AppState.profile-pin-cancel-focused = false;
                            AppState.profile-pin-key(k);
                        }
                    }
                }

                // Real bug, live-reported 2026-08-17: "there is no
                // backbutton or so so nothing dpad navigatible or mouse
                // svigatible to get back... cant close the pin screen
                // without escape ether" — this was plain hint text with no
                // actual control behind it. A real FjordButton, D-pad
                // reachable via Down past the keypad's bottom row (keys.rs)
                // and mouse-clickable directly.
                cancel-btn := FjordButton {
                    text: "← Cancel";
                    width: 120px;
                    x: (parent.width - self.width) / 2;
                    kbd-focused: AppState.profile-pin-cancel-focused;
                    clicked => {
                        AppState.profile-pin-cancel-focused = false;
                        AppState.show-profile-pin-entry = false;
                        AppState.profile-pin-error = "";
                    }
                }
            }
        }
    }

    // ── Loading overlay — a switch is in flight (network round trip to
    // Bonfire's /switch or a plain-account revalidation, then the new
    // session's own home/series/system-info fetches). Declared last so it
    // draws on top of both the tile grid AND the PIN modal above — a
    // PIN-confirmed switch leaves that modal technically still "open"
    // underneath for the whole duration otherwise. Live-reported
    // 2026-08-14: "you press enter and nothing happens for a really long
    // time then you get in to fjord, no feedback whats going on."
    if AppState.profile-picker-loading: Rectangle {
        background: #000000c0;

        VerticalLayout {
            alignment: center;
            spacing:   20px;

            LoadingSpinner { }

            Text {
                text:                 "Signing in…";
                color:                Theme.text;
                font-size:            15px;
                horizontal-alignment: center;
            }
        }
    }
}
