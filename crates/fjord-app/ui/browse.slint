// ── fjord-app · browse.slint ─────────────────────────────────────────────────
//   BrowseScreen  Browse All: keyboard-driven search bar (browse-query, caret at browse-query-cursor)
//                 + scrollable list; on-screen keyboard window-centered, target-guarded
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import { FjordButton, BrowseItem, QwertyKeyboard } from "widgets.slint";

export component BrowseScreen inherits Rectangle {
    background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 54px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: Theme.sp-sm;
                padding-right: Theme.sp;
                spacing: Theme.sp-sm;
                alignment: start;

                FjordButton {
                    text: "← Back";
                    width: 80px * AppState.text-scale;
                    clicked => {
                        AppState.browse-header-focused = false;
                        AppState.current-item = -1;
                        AppState.show-browse = false;
                        AppState.browse-search-clear();
                        // Browse All is nav 5 since the Phase 40 renumbering (3 is
                        // Collections now). The stale ==3 check left active-nav at 5
                        // with no screen mapped to it — a blank content area.
                        if AppState.active-nav == 5 { AppState.active-nav = 0; }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    border-radius: Theme.radius;
                    border-width: search-ta.pressed ? 4px : (AppState.browse-header-focused ? 2px : 1px);
                    border-color: AppState.browse-header-focused ? Theme.focus-border : Theme.border;
                    background: Theme.bg;
                    animate border-width {
                        duration: 90ms * AppState.settings-animation-speed;
                        easing: ease-out-expo;
                    }

                    search-ta := TouchArea {
                        clicked => {
                            AppState.browse-header-focused = true;
                            AppState.current-item = -1;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            // U+1F50D 🔍 — in Noto Sans Symbols 2 (U+2315 ⌕ isn't, and showed as tofu without a system
                            // fallback).
                            text: "🔍";
                            font-family: "Noto Sans Symbols 2";
                            color: AppState.browse-header-focused ? Theme.accent : Theme.text-muted;
                            font-size: 17px * AppState.text-scale;
                            vertical-alignment: center;
                            width: 22px * AppState.text-scale;
                        }

                        Text {
                            text: AppState.browse-header-focused
                                ? AppState.caret-text(AppState.browse-query, AppState.browse-query-cursor, "|")
                                : AppState.browse-query != "" ? AppState.browse-query
                                : "Search…";
                            color: AppState.browse-query != "" ? Theme.text
                                : AppState.browse-header-focused ? Theme.text-muted
                                : Theme.text-subtle;
                            font-size: 14px * AppState.text-scale;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if AppState.browse-query != "" && !AppState.browse-header-focused: Text {
                            text: "Esc to clear";
                            color: Theme.text-subtle;
                            font-size: 12px * AppState.text-scale;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        list-container := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            property <length> kb-y: AppState.current-item < 0 ? 0px
                : clamp(
                      -(AppState.current-item * 42px + 21px - self.height / 2),
                      min(0px, self.height - AppState.media-items.length * 42px),
                      0px);
            changed kb-y => { list-flick.content-y = kb-y; }

            list-flick := Flickable {
                interactive: true;
                content-height: AppState.media-items.length * 42px;
                animate content-y {
                    duration: 150ms * AppState.settings-scroll-speed;
                    easing: ease-out-expo;
                }

                VerticalLayout {
                    for item[i] in AppState.media-items: BrowseItem {
                        text: item.text;
                        // No row highlight while the search field has focus (current-item keeps the old row), like
                        // LibraryGrid.
                        selected: i == AppState.current-item && !AppState.browse-header-focused;
                        clicked => { AppState.current-item = i; AppState.browse-header-focused = false; }
                        activated => { AppState.play-item(i); }
                        right-clicked => { AppState.open-context-menu-browse(i); }
                    }
                }
            }

            // A search that found nothing says so (the list used to just go blank). Results land async,
            // but the previous list stays until they do, so this can't flash mid-search.
            if AppState.browse-query != "" && AppState.media-items.length == 0: Text {
                text: "No results for \"\{AppState.browse-query}\"";
                color: Theme.text-muted;
                font-size: 14px * AppState.text-scale;
                horizontal-alignment: center;
                y: parent.height / 3;
                width: parent.width;
            }
        }

        Rectangle {
            height: 50px;
            background: Theme.surface;

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: Theme.sp;
                padding-right: Theme.sp;
                padding-top: Theme.sp-xs;
                spacing: Theme.sp;
                alignment: space-between;

                Text {
                    text: AppState.status;
                    color: Theme.text-muted;
                    font-size: 13px * AppState.text-scale;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                FjordButton {
                    icon-left: "▶";
                    text: "Play";
                    width: 100px * AppState.text-scale;
                    enabled: AppState.current-item >= 0;
                    clicked => { AppState.play-item(AppState.current-item); }
                }
            }
        }
    }

    // On-screen alphanumeric keyboard. BrowseScreen is permanently mounted (toggled with
    // `visible`), so the target check is essential — without it this would react to every other
    // screen's keys while hidden.
    if AppState.show-onscreen-keyboard && AppState.settings-onscreen-keyboard-enabled && AppState.onscreen-keyboard-target == "browse-search": QwertyKeyboard {
        x: (parent.width - self.width) / 2;
        // Window-centered: the search field sits in the top header bar, never under a centered
        // keyboard.
        y: (parent.height - self.height) / 2;
        cursor: AppState.onscreen-keyboard-cursor;
        active: AppState.show-onscreen-keyboard;
        key-pressed(k) => {
            if k == "done" { AppState.show-onscreen-keyboard = false; }
            else if k == "backspace" { AppState.browse-search-backspace(); }
            else if k == "left" || k == "right" { AppState.text-field-caret("browse-search", k == "left" ? -1 : 1); }
            else { AppState.browse-search-append(k); }
        }
    }

    property <int> _physical-key-mirror: AppState.onscreen-keyboard-physical-key-seq;
    changed _physical-key-mirror => {
        if AppState.show-onscreen-keyboard && AppState.onscreen-keyboard-target == "browse-search" {
            if AppState.onscreen-keyboard-physical-key == "backspace" { AppState.browse-search-backspace(); }
            else { AppState.browse-search-append(AppState.onscreen-keyboard-physical-key); }
        }
    }
}
