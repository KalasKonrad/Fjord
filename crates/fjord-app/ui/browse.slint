// ── fjord-app · browse.slint ─────────────────────────────────────────────────
//   BrowseScreen  keyboard-driven search bar (browse-query) + scrollable ListView
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import { FjordButton, BrowseItem, QwertyKeyboard } from "widgets.slint";

export component BrowseScreen inherits Rectangle {
    background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height:     54px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left:  Theme.sp-sm;
                padding-right: Theme.sp;
                spacing:       Theme.sp-sm;
                alignment:     start;

                FjordButton {
                    text:  "← Back";
                    width: 80px;
                    clicked => {
                        AppState.browse-header-focused = false;
                        AppState.current-item = -1;
                        AppState.show-browse  = false;
                        AppState.browse-search-clear();
                        // Browse All is nav 5 since the Phase 40 renumbering (3 is
                        // Collections now). The stale ==3 check left active-nav at 5
                        // with no screen mapped to it — a blank content area.
                        if AppState.active-nav == 5 { AppState.active-nav = 0; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height:             36px;
                    border-radius:      Theme.radius;
                    border-width:       search-ta.pressed ? 4px : (AppState.browse-header-focused ? 2px : 1px);
                    border-color:       AppState.browse-header-focused ? Theme.focus-border : Theme.border;
                    background:         Theme.bg;
                    animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }

                    search-ta := TouchArea {
                        clicked => {
                            AppState.browse-header-focused = true;
                            AppState.current-item = -1;
                        }
                    }

                    HorizontalLayout {
                        padding-left:  12px;
                        padding-right: 12px;
                        spacing:       8px;
                        alignment:     start;

                        Text {
                            // U+2315 (⌕) was pinned to Noto Sans Symbols 2 on
                            // the assumption it lived there — it doesn't (confirmed
                            // via fc-query cmap inspection against the actual bundled
                            // .ttf, 2026-07-22, PLAN.md Issues: "my htpc dosent have
                            // the symbol for search"), so the font-family pin never
                            // helped and this fell through to system fallback, tofu
                            // on any minimal install. U+1F50D (🔍, the real magnifying-
                            // glass codepoint) genuinely IS in Symbols2's cmap.
                            text:               "🔍";
                    font-family:        "Noto Sans Symbols 2";
                            color:              AppState.browse-header-focused ? Theme.accent : Theme.text-muted;
                            font-size:          17px;
                            vertical-alignment: center;
                            width:              22px;
                        }
                        Text {
                            text: AppState.browse-header-focused
                                ? (AppState.browse-query != "" ? AppState.browse-query + "▌" : "▌")
                                : AppState.browse-query != "" ? AppState.browse-query
                                : "Search…";
                            color: AppState.browse-query != "" ? Theme.text
                                 : AppState.browse-header-focused ? Theme.text-muted
                                 : Theme.text-subtle;
                            font-size:          14px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if AppState.browse-query != "" && !AppState.browse-header-focused: Text {
                            text:               "Esc to clear";
                            color:              Theme.text-subtle;
                            font-size:          12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }

        list-container := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch:   1;
            property <length> kb-y: AppState.current-item < 0 ? 0px
                : clamp(
                      -(AppState.current-item * 42px + 21px - self.height / 2),
                      min(0px, self.height - AppState.media-items.length * 42px),
                      0px
                  );
            changed kb-y => { list-flick.viewport-y = kb-y; }

            list-flick := Flickable {
                interactive:     true;
                viewport-height: AppState.media-items.length * 42px;
                animate viewport-y { duration: 150ms * AppState.settings-scroll-speed; easing: ease-out-expo; }

                VerticalLayout {
                    for item[i] in AppState.media-items: BrowseItem {
                        text:     item.text;
                        // Same bug/fix as LibraryGrid's own card highlight
                        // (2026-08-12) — current-item stays set to whatever
                        // row you were on when Up-from-row-0 moves focus to
                        // the search field (browse-header-focused), so
                        // without this exclusion that row kept showing
                        // selected even though the search field is what
                        // actually has focus now.
                        selected: i == AppState.current-item && !AppState.browse-header-focused;
                        clicked        => { AppState.current-item = i; AppState.browse-header-focused = false; }
                        activated      => { AppState.play-item(i); }
                        right-clicked  => { AppState.open-context-menu-browse(i); }
                    }
                }
            }
        }

        Rectangle {
            height:     50px;
            background: Theme.surface;

            Rectangle { height: 1px; background: Theme.border; }

            HorizontalLayout {
                padding-left:  Theme.sp;
                padding-right: Theme.sp;
                padding-top:   Theme.sp-xs;
                spacing:       Theme.sp;
                alignment:     space-between;

                Text {
                    text:               AppState.status;
                    color:              Theme.text-muted;
                    font-size:          13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                FjordButton {
                    icon-left: "▶";
                    text:    "Play";
                    width:   100px;
                    enabled: AppState.current-item >= 0;
                    clicked => { AppState.play-item(AppState.current-item); }
                }
            }
        }
    }

    // On-screen alphanumeric keyboard (2026-08-23, full rollout beyond
    // Login). Real gap this screen needs guarding against that Discover
    // doesn't: BrowseScreen is a PERMANENTLY-mounted sibling (visible:
    // AppState.show-browse toggles it, per this screen's own established
    // mount-lifecycle history), never conditionally created/destroyed — so
    // without the target check below, this tracker would fire on EVERY
    // other screen's physical-keyboard keystroke too, not just its own,
    // even while Browse is fully hidden.
    if AppState.show-onscreen-keyboard && AppState.onscreen-keyboard-target == "browse-search": QwertyKeyboard {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 16px;
        cursor: AppState.onscreen-keyboard-cursor;
        active: AppState.show-onscreen-keyboard;
        key-pressed(k) => {
            if k == "done" { AppState.show-onscreen-keyboard = false; }
            else if k == "backspace" { AppState.browse-search-backspace(); }
            else { AppState.browse-search-append(k); }
        }
    }

    property <int> _physical-key-mirror: AppState.onscreen-keyboard-physical-key-seq;
    changed _physical-key-mirror => {
        if AppState.show-onscreen-keyboard && AppState.onscreen-keyboard-target == "browse-search" {
            if AppState.onscreen-keyboard-physical-key == "backspace" { AppState.browse-search-backspace(); }
            else { AppState.browse-search-append(AppState.onscreen-keyboard-physical-key); }
        }
    }
}
