// ── fjord-app · collection.slint ─────────────────────────────────────────────
//   CollectionScreen  BoxSet detail (Enter on a BoxSet in Collections): backdrop hero, Back, title
//                     column (a plain Rectangle fixed at PosterBlock's 240px, width from root.width
//                     — not parent.width, binding loop — title/item count/overview at the top,
//                     ♥/✓/⛔ pinned at y = parent.height - 38px), member grid, then the "Missing
//                     From This Collection" row. ⛔ (only with seerr-can-manage-blocklist) opens a
//                     ConfirmDialog: it blocklists the whole TMDB collection.
//                     Focus: collection-focused (card), collection-back-focused, the button row,
//                     collection-missing-focused >= 0 (Down from the grid's last row). Enter on a
//                     card → open-detail; C → context menu; Back → close.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import {
    FjordButton,
    MediaCard,
    PosterBlock,
    IconCircleButton,
    ConfirmDialog,
} from "widgets.slint";
import { SectionRow } from "home.slint";

export component CollectionScreen inherits Rectangle {
    property <length> card-w: 145px * AppState.card-scale;
    property <length> card-h: 224px * AppState.card-scale;
    property <length> gap:    14px;
    property <length> grid-content-height:
        ((AppState.collection-items.length + AppState.library-cols - 1) / AppState.library-cols)
        * (card-h + gap) + gap;

    property <length> kb-y:
        AppState.collection-missing-focused >= 0 ?
        clamp(root.height / 2 - missing-anchor.y, min(0px, root.height - coll-content.preferred-height), 0px) :
        clamp(
            -(AppState.collection-focused / AppState.library-cols) * (card-h + gap) + fl-container.height / 2 - card-h / 2,
            min(0px, fl-container.height - grid-content-height),
            0px);
    // Missing-row case scrolls the OUTER page Flickable (fl) — the new row
    // sits below fl-container entirely, outside coll-fl's own scope; the
    // pre-existing grid case is untouched, still targeting coll-fl exactly
    // as before this row was added.
    changed kb-y => {
        if AppState.collection-missing-focused >= 0 {
            fl.content-y = kb-y;
        } else {
            coll-fl.content-y = kb-y;
        }
    }

    fl := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: coll-content.preferred-height;
        content-width: self.width;
        animate content-y {
            duration: 200ms * AppState.settings-scroll-speed;
            easing: ease-in-out;
        }

        coll-content := VerticalLayout {

            // ── Header: backdrop + title block ────────────────────────────────
            Rectangle {
                background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;

                if AppState.collection-has-backdrop: Image {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                    source: AppState.collection-backdrop;
                }
                if AppState.collection-has-backdrop: Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    background: @linear-gradient(180deg, Theme.hero-fade-top 0%, Theme.hero-fade-bottom 100%);
                }

                VerticalLayout {
                    HorizontalLayout {
                        padding-left: 48px;
                        padding-right: 48px;
                        padding-top: 68px;
                        padding-bottom: 24px;
                        spacing: 32px;
                        alignment: start;

                        if AppState.collection-has-poster: PosterBlock {
                            source: AppState.collection-poster;
                            has-image: true;
                        }

                        // Plain Rectangle fixed at 240px (PosterBlock's height): title/item count/overview at the
                        // top, the ♥/✓ row pinned at `y: parent.height - 38px` (IconCircleButton is 38px) — neither
                        // depends on the other's size (same fix as detail.slint).
                        Rectangle {
                            height: 240px;
                            // Width from root.width (horizontal-stretch doesn't work on a plain Rectangle; parent.width
                            // is a binding loop — see detail.slint): minus the padding (48+48), PosterBlock (160) and the
                            // spacing (32).
                            width: root.width - 48px - 48px - 160px - 32px;

                            VerticalLayout {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                spacing: 12px;
                                alignment: start;

                                Text {
                                    text: AppState.collection-title;
                                    color: Theme.text;
                                    font-size: 28px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }

                                if AppState.collection-items.length > 0: Text {
                                    text: AppState.plural(AppState.collection-items.length, "item", "items");
                                    color: AppState.collection-has-backdrop ? Theme.text-soft : Theme.text-muted;
                                    font-size: 14px * AppState.text-scale;
                                }

                                if AppState.collection-overview != "": Text {
                                    text: AppState.collection-overview;
                                    color: AppState.collection-has-backdrop ? Theme.text-soft : Theme.text-muted;
                                    font-size: 13px * AppState.text-scale;
                                    wrap: word-wrap;
                                    max-width: 620px;
                                }
                            }

                            HorizontalLayout {
                                x: 0;
                                y: parent.height - 38px;
                                spacing: 10px;
                                alignment: start;
                                IconCircleButton {
                                    icon: "❤";
                                    active: AppState.collection-is-favorite;
                                    kbd-focused: AppState.collection-btn-focused == 0;
                                    clicked => { AppState.toggle-collection-fav(); }
                                }

                                IconCircleButton {
                                    icon: "✓";
                                    active: AppState.collection-has-played;
                                    kbd-focused: AppState.collection-btn-focused == 1;
                                    clicked => { AppState.toggle-collection-played(); }
                                }
                                // Blocklist the whole TMDB collection — no `active` state (no single "is it blocklisted"
                                // flag), and it asks first: it blocklists every part of the franchise, globally.
                                if AppState.seerr-can-manage-blocklist: IconCircleButton {
                                    icon: "⛔";
                                    kbd-focused: AppState.collection-btn-focused == 2;
                                    clicked => {
                                        AppState.collection-btn-focused = 2;
                                        AppState.collection-blocklist-confirm-focused = 0;
                                        AppState.collection-blocklist-confirm-open = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // ── Member grid ───────────────────────────────────────────────────
            fl-container := Rectangle {
                height: grid-content-height;
                horizontal-stretch: 1;

                coll-fl := Flickable {
                    content-width: fl-container.width;
                    content-height: max(fl-container.height, grid-content-height);
                    animate content-y {
                        duration: 150ms * AppState.settings-scroll-speed;
                        easing: ease-out-expo;
                    }

                    VerticalLayout {
                        padding: gap;
                        spacing: gap;

                        for row-idx in (AppState.collection-items.length + AppState.library-cols - 1) / AppState.library-cols: HorizontalLayout {
                            // The focused card's row draws above the next one (its zoom reaches into the gap).
                            z: floor(AppState.collection-focused / AppState.library-cols) == row-idx ? 1 : 0;
                            alignment: start;
                            spacing: gap;
                            height: card-h;

                            for col-idx in AppState.library-cols: MediaCard {
                                property <int> idx: row-idx * AppState.library-cols + col-idx;
                                // Edge cards zoom inward so the grid's edges don't cut them off.
                                zoom-anchor-x: col-idx == 0 ? 0 : col-idx == AppState.library-cols - 1 ? 1 : 0.5;
                                zoom-anchor-y: row-idx == 0 ? 0 : row-idx == floor((AppState.collection-items.length - 1) / AppState.library-cols) ? 1 : 0.5;
                                visible: idx < AppState.collection-items.length;
                                item: AppState.collection-items[idx];
                                width: card-w;
                                focused: idx == AppState.collection-focused && !AppState.collection-back-focused
                                    && AppState.collection-btn-focused < 0 && AppState.collection-missing-focused < 0;
                                clicked => {
                                    AppState.collection-focused = idx;
                                    AppState.collection-back-focused = false;
                                    AppState.collection-btn-focused = -1;
                                    AppState.collection-missing-focused = -1;
                                    let c = AppState.collection-items[idx];
                                    AppState.open-detail(c.id, c.item-type);
                                }
                                right-clicked => {
                                    let c = AppState.collection-items[idx];
                                    AppState.context-menu-title = c.title;
                                    AppState.open-context-menu(c.id, c.has-played, c.is-favorite, c.resume-pct, c.item-type, c.series-id);
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: gap;
            }

            // ── Missing-anchor (scroll target) ─────────────────────────────────
            missing-anchor := Rectangle {
                height: 0px;
            }

            // ── Missing From This Collection (Discover-sourced, 2026-07-29) ────
            if AppState.collection-missing.length > 0: VerticalLayout {
                padding-left: 48px;
                padding-right: 48px;
                padding-bottom: 40px;

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                Rectangle {
                    height: 12px;
                }

                SectionRow {
                    section-title: "Missing From This Collection";
                    items: AppState.collection-missing;
                    section-focused: AppState.collection-missing-focused >= 0;
                    focused-card: AppState.collection-missing-focused;
                    item-play(id, it) => { AppState.open-discover-item(it == "DiscoverMovie" ? "movie" : "tv", id); }
                    item-context-full(itm) => { AppState.open-context-menu-discover(itm); }
                }
            }
        }
    }

    // Floating Back button — same position as detail.slint, overlaid on the backdrop
    FjordButton {
        x: 16px;
        y: 16px;
        text: "← Back";
        width: 88px * AppState.text-scale;
        kbd-focused: AppState.collection-back-focused;
        clicked => { AppState.show-collection = false; }
    }

    // Bulk-blocklist confirm dialog (2026-08-06, Seerr Blocklist support) —
    // declared last so it renders on top of everything else on this screen,
    // same z-order convention as every other overlay-on-a-screen in this app.
    if AppState.collection-blocklist-confirm-open: ConfirmDialog {
        title: "Blocklist Collection?";
        message: "This blocklists every movie in this collection on your Seerr server, preventing anyone from requesting them.";
        confirm-label: "Blocklist";
        focused: AppState.collection-blocklist-confirm-focused;
        confirmed => { AppState.collection-blocklist-confirm(); }
        cancelled => { AppState.collection-blocklist-confirm-open = false; }
    }
}
