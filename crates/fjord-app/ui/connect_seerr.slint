// ── fjord-app · connect_seerr.slint ──────────────────────────────────────────
//   MethodTab           one sign-in method tab (ring + press pulse only on the active tab)
//   ConnectSeerrScreen  free-floating overlay, mounted by main.slint's gate30 FadeGate (the gate
//                       must live at the mount site). A server URL LineEdit shared by the 4 methods
//                       (API key, Jellyfin, Quick Connect, local account), a tab row picks which
//                       fields show below. Success (seerr_auth.rs) closes the screen; errors stay
//                       on-screen, not a toast. root.close-screen() is the one close path (backdrop,
//                       ✕, Escape) and also closes the on-screen keyboard; keys.rs's own close
//                       sites do the same in Rust (keep in sync).
//   D-pad zones         connect-seerr-zone (see app_state.slint): -1 ✕, 0 url-input, 1 tab row
//                       (Left/Right switch the method), 2+ the method's fields, the last zone is
//                       always its submit/"Get Code" button (seerr_auth::existing_connect_seerr_zones);
//                       dispatched inline in keys.rs's show_connect_seerr tier. init focuses url-input.
//   Text entry          Enter in a field opens the on-screen keyboard (QwertyKeyboard, clamped to the
//                       window bottom); keys edit at its caret (onscreen-keyboard-edit). With the
//                       keyboard off: Enter in the URL → the method's first field, user/email →
//                       password, the last field presses Save / Sign In. Submitting is otherwise the
//                       button (no `accepted =>` handlers). Double Enters are blocked by
//                       !connect-seerr-busy.
//   Relay               the 5 method-specific fields sit in `if connect-seerr-method == N:` blocks
//                       and can't be referenced from root: dispatch-onscreen-key handles "done" and
//                       url-input itself and relays the rest through _relay-key/-seq, picked up by a
//                       local tracker in each block (same for focus restore, zone→focus and the
//                       Enter-driven submit). A mouse tab switch while the keyboard targets an old
//                       tab's field closes it (close-keyboard-if-orphaned).
//   Coexistence guard   is-my-onscreen-target(): the keyboard mount and _physical-key-mirror check
//                       the target, so two screens' keyboards never cross-fire.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import {
    FjordButton,
    FieldFocusWrap,
    QwertyKeyboard,
    PressPulse,
} from "widgets.slint";
import { LineEdit } from "std-widgets.slint";

component MethodTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> kbd-focused;
    callback clicked;

    height: 34px;
    border-radius: Theme.radius;
    background: active ? Theme.accent : (ta.has-hover ? Theme.surface : transparent);
    // Persistent 2px ring + 3px press flash (VirtualKeyboardKey's convention) — only on the
    // ACTIVE tab: all four tabs share one zone (1) and Left/Right switch the active tab, so
    // kbd-focused alone would ring every tab at once.
    border-width: (ta.pressed || pulse.pulsing) ? 3px : (kbd-focused && active ? 2px : 0px);
    border-color: Theme.focus-border;
    animate border-width, background {
        duration: 90ms * AppState.settings-animation-speed;
        easing: ease-out-expo;
    }
    pulse := PressPulse {
        trigger: AppState.kb-activate-pulse;
        active: root.active && root.kbd-focused;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: label;
        // White on the accent fill, like every other accent-filled control.
        color: active ? #ffffff : Theme.text;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ConnectSeerrScreen inherits Rectangle {
    background: #000000aa;

    function close-screen() {
        AppState.show-connect-seerr = false;
        AppState.show-onscreen-keyboard = false;
        AppState.onscreen-keyboard-target = "";
        AppState.onscreen-keyboard-cursor = 0;
    }

    // Real native focus into url-input on mount, and zone 0 set with it (like login-zone). A
    // direct call is safe here (the screen only opens from a running UI; LoginScreen needs a
    // Timer for its cold start). Without it, a reopen with the zone already 0 never fires the
    // zone→focus tracker (`changed` needs a real transition), leaving url-input unfocused.
    init => {
        AppState.connect-seerr-zone = 0;
        url-input.focus();
    }

    // Payload+counter relay for keystrokes bound for one of the 5
    // conditionally-mounted method-specific fields — see this file's own
    // header doc comment for why root-level code can't reach them directly.
    property <string> _relay-key: "";
    property <int> _relay-key-seq: 0;

    pure function is-my-onscreen-target() -> bool {
        AppState.onscreen-keyboard-target == "connect-seerr-url"
            || AppState.onscreen-keyboard-target == "connect-seerr-key"
            || AppState.onscreen-keyboard-target == "connect-seerr-jf-user"
            || AppState.onscreen-keyboard-target == "connect-seerr-jf-pass"
            || AppState.onscreen-keyboard-target == "connect-seerr-local-email"
            || AppState.onscreen-keyboard-target == "connect-seerr-local-pass"
    }

    // A mouse click on another tab while the keyboard targets a field of the OLD tab unmounts
    // that field and its `_relay-mirror`, so the open keyboard would silently stop typing.
    // Close it then; "connect-seerr-url" is mounted on every tab and stays.
    function close-keyboard-if-orphaned() {
        if AppState.show-onscreen-keyboard && AppState.onscreen-keyboard-target != "connect-seerr-url" {
            AppState.show-onscreen-keyboard = false;
            AppState.onscreen-keyboard-target = "";
            AppState.onscreen-keyboard-cursor = 0;
        }
    }

    function dispatch-onscreen-key(k: string) {
        if k == "done" {
            AppState.show-onscreen-keyboard = false;
        } else if AppState.onscreen-keyboard-target == "connect-seerr-url" {
            // At the keyboard's own caret (◀ ▶ move it, 2026-10-05).
            let r = AppState.onscreen-keyboard-edit(url-input.text, AppState.onscreen-keyboard-caret, k);
            url-input.text = r.text;
            AppState.onscreen-keyboard-caret = r.caret;
            url-input.set-selection-offsets(r.byte, r.byte);
        } else {
            root._relay-key = k;
            root._relay-key-seq += 1;
        }
    }

    close-ta := TouchArea {
        clicked => { root.close-screen(); AppState.refocus(); }
    }

    card := Rectangle {
        width: min(460px, parent.width - 48px);
        height: inner.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        drop-shadow-blur: 28px;
        drop-shadow-color: #00000070;

        // Swallow clicks so the backdrop TouchArea above doesn't close the
        // card when interacting with it.
        card-ta := TouchArea { }

        inner := VerticalLayout {
            padding: Theme.sp-xl;
            spacing: Theme.sp;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Connect Seerr";
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 700;
                }

                FjordButton {
                    text: "✕";
                    width: 32px;
                    height: 32px;
                    kbd-focused: AppState.connect-seerr-zone == -1;
                    clicked => {
                        AppState.connect-seerr-zone = -1;
                        root.close-screen();
                        AppState.refocus();
                    }
                }
            }

            url-field-wrap := FieldFocusWrap {
                focused: AppState.show-onscreen-keyboard && AppState.connect-seerr-zone == 0;
                url-input := LineEdit {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    placeholder-text: "Seerr URL  (e.g. seerr.example.com or 192.168.1.10:5055)";
                    changed has-focus => {
                        if self.has-focus {
                            AppState.connect-seerr-zone = 0;
                            if AppState.show-onscreen-keyboard {
                                AppState.onscreen-keyboard-target = "connect-seerr-url";
                                // Retargeting by mouse lands on Done, like every open site.
                                AppState.onscreen-keyboard-cursor = AppState.onscreen-keyboard-done-cursor;
                            }
                        }
                    }
                    key-pressed(event) => {
                        if event.text == "\u{1b}" {
                            root.close-screen();
                            AppState.refocus();
                            return accept;
                        }
                        if event.text == "\u{F700}" {
                            // Up from url-input (the top zone) goes to Close — nothing sits between them.
                            AppState.connect-seerr-zone = -1;
                            AppState.refocus();
                            return accept;
                        }
                        // Down leaves this field entirely and hands off via
                        // connect-seerr-zone + refocus() to the tab row
                        // (zone 1), which is ALWAYS present regardless of
                        // tab/polling state — unlike the old numbering,
                        // this needs no qc-polling special case at all,
                        // since the tab row is never absent the way a
                        // per-tab button can be.
                        if event.text == "\u{F701}" {
                            AppState.connect-seerr-zone = 1;
                            AppState.refocus();
                            return accept;
                        }
                        if event.text == "\u{000a}" {
                            // On-screen keyboard off in Settings: Enter moves on to the sign-in method's first field.
                            if !AppState.open-onscreen-keyboard("connect-seerr-url") {
                                // The chosen method's first field (its local zone mirror focuses
                                // it); Quick Connect's zone 2 is its Get Code button.
                                AppState.connect-seerr-zone = 2;
                                if AppState.connect-seerr-method == 2 { AppState.refocus(); }
                            }
                            return accept;
                        }
                        return reject;
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                MethodTab {
                    label: "API Key";
                    active: AppState.connect-seerr-method == 0;
                    kbd-focused: AppState.connect-seerr-zone == 1;
                    clicked => { AppState.connect-seerr-zone = 1; AppState.connect-seerr-method = 0; AppState.connect-seerr-error = ""; root.close-keyboard-if-orphaned(); }
                }

                MethodTab {
                    label: "Jellyfin";
                    active: AppState.connect-seerr-method == 1;
                    kbd-focused: AppState.connect-seerr-zone == 1;
                    clicked => { AppState.connect-seerr-zone = 1; AppState.connect-seerr-method = 1; AppState.connect-seerr-error = ""; root.close-keyboard-if-orphaned(); }
                }

                MethodTab {
                    label: "Quick Connect";
                    active: AppState.connect-seerr-method == 2;
                    kbd-focused: AppState.connect-seerr-zone == 1;
                    clicked => { AppState.connect-seerr-zone = 1; AppState.connect-seerr-method = 2; AppState.connect-seerr-error = ""; root.close-keyboard-if-orphaned(); }
                }

                MethodTab {
                    label: "Local Account";
                    active: AppState.connect-seerr-method == 3;
                    kbd-focused: AppState.connect-seerr-zone == 1;
                    clicked => { AppState.connect-seerr-zone = 1; AppState.connect-seerr-method = 3; AppState.connect-seerr-error = ""; root.close-keyboard-if-orphaned(); }
                }
            }

            Rectangle {
                height: 2px;
            }

            // ── Method 0: static API key ─────────────────────────────────
            if AppState.connect-seerr-method == 0: VerticalLayout {
                spacing: Theme.sp;
                Text {
                    text: "Paste an API key generated in Seerr's own admin Settings.";
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                key-field-wrap := FieldFocusWrap {
                    focused: AppState.show-onscreen-keyboard && AppState.connect-seerr-zone == 2;
                    key-input := LineEdit {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        placeholder-text: "API key";
                        input-type: password;
                        // No `accepted =>` handler (removed 2026-08-23) —
                        // see this file's own header doc comment.
                        changed has-focus => {
                            if self.has-focus {
                                AppState.connect-seerr-zone = 2;
                                if AppState.show-onscreen-keyboard {
                                    AppState.onscreen-keyboard-target = "connect-seerr-key";
                                    AppState.onscreen-keyboard-cursor = AppState.onscreen-keyboard-done-cursor;
                                }
                            }
                        }
                        key-pressed(event) => {
                            if event.text == "\u{1b}" {
                                root.close-screen();
                                AppState.refocus();
                                return accept;
                            }
                            if event.text == "\u{F700}" {
                                url-input.focus();
                                return accept;
                            }
                            if event.text == "\u{F701}" {
                                AppState.connect-seerr-zone = 3;
                                AppState.refocus();
                                return accept;
                            }
                            if event.text == "\u{000a}" {
                                // On-screen keyboard off in Settings: Enter presses Save.
                                if !AppState.open-onscreen-keyboard("connect-seerr-key") {
                                    if !AppState.connect-seerr-busy { AppState.connect-seerr-api-key(url-input.text, key-input.text); }
                                }
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                FjordButton {
                    text: AppState.connect-seerr-busy ? "Connecting…" : "Save";
                    enabled: !AppState.connect-seerr-busy;
                    kbd-focused: AppState.connect-seerr-zone == 3;
                    clicked => {
                        AppState.connect-seerr-zone = 3;
                        AppState.connect-seerr-api-key(url-input.text, key-input.text);
                    }
                }

                // Local mirrors — this block's own fields (key-input) are
                // conditionally mounted and can't be reached from root-level
                // code, so this tab carries its own small copy of the same
                // relay/close/zone/pulse idiom root-level fields get for
                // free (see this file's own header doc comment).
                property <int> _relay-mirror: root._relay-key-seq;
                changed _relay-mirror => {
                    if AppState.onscreen-keyboard-target == "connect-seerr-key" {
                        // At the keyboard's own caret (◀ ▶ move it, 2026-10-05).
                        let r = AppState.onscreen-keyboard-edit(key-input.text, AppState.onscreen-keyboard-caret, root._relay-key);
                        key-input.text = r.text;
                        AppState.onscreen-keyboard-caret = r.caret;
                        key-input.set-selection-offsets(r.byte, r.byte);
                    }
                }
                property <bool> _kb-close-local-mirror: AppState.show-onscreen-keyboard;
                changed _kb-close-local-mirror => {
                    if !_kb-close-local-mirror && AppState.onscreen-keyboard-target == "connect-seerr-key" {
                        key-input.focus();
                    }
                }
                property <int> _zone-local-mirror: AppState.connect-seerr-zone;
                changed _zone-local-mirror => {
                    if _zone-local-mirror == 2 { key-input.focus(); }
                }
                property <int> _pulse-local-mirror: AppState.kb-activate-pulse;
                changed _pulse-local-mirror => {
                    // !connect-seerr-busy, as the mouse button has via `enabled:` — a bouncing double Enter on a
                    // remote fired two concurrent verify-key attempts.
                    if AppState.show-connect-seerr && AppState.connect-seerr-zone == 3 && !AppState.connect-seerr-busy {
                        AppState.connect-seerr-api-key(url-input.text, key-input.text);
                    }
                }
            }

            // ── Method 1: Jellyfin username/password ─────────────────────
            if AppState.connect-seerr-method == 1: VerticalLayout {
                spacing: Theme.sp;
                jf-user-wrap := FieldFocusWrap {
                    focused: AppState.show-onscreen-keyboard && AppState.connect-seerr-zone == 2;
                    jf-user := LineEdit {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        placeholder-text: "Jellyfin username";
                        changed has-focus => {
                            if self.has-focus {
                                AppState.connect-seerr-zone = 2;
                                if AppState.show-onscreen-keyboard {
                                    AppState.onscreen-keyboard-target = "connect-seerr-jf-user";
                                    AppState.onscreen-keyboard-cursor = AppState.onscreen-keyboard-done-cursor;
                                }
                            }
                        }
                        key-pressed(event) => {
                            if event.text == "\u{1b}" {
                                root.close-screen();
                                AppState.refocus();
                                return accept;
                            }
                            if event.text == "\u{F700}" {
                                url-input.focus();
                                return accept;
                            }
                            if event.text == "\u{F701}" {
                                jf-pass.focus();
                                return accept;
                            }
                            if event.text == "\u{000a}" {
                                // On-screen keyboard off in Settings: Enter moves on to Password.
                                if !AppState.open-onscreen-keyboard("connect-seerr-jf-user") {
                                    AppState.connect-seerr-zone = 3;
                                }
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                jf-pass-wrap := FieldFocusWrap {
                    focused: AppState.show-onscreen-keyboard && AppState.connect-seerr-zone == 3;
                    jf-pass := LineEdit {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        placeholder-text: "Jellyfin password";
                        input-type: password;
                        // No `accepted =>` handler (removed 2026-08-23) —
                        // see this file's own header doc comment.
                        changed has-focus => {
                            if self.has-focus {
                                AppState.connect-seerr-zone = 3;
                                if AppState.show-onscreen-keyboard {
                                    AppState.onscreen-keyboard-target = "connect-seerr-jf-pass";
                                    AppState.onscreen-keyboard-cursor = AppState.onscreen-keyboard-done-cursor;
                                }
                            }
                        }
                        key-pressed(event) => {
                            if event.text == "\u{1b}" {
                                root.close-screen();
                                AppState.refocus();
                                return accept;
                            }
                            if event.text == "\u{F700}" {
                                jf-user.focus();
                                return accept;
                            }
                            if event.text == "\u{F701}" {
                                AppState.connect-seerr-zone = 4;
                                AppState.refocus();
                                return accept;
                            }
                            if event.text == "\u{000a}" {
                                // On-screen keyboard off in Settings: Enter presses Sign In.
                                if !AppState.open-onscreen-keyboard("connect-seerr-jf-pass") {
                                    if !AppState.connect-seerr-busy { AppState.connect-seerr-jellyfin(url-input.text, jf-user.text, jf-pass.text); }
                                }
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                FjordButton {
                    text: AppState.connect-seerr-busy ? "Signing in…" : "Sign In";
                    enabled: !AppState.connect-seerr-busy;
                    kbd-focused: AppState.connect-seerr-zone == 4;
                    clicked => {
                        AppState.connect-seerr-zone = 4;
                        AppState.connect-seerr-jellyfin(url-input.text, jf-user.text, jf-pass.text);
                    }
                }

                // Local mirrors — see the API key tab's own identical block
                // for the full "why" (this file's header doc comment).
                property <int> _relay-mirror: root._relay-key-seq;
                changed _relay-mirror => {
                    if AppState.onscreen-keyboard-target == "connect-seerr-jf-user" {
                        // At the keyboard's own caret (◀ ▶ move it, 2026-10-05).
                        let r = AppState.onscreen-keyboard-edit(jf-user.text, AppState.onscreen-keyboard-caret, root._relay-key);
                        jf-user.text = r.text;
                        AppState.onscreen-keyboard-caret = r.caret;
                        jf-user.set-selection-offsets(r.byte, r.byte);
                    } else if AppState.onscreen-keyboard-target == "connect-seerr-jf-pass" {
                        // At the keyboard's own caret (◀ ▶ move it, 2026-10-05).
                        let r = AppState.onscreen-keyboard-edit(jf-pass.text, AppState.onscreen-keyboard-caret, root._relay-key);
                        jf-pass.text = r.text;
                        AppState.onscreen-keyboard-caret = r.caret;
                        jf-pass.set-selection-offsets(r.byte, r.byte);
                    }
                }
                property <bool> _kb-close-local-mirror: AppState.show-onscreen-keyboard;
                changed _kb-close-local-mirror => {
                    if !_kb-close-local-mirror {
                        if AppState.onscreen-keyboard-target == "connect-seerr-jf-user" { jf-user.focus(); }
                        else if AppState.onscreen-keyboard-target == "connect-seerr-jf-pass" { jf-pass.focus(); }
                    }
                }
                property <int> _zone-local-mirror: AppState.connect-seerr-zone;
                changed _zone-local-mirror => {
                    if _zone-local-mirror == 2 { jf-user.focus(); }
                    else if _zone-local-mirror == 3 { jf-pass.focus(); }
                }
                property <int> _pulse-local-mirror: AppState.kb-activate-pulse;
                changed _pulse-local-mirror => {
                    // !connect-seerr-busy guard — see the API key tab's own
                    // identical fix (code review, 2026-08-26) for the full
                    // "why."
                    if AppState.show-connect-seerr && AppState.connect-seerr-zone == 4 && !AppState.connect-seerr-busy {
                        AppState.connect-seerr-jellyfin(url-input.text, jf-user.text, jf-pass.text);
                    }
                }
            }

            // ── Method 2: Jellyfin Quick Connect ──────────────────────────
            if AppState.connect-seerr-method == 2: VerticalLayout {
                spacing: Theme.sp;
                if !AppState.connect-seerr-qc-polling: VerticalLayout {
                    spacing: Theme.sp;
                    Text {
                        text: "Passwordless — approve a code from inside your Jellyfin app or web UI.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    FjordButton {
                        text: AppState.connect-seerr-busy ? "Requesting code…" : "Get Code";
                        enabled: !AppState.connect-seerr-busy;
                        kbd-focused: AppState.connect-seerr-zone == 2;
                        clicked => {
                            AppState.connect-seerr-zone = 2;
                            AppState.connect-seerr-quickconnect-start(url-input.text);
                        }
                    }
                }
                if AppState.connect-seerr-qc-polling: VerticalLayout {
                    spacing: Theme.sp;
                    alignment: center;
                    Text {
                        text: AppState.connect-seerr-qc-code;
                        color: Theme.accent;
                        font-size: 40px;
                        font-weight: 700;
                        letter-spacing: 6px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Enter this code in Jellyfin's Quick Connect settings — waiting for approval…";
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    qc-poll-timer := Timer {
                        interval: 2000ms;
                        running: AppState.connect-seerr-qc-polling;
                        triggered => {
                            AppState.connect-seerr-quickconnect-poll(url-input.text, AppState.connect-seerr-qc-secret);
                        }
                    }
                }
                // No local mirrors needed here — Get Code only ever
                // references url-input, which is unconditionally mounted
                // and already reachable from root scope; the root-level
                // _pulse-mirror below dispatches it directly.
            }

            // ── Method 3: local Seerr account ─────────────────────────────
            if AppState.connect-seerr-method == 3: VerticalLayout {
                spacing: Theme.sp;
                local-email-wrap := FieldFocusWrap {
                    focused: AppState.show-onscreen-keyboard && AppState.connect-seerr-zone == 2;
                    local-email := LineEdit {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        placeholder-text: "Email";
                        changed has-focus => {
                            if self.has-focus {
                                AppState.connect-seerr-zone = 2;
                                if AppState.show-onscreen-keyboard {
                                    AppState.onscreen-keyboard-target = "connect-seerr-local-email";
                                    AppState.onscreen-keyboard-cursor = AppState.onscreen-keyboard-done-cursor;
                                }
                            }
                        }
                        key-pressed(event) => {
                            if event.text == "\u{1b}" {
                                root.close-screen();
                                AppState.refocus();
                                return accept;
                            }
                            if event.text == "\u{F700}" {
                                url-input.focus();
                                return accept;
                            }
                            if event.text == "\u{F701}" {
                                local-pass.focus();
                                return accept;
                            }
                            if event.text == "\u{000a}" {
                                // On-screen keyboard off in Settings: Enter moves on to Password.
                                if !AppState.open-onscreen-keyboard("connect-seerr-local-email") {
                                    AppState.connect-seerr-zone = 3;
                                }
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                local-pass-wrap := FieldFocusWrap {
                    focused: AppState.show-onscreen-keyboard && AppState.connect-seerr-zone == 3;
                    local-pass := LineEdit {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        placeholder-text: "Password";
                        input-type: password;
                        // No `accepted =>` handler (removed 2026-08-23) —
                        // see this file's own header doc comment.
                        changed has-focus => {
                            if self.has-focus {
                                AppState.connect-seerr-zone = 3;
                                if AppState.show-onscreen-keyboard {
                                    AppState.onscreen-keyboard-target = "connect-seerr-local-pass";
                                    AppState.onscreen-keyboard-cursor = AppState.onscreen-keyboard-done-cursor;
                                }
                            }
                        }
                        key-pressed(event) => {
                            if event.text == "\u{1b}" {
                                root.close-screen();
                                AppState.refocus();
                                return accept;
                            }
                            if event.text == "\u{F700}" {
                                local-email.focus();
                                return accept;
                            }
                            if event.text == "\u{F701}" {
                                AppState.connect-seerr-zone = 4;
                                AppState.refocus();
                                return accept;
                            }
                            if event.text == "\u{000a}" {
                                // On-screen keyboard off in Settings: Enter presses Sign In.
                                if !AppState.open-onscreen-keyboard("connect-seerr-local-pass") {
                                    if !AppState.connect-seerr-busy { AppState.connect-seerr-local(url-input.text, local-email.text, local-pass.text); }
                                }
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                FjordButton {
                    text: AppState.connect-seerr-busy ? "Signing in…" : "Sign In";
                    enabled: !AppState.connect-seerr-busy;
                    kbd-focused: AppState.connect-seerr-zone == 4;
                    clicked => {
                        AppState.connect-seerr-zone = 4;
                        AppState.connect-seerr-local(url-input.text, local-email.text, local-pass.text);
                    }
                }

                // Local mirrors — see the API key tab's own identical block
                // for the full "why" (this file's header doc comment).
                property <int> _relay-mirror: root._relay-key-seq;
                changed _relay-mirror => {
                    if AppState.onscreen-keyboard-target == "connect-seerr-local-email" {
                        // At the keyboard's own caret (◀ ▶ move it, 2026-10-05).
                        let r = AppState.onscreen-keyboard-edit(local-email.text, AppState.onscreen-keyboard-caret, root._relay-key);
                        local-email.text = r.text;
                        AppState.onscreen-keyboard-caret = r.caret;
                        local-email.set-selection-offsets(r.byte, r.byte);
                    } else if AppState.onscreen-keyboard-target == "connect-seerr-local-pass" {
                        // At the keyboard's own caret (◀ ▶ move it, 2026-10-05).
                        let r = AppState.onscreen-keyboard-edit(local-pass.text, AppState.onscreen-keyboard-caret, root._relay-key);
                        local-pass.text = r.text;
                        AppState.onscreen-keyboard-caret = r.caret;
                        local-pass.set-selection-offsets(r.byte, r.byte);
                    }
                }
                property <bool> _kb-close-local-mirror: AppState.show-onscreen-keyboard;
                changed _kb-close-local-mirror => {
                    if !_kb-close-local-mirror {
                        if AppState.onscreen-keyboard-target == "connect-seerr-local-email" { local-email.focus(); }
                        else if AppState.onscreen-keyboard-target == "connect-seerr-local-pass" { local-pass.focus(); }
                    }
                }
                property <int> _zone-local-mirror: AppState.connect-seerr-zone;
                changed _zone-local-mirror => {
                    if _zone-local-mirror == 2 { local-email.focus(); }
                    else if _zone-local-mirror == 3 { local-pass.focus(); }
                }
                property <int> _pulse-local-mirror: AppState.kb-activate-pulse;
                changed _pulse-local-mirror => {
                    // !connect-seerr-busy guard — see the API key tab's own
                    // identical fix (code review, 2026-08-26) for the full
                    // "why."
                    if AppState.show-connect-seerr && AppState.connect-seerr-zone == 4 && !AppState.connect-seerr-busy {
                        AppState.connect-seerr-local(url-input.text, local-email.text, local-pass.text);
                    }
                }
            }

            if AppState.connect-seerr-error != "": Text {
                text: AppState.connect-seerr-error;
                color: Theme.error;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // On-screen alphanumeric keyboard, below the card like login.slint's (incl. the coexistence
    // guard, see the header).
    if AppState.show-onscreen-keyboard && AppState.settings-onscreen-keyboard-enabled && root.is-my-onscreen-target(): QwertyKeyboard {
        x: (parent.width - self.width) / 2;
        // Clamped to the window bottom (like PlaylistPicker): on a short window the taller tabs
        // pushed the keyboard's bottom rows, incl. Done, off-screen.
        y: min(card.y + card.height + 16px, parent.height - self.height - 16px);
        cursor: AppState.onscreen-keyboard-cursor;
        active: AppState.show-onscreen-keyboard;
        key-pressed(k) => { root.dispatch-onscreen-key(k); }
    }

    // Restores real native focus to url-input the instant the keyboard
    // closes — same idiom as login.slint's own _kb-close-mirror. The 5
    // method-specific fields each have their OWN local copy of this same
    // idiom inside their own conditional block (see this file's header doc
    // comment) since they can't be referenced from here.
    property <bool> _kb-close-mirror: AppState.show-onscreen-keyboard;
    changed _kb-close-mirror => {
        if !_kb-close-mirror && AppState.onscreen-keyboard-target == "connect-seerr-url" {
            url-input.focus();
        }
    }

    // Physical-keyboard passthrough — same idiom as login.slint's own
    // _physical-key-mirror. dispatch-onscreen-key itself handles routing
    // to url-input directly or relaying to whichever conditional block owns
    // the current target, so this needs no target-specific logic of its
    // own beyond the existing coexistence guard.
    property <int> _physical-key-mirror: AppState.onscreen-keyboard-physical-key-seq;
    changed _physical-key-mirror => {
        if AppState.show-onscreen-keyboard && root.is-my-onscreen-target() {
            root.dispatch-onscreen-key(AppState.onscreen-keyboard-physical-key);
        }
    }

    // Zone → url-input focus hand-off for whenever keys.rs's own
    // show_connect_seerr tier sets connect-seerr-zone back to 0 (it can
    // only SET the zone value, never call a named element's .focus()
    // method directly — same limitation login-zone's own _zone-mirror
    // already works around). The method-specific zones (2/3/4) are each
    // handled by their own conditional block's local zone mirror instead.
    property <int> _zone-mirror: AppState.connect-seerr-zone;
    changed _zone-mirror => {
        if _zone-mirror == 0 { url-input.focus(); }
    }

    // Zone 2's D-pad Enter on Quick Connect's "Get Code": Rust can only bump kb-activate-pulse
    // (quickconnect-start needs the live url-input.text), this tracker does the call — like
    // login's zone 4. The other tabs' submit buttons have their own local copy (their
    // conditionally-mounted fields aren't reachable from here). Zone -1 (close) is handled in
    // keys.rs.
    property <int> _pulse-mirror: AppState.kb-activate-pulse;
    changed _pulse-mirror => {
        // !connect-seerr-busy too: busy is set at once, qc-polling only after quickconnect-start
        // succeeds — a second Enter in between started a second request.
        if AppState.show-connect-seerr && AppState.connect-seerr-method == 2
            && AppState.connect-seerr-zone == 2 && !AppState.connect-seerr-qc-polling
            && !AppState.connect-seerr-busy {
            AppState.connect-seerr-quickconnect-start(url-input.text);
        }
    }
}
