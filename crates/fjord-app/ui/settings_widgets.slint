// ── fjord-app · settings_widgets.slint ───────────────────────────────────────
//   ToggleSwitch / SectionHeader / SettingsDropdown / SettingsRow (key = settings.rs row key;
//                      `choice: true` + `value` = a fixed-choice row: its dropdown comes from
//                      settings.rs CHOICES via AppState.setting-options/-label/-choose)
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import { FocusHalo, PressPulse } from "focus.slint";

// ── Pill toggle switch ────────────────────────────────────────────────────────
export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled;

    width: 52px;
    height: 28px;

    Rectangle {
        border-radius: parent.height / 2;
        background: root.checked ? Theme.accent : Theme.surface-raised;
        border-width: ta.pressed ? 3px : 1.5px;
        border-color: root.checked ? Theme.accent : Theme.border;
        animate background {
            duration: 140ms * AppState.settings-animation-speed;
            easing: ease;
        }
        animate border-width {
            duration: 90ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }

        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: #ffffff;
            y: (parent.height - self.height) / 2;
            x: root.checked ? parent.width - self.width - 3px : 3px;
            animate x {
                duration: 140ms * AppState.settings-animation-speed;
                easing: ease-in-out;
            }
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000040;
        }
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// ── Settings section divider (accent label + hairline) ────────────────────────
export component SectionHeader inherits Rectangle {
    in property <string> text;
    height: 28px;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Text {
            text: root.text;
            color: Theme.accent;
            font-size: 11px * AppState.text-scale;
            font-weight: 700;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                width: parent.width;
                height: 1px;
                y: (parent.height - 1px) / 2;
                background: Theme.accent;
                opacity: 0.3;
            }
        }
    }
}

// ── Settings dropdown (auto-sizes to current value; popup right-aligns) ───────
export component SettingsDropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <string> current-value;
    callback selected(string);

    property <string> display-value: root.current-value != "" ? root.current-value : "(none)";
    // Cap popup height for long lists; Flickable handles overflow.
    property <length> pop-h: min(root.model.length * 32px + 8px, 320px);

    // Width tracks rendered text; capped so long descriptions don't overflow the settings row.
    width: min(max(80px, val.preferred-width + chevron.preferred-width + 24px), 280px);
    height: 34px;
    border-radius: Theme.radius;
    background: ta.has-hover ? Theme.surface-overlay : Theme.surface-raised;
    border-width: max(1px, AppState.ring-width(false, ta.pressed));
    border-color: ta.pressed ? AppState.focus-color : Theme.border;
    animate border-width {
        duration: 90ms * AppState.settings-animation-speed;
        easing: ease-out-expo;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;
        val := Text {
            text: root.display-value;
            color: Theme.text;
            font-size: 13px * AppState.text-scale;
            vertical-alignment: center;
            overflow: elide;
        }

        chevron := Text {
            text: "▾";
            font-family: "Noto Sans Symbols 2";
            color: Theme.text-muted;
            font-size: 10px * AppState.text-scale;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        // Width grows to fit the widest item; right edge stays flush with the trigger.
        x: root.width - self.width;
        y: root.height + 2px;
        width: min(max(root.width, items-layout.preferred-width + 8px), 700px);
        height: root.pop-h;

        Rectangle {
            background: Theme.surface-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000060;
            clip: true;

            Flickable {
                content-height: root.model.length * 32px + 8px;
                items-layout := VerticalLayout {
                    padding: 4px;
                    for opt in root.model: Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        preferred-width: opt-text.preferred-width + 20px;
                        background: opt-ta.has-hover ? Theme.accent-muted : transparent;
                        opt-text := Text {
                            x: 10px;
                            text: opt != "" ? opt : "(none)";
                            color: opt == root.current-value ? Theme.accent : Theme.text;
                            font-size: 13px * AppState.text-scale;
                            font-weight: opt == root.current-value ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        opt-ta := TouchArea {
                            clicked => {
                                root.current-value = opt;
                                root.selected(opt);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// ── Settings content row ──────────────────────────────────────────────────────
// Standard two-column row: title+subtitle on the left, @children on the right.
// TouchArea (lower z) lets ToggleSwitch / SettingsDropdown children receive their
// own clicks while still tracking hover for the row highlight.
export component SettingsRow inherits Rectangle {
    // Stable string key ("general.launch_fullscreen" etc., matching settings.rs's row
    // constants). No section needed: a row only exists inside its section's
    // `if AppState.settings-section == …` block.
    in property <string> key;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> indent:   false;
    // Saved per profile (not for the whole device): shows a small "Profile" tag after the title.
    // These are exactly the settings "Copy settings from…" copies.
    in property <bool> per-profile: false;
    // A fixed-choice setting (settings.rs CHOICES): the row draws its own dropdown from that table —
    // `value` is the stored value (an AppState.settings-… property); a pick saves through Rust.
    in property <bool> choice: false;
    in property <string> value;

    border-radius: Theme.radius;
    background: {
        let hov = ta.has-hover;
        AppState.settings-focused == root.key
            ? Theme.accent-muted
            : (hov ? Theme.surface : transparent)
    };
    border-width: AppState.ring-width(pulse.active, ta.pressed || pulse.pulsing);
    border-color: AppState.focus-color;
    animate border-width {
        duration: 90ms * AppState.settings-animation-speed;
        easing: ease-out-expo;
    }
    FocusHalo {
        glowing: pulse.active;
        radius: Theme.radius;
    }

    // !show-dashboard-rows: Enter inside that editor (opened from the focused row) bumps the shared
    // kb-activate-pulse — the row behind the translucent backdrop must not flash with it.
    pulse := PressPulse {
        trigger: AppState.kb-activate-pulse;
        active: AppState.settings-focused == root.key && !AppState.show-dashboard-rows;
    }

    ta := TouchArea {
        clicked => {
            AppState.settings-row-focused(root.key);
        }
    }

    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-right: 12px;
        padding-left: root.indent ? 28px : 12px;
        spacing: Theme.sp;
        alignment: space-between;
        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 14px * AppState.text-scale;
                }

                if root.per-profile: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: profile-tag.preferred-width + 12px;
                        height: 16px * AppState.text-scale;
                        border-radius: self.height / 2;
                        background: Theme.surface-overlay;
                        profile-tag := Text {
                            text: "Profile";
                            color: Theme.text-muted;
                            font-size: 10px * AppState.text-scale;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // One line, cut with "…" — except on the focused row, which shows the whole description
            // (a remote can't hover to read the rest).
            Text {
                text: root.subtitle;
                color: Theme.text-muted;
                font-size: 12px * AppState.text-scale;
                wrap: AppState.settings-focused == root.key ? TextWrap.word-wrap : TextWrap.no-wrap;
                overflow: elide;
            }
        }

        @children
        if root.choice: SettingsDropdown {
            model: AppState.setting-options(root.key);
            current-value: AppState.setting-label(root.key, root.value);
            selected(v) => {
                AppState.setting-choose(root.key, v);
                AppState.refocus();
            }
        }
    }
}
