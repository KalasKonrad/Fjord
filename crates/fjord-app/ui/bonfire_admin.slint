// ── fjord-app · bonfire_admin.slint ──────────────────────────────────────────
//   BonfireAdminScreen Settings → Profiles → "Bonfire Admin" (Jellyfin server admins only); a
//                      FadeGate overlay from main.slint with the floating "← Back". Header: Back,
//                      title, tab switcher (widgets.slint TabButton). Mappings: a flat scrollable
//                      list (BlocklistScreen's Flickable/kb-y) of BonfireAdminRow — each master
//                      (avatar, name, PIN badge, Reset PIN when it has a PIN, profile-limit stepper)
//                      followed by its indented sub-profiles (Reset PIN when they have one). Audit
//                      Logs: the same list, read-only. Reset PIN asks via ConfirmDialog. All keys in
//                      bonfire_admin.rs's handle_key (an AppMode — no text entry here).
// ─────────────────────────────────────────────────────────────────────────────
import { Theme, BonfireAdminRow, BonfireAuditRow } from "theme.slint";
import { AppState } from "app_state.slint";
import {
    FocusGlow,
    FjordButton,
    PressPulse,
    LoadingSpinner,
    ConfirmDialog,
    TabButton,
} from "widgets.slint";

export component BonfireAdminScreen inherits Rectangle {
    background: Theme.bg;

    property <length> row-h: 68px;
    property <length> header-h: 100px;

    // ── Header: Back + title + tab switcher ─────────────────────────────────
    Rectangle {
        y: 0;
        height: root.header-h;
        background: Theme.surface;

        FjordButton {
            x: 16px;
            y: 16px;
            text: "← Back";
            width: 88px * AppState.text-scale;
            kbd-focused: AppState.bonfire-admin-back-focused;
            clicked => { AppState.show-bonfire-admin = false; }
        }

        Text {
            x: (parent.width - self.width) / 2;
            y: 16px;
            height: 32px * AppState.text-scale;
            text: "Bonfire Admin";
            color: Theme.text;
            font-size: 18px * AppState.text-scale;
            font-weight: 700;
            vertical-alignment: center;
        }

        HorizontalLayout {
            x: (parent.width - self.width) / 2;
            y: 56px;
            width: 240px;
            height: 34px;
            spacing: 8px;

            TabButton {
                label: "Mappings";
                active: AppState.bonfire-admin-tab == 0;
                kbd-focused: AppState.bonfire-admin-cursor < 0 && !AppState.bonfire-admin-back-focused;
                // Reset the cursor and back-focused on a mouse click too (the keyboard path guarantees
                // both): a stale cursor could point past the new tab's rows, and Back would keep its ring.
                clicked => { AppState.bonfire-admin-cursor = -1; AppState.bonfire-admin-back-focused = false; AppState.bonfire-admin-tab-selected(0); }
            }

            TabButton {
                label: "Audit Logs";
                active: AppState.bonfire-admin-tab == 1;
                kbd-focused: AppState.bonfire-admin-cursor < 0 && !AppState.bonfire-admin-back-focused;
                clicked => { AppState.bonfire-admin-cursor = -1; AppState.bonfire-admin-back-focused = false; AppState.bonfire-admin-tab-selected(1); }
            }
        }

        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }
    }

    // ── Loading / error / empty states ──────────────────────────────────────
    if AppState.bonfire-admin-loading: LoadingSpinner {
        y: root.header-h + 40px;
        height: 60px;
    }
    if !AppState.bonfire-admin-loading && AppState.bonfire-admin-error != "": Text {
        x: 24px;
        y: root.header-h + 40px;
        width: parent.width - 48px;
        text: AppState.bonfire-admin-error;
        color: Theme.error;
        font-size: 13px * AppState.text-scale;
        wrap: word-wrap;
        horizontal-alignment: center;
    }
    if !AppState.bonfire-admin-loading && AppState.bonfire-admin-error == "" && AppState.bonfire-admin-tab == 0 && AppState.bonfire-admin-rows.length == 0: Text {
        x: (parent.width - self.width) / 2;
        y: root.header-h + 40px;
        text: "No master accounts found";
        color: Theme.text-muted;
        font-size: 14px * AppState.text-scale;
    }
    if !AppState.bonfire-admin-loading && AppState.bonfire-admin-error == "" && AppState.bonfire-admin-tab == 1 && AppState.bonfire-admin-audit-rows.length == 0: Text {
        x: (parent.width - self.width) / 2;
        y: root.header-h + 40px;
        text: "No audit log entries";
        color: Theme.text-muted;
        font-size: 14px * AppState.text-scale;
    }

    // ── Mappings tab ─────────────────────────────────────────────────────────
    if AppState.bonfire-admin-tab == 0 && !AppState.bonfire-admin-loading: mappings-container := Rectangle {
        y: root.header-h;
        height: parent.height - root.header-h;
        clip: true;

        property <length> kb-y: AppState.bonfire-admin-cursor < 0 ? 0px : clamp(
            -(AppState.bonfire-admin-cursor * root.row-h) + self.height / 2 - root.row-h / 2,
            min(0px, self.height - mappings-rows.preferred-height),
            0px);
        changed kb-y => { mappings-fl.content-y = kb-y; }

        mappings-fl := Flickable {
            width: parent.width;
            height: parent.height;
            content-height: max(parent.height, mappings-rows.preferred-height);
            animate content-y {
                duration: 150ms * AppState.settings-scroll-speed;
                easing: ease-out-expo;
            }

            mappings-rows := VerticalLayout {
                alignment: start;
                spacing: 0px;

                for row[i] in AppState.bonfire-admin-rows: row-ta := TouchArea {
                    height: root.row-h;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        AppState.bonfire-admin-cursor = i;
                        AppState.bonfire-admin-back-focused = false;
                        // Lands on what exists, like bonfire_admin.rs's default_col_for_row: a master without a PIN
                        // has only the limit stepper (col 1); otherwise col 0.
                        AppState.bonfire-admin-col = row.requires-pin ? 0 : (row.is-master ? 1 : 0);
                    }

                    Rectangle {
                        height: parent.height;
                        background: (AppState.bonfire-admin-cursor == i) ? Theme.surface-overlay
                            : row-ta.has-hover ? #ffffff08
                            : transparent;
                        border-width: AppState.ring-width(row-pulse.active, row-ta.pressed || row-pulse.pulsing);
                        border-color: AppState.focus-color;
                        animate border-width {
                            duration: 90ms * AppState.settings-animation-speed;
                            easing: ease-out-expo;
                        }
                        row-pulse := PressPulse {
                            trigger: AppState.kb-activate-pulse;
                            active: AppState.bonfire-admin-cursor == i;
                        }

                        HorizontalLayout {
                            padding-left: row.is-master ? 24px : 64px;
                            padding-right: 24px;
                            spacing: 16px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                horizontal-stretch: 1;

                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: self.width / 2;
                                    background: row.avatar-color;
                                    Text {
                                        text: row.avatar-initial;
                                        color: Theme.text;
                                        font-size: 16px * AppState.text-scale;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: row.display-name;
                                        color: Theme.text;
                                        font-size: 14px * AppState.text-scale;
                                        font-weight: 600;
                                        overflow: elide;
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: row.is-master ? "Master account" : "Sub-profile";
                                            color: Theme.text-subtle;
                                            font-size: 11px * AppState.text-scale;
                                        }

                                        // The lock in the symbol font (no colour emoji), the words in the UI font.
                                        if row.requires-pin: HorizontalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: "🔒";
                                                font-family: "Noto Sans Symbols 2";
                                                color: Theme.text-muted;
                                                font-size: 11px * AppState.text-scale;
                                            }

                                            Text {
                                                text: "PIN set";
                                                color: Theme.text-muted;
                                                font-size: 11px * AppState.text-scale;
                                            }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                alignment: end;

                                // Hidden when the row has no PIN: ResetPinAdmin on such a profile does nothing visible
                                // (it just sets an empty PinHash), so offering it was confusing. Keyboard side:
                                // bonfire_admin.rs's default_col_for_row.
                                if row.requires-pin: reset-ta := TouchArea {
                                    width: 100px;
                                    height: 32px;
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        AppState.bonfire-admin-cursor = i;
                                        AppState.bonfire-admin-back-focused = false;
                                        AppState.bonfire-admin-col = 0;
                                        AppState.bonfire-admin-reset-confirm-target = row.profile-user-id;
                                        AppState.bonfire-admin-reset-confirm-name = row.display-name;
                                        AppState.bonfire-admin-reset-confirm-focused = 0;
                                        AppState.show-bonfire-admin-reset-confirm = true;
                                    }
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: Theme.radius;
                                        background: transparent;
                                        reset-pulse := PressPulse {
                                            trigger: AppState.kb-activate-pulse;
                                            active: AppState.bonfire-admin-cursor == i && AppState.bonfire-admin-col == 0;
                                        }

                                        border-width: max(1px, AppState.ring-width(AppState.bonfire-admin-cursor == i && AppState.bonfire-admin-col == 0, reset-ta.pressed || reset-pulse.pulsing));
                                        border-color: (AppState.bonfire-admin-cursor == i && AppState.bonfire-admin-col == 0) ? AppState.focus-color : Theme.border-strong;
                                        Text {
                                            text: "Reset PIN";
                                            color: Theme.error;
                                            font-size: 12px * AppState.text-scale;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }
                                }

                                if row.is-master: HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Limit";
                                        color: Theme.text-muted;
                                        font-size: 11px * AppState.text-scale;
                                        vertical-alignment: center;
                                    }

                                    limit-ta := TouchArea {
                                        width: 72px;
                                        height: 32px;
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            AppState.bonfire-admin-cursor = i;
                                            AppState.bonfire-admin-back-focused = false;
                                            AppState.bonfire-admin-col = 1;
                                            AppState.bonfire-admin-cycle-limit(row.profile-user-id);
                                        }
                                        FocusGlow {
                                            width: parent.width;
                                            height: parent.height;
                                            radius: Theme.radius;
                                            fill: Theme.surface-overlay;
                                            limit-pulse := PressPulse {
                                                trigger: AppState.kb-activate-pulse;
                                                active: AppState.bonfire-admin-cursor == i && AppState.bonfire-admin-col == 1;
                                            }

                                            ring-width: AppState.glow-ring-width(AppState.bonfire-admin-cursor == i && AppState.bonfire-admin-col == 1, limit-ta.pressed || limit-pulse.pulsing);
                                            glowing: AppState.bonfire-admin-cursor == i && AppState.bonfire-admin-col == 1;
                                            Text {
                                                // Slint's ternary requires both branches to share
                                                // a type — "" + row.max-profiles coerces the int
                                                // branch to string so it unifies with "Default"
                                                // (a bare int branch would be a type error here,
                                                // unlike a direct `text: some_int;` assignment,
                                                // which gets the coercion for free).
                                                text: row.max-profiles < 0 ? "Default" : "" + row.max-profiles;
                                                color: Theme.text;
                                                font-size: 12px * AppState.text-scale;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                width: parent.width;
                                                height: parent.height;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Theme.border;
                        }
                    }
                }
            }
        }
    }

    // ── Audit Logs tab ───────────────────────────────────────────────────────
    if AppState.bonfire-admin-tab == 1 && !AppState.bonfire-admin-loading: audit-container := Rectangle {
        y: root.header-h;
        height: parent.height - root.header-h;
        clip: true;

        property <length> kb-y: AppState.bonfire-admin-cursor < 0 ? 0px : clamp(
            -(AppState.bonfire-admin-cursor * root.row-h) + self.height / 2 - root.row-h / 2,
            min(0px, self.height - audit-rows.preferred-height),
            0px);
        changed kb-y => { audit-fl.content-y = kb-y; }

        audit-fl := Flickable {
            width: parent.width;
            height: parent.height;
            content-height: max(parent.height, audit-rows.preferred-height);
            animate content-y {
                duration: 150ms * AppState.settings-scroll-speed;
                easing: ease-out-expo;
            }

            audit-rows := VerticalLayout {
                alignment: start;
                spacing: 0px;

                for row[i] in AppState.bonfire-admin-audit-rows: Rectangle {
                    height: root.row-h;
                    background: (AppState.bonfire-admin-cursor == i) ? Theme.surface-overlay : transparent;
                    border-width: AppState.ring-width(audit-pulse.active, audit-pulse.pulsing);
                    border-color: AppState.focus-color;
                    animate border-width {
                        duration: 90ms * AppState.settings-animation-speed;
                        easing: ease-out-expo;
                    }
                    audit-pulse := PressPulse {
                        trigger: AppState.kb-activate-pulse;
                        active: AppState.bonfire-admin-cursor == i;
                    }

                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 16px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: row.master-username + " → " + row.target-username;
                                color: Theme.text;
                                font-size: 13px * AppState.text-scale;
                                font-weight: 600;
                                overflow: elide;
                            }

                            Text {
                                text: row.device-name + " · " + row.client + " · " + row.ip-address;
                                color: Theme.text-muted;
                                font-size: 11px * AppState.text-scale;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: row.timestamp;
                            color: Theme.text-subtle;
                            font-size: 11px * AppState.text-scale;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.border;
                    }
                }
            }
        }
    }

    // Reset PIN confirm — reachable from both a master's and a sub-profile's
    // own row, so the message reads the stashed target name; keys.rs's
    // AppMode::BonfireAdmin dispatch owns Left/Right/Confirm/Back, this
    // component is purely presentational + mouse, matching every other
    // ConfirmDialog consumer in this app.
    if AppState.show-bonfire-admin-reset-confirm: ConfirmDialog {
        title: "Reset PIN?";
        message: "Clear " + AppState.bonfire-admin-reset-confirm-name + "'s PIN? They'll be able to switch into this profile with no PIN until a new one is set.";
        confirm-label: "Reset PIN";
        focused: AppState.bonfire-admin-reset-confirm-focused;
        confirmed => {
            AppState.bonfire-admin-reset-pin(AppState.bonfire-admin-reset-confirm-target);
            AppState.show-bonfire-admin-reset-confirm = false;
        }
        cancelled => {
            AppState.show-bonfire-admin-reset-confirm = false;
        }
    }
}
