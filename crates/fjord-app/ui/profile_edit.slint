// ── fjord-app · profile_edit.slint ───────────────────────────────────────────
//   ProfileEditScreen  Bonfire Phase 2 (2026-08-09) — create or edit a Bonfire
//                      sub-profile (profile-edit-is-create picks the mode).
//                      Full D-pad keyboard navigation added 2026-08-17 (see
//                      app_state.slint's profile-edit-zone doc comment for
//                      the full 12-zone design) — Name/Blocked tags/Allowed
//                      tags still need a physical keyboard to TYPE into
//                      (Phase 3's on-screen alphanumeric keyboard doesn't
//                      exist yet), but D-pad can enter/exit every zone,
//                      including those three. Dispatch lives in
//                      profile_edit.rs::handle_key_profile_edit, called from
//                      keys.rs's show_profile_edit raw-key tier — this file
//                      only wires the VISUAL focus rings + the mouse-sync
//                      assignments + the two Rust-can't-do-this-itself
//                      mechanisms: LineEdit.focus() (a local mirror +
//                      changed tracker, since Rust can only SET
//                      profile-edit-text-editing, not call a named
//                      element's method) and the button row's actual
//                      Save/Cancel/Delete dispatch (a changed tracker on
//                      kb-activate-pulse, since Rust can't read live
//                      LineEdit.text to build the Save call itself).
//                      On-screen alphanumeric keyboard (2026-08-23, full
//                      rollout beyond Login) — Name/Blocked tags/Allowed
//                      tags (zones 0/5/6). ONE Enter opens the keyboard
//                      directly (2026-08-25, collapsed from two separate
//                      presses — real friction, live-reported: "2 presses
//                      of enter one to get in to it... one more opens the
//                      virtiul keybord") WITHOUT touching native LineEdit
//                      focus at all — a first version of this fix DID grab
//                      native focus (via profile-edit-text-editing) and
//                      then immediately tried to release it again via
//                      AppState.refocus(), and was STILL broken, live-
//                      reported the SAME day ("must pres down before i can
//                      use the onscreen keybord... left and right just
//                      moves the curser itn the textbox") — grab-then-
//                      release in one call is a race this sandboxed
//                      environment can't verify wins reliably. Real native
//                      focus is now granted for the first time only once
//                      Done closes the keyboard (the existing
//                      _kb-close-mirror tracker below, which ALSO now sets
//                      profile-edit-text-editing = true at that point — see
//                      its own doc comment). The field's own key-pressed
//                      Enter branch is untouched and still needed for
//                      every Enter AFTER Done, once real focus is
//                      genuinely held. The existing hand-rolled 3-state
//                      border ring (unfocused/zone-focused/text-editing)
//                      gained a 4th outer state for keyboard-open rather
//                      than migrating to widgets.slint's FieldFocusWrap,
//                      which only models 2 states.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme, ToggleListItem } from "theme.slint";
import { AppState } from "app_state.slint";
import { FjordButton, VirtualKeyboard, QwertyKeyboard, SettingsDropdown, ToggleSwitch, PressPulse, ConfirmDialog } from "widgets.slint";
import { LineEdit } from "std-widgets.slint";

component ToggleRow inherits Rectangle {
    in property <ToggleListItem> item;
    // Real gap, code review 2026-08-17 (full D-pad retrofit) — this
    // component (the two checklist rows) had no keyboard-focus concept at
    // all, just per-tap TouchArea. Same border/PressPulse convention as
    // FjordButton.
    in property <bool> kbd-focused: false;
    callback toggled();

    height: 40px;
    border-radius: Theme.radius;
    background: ta.has-hover ? Theme.surface-overlay : transparent;
    border-width: (ta.pressed || pulse.pulsing) ? 3px : (root.kbd-focused ? 2px : 0px);
    border-color: Theme.focus-border;
    animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
    pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: root.kbd-focused; }

    ta := TouchArea { clicked => { root.toggled(); } }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;

        Rectangle {
            width: 20px; height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.item.selected ? Theme.accent : transparent;
            border-width: 1.5px;
            border-color: root.item.selected ? Theme.accent : Theme.border-strong;
            if root.item.selected: Text {
                text: "✓";
                font-family: "Adwaita Sans";
                color: Theme.bg;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
            }
            if root.item.subtitle != "": Text {
                text: root.item.subtitle;
                color: Theme.text-muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

component FieldLabel inherits Text {
    color: Theme.text-muted;
    font-size: 12px;
    font-weight: 600;
}

export component ProfileEditScreen inherits Rectangle {
    background: #000000aa;

    // Two parallel arrays, not one — Slint's expression language has no
    // string-to-color parse (confirmed the hard way: "Cannot convert string
    // to brush" at compile time), so the swatch background needs a real
    // `color` literal while profile-edit-avatar-color-selected still needs
    // the matching raw hex STRING to send to Bonfire's API. Same 8-color
    // palette as profile.rs::avatar_color_for's own fallback set, kept in
    // lockstep by hand — the two lists have no shared source of truth
    // between Rust and Slint, same caveat as every other dual-side list in
    // this app (settings.rs's dropdown models, profile_edit.rs's own
    // AVATAR_PALETTE_HEX/PIN_VALS/PARENTAL_RATING_MODEL/LOCKOUT_MODEL).
    property <[color]> avatar-palette-colors: [
        #4a90d9, #d94a6b, #4ad98e, #d9a04a,
        #9a4ad9, #4ac9d9, #d9d94a, #d96b4a,
    ];
    property <[string]> avatar-palette-hex: [
        "#4a90d9", "#d94a6b", "#4ad98e", "#d9a04a",
        "#9a4ad9", "#4ac9d9", "#d9d94a", "#d96b4a",
    ];
    // Delete only shows for an existing sub-profile, never create mode or
    // self-edit — hoisted here (was a local `property` mistakenly declared
    // INSIDE a callback body, not valid Slint) since it's read from the
    // button row's three kbd-focused bindings, their clicked handlers, AND
    // the _pulse-mirror dispatch tracker below.
    property <bool> delete-shown: !AppState.profile-edit-is-create && !AppState.profile-edit-is-self;

    // Reverse-lookup for VirtualKeyboard's own key order (widgets.slint's
    // `vals: ["1","2",...,"9","backspace","0","confirm"]`) — needed so a
    // MOUSE click on a PIN key can sync profile-edit-pin-cursor /
    // -master-pin-cursor, matching every other zone's mouse-sync discipline.
    pure function pin-key-index(k: string) -> int {
        k == "1" ? 0 : k == "2" ? 1 : k == "3" ? 2 : k == "4" ? 3 : k == "5" ? 4
        : k == "6" ? 5 : k == "7" ? 6 : k == "8" ? 7 : k == "9" ? 8
        : k == "backspace" ? 9 : k == "0" ? 10 : 11
    }

    // Direct-element-.y reads for the whole-screen auto-scroll — same
    // technique CLAUDE.md documents as the eventually-correct fix for the
    // Key Bindings Reset-button scroll saga ("read the element's own real,
    // Slint-resolved y directly... not an approximation, it's the literal
    // answer") rather than hand-computing cumulative pixel offsets, which
    // that same saga took 4 attempts to get right by hand. Zones 4/9 (the
    // two conditional checklists) CAN'T be referenced this way — an element
    // declared inside an `if` block isn't a valid identifier outside it, a
    // hard Slint scoping rule, not a style choice — so those two fall back
    // to a fixed offset from their nearest unconditional neighbor. Flagged
    // in the plan as the one part of this feature accepted to ship
    // imprecise on the first pass: the FOCUS RING itself is always correct
    // regardless of this function's accuracy, only auto-scroll timing can
    // be off.
    pure function zone-el-y(zone: int) -> length {
        zone == 0  ? name-field-wrap.y :
        zone == 1  ? avatar-row.y :
        zone == 2  ? pin-pad-wrap.y :
        zone == 3  ? rating-dd-wrap.y :
        zone == 4  ? rating-dd-wrap.y + 80px :
        zone == 5  ? blocked-tags-wrap.y :
        zone == 6  ? allowed-tags-wrap.y :
        zone == 7  ? lockout-dd-wrap.y :
        zone == 8  ? lan-bypass-row.y :
        zone == 9  ? lan-bypass-row.y + 60px :
        zone == 10 ? master-pin-pad-wrap.y :
        zone == 11 ? button-row.y :
        0px
    }

    close-ta := TouchArea {
        clicked => { AppState.profile-edit-cancel(); }
    }

    card := Rectangle {
        width:  min(560px, parent.width - 48px);
        height: min(inner.preferred-height, parent.height - 48px);
        x:      (parent.width  - self.width)  / 2;
        y:      (parent.height - self.height) / 2;
        background:    Theme.surface;
        border-radius: Theme.radius-lg;
        drop-shadow-blur:  28px;
        drop-shadow-color: #00000070;
        clip: true;

        card-ta := TouchArea {}

        fl := Flickable {
            x: 0; y: 0;
            width: parent.width; height: parent.height;
            viewport-width: self.width;
            viewport-height: inner.preferred-height;
            // Live-reported 2026-08-17: "no animation in the scrol so its
            // instant" — every other keyboard-scrollable Flickable in the
            // app animates viewport-y (Detail/Series/Season/Settings/etc.,
            // all `200ms * settings-scroll-speed, ease-in-out`); this one
            // was the one screen missing it, a real inconsistency, not a
            // deliberate choice — matching the established convention.
            animate viewport-y { duration: 200ms * AppState.settings-scroll-speed; easing: ease-in-out; }

            // Never a direct viewport-y binding — that blocks native
            // mouse-wheel scroll (documented Flickable gotcha). `kb-y`'s
            // own clamp keeps it within real bounds regardless of
            // zone-el-y's accuracy for zones 4/9.
            property <length> kb-y: clamp(
                -(zone-el-y(AppState.profile-edit-zone) - 80px),
                min(0px, self.height - inner.preferred-height),
                0px
            );
            changed kb-y => { fl.viewport-y = kb-y; }

            inner := VerticalLayout {
                width: parent.width;
                padding: Theme.sp-xl;
                spacing: Theme.sp;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: AppState.profile-edit-is-create ? "Add Profile" : (AppState.profile-edit-is-self ? "Edit My Profile" : "Edit Profile");
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                    }
                    FjordButton {
                        text: "✕";
                        width: 32px;
                        height: 32px;
                        clicked => { AppState.profile-edit-cancel(); }
                    }
                }

                FieldLabel { text: "Name"; }
                // Zone 0 — a bordered wrapper since LineEdit exposes no
                // settable border of its own; the LineEdit itself is given
                // explicit geometry since a plain Rectangle isn't a Layout.
                name-field-wrap := Rectangle {
                    height: 44px;
                    border-radius: Theme.radius;
                    border-width: AppState.profile-edit-zone == 0 ? (AppState.show-onscreen-keyboard ? 2px : (AppState.profile-edit-text-editing ? 3px : 2px)) : 0px;
                    border-color: Theme.focus-border;
                    animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                    name-field := LineEdit {
                        x: 2px; y: 2px;
                        width: parent.width - 4px;
                        height: 40px;
                        placeholder-text: "Profile name";
                        text: AppState.profile-edit-name-initial;
                        changed has-focus => {
                            if self.has-focus {
                                AppState.profile-edit-zone = 0;
                                AppState.profile-edit-text-editing = true;
                            } else if AppState.profile-edit-text-editing && AppState.profile-edit-zone == 0 {
                                AppState.profile-edit-text-editing = false;
                            }
                        }
                        key-pressed(event) => {
                            if event.text == "\u{1b}" {
                                AppState.profile-edit-text-editing = false;
                                AppState.refocus();
                                return accept;
                            }
                            // Real bug, live-reported 2026-08-17: "after the
                            // last you go out it do not cycle back to
                            // name" — mid-chain Tab between the 3 fields
                            // already works via Slint's own native focus-
                            // chain traversal (unmodified, left to `reject`
                            // below); only the WRAP at either end needed an
                            // explicit hand-off, since this screen is the
                            // one place in the app with real LineEdit
                            // focus and there's nothing else in the window
                            // for the native chain to wrap into/out of.
                            if event.text == "\u{9}" && event.modifiers.shift {
                                allowed-tags-field.focus();
                                return accept;
                            }
                            // Real bug, live-reported 2026-08-21: "when in a
                            // text field in manage profile you cant navigate
                            // out of it with out pressing escape" — Escape/
                            // Tab were the only keys this hook (or any of
                            // the other two text fields' own hooks) ever
                            // handled; Up/Down fell through to Slint's own
                            // native LineEdit behavior, a no-op in a single-
                            // line field, so the field was a genuine dead
                            // end for D-pad/remote navigation. Down hands
                            // off to zone 1 (Avatar) — the same `text-
                            // editing=false; refocus();` shape Escape
                            // already uses. Zone 0 is always first in
                            // existing_profile_edit_zones (profile_edit.rs),
                            // so its Down target (zone 1) and Up target
                            // (nothing — left unhandled, matching this
                            // field's own pre-existing "no-op, nothing
                            // above it" comment) are both fixed regardless
                            // of which conditional zones happen to exist.
                            if event.text == "\u{F701}" {
                                AppState.profile-edit-zone = 1;
                                AppState.profile-edit-avatar-cursor = 0;
                                AppState.profile-edit-text-editing = false;
                                AppState.refocus();
                                return accept;
                            }
                            // On-screen keyboard, 2026-08-23 — only reached
                            // once text-editing is already true and this
                            // field genuinely has native focus (Enter's
                            // FIRST job, entering text-editing, is handled
                            // in Rust before this hook can ever see a key at
                            // all — see this file's own header comment).
                            if event.text == "\u{000a}" {
                                AppState.onscreen-keyboard-target = "profile-edit-name";
                                AppState.onscreen-keyboard-cursor = AppState.onscreen-keyboard-done-cursor;
                                AppState.show-onscreen-keyboard = true;
                                AppState.refocus();
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                FieldLabel { text: "Avatar color"; }
                avatar-row := HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 40px; height: 40px;
                        border-radius: 20px;
                        background: AppState.profile-edit-avatar-preview;
                        border-width: 2px;
                        border-color: Theme.border-strong;
                    }

                    for c[i] in avatar-palette-colors: Rectangle {
                        width: 32px; height: 32px;
                        y: 4px;
                        border-radius: 16px;
                        background: c;
                        border-width: (AppState.profile-edit-zone == 1 && AppState.profile-edit-avatar-cursor == i) ? 3px
                            : (AppState.profile-edit-avatar-color == avatar-palette-hex[i] ? 3px : 0px);
                        border-color: (AppState.profile-edit-zone == 1 && AppState.profile-edit-avatar-cursor == i) ? Theme.focus-border : Theme.text;
                        swatch-ta := TouchArea {
                            clicked => {
                                AppState.profile-edit-zone = 1;
                                AppState.profile-edit-avatar-cursor = i;
                                AppState.profile-edit-avatar-color-selected(avatar-palette-hex[i]);
                            }
                        }
                    }
                }

                FieldLabel { text: AppState.profile-edit-is-create ? "PIN (optional)" : "PIN — leave blank to keep the current one"; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 8px;
                        for d in 8: Rectangle {
                            width: 12px; height: 12px;
                            y: 14px;
                            border-radius: 6px;
                            background: d < AppState.profile-edit-pin-len ? Theme.accent : Theme.surface-overlay;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                        }
                    }
                    if !AppState.profile-edit-is-create && AppState.profile-edit-has-pin: Text {
                        text: "(a PIN is currently set)";
                        color: Theme.text-subtle;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
                pin-pad-wrap := Rectangle {
                    height: pin-pad.preferred-height;
                    pin-pad := VirtualKeyboard {
                        cursor: AppState.profile-edit-zone == 2 ? AppState.profile-edit-pin-cursor : -1;
                        key-pressed(k) => {
                            AppState.profile-edit-zone = 2;
                            AppState.profile-edit-pin-cursor = pin-key-index(k);
                            AppState.profile-edit-pin-key(k);
                        }
                    }
                }

                FieldLabel { text: "Max parental rating"; }
                // Real gap, live-questioned 2026-08-17 ("thats a bit bad to
                // not know what parental ration a profile is on") —
                // re-confirmed against Bonfire's own real API docs that no
                // endpoint ever reports the current value at all (genuine
                // upstream limitation). "Unknown" (profile_edit.rs's
                // UNKNOWN_RATING sentinel) is the honest starting display
                // in Edit mode — distinct from "Any", which is only ever
                // shown once the user has genuinely opened this dropdown
                // and picked it.
                Text {
                    text: "Bonfire doesn't report a profile's current rating — this starts unset until you pick one.";
                    color: Theme.text-subtle;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                // Real bug, live-reported 2026-08-19 ("still no hilight so
                // the user knows it is on the dropdown menu") — this fix's
                // earlier pass only highlighted the CURSOR ROW inside the
                // popup once opened; there was no indicator on the row
                // itself while just D-pad-navigating past it, unlike every
                // other zone in this screen (Name/PIN/checklists/LAN
                // bypass all have their own bordered wrapper).
                // SettingsDropdown has no kbd-focused concept of its own
                // (Settings' own usage relies entirely on SettingsRow's
                // wrapping ring for this) — wrapped here the same way
                // name-field-wrap/lan-bypass-row already wrap their own
                // controls. zone-el-y reads this wrapper's own .y, not
                // rating-dd's (which is now relative to IT, not the
                // screen — a real, easy-to-miss coordinate-space trap).
                rating-dd-wrap := Rectangle {
                    width:  rating-dd.width + 4px;
                    height: rating-dd.height + 4px;
                    border-radius: Theme.radius;
                    border-width: AppState.profile-edit-zone == 3 ? 2px : 0px;
                    border-color: Theme.focus-border;
                    animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                    rating-dd := SettingsDropdown {
                        x: 2px; y: 2px;
                        model: ["Any", "G", "PG", "PG-13", "R", "NC-17", "TV-Y", "TV-Y7", "TV-G", "TV-PG", "TV-14", "TV-MA", "Not Rated"];
                        current-value: AppState.profile-edit-parental-rating == "" ? "Any"
                                     : AppState.profile-edit-parental-rating == "__unknown__" ? "Unknown"
                                     : AppState.profile-edit-parental-rating;
                        selected(v) => {
                            AppState.profile-edit-zone = 3;
                            AppState.profile-edit-parental-rating = v == "Any" ? "" : v;
                        }
                    }
                }

                if AppState.profile-edit-libraries.length > 0: VerticalLayout {
                    spacing: 4px;
                    FieldLabel { text: "Enabled libraries"; }
                    for lib[i] in AppState.profile-edit-libraries: ToggleRow {
                        item: lib;
                        kbd-focused: AppState.profile-edit-zone == 4 && AppState.profile-edit-libraries-cursor == i;
                        toggled => {
                            AppState.profile-edit-zone = 4;
                            AppState.profile-edit-libraries-cursor = i;
                            AppState.profile-edit-toggle-library(i);
                        }
                    }
                }

                FieldLabel { text: "Blocked tags (comma-separated)"; }
                blocked-tags-wrap := Rectangle {
                    height: 44px;
                    border-radius: Theme.radius;
                    border-width: AppState.profile-edit-zone == 5 ? (AppState.show-onscreen-keyboard ? 2px : (AppState.profile-edit-text-editing ? 3px : 2px)) : 0px;
                    border-color: Theme.focus-border;
                    animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                    blocked-tags-field := LineEdit {
                        x: 2px; y: 2px;
                        width: parent.width - 4px;
                        height: 40px;
                        placeholder-text: "e.g. violence, gore";
                        text: AppState.profile-edit-blocked-tags-initial;
                        changed has-focus => {
                            if self.has-focus {
                                AppState.profile-edit-zone = 5;
                                AppState.profile-edit-text-editing = true;
                            } else if AppState.profile-edit-text-editing && AppState.profile-edit-zone == 5 {
                                AppState.profile-edit-text-editing = false;
                            }
                        }
                        key-pressed(event) => {
                            if event.text == "\u{1b}" {
                                AppState.profile-edit-text-editing = false;
                                AppState.refocus();
                                return accept;
                            }
                            // Real bug, live-reported 2026-08-21 — see
                            // name-field's own key-pressed comment for the
                            // full explanation. Up's target is the one
                            // transition in this whole retrofit that
                            // genuinely depends on a conditional zone
                            // (Enabled libraries, zone 4, only exists when
                            // AppState.profile-edit-libraries is non-empty)
                            // — mirrors existing_profile_edit_zones'
                            // (profile_edit.rs) own prev-zone resolution
                            // for zone 5 by hand, since Slint has no access
                            // to that Rust-side filtered list; kept in
                            // lockstep the same way that function's own doc
                            // comment already flags for its Slint `if`
                            // counterpart. Down's target (zone 6, Allowed
                            // tags) is unconditional — nothing ever sits
                            // between 5 and 6 in the zone list.
                            if event.text == "\u{F700}" {
                                if AppState.profile-edit-libraries.length > 0 {
                                    AppState.profile-edit-zone = 4;
                                    AppState.profile-edit-libraries-cursor = 0;
                                } else {
                                    AppState.profile-edit-zone = 3;
                                }
                                AppState.profile-edit-text-editing = false;
                                AppState.refocus();
                                return accept;
                            }
                            if event.text == "\u{F701}" {
                                AppState.profile-edit-zone = 6;
                                AppState.profile-edit-text-editing = false;
                                AppState.refocus();
                                return accept;
                            }
                            // On-screen keyboard, 2026-08-23 — see
                            // name-field's own key-pressed comment.
                            if event.text == "\u{000a}" {
                                AppState.onscreen-keyboard-target = "profile-edit-blocked-tags";
                                AppState.onscreen-keyboard-cursor = AppState.onscreen-keyboard-done-cursor;
                                AppState.show-onscreen-keyboard = true;
                                AppState.refocus();
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                FieldLabel { text: "Allowed tags (comma-separated, overrides blocked)"; }
                allowed-tags-wrap := Rectangle {
                    height: 44px;
                    border-radius: Theme.radius;
                    border-width: AppState.profile-edit-zone == 6 ? (AppState.show-onscreen-keyboard ? 2px : (AppState.profile-edit-text-editing ? 3px : 2px)) : 0px;
                    border-color: Theme.focus-border;
                    animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                    allowed-tags-field := LineEdit {
                        x: 2px; y: 2px;
                        width: parent.width - 4px;
                        height: 40px;
                        placeholder-text: "e.g. kids";
                        text: AppState.profile-edit-allowed-tags-initial;
                        changed has-focus => {
                            if self.has-focus {
                                AppState.profile-edit-zone = 6;
                                AppState.profile-edit-text-editing = true;
                            } else if AppState.profile-edit-text-editing && AppState.profile-edit-zone == 6 {
                                AppState.profile-edit-text-editing = false;
                            }
                        }
                        key-pressed(event) => {
                            if event.text == "\u{1b}" {
                                AppState.profile-edit-text-editing = false;
                                AppState.refocus();
                                return accept;
                            }
                            // Wrap forward-Tab from the last field back to
                            // Name — see name-field's own key-pressed
                            // comment for the full explanation; this is its
                            // mirror image at the other end of the chain.
                            if event.text == "\u{9}" && !event.modifiers.shift {
                                name-field.focus();
                                return accept;
                            }
                            // Real bug, live-reported 2026-08-21 — see
                            // name-field's own key-pressed comment. Both
                            // targets here are unconditional: zone 5
                            // (Blocked tags) always precedes zone 6, and
                            // zone 7 (Auto-lock dropdown) always follows it
                            // — nothing conditional sits on either side.
                            if event.text == "\u{F700}" {
                                AppState.profile-edit-zone = 5;
                                AppState.profile-edit-text-editing = false;
                                AppState.refocus();
                                return accept;
                            }
                            if event.text == "\u{F701}" {
                                AppState.profile-edit-zone = 7;
                                AppState.profile-edit-text-editing = false;
                                AppState.refocus();
                                return accept;
                            }
                            // On-screen keyboard, 2026-08-23 — see
                            // name-field's own key-pressed comment.
                            if event.text == "\u{000a}" {
                                AppState.onscreen-keyboard-target = "profile-edit-allowed-tags";
                                AppState.onscreen-keyboard-cursor = AppState.onscreen-keyboard-done-cursor;
                                AppState.show-onscreen-keyboard = true;
                                AppState.refocus();
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                FieldLabel { text: "Auto-lock after inactivity"; }
                // Same fix as rating-dd-wrap above — see its own comment.
                lockout-dd-wrap := Rectangle {
                    width:  lockout-dd.width + 4px;
                    height: lockout-dd.height + 4px;
                    border-radius: Theme.radius;
                    border-width: AppState.profile-edit-zone == 7 ? 2px : 0px;
                    border-color: Theme.focus-border;
                    animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                    lockout-dd := SettingsDropdown {
                        x: 2px; y: 2px;
                        model: ["Never", "5", "15", "30", "60", "120"];
                        current-value: AppState.profile-edit-lockout-minutes == "0" ? "Never" : AppState.profile-edit-lockout-minutes;
                        selected(v) => {
                            AppState.profile-edit-zone = 7;
                            AppState.profile-edit-lockout-minutes = v == "Never" ? "0" : v;
                        }
                    }
                }

                lan-bypass-row := Rectangle {
                    // Real bug, live-reported 2026-08-19/21/21 ("this is
                    // miss alinged" / "did you not fix this?" / a
                    // screenshot showing the row's own border stretching
                    // noticeably wider than every sibling row). Two prior
                    // attempts (padding 4px→12px on a HorizontalLayout,
                    // then dropping that layout for explicit x/y
                    // positioning of the Text/ToggleSwitch children) both
                    // targeted where the CHILDREN sit within this row —
                    // neither touched the ROOT `Rectangle`'s own width,
                    // which was the actual bug the screenshot revealed:
                    // `width: parent.width` reads the enclosing
                    // VerticalLayout's raw, UNPADDED width, not the padded
                    // content width every sibling row gets automatically
                    // by leaving `width` unset (confirmed directly against
                    // blocked-tags-wrap/allowed-tags-wrap above, neither
                    // of which sets an explicit width at all) — so this
                    // row alone rendered wider than the form around it,
                    // extending into the padding no other row does.
                    // Removed the explicit width entirely; the layout now
                    // assigns the same content width as every sibling, and
                    // the children's own `parent.width`-relative x
                    // bindings below are unaffected — they just resolve
                    // against the corrected value instead of the wrong one.
                    height: 36px;
                    border-radius: Theme.radius;
                    border-width: AppState.profile-edit-zone == 8 ? 2px : 0px;
                    border-color: Theme.focus-border;
                    animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                    Text {
                        x:                  12px;
                        y:                  (parent.height - self.height) / 2;
                        text:               "Skip PIN on this network";
                        color:              Theme.text;
                        font-size:          13px;
                        vertical-alignment: center;
                    }
                    ToggleSwitch {
                        x: parent.width - self.width - 12px;
                        y: (parent.height - self.height) / 2;
                        checked: AppState.profile-edit-lan-bypass;
                        toggled => {
                            AppState.profile-edit-zone = 8;
                            AppState.profile-edit-lan-bypass = !AppState.profile-edit-lan-bypass;
                        }
                    }
                }

                if AppState.profile-edit-devices.length > 0: VerticalLayout {
                    spacing: 4px;
                    FieldLabel { text: "Allowed devices (none checked = all devices)"; }
                    for dev[i] in AppState.profile-edit-devices: ToggleRow {
                        item: dev;
                        kbd-focused: AppState.profile-edit-zone == 9 && AppState.profile-edit-devices-cursor == i;
                        toggled => {
                            AppState.profile-edit-zone = 9;
                            AppState.profile-edit-devices-cursor = i;
                            AppState.profile-edit-toggle-device(i);
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }

                FieldLabel { text: "Your own account PIN (only needed if your account has one set)"; }
                HorizontalLayout {
                    spacing: 8px;
                    for d in 8: Rectangle {
                        width: 12px; height: 12px;
                        y: 14px;
                        border-radius: 6px;
                        background: d < AppState.profile-edit-master-pin-len ? Theme.accent : Theme.surface-overlay;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                    }
                }
                master-pin-pad-wrap := Rectangle {
                    height: master-pin-pad.preferred-height;
                    master-pin-pad := VirtualKeyboard {
                        cursor: AppState.profile-edit-zone == 10 ? AppState.profile-edit-master-pin-cursor : -1;
                        key-pressed(k) => {
                            AppState.profile-edit-zone = 10;
                            AppState.profile-edit-master-pin-cursor = pin-key-index(k);
                            AppState.profile-edit-master-pin-key(k);
                        }
                    }
                }

                if AppState.profile-edit-error != "": Text {
                    text: AppState.profile-edit-error;
                    color: Theme.error;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                button-row := HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    // Index scheme accounts for Delete's conditional
                    // presence — 0=Delete/1=Cancel/2=Save when shown,
                    // 0=Cancel/1=Save otherwise, matching
                    // profile_edit.rs::handle_key_profile_edit's own
                    // delete_shown-derived max_btn.
                    if !AppState.profile-edit-is-create && !AppState.profile-edit-is-self: FjordButton {
                        text: "Delete";
                        danger: true;
                        width: 90px;
                        kbd-focused: AppState.profile-edit-zone == 11 && !AppState.profile-edit-dropdown-open && AppState.profile-edit-button-focused == 0;
                        clicked => {
                            AppState.profile-edit-zone = 11;
                            AppState.profile-edit-button-focused = 0;
                            // Confirmation dialog, 2026-08-21 — see
                            // show-profile-edit-delete-confirm's own doc
                            // comment in app_state.slint.
                            AppState.profile-edit-delete-confirm-focused = 0;
                            AppState.show-profile-edit-delete-confirm = true;
                        }
                    }
                    FjordButton {
                        text: "Cancel";
                        width: 90px;
                        kbd-focused: AppState.profile-edit-zone == 11 && !AppState.profile-edit-dropdown-open
                            && AppState.profile-edit-button-focused == (delete-shown ? 1 : 0);
                        clicked => {
                            AppState.profile-edit-zone = 11;
                            AppState.profile-edit-button-focused = delete-shown ? 1 : 0;
                            AppState.profile-edit-cancel();
                        }
                    }
                    FjordButton {
                        text: AppState.profile-edit-saving ? "Saving…" : "Save";
                        width: 90px;
                        enabled: !AppState.profile-edit-saving;
                        kbd-focused: AppState.profile-edit-zone == 11 && !AppState.profile-edit-dropdown-open
                            && AppState.profile-edit-button-focused == (delete-shown ? 2 : 1);
                        clicked => {
                            AppState.profile-edit-zone = 11;
                            AppState.profile-edit-button-focused = delete-shown ? 2 : 1;
                            AppState.profile-edit-save(name-field.text, blocked-tags-field.text, allowed-tags-field.text);
                        }
                    }
                }
            }
        }
    }

    // Zone 0/5/6's own D-pad Enter can only SET profile-edit-text-editing
    // (Rust has no way to call a named Slint element's .focus() directly);
    // this local mirror + changed tracker is what actually performs the
    // call — same idiom as main.slint's _browse-vis / now_playing.slint's
    // _pause-mirror (changed can't observe a dotted global path directly).
    property <bool> _text-editing-mirror: AppState.profile-edit-text-editing;
    changed _text-editing-mirror => {
        if _text-editing-mirror {
            if AppState.profile-edit-zone == 0 { name-field.focus(); }
            else if AppState.profile-edit-zone == 5 { blocked-tags-field.focus(); }
            else if AppState.profile-edit-zone == 6 { allowed-tags-field.focus(); }
        }
    }

    // Zone 11's own D-pad Enter bumps the shared kb-activate-pulse counter
    // (in keys.rs's show_profile_edit tier, unconditionally, before
    // dispatch) — this is what actually fires Delete/Cancel/Save, since
    // Rust can't read live LineEdit.text to build the Save call itself.
    // Safe because show_profile_edit's own raw-key tier returns
    // unconditionally, so no other screen's Enter can bump the counter
    // while this one owns dispatch.
    property <int> _pulse-mirror: AppState.kb-activate-pulse;
    changed _pulse-mirror => {
        if AppState.show-profile-edit && AppState.profile-edit-zone == 11
            && !AppState.profile-edit-dropdown-open && !AppState.profile-edit-text-editing {
            if delete-shown && AppState.profile-edit-button-focused == 0 {
                // Confirmation dialog, 2026-08-21 — see
                // show-profile-edit-delete-confirm's own doc comment in
                // app_state.slint. Mirrors the mouse click handler exactly
                // so keyboard and mouse can't diverge on what Enter/click
                // on Delete actually does.
                AppState.profile-edit-delete-confirm-focused = 0;
                AppState.show-profile-edit-delete-confirm = true;
            } else if AppState.profile-edit-button-focused == (delete-shown ? 1 : 0) {
                AppState.profile-edit-cancel();
            } else {
                AppState.profile-edit-save(name-field.text, blocked-tags-field.text, allowed-tags-field.text);
            }
        }
    }

    // ── On-screen alphanumeric keyboard (2026-08-23, full rollout) ──────────
    // Real gap caught while wiring this in, not assumed away: unlike Login
    // (a startup-tier screen that can never coexist with a post-login
    // screen), ProfileEditScreen is an overlay reachable from the sidebar
    // quick-menu regardless of which content tab is underneath it — so it
    // CAN be mounted at the same time as Discover/Browse/etc, which also
    // get their own on-screen-keyboard interaction in this same rollout.
    // Every one of this screen's 3 keyboard-interaction sites (mount
    // condition, close-mirror, physical-key-mirror) needs to check that
    // onscreen-keyboard-target is actually ONE OF ITS OWN 3 fields before
    // acting — without this, two screens' QwertyKeyboard instances could
    // render simultaneously, or one screen's Done/physical keystroke could
    // wrongly steal focus/dispatch meant for a completely different screen.
    pure function is-my-onscreen-target() -> bool {
        AppState.onscreen-keyboard-target == "profile-edit-name"
            || AppState.onscreen-keyboard-target == "profile-edit-blocked-tags"
            || AppState.onscreen-keyboard-target == "profile-edit-allowed-tags"
    }

    // Dispatches by the generic onscreen-keyboard-target id set by whichever
    // of the 3 text fields opened it — same shape as login.slint's own
    // dispatch-onscreen-key, just against 3 different target ids.
    function dispatch-onscreen-key(k: string) {
        if k == "done" {
            AppState.show-onscreen-keyboard = false;
        } else if AppState.onscreen-keyboard-target == "profile-edit-name" {
            name-field.text = k == "backspace"
                ? AppState.onscreen-keyboard-trim-last(name-field.text)
                : name-field.text + k;
            let len = AppState.onscreen-keyboard-byte-len(name-field.text);
            name-field.set-selection-offsets(len, len);
        } else if AppState.onscreen-keyboard-target == "profile-edit-blocked-tags" {
            blocked-tags-field.text = k == "backspace"
                ? AppState.onscreen-keyboard-trim-last(blocked-tags-field.text)
                : blocked-tags-field.text + k;
            let len = AppState.onscreen-keyboard-byte-len(blocked-tags-field.text);
            blocked-tags-field.set-selection-offsets(len, len);
        } else if AppState.onscreen-keyboard-target == "profile-edit-allowed-tags" {
            allowed-tags-field.text = k == "backspace"
                ? AppState.onscreen-keyboard-trim-last(allowed-tags-field.text)
                : allowed-tags-field.text + k;
            let len = AppState.onscreen-keyboard-byte-len(allowed-tags-field.text);
            allowed-tags-field.set-selection-offsets(len, len);
        }
    }

    // Anchored to whichever text field is actually focused, not a fixed
    // screen position (real fix, live-reported 2026-08-25: a background-
    // less keyboard docked flush at the screen bottom visibly overlapped
    // this screen's own form content — a fixed-bottom dock never actually
    // knew where the card's own content ended). active-field-y reads the
    // SAME zone-el-y this screen's own kb-y auto-scroll already uses,
    // combined with the Flickable's real live scroll offset (fl.viewport-y,
    // a plain property, not layout-cache-derived — safe to read from here)
    // and the card's own on-screen position (also a plain, non-conditional
    // expression) — the literal, exact on-screen Y of whichever field
    // currently holds focus, not an approximation. Docks below that field
    // with a margin (FieldFocusWrap's own fixed 40px height accounts for
    // the field itself); falls back to ABOVE it if there's no room below
    // (a field near the very bottom of a tall, fully-scrolled form).
    property <length> active-field-y: card.y + fl.viewport-y + zone-el-y(AppState.profile-edit-zone);
    if AppState.show-onscreen-keyboard && AppState.settings-onscreen-keyboard-enabled && root.is-my-onscreen-target(): QwertyKeyboard {
        x: (parent.width - self.width) / 2;
        y: (active-field-y + 40px + 16px + self.height <= parent.height)
            ? active-field-y + 40px + 16px
            : max(0px, active-field-y - self.height - 16px);
        cursor: AppState.onscreen-keyboard-cursor;
        active: AppState.show-onscreen-keyboard;
        key-pressed(k) => { root.dispatch-onscreen-key(k); }
    }

    // Restores real native LineEdit focus to the right field the instant
    // the keyboard closes (Done) — this needs its own tracker on
    // show-onscreen-keyboard rather than profile-edit-text-editing, same
    // idiom as login.slint's own _kb-close-mirror. Also sets
    // profile-edit-text-editing = true here now (2026-08-25 — Enter no
    // longer sets it when opening the keyboard, see profile_edit.rs's own
    // zone 0/5/6 doc comment for the real bug that fix avoids): this is
    // the FIRST point real native focus is ever genuinely granted in the
    // collapsed one-Enter flow, so it's also the correct point to flip the
    // border ring's own "editing" state to match reality — setting it
    // false-to-true here is a genuine transition (not a no-op the way it
    // would have been under the old design, where it was already true
    // before Enter ever opened the keyboard), so _text-editing-mirror's
    // own tracker fires too and redundantly re-issues the identical
    // .focus() call below — harmless, not a conflict.
    property <bool> _kb-close-mirror: AppState.show-onscreen-keyboard;
    changed _kb-close-mirror => {
        // onscreen-keyboard-target is only ever cleared by close_profile_edit_screen
        // (a different screen closing entirely) — a plain Done press leaves
        // it exactly as it was, still correctly identifying which field this
        // was for at the moment it closes, so this check is safe here too.
        if !_kb-close-mirror && is-my-onscreen-target() {
            AppState.profile-edit-text-editing = true;
            if AppState.profile-edit-zone == 0 { name-field.focus(); }
            else if AppState.profile-edit-zone == 5 { blocked-tags-field.focus(); }
            else if AppState.profile-edit-zone == 6 { allowed-tags-field.focus(); }
        }
    }

    // Physical-keyboard passthrough — keys.rs forwards any ordinary
    // printable key (or Backspace) it sees while the on-screen keyboard is
    // open via AppState.onscreen-keyboard-physical-key/-seq; this mirrors
    // the counter (changed can only observe a property on THIS component)
    // and funnels the payload through the exact same dispatch-onscreen-key
    // a mouse click or the on-screen grid's own Enter already use.
    property <int> _physical-key-mirror: AppState.onscreen-keyboard-physical-key-seq;
    changed _physical-key-mirror => {
        if AppState.show-onscreen-keyboard && is-my-onscreen-target() {
            root.dispatch-onscreen-key(AppState.onscreen-keyboard-physical-key);
        }
    }

    // ── Keyboard dropdown overlay (Max parental rating / Auto-lock) ─────────
    // Screen-local mirror of Settings' own keyboard-driven dropdown overlay
    // (settings.slint's kbdd-* block) — SettingsDropdown itself has no
    // keyboard path of its own, confirmed by reading its real current
    // definition. Always in tree (visible: not if:) so ddvl.preferred-width
    // is readable for sizing, same reasoning Settings' own version notes.
    Rectangle {
        visible:       AppState.profile-edit-dropdown-open;
        z:             20;
        width:         min(320px, card.width - 40px);
        height:        min(ddvl.preferred-height + 8px, 280px);
        x:             (parent.width - self.width) / 2;
        y:             (parent.height - self.height) / 2;
        background:    Theme.surface-raised;
        border-radius: 8px;
        border-width:  1px;
        border-color:  Theme.border;
        drop-shadow-blur:  12px;
        drop-shadow-color: #00000080;
        clip:          true;

        ddfl := Flickable {
            viewport-height: ddvl.preferred-height;

            property <length> dd-scroll: AppState.profile-edit-dropdown-cursor >= 0
                ? clamp(-(AppState.profile-edit-dropdown-cursor * 32px + 16px - self.height / 2),
                        min(0px, self.height - ddvl.preferred-height), 0px)
                : 0px;
            changed dd-scroll => { ddfl.viewport-y = dd-scroll; }
            init    => { ddfl.viewport-y = dd-scroll; }

            ddvl := VerticalLayout {
                padding: 4px;
                for opt[i] in AppState.profile-edit-dropdown-model: Rectangle {
                    height:          32px;
                    border-radius:   4px;
                    background:      i == AppState.profile-edit-dropdown-cursor
                                     ? Theme.accent-muted
                                     : (dd-item-ta.has-hover ? Theme.surface-overlay : transparent);
                    // Real bug, live-reported 2026-08-17: "they pop up but
                    // you dont get a hilight when you are on them" —
                    // accent-muted is only 25% alpha (theme.slint), which
                    // reads as genuinely too subtle against
                    // surface-raised's near-black on a real display. Adds
                    // a steady Theme.focus-border ring (this codebase's own
                    // established, high-contrast focus indicator) at 2px
                    // for the cursor row, bumping to 3px on an actual press
                    // — same "existing ring bumps up on press" convention
                    // every other keyboard-focus site in this app uses.
                    border-width:  (dd-item-ta.pressed || dd-pulse.pulsing) ? 3px
                                   : (i == AppState.profile-edit-dropdown-cursor ? 2px : 0px);
                    border-color:  Theme.focus-border;
                    animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                    dd-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: i == AppState.profile-edit-dropdown-cursor; }
                    dd-txt := Text {
                        x:                  12px;
                        text:               opt;
                        color:              opt == AppState.profile-edit-dropdown-display ? Theme.accent : Theme.text;
                        font-size:          13px;
                        font-weight:        opt == AppState.profile-edit-dropdown-display ? 600 : 400;
                        vertical-alignment: center;
                        overflow:           elide;
                    }
                    dd-item-ta := TouchArea {
                        clicked => {
                            AppState.profile-edit-dropdown-cursor = i;
                            // Reuse the exact same commit path the keyboard's
                            // Enter uses — Rust's apply_profile_edit_dropdown_selection
                            // reads dropdown-cursor, so setting it just above
                            // then bumping kb-activate-pulse would ALSO work,
                            // but calling straight through keys.rs's own
                            // handle_key_profile_edit dispatch (via a
                            // synthetic RETURN) isn't reachable from Slint —
                            // simplest correct option is the dedicated
                            // callback below instead.
                            AppState.profile-edit-dropdown-pick();
                        }
                    }
                }
            }
        }
    }

    // Delete-profile confirm dialog, 2026-08-21 — direct request after full
    // live-testing ("did spot one improvment, we shuld add a confirmation
    // dialog when deliting profile"): Delete previously fired
    // AppState.profile-edit-delete() immediately on both mouse click and
    // keyboard Enter (via the _pulse-mirror tracker above), with zero
    // confirmation — a single mis-click/mis-press permanently removed a
    // profile. Reuses ConfirmDialog (widgets.slint) rather than inventing a
    // second modal mechanism — same shape as settings.slint's own Reset Key
    // Bindings / rebind-collision dialogs, declared last so it renders on
    // top of everything else on this screen. Keyboard (Left/Right/Confirm/
    // Back) is handled by keys.rs's own show_profile_edit raw-key tier, not
    // here — ConfirmDialog itself is keyboard-dumb by design. name-field.text
    // (not profile-edit-name-initial, which is only the pre-fill) so the
    // message reflects whatever the user actually has typed right now.
    if AppState.show-profile-edit-delete-confirm: ConfirmDialog {
        title:         "Delete Profile?";
        message:       "Delete " + name-field.text + "? This can't be undone.";
        confirm-label: "Delete";
        focused:       AppState.profile-edit-delete-confirm-focused;
        confirmed => {
            AppState.profile-edit-delete();
            AppState.show-profile-edit-delete-confirm = false;
            AppState.refocus();
        }
        cancelled => {
            AppState.show-profile-edit-delete-confirm = false;
            AppState.refocus();
        }
    }
}
