// ── fjord-app · remember_login_confirm.slint ─────────────────────────────────
//   RememberLoginConfirmOverlay  Settings → Profiles → "Remember this login" turned back ON
//                       (OFF is immediate; ON re-checks the password first). A small modal, not
//                       the LoginScreen/do-login pipeline (which would rebuild the whole session
//                       just to verify a password). Dim backdrop + centered box like
//                       ConfirmDialog; server + username are read-only, only the password is
//                       editable. FadeGate-mounted from main.slint.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import { FjordButton, LoadingSpinner } from "widgets.slint";
import { LineEdit } from "std-widgets.slint";

export component RememberLoginConfirmOverlay inherits Rectangle {
    background: Theme.scrim;

    init => { pass-input.focus(); }

    TouchArea {
        width: parent.width;
        height: parent.height;
        // No-op click-through-blocker — cancelling is a deliberate
        // Escape/Cancel-button action (same reasoning as the profile
        // picker's own PIN-entry backdrop), not an accidental stray click.
    }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 360px;
        height: content.preferred-height + 32px;
        border-radius: Theme.radius-lg;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 20px;
        drop-shadow-color: Theme.shadow-strong;
        drop-shadow-offset-y: 6px;

        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        content := VerticalLayout {
            x: 16px;
            y: 16px;
            width: parent.width - 32px;
            // A Layout directly in a plain Rectangle: bind its height to preferred-height, or it can
            // disagree with card's height (computed from content.preferred-height), which varies here
            // (optional error line, spinner or buttons) — the ConfirmDialog fix.
            height: self.preferred-height;
            spacing: 14px;

            Text {
                text: "Confirm password for " + AppState.remember-login-confirm-username;
                color: Theme.text;
                font-size: 15px * AppState.text-scale;
                font-weight: 700;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
                text: "Re-entering your password lets this account resume automatically again at startup.";
                color: Theme.text-muted;
                font-size: 12px * AppState.text-scale;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            pass-input := LineEdit {
                placeholder-text: "Password";
                input-type: password;
                height: 40px;
                accepted => { AppState.remember-login-confirm(self.text); }
                // Escape can't be handled by keys.rs's own global dispatch
                // here — the global FocusScope is a SIBLING of this
                // free-floating overlay, not an ancestor, so a key
                // consumed/routed by a natively-focused LineEdit never
                // reaches it at all (the same finding ProfileEditScreen's
                // own text fields already established). Handled directly
                // in Slint instead.
                key-pressed(event) => {
                    if event.text == "\u{1b}" {
                        AppState.remember-login-confirm-cancel();
                        return accept;
                    }
                    return reject;
                }
            }

            if AppState.remember-login-confirm-error != "": Text {
                text: AppState.remember-login-confirm-error;
                color: Theme.error;
                font-size: 12px * AppState.text-scale;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if AppState.remember-login-confirm-loading: LoadingSpinner { }

            if !AppState.remember-login-confirm-loading: HorizontalLayout {
                spacing: 10px;
                FjordButton {
                    text: "Cancel";
                    clicked => { AppState.remember-login-confirm-cancel(); }
                }

                FjordButton {
                    text: "Confirm";
                    clicked => { AppState.remember-login-confirm(pass-input.text); }
                }
            }
        }
    }
}
