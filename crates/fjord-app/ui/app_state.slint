// ── fjord-app · app_state.slint ──────────────────────────────────────────────
//   Screen routing        show-login, show-detail, show-series, show-library, show-album, show-artist,
//                         app-content-loading, …; show-connecting/show-offline (startup connectivity
//                         gate, checked before show-login) + retry-connection (OfflineScreen's Retry)
//   Profile picker        show-profile-picker + profile-picker-sections ([ProfileSection] { header,
//                         tiles }) + -section (row) / -cursor (column) / -error; section 0 = the
//                         account's own household, further sections = Bonfire-linked households;
//                         show-profile-pin-entry + profile-pin-target-id/-name/-value/-cursor/-error
//   Account picker        show-account-picker + account-picker-accounts ([AccountTile]) — above the
//                         profile picker, only with 2+ accounts; account-picker-select/-add-account;
//                         login-append-mode/-source/-server-prefill/-username-prefill/-remember thread
//                         through LoginScreen for both "Add Account" entry points and RequireLogin
//   On-screen keyboard    show-onscreen-keyboard, onscreen-keyboard-target/-cursor/-caret,
//                         onscreen-keyboard-row-lens (topology shared with QwertyKeyboard),
//                         onscreen-keyboard-trim-last/-byte-len/-edit, caret-text, text-field-caret;
//                         open-onscreen-keyboard(target) — the one way to open it (false when Settings
//                         has it off); keys.rs checks it before every other input tier
//   Bonfire Group         show-bonfire-group, bonfire-group-is-owner/-is-member/-owned-code/-owned-members/
//                         -joined-owner-name/-has-pin/-is-administrator, the 3 settings toggles (LAN
//                         bypass OFF→ON confirmed first), join-code entry (append/backspace/submit),
//                         bonfire-group-zone (profile.rs::existing_bonfire_group_zones), Kick/Leave/
//                         Delete/LAN-bypass ConfirmDialogs — profile.rs::open_bonfire_group_screen
//   Bonfire Admin         jellyfin-is-server-admin (Jellyfin's admin flag; gates the Settings row),
//                         show-bonfire-admin, bonfire-admin-tab (0=Mappings 1=Audit Logs)/-cursor
//                         (-1 = tab switcher)/-col, bonfire-admin-rows / -audit-rows (lazy), Reset PIN
//                         confirm (stashes its target) — bonfire_admin.rs::open_bonfire_admin_screen
//   Toast notification    toast-message, toast-visible (auto-dismissed after 4 s)
//   Navigation state      active-nav, focused-section, focused-card, float-card-focused;
//                         settings-focused (string key, "" = left pane), settings-section ("" = sidebar),
//                         settings-focused-visual-index (scroll-to-view only)
//   Server info           server-url (+ server-unencrypted), server-name, server-version, client-version
//   Library grid          library-cols/-query/-header-focused/-sort (0-4)/-filter-unwatched/-filter-favorites/
//                         -sort-focused/-sort-cursor/-back-focused/-scrubber-focused/-scrubber-cursor
//                         (0=#, 1..26=A..Z)/-alpha-offsets (27)/-has-filters (false for Collections/Music)/
//                         -music-view (0=Artists 1=Albums 2=Playlists)
//   Browse list           media-items, current-item, browse-query, browse-header-focused
//   Dashboard data        continue-watching, next-up, recently-added, recently-added-albums, …
//   Auto-advance          show-next-ep-banner, next-ep-title/-ends-at/-secs
//   Volume overlay        show-volume-overlay, volume-level, audio-passthrough-active (~1.5 s)
//   Segment skip          show-skip-segment/-label (ask), show-skip-timed + -label/-secs/-focused (ask-timed);
//                         skip-fade-active (fade-to-black around the seek)
//   Player state          is-playing, is-paused, playing-artist, video-frame, playback-ends-at;
//                         video-surface-active + video-rect-* + window-bg (separate video surface)
//   Music bar             is-audio-playing, music-bar-title/artist/album-id/art/has-art/pos/elapsed/total/paused,
//                         music-bar-play-pause/-stop/-open-album, play-album-all
//   Now Playing / player  show-now-playing, now-playing-in-strip/-ctrl-focused/-strip-focused, open-now-playing;
//                         seek-hover-time, seek-dragging, buffering-active/pct, playback-stalled, buffered-pos,
//                         playback-total-secs, track panels; chapter-marks/-osd/-entries, current-chapter,
//                         chapter-prev/next/-jump; delay-osd-*, sub/audio-delay-ms + inc/dec
//   Detail page           detail-id/-item-type/-resume-secs/-title/-tagline/-studio/-is-favorite/-has-played,
//                         detail-focused-row/-btn, detail-cast/-similar/-collection/-recommended (+ -focused),
//                         detail-series-id, detail-scroll, detail-ends-at, …
//   Series / season       series-id, seasons, episode-cards, poster, backdrop, tagline, studio, is-favorite,
//                         meta/genres/rating-label, next-up card, cast, similar, series-recommended,
//                         series-missing-seasons (+ -focused); show-season, season-id/title/overview/meta,
//                         poster/backdrop, cast, focused-ep
//   Person                show-person, person-id/name/bio, portrait, filmography, film-focused, in-film-row,
//                         person-other-work (+ -focused), person-in-other-work-row
//   Album / artist        show-album, album-id/title/artist/meta/overview, poster, tracks ([TrackItem]),
//                         album-focused-track/-back-focused/-is-favorite/-has-played/-open-gen/-btn-focused/
//                         -overview-expanded; show-artist, artist-id/title/overview/meta, portrait, albums,
//                         artist-focused/-back-focused/-open-gen/-is-favorite/-btn-focused (-1/0=▶/1=♥)/
//                         -overview-expanded; play-artist-all, toggle-artist-fav
//   Seerr integration     settings-seerr-enabled, seerr-connected/-label (connected implies enabled),
//                         seerr-unencrypted, open-connect-seerr, seerr-disconnect; streaming/discover region,
//                         display/discover language dropdowns (dynamic, Settings → Integrations, shown while
//                         connected); settings-trailer-quality (static); yt-dlp-available; seerr-is-admin
//                         (MANAGE_REQUESTS), seerr-can-manage-blocklist; ConnectSeerrScreen: show-connect-seerr,
//                         connect-seerr-zone/-method (0-3)/-error/-busy/-qc-code/-qc-secret/-qc-polling +
//                         connect-seerr-api-key/-jellyfin/-local/-quickconnect-start/-poll
//   Discover screen       discover-query (+ -cursor), discover-searching, discover-results, discover-focused/
//                         -focused-row/-header-focused, discover-search-*, open-discover-item (redirects to
//                         the Jellyfin item when the library has it); landing rows (query ""):
//                         discover-trending/-popular-movies/-popular-tv/-upcoming-movies/-upcoming-tv/
//                         -requested/-new-in-theaters/-coming-up/-watchlist-mixed (rows 0-8),
//                         discover-landing-card; discover-watchlist-movies/-tv and -coming-up-mixed/-movies/
//                         -tv also feed the Home/Movies/TV dashboard rows
//   Discover filters      discover-filter-type/-sort/-rating/-year-desc (pills), -genres/-providers (chips),
//                         discover-filter-clear, discover-filters-active, discover-filter-bar-active/-focused,
//                         discover-popup-open/-cursor (Discover's own popup keyboard machinery);
//                         persisted via Config.discover_filter_*
//   Request detail        show-request-detail, request-detail-media-type/-tmdb-id/-title/-meta/-overview/
//                         -rating/-overview-expanded/-poster/-backdrop, request-detail-status/-status-4k
//                         (final display text per tier), -availability, -on-watchlist, -cast/-seasons/-tags/
//                         -profiles (+ -focused / -alt tier), -zone, -btn-focused, -trailer-url/-state,
//                         -open-gen, -requesting; play-trailer; Request Options modal: show-request-options,
//                         request-options-zone (0=Quality 1=Profile 2=Tags 3=Seasons 4=Confirm, absent zones
//                         skipped), -confirm-focused, -editing/-editing-request-id (Edit Request → PUT)
//   Context menu          show-context-menu, context-menu-* state/-focused; Discover family:
//                         context-menu-request-id/-availability/-request-pending/-request-mine +
//                         open-context-menu-discover(CardItem); Jellyfin Watchlist row:
//                         context-menu-jf-tmdb-id/-jf-media-type + context-jf-toggle-watchlist
//   Calendar / blocklist  show-calendar + calendar-days/-leading-blanks/-total-days/…; show-blocklist + rows
//   Settings state        hwdec, interpolation, audio-spdif, sub-lang, skip-*-mode/secs, display-sync-*, …
//   Key binding editor    keybinding-normal/-player rows, keybinding-focused, keybinding-rebinding;
//                         reset-to-defaults and rebind-collision ConfirmDialogs + keybinding-collision-
//                         confirmed/-cancelled; settings-row-focused(string) (mouse click on a SettingsRow)
//   Nav helpers           section-len, find-first/next/prev-section, section-card-item — hand-enumerated
//                         ternary chains; adding a dashboard row needs explicit branches (see their comment)
//   Callbacks — auth      do-login, sign-out, quit, toggle-fullscreen
//   Callbacks — browse    nav-selected, filter-changed, browse-search-*, library-search-*
//   Callbacks — play      item-play, play/resume-detail, open-detail/series, open-album, play-album-track
//   Callbacks — player    pause-play-toggle, seek-*, volume-*, mute, select-*, stop
//   Queue                 queue-count/-repeat-mode/-shuffle, playlist callbacks; show-queue-panel, queue-items,
//                         queue-panel-cursor; open-queue-panel (mouse entry, like the 'q' key)
//   Lyrics                show-lyrics, lyrics-available, lyrics-lines ([LyricEntry]), lyrics-active-idx, toggle-lyrics
//   Callbacks — context   open-context-menu, context-mark-played, context-toggle-fav, context-play-from-start
//   Callbacks — misc      show-controls, cancel-auto-advance, play-next-ep, close-detail/series/album/artist, refocus
//   Callbacks — keys      handle-key (main dispatch), keybinding-reset-defaults
// ─────────────────────────────────────────────────────────────────────────────
import {
    Theme,
    TrackEntry,
    TrackItem,
    CastMember,
    SeasonEntry,
    CardItem,
    KeyBindingEntry,
    QueueEntry,
    LyricEntry,
    SeasonItem,
    TagItem,
    ProfileItem,
    StreamingProvider,
    GenreItem,
    ProviderItem,
    BlocklistRow,
    ProfileTile,
    ProfileSection,
    AccountTile,
    ToggleListItem,
    BonfireGroupMemberTile,
    BonfireAdminRow,
    BonfireAuditRow,
    OskEdit,
    VideoRect,
} from "theme.slint";
import { StandardListView } from "std-widgets.slint";

export global AppState {
    // ── Screen routing ────────────────────────────────────────────────────────
    in-out property <bool> show-login:            true;
    // Startup connectivity gate (checked before show-login): show-connecting while
    // the saved-session auth probe is in flight; show-offline if it fails to reach
    // the server at all (as opposed to a definite 401, which routes to show-login).
    in-out property <bool> show-connecting:       false;
    in-out property <bool> show-offline:          false;
    // 0=Retry 1=Change Server 2=Quit — a permanent failure (server decommissioned,
    // wrong saved URL) needs a way out besides retrying forever.
    in-out property <int> offline-focused:       0;
    callback retry-connection();

    // ── Profile picker ──────────────────────────────────────────────────────────
    // Shown instead of show-login at startup when the launch policy calls for it and
    // the chosen account has 2+ profiles, or when a remembered/default profile needs a
    // PIN it can't supply silently. "+ Add Account" lives one tier up (account picker).
    //
    // profile-picker-sections: one section per household, 2D nav like Discover's
    // landing rows — profile-picker-section = row (section), profile-picker-cursor =
    // column (tile). Section 0 is profile-picker-account-root-id's own group (root
    // tile included); further sections are households linked via a Bonfire group
    // (profile.rs::linked_account_roots), each with its full member list. PIN entry is
    // a layered state (show-profile-pin-entry), entered after picking a requires-pin tile.
    in-out property <bool> show-profile-picker: false;
    in-out property <[ProfileSection]> profile-picker-sections: [];
    // Which section/row has focus — see the block comment above.
    in-out property <int> profile-picker-section: 0;
    // Column within the focused section — see the block comment above.
    in-out property <int> profile-picker-cursor: 0;
    in-out property <string> profile-picker-error: "";
    // Section 0 is always scoped to one account (profile-picker-account-root-id),
    // not the flat Config.profiles list — see profile.rs::should_show_picker_at_startup.
    in-out property <string> profile-picker-account-root-id: "";
    // Where Back goes: "accounts" | "cancel". Opened from a live session (sidebar
    // "Switch Profile") Back cancels and keeps the current profile; reached via the
    // account tier (or not cancelable) it returns to Accounts. Set by
    // profile::open_profile_picker; exactly one of the two buttons is shown.
    in-out property <string> profile-picker-back-mode: "accounts";
    callback profile-picker-back-to-accounts();
    // Closes the picker without switching anything — same live session,
    // same profile, exactly what "cancelable" already meant everywhere
    // else in this app before this button existed to expose it visually.
    callback profile-picker-cancel();
    // Keyboard cursor on "← Back to Accounts": Up from the tile row (when the button
    // exists) sets it, Down returns; Enter/Escape/Backspace activate it.
    in-out property <bool> profile-picker-back-focused: false;
    // Keyboard cursor on Quit: Down from the tile row sets it, Up returns; Enter
    // quits, Escape/Backspace only un-focus it (a terminal action never fires on Escape).
    in-out property <bool> profile-picker-quit-focused: false;
    // True from picking a tile (or confirming a PIN) until switch_to_profile's async
    // work resolves (Bonfire /switch or check_auth, then finish_session_setup) — can
    // take seconds. Drives profile_picker.slint's loading overlay and blocks a second
    // concurrent switch from a repeated press.
    in-out property <bool> profile-picker-loading: false;
    callback profile-picker-select(string);   // user_id; Rust decides PIN-needed vs. switch-now
    // No "+ Add Account" tile here: a profile-tier picker is scoped to one known
    // account; adding accounts happens on the account picker.

    in-out property <bool> show-profile-pin-entry: false;
    in-out property <string> profile-pin-target-id: "";
    in-out property <string> profile-pin-target-name: "";
    // Digit count typed so far — the actual PIN digits are kept purely on
    // the Rust side (FjordState.profile_pin_buffer), never round-tripped
    // through a Slint string property; this is only what the masked-dot
    // display needs (Slint strings have no .length to read directly).
    in-out property <int> profile-pin-len: 0;
    in-out property <int> profile-pin-cursor: 0;     // VirtualKeyboard cursor
    in-out property <string> profile-pin-error: "";
    // Keyboard cursor on the PIN pad's "← Cancel" button: Down past the keypad's
    // bottom row focuses it, Up returns; Enter/Escape/Backspace cancel.
    in-out property <bool> profile-pin-cancel-focused: false;
    callback profile-pin-key(string);  // forwarded verbatim from VirtualKeyboard.key-pressed

    // True when the picker was reopened from a live session (sidebar "Switch
    // Profile"): Escape/Back may cancel back to it. The startup picker has nothing
    // to cancel back to.
    in-out property <bool> profile-picker-cancelable: false;

    // ── Account picker ──────────────────────────────────────────────────────────
    // One tier above the profile picker, shown instead of it when 2+ ACCOUNTS exist
    // (an account = a plain login, or a Bonfire household represented by its master;
    // profile.rs::AccountGroup). Tile row of AccountTiles + a trailing "+ Add Account"
    // tile + a loading overlay. A tile with 2+ profiles opens the profile picker
    // scoped to it; a 1-profile tile switches directly (or opens the profile-tier PIN
    // modal — there is no account-level PIN).
    in-out property <bool> show-account-picker: false;
    in-out property <[AccountTile]> account-picker-accounts: [];
    in-out property <int> account-picker-cursor: 0;
    in-out property <string> account-picker-error: "";
    in-out property <bool> account-picker-loading: false;
    // Same "reopened from a live session vs. the startup-only gate" shape
    // profile-picker-cancelable already established.
    in-out property <bool> account-picker-cancelable: false;
    // Same Quit-button keyboard-focus fix as profile-picker-quit-focused
    // above, applied to this tier too — this screen has its own separate
    // Quit button/dispatch, not a shared one.
    in-out property <bool> account-picker-quit-focused: false;
    // Keyboard cursor on the account picker's Back button. The button only exists
    // when account-picker-cancelable (opened from a live session); Escape/Backspace
    // close the picker in the same case (keys.rs).
    in-out property <bool> account-picker-back-focused: false;
    callback account-picker-select(string);   // account root_id
    callback account-picker-add-account();    // "+ Add Account" tile → opens LoginScreen

    // Sidebar profile row (active-nav == 7, between Discover/Browse All and Settings
    // in browse.rs::sidebar_nav): the active profile's avatar + name, opening the
    // profile quick-menu. Pushed by profile.rs::push_current_profile_tile on every
    // session start/switch.
    in-out property <ProfileTile> current-profile-tile;
    // Enter/click on the sidebar row opens a small quick-menu — row labels
    // are pushed by Rust (profile.rs::sidebar_profile_menu_rows) rather than
    // hardcoded here, since which rows apply is dynamic (Switch Profile only
    // with 2+ known profiles; Manage Profiles only for a master account).
    in-out property <bool> show-sidebar-profile-menu: false;
    in-out property <[string]> sidebar-profile-menu-rows: [];
    in-out property <int> sidebar-profile-menu-focused: 0;
    callback open-sidebar-profile-menu();
    callback sidebar-profile-menu-action(int);  // index into sidebar-profile-menu-rows

    // ── Launch policy (Settings → Profiles) ─────────────────────────────────────
    // Whether show-profile-picker is considered at startup —
    // profile.rs::should_show_picker_at_startup. "always_ask" | "remember_last" |
    // "default" (DeviceConfig.launch_policy's raw strings). The default-profile
    // dropdown's -id (persisted DeviceConfig.default_profile_id) / -desc (label) /
    // -display (options) are pushed from Rust (profile::refresh_profile_settings_dropdown)
    // since the options are Config.profiles.
    in-out property <string> settings-launch-policy: "always_ask";
    in-out property <string> settings-default-profile-id: "";
    in-out property <string> settings-default-profile-desc: "";
    in-out property <[string]> settings-default-profile-display: [];
    callback default-profile-selected(string);
    // Gates the Manage Profiles row: true when the active profile is a master
    // account (not a Bonfire sub-profile, !Config.active().is_bonfire). Refreshed in
    // apply_settings_to_window + finish_session_setup — it only changes at session start.
    in-out property <bool> settings-is-master-profile: true;
    callback open-manage-profiles();

    // ── Account launch policy (Settings → Profiles) ─────────────────────────────
    // The same one tier up: whether show-account-picker is considered at startup,
    // same 3 raw strings, default-account dropdown options = the known accounts'
    // names. Only visible in effect with 2+ accounts (should_show_picker_at_startup).
    in-out property <string> settings-account-launch-policy: "always_ask";
    in-out property <string> settings-default-account-id: "";
    in-out property <string> settings-default-account-desc: "";
    in-out property <[string]> settings-default-account-display: [];
    callback default-account-selected(string);
    // Settings → Profiles → "Add Account": always available, unlike the picker tiles
    // (which need a 2nd account to exist) — this is how one account becomes two.
    callback settings-add-account();

    // ── Remember this login (Settings → Profiles) ──────────────────────────────
    // Whether this account's root resumes silently at startup or always asks for the
    // password (should_show_picker_at_startup's RequireLogin arm). Turning it OFF is
    // immediate; turning it back ON needs the password re-checked first —
    // remember-login-confirm below, a small modal (not the full LoginScreen, which
    // would rebuild the whole session).
    in-out property <bool> settings-remember-login: true;
    callback settings-remember-login-toggle();
    in-out property <bool> show-remember-login-confirm: false;
    in-out property <string> remember-login-confirm-username: "";
    in-out property <string> remember-login-confirm-error: "";
    in-out property <bool> remember-login-confirm-loading: false;
    callback remember-login-confirm(string /* password */);
    callback remember-login-confirm-cancel();

    // ── Manage Profiles + Profile Edit (Bonfire) ────────────────────────────────
    // ManageProfilesScreen: ProfilePickerScreen's tile-row + "+" shape (ProfileTile),
    // opening ProfileEditScreen per tile instead of switching. Only reachable from a
    // master account (Settings gates the row on !is_bonfire).
    in-out property <bool> show-manage-profiles: false;
    in-out property <[ProfileTile]> manage-profiles-list: [];
    in-out property <int> manage-profiles-cursor: 0;
    in-out property <string> manage-profiles-error: "";
    // The master's sub-profile cap: BonfireProfile.max_sub_profiles from the master's
    // own /list entry (changeable server-side via admin_set_profile_limit; 5 only when
    // the server reports 0/absent). Gates the Add tile and the subtitle text.
    in-out property <int> manage-profiles-max-sub-profiles: 5;
    // Keyboard cursor on Manage Profiles' "✕": Up from the tile row focuses it, Down
    // returns; Enter/Escape/Backspace close.
    in-out property <bool> manage-profiles-close-focused: false;
    callback manage-profiles-select(string);  // user_id -> opens ProfileEditScreen in edit mode
    callback manage-profiles-add();           // "+ Add Profile" tile -> create mode

    // ProfileEditScreen: native-LineEdit-focus screen (like LoginScreen/
    // ConnectSeerrScreen) with full D-pad navigation over every zone — see
    // profile-edit-zone below. Text zones (Name/Blocked tags/Allowed tags) take a
    // physical keyboard or the on-screen keyboard. Key dispatch lives in
    // profile_edit.rs (keys.rs → handle_key_profile_edit), like discover's
    // handle_key_request_options for a comparably large multi-zone screen.
    in-out property <bool> show-profile-edit: false;
    // Stable zone id (not a traversal position — gaps are fine, like discover's
    // existing_option_zones), in visual order: 0=Name 1=Avatar color 2=PIN pad
    // 3=Max parental rating 4=Enabled libraries (absent when the list is empty)
    // 5=Blocked tags 6=Allowed tags 7=Auto-lock dropdown 8=Skip PIN on this network
    // 9=Allowed devices (conditional) 10=Your own account PIN pad 11=Button row.
    // The header ✕ isn't a zone — Escape closes the screen.
    in-out property <int> profile-edit-zone: 0;
    // True while a LineEdit (zone 0/5/6) holds REAL Slint focus — set by
    // that field's own `changed has-focus` tracker (profile_edit.slint),
    // which covers both a keyboard Enter-on-zone and a plain mouse click
    // for free. keys.rs's raw-key tier checks this before touching
    // Escape (a LineEdit in real focus swallows every key itself via its
    // own key-pressed(event) hook — Slint's key routing walks only the
    // focused item's own ancestor chain, so keys.rs literally never sees
    // a keypress while this is true, confirmed against i-slint-core's own
    // source before relying on it).
    in-out property <bool> profile-edit-text-editing: false;
    in-out property <int> profile-edit-avatar-cursor: 0;      // zone 1, 0..7
    in-out property <int> profile-edit-pin-cursor: 0;         // zone 2, 0..11 (VirtualKeyboard's row-major grid)
    in-out property <int> profile-edit-master-pin-cursor: 0;  // zone 10, same shape
    // A screen-local mirror of Settings' own keyboard-driven dropdown
    // overlay (settings.slint's kbdd-* block) — SettingsDropdown itself
    // (widgets.slint) has no keyboard path of its own, confirmed by
    // reading its real current definition, so this reuses the same
    // established SHAPE (a second, hand-built overlay) rather than trying
    // to extend the shared widget or reuse Settings' own row-keyed
    // dispatch tables, which aren't a general-purpose primitive.
    in-out property <bool> profile-edit-dropdown-open: false;
    in-out property <string> profile-edit-dropdown-key: "";   // "rating" | "lockout"
    in-out property <[string]> profile-edit-dropdown-model: [];
    in-out property <int> profile-edit-dropdown-cursor: 0;
    in-out property <string> profile-edit-dropdown-display: "";
    in-out property <int> profile-edit-libraries-cursor: 0;   // zone 4
    in-out property <int> profile-edit-devices-cursor: 0;     // zone 9
    in-out property <int> profile-edit-button-focused: 0;     // zone 11, 0-based over whichever buttons are VISIBLE this keypress (Delete is conditional)
    callback profile-edit-dropdown-pick; // mouse click on the dropdown overlay item; cursor already set — mirrors dropdown-pick below
    in-out property <bool> profile-edit-is-create: true;
    // True when opened via the sidebar's "Edit My Profile" (a master editing itself)
    // rather than Manage Profiles (editing a sub-profile): hides Delete and changes
    // where Save/Cancel return to.
    in-out property <bool> profile-edit-is-self: false;
    in-out property <string> profile-edit-target-id: "";      // "" in create mode
    in-out property <string> profile-edit-name-initial: "";   // LineEdit's starting text (edit mode pre-fill)
    // The two tag fields' starting text — /list carries blocked/allowed tags (unlike
    // max_parental_rating, which /list never returns, so that dropdown starts at
    // "Any"; see profile_edit.rs for why that's correct).
    in-out property <string> profile-edit-blocked-tags-initial: "";
    in-out property <string> profile-edit-allowed-tags-initial: "";
    // Selected swatch, a raw #rrggbb hex — sent to Bonfire as-is; Rust
    // resolves it to a real Slint `color` only for the live preview circle
    // (Slint's expression language has no string-to-color parse, same
    // reasoning as ProfileTile.avatar-color above).
    in-out property <string> profile-edit-avatar-color: "";
    in-out property <color> profile-edit-avatar-preview: #4a90d9;
    // PIN digits stay in Rust (FjordState.profile_edit_pin_buffer), never in Slint —
    // like the picker's profile-pin-len/-key. Empty on save = keep the existing PIN
    // (edit) / no PIN (create); digits typed = set/replace it.
    in-out property <int> profile-edit-pin-len: 0;
    in-out property <bool> profile-edit-has-pin: false;  // edit mode: informational only
    callback profile-edit-pin-key(string);               // forwarded from VirtualKeyboard.key-pressed
    // Same shape, for the household master-PIN confirmation field — only
    // ever meaningful when the ACTIVE (master) profile itself has a PIN set,
    // but shown unconditionally (best-effort, see profile_edit.rs's own doc
    // comment for why): left blank, it's simply omitted from the request,
    // which is only wrong for the one household-config combination that
    // needed it, and fails with a clear server-side error rather than a
    // silently wrong local guess.
    in-out property <int> profile-edit-master-pin-len: 0;
    callback profile-edit-master-pin-key(string);
    in-out property <string> profile-edit-parental-rating: "";
    in-out property <[ToggleListItem]> profile-edit-libraries: [];
    in-out property <[ToggleListItem]> profile-edit-devices: [];
    callback profile-edit-toggle-library(int);
    callback profile-edit-toggle-device(int);
    in-out property <string> profile-edit-lockout-minutes: "0";
    in-out property <bool> profile-edit-lan-bypass: false;
    in-out property <bool> profile-edit-saving: false;
    in-out property <string> profile-edit-error: "";
    // name/blocked-tags/allowed-tags are read directly off their own
    // LineEdits at Save time (`name-field.text`, etc.) and passed as call
    // arguments — same shape as ConnectSeerrScreen's own
    // connect-seerr-jellyfin(url, username, password), not tracked as
    // separate AppState properties, since nothing else needs to observe
    // them live.
    callback profile-edit-save(string, string, string);  // name, blocked-tags-csv, allowed-tags-csv
    callback profile-edit-delete();
    // Confirmation before Delete — the same ConfirmDialog (widgets.slint) and
    // "screen owns Left/Right/Confirm/Back, dialog is keyboard-dumb" convention as
    // Key Bindings' dialogs. Cancel is focused by default.
    in-out property <bool> show-profile-edit-delete-confirm: false;
    in-out property <int> profile-edit-delete-confirm-focused: 0; // 0=Cancel, 1=Delete
    callback profile-edit-cancel();
    callback profile-edit-avatar-color-selected(string);

    in-out property <bool> show-browse:           false;
    in-out property <bool> show-library:          false;
    in-out property <bool> show-series:           false;
    in-out property <bool> show-detail:           false;
    in-out property <bool> is-playing:            false;
    in-out property <bool> has-background-player: false;
    in-out property <bool> video-behind-ui:       false;
    in-out property <bool> app-content-loading:   false;  // true while fetching detail/series before showing screen
    in-out property <float> app-loading-progress:  0.0;   // 0.0→1.0 while app-content-loading; drives the progress bar

    // ── Toast notification ────────────────────────────────────────────────────
    in-out property <string> toast-message: "";
    in-out property <bool> toast-visible:  false;

    // ── Press animation ────────────────────────────────────────────────────────
    // Bumped once by keys.rs::handle_key() on every Enter press; every mounted
    // widgets.slint::PressPulse instance reacts if its own focus/selection
    // expression is currently true, playing a brief border-flash "press" cue.
    // Mouse press feedback needs no Rust involvement (TouchArea.pressed).
    in-out property <int> kb-activate-pulse: 0;
    // True only under the same condition keys.rs::active_mode() calls
    // AppMode::Dashboard, plus focused-section < 0 — the one narrow condition
    // under which the sidebar is genuinely the thing holding focus. Used by
    // both the press-pulse gate above and NavItem's own background highlight
    // (widgets.slint) in place of the old per-instance `kbd-focused` prop
    // (`focused-section < 0` alone, identically bound on every sidebar row),
    // which stayed stale/true while deep in Library/Browse/Settings/Detail/
    // etc since those modes never touch focused-section — the active sidebar
    // tab used to stay fully lit (and, once the press-pulse existed, kept
    // pulsing) long after focus had moved elsewhere. Deliberately a **pure
    // Slint expression**, not a value Rust pushes on keypress: an earlier
    // version was only recomputed inside keys::handle_key(), so it went stale
    // again the moment a screen change was triggered by the *mouse* instead
    // of the keyboard (e.g. clicking into the library grid) — a plain
    // expression mirroring active_mode()'s own conditions off the same
    // AppState flags is correct-by-construction for every input method at
    // once, since those flags are set identically regardless of how they
    // were triggered. The trade-off is duplicating active_mode()'s condition
    // list here; if a new screen/overlay is ever added to that Rust function,
    // this expression needs the matching branch added too.
    out property <bool> sidebar-kb-active:
        !show-context-menu
        && !show-queue-panel
        && !(show-now-playing && is-audio-playing)
        && !(show-person && !is-playing)
        && !(show-detail && !is-playing)
        && !(show-season && !is-playing)
        && !(show-series && !is-playing)
        && !(show-artist && !is-playing)
        && !(show-collection && !is-playing)
        && !(show-album && !is-playing)
        && !(show-request-detail && !is-playing)
        && !is-playing
        && !show-library
        && !show-browse
        && !show-sidebar-profile-menu
        && !show-manage-profiles
        && !show-profile-edit
        && active-nav != 10
        && focused-section < 0;
        // show-sidebar-profile-menu / -manage-profiles / -profile-edit keep active-nav at
        // 7 and don't touch focused-section, so without this exclusion the sidebar's
        // Profile row would flash its press-pulse with every Enter inside those overlays
        // (shared kb-activate-pulse). Discover (6) needs no exclusion, unlike Settings
        // (10): discover::handle_key keeps dispatch_dashboard's focused-section contract,
        // so focused-section < 0 means "sidebar focused" there too.

    // ── On-screen alphanumeric keyboard ─────────────────────────────────────────
    // Screen-agnostic. Open it only via open-onscreen-keyboard(target) below (sets
    // the target id + cursor, shows it, refocus()es so keys.rs's tier — a sibling,
    // not an ancestor, of every screen — sees the keys; does nothing when Settings
    // has it off). Each screen's key-pressed(k) handler decides what its target id
    // means. Widget: widgets.slint's QwertyKeyboard.
    in-out property <bool> show-onscreen-keyboard:   false;
    in-out property <string> onscreen-keyboard-target: ""; // e.g. "login-server"
    in-out property <int> onscreen-keyboard-cursor: 0;  // Rust-owned flat row-major index
    // Grid TOPOLOGY only (row lengths), shared by QwertyKeyboard's for-loops and
    // keys.rs's cursor math — never key VALUES, which live only in QwertyKeyboard
    // (a wrong length can mis-land the cursor by a cell, never fire a wrong key).
    // Last row: 123 · ◀ · space · ▶ · Done.
    out property <[int]> onscreen-keyboard-row-lens: [10, 9, 9, 5];
    // Flat index of "Done" — the last cell on both pages. Every open lands the
    // cursor here, so an accidental open is closed by the same Enter. Kept in sync
    // with onscreen-keyboard-row-lens by hand (10+9+9+5-1 = 32).
    out property <int> onscreen-keyboard-done-cursor: 32;
    // The one way Slint opens the on-screen keyboard. With it turned off in
    // Settings → UI nothing changes and false comes back, so the caller keeps
    // its field's focus and does its own Enter action instead (opening it anyway
    // left an undrawn keyboard holding focus — no key did anything, 2026-10-10).
    // Rust's twin: keys::open_onscreen_keyboard.
    public function open-onscreen-keyboard(target: string) -> bool {
        if !settings-onscreen-keyboard-enabled {
            return false;
        }
        onscreen-keyboard-target = target;
        onscreen-keyboard-cursor = onscreen-keyboard-done-cursor;
        show-onscreen-keyboard = true;
        refocus();
        return true;
    }
    // Physical-keyboard passthrough while the on-screen keyboard is open
    // (2026-08-23, live feedback: "i want it to still work to type on the
    // keybord even if its open") — keys.rs forwards any ordinary printable
    // key it sees while show-onscreen-keyboard is true (or Backspace, as
    // the sentinel "backspace", matching QwertyKeyboard's own key-pressed
    // vocabulary exactly) into whichever field onscreen-keyboard-target
    // points at. A payload+counter pair, not a callback Rust invokes
    // directly — Rust can't call a named Slint element's own method or
    // mutate a screen's local LineEdit state directly (the same reason
    // .focus() calls elsewhere in this app go through a changed-tracker
    // mirror, not a direct call). A plain string payload alone isn't
    // enough on its own: Slint's `changed` only fires on a genuine VALUE
    // change, so typing the same character twice in a row would silently
    // drop the second press if nothing else changed — the counter (bumped
    // unconditionally on every forward, mirroring kb-activate-pulse's own
    // reasoning) is what guarantees the mirror's `changed` fires every
    // time regardless of what was typed. Rust sets the payload BEFORE
    // bumping the counter; Slint property writes are synchronous within
    // one Rust function call, so the mirror's own changed handler always
    // reads the already-final payload value.
    in-out property <string> onscreen-keyboard-physical-key: "";
    in-out property <int> onscreen-keyboard-physical-key-seq: 0;
    // Two pure Rust string helpers — Slint strings have no length/substring:
    // remove exactly one Unicode character (backspace), and the UTF-8 byte length
    // (LineEdit.set-selection-offsets takes byte offsets). Screen-agnostic.
    pure callback onscreen-keyboard-trim-last(string) -> string;
    pure callback onscreen-keyboard-byte-len(string) -> int;
    // Caret editing (2026-10-05, text_field.rs). caret-text(text, caret,
    // glyph): the text with `glyph` drawn at the caret (grapheme index,
    // -1/past the end = end) — the drawn fields' display. onscreen-keyboard-
    // edit(text, caret, key): one on-screen key applied at the caret, for the
    // LineEdit targets (LineEdit has no cursor getter, so the keyboard keeps
    // its own caret in onscreen-keyboard-caret, reset to the end each time
    // the keyboard opens — main.slint). text-field-caret(target, delta): ◀ ▶
    // on a drawn target.
    pure callback caret-text(string, int, string) -> string;
    pure callback onscreen-keyboard-edit(string, int, string) -> OskEdit;
    in-out property <int> onscreen-keyboard-caret: -1;
    callback text-field-caret(string, int);

    // ── Navigation state ──────────────────────────────────────────────────────
    in-out property <int> active-nav:         0;
    in-out property <int> focused-section:   -1;
    in-out property <int> focused-card:       0;
    in-out property <int> float-card-focused: -1;  // -1=not focused, 0=Resume, 1=Stop; floating mini-player
    in property <string> server-url:       "";
    // True for an http:// server (set by crate::set_server_url_ui) — Settings
    // shows "not encrypted" under SERVER (2026-10-09 security review).
    in property <bool> server-unencrypted: false;
    // Same for the Seerr connection (seerr_auth::push_seerr_status).
    in property <bool> seerr-unencrypted:  false;
    in property <string> server-name:      "";
    in property <string> server-version:   "";
    in property <string> client-version:   "";  // "<semver> (<git build-id>)", set once at startup
    // Stable string keys (e.g. "general.launch_fullscreen", "video"), not indices,
    // so inserting a row/section never renumbers the others — see settings.rs's module
    // doc. "" = nothing focused.
    in-out property <string> settings-focused: "";   // "" = left pane focus, else the focused row's stable key
    in-out property <string> settings-section: "";   // "" = sidebar, else the selected section's stable key
    // Approximate scroll-target index for the focused row within the
    // current section's visible list (see settings.slint's kb-y) — Rust
    // recomputes this alongside settings-focused on every focus change
    // (settings-row-focused callback below), since Slint has no way to ask
    // "what's this key's position in the list Rust would build" reactively.
    in-out property <int> settings-focused-visual-index: 0;
    in-out property <bool> settings-dropdown-open:   false;  // a dropdown popup is keyboard-open
    in-out property <int> settings-dropdown-cursor: -1;     // focused item index inside open popup
    in-out property <[string]> settings-dropdown-model:  [];     // display strings for the open dropdown
    in-out property <string> settings-dropdown-display: "";    // display string of current value (accent highlight)

    // ── Library grid state ────────────────────────────────────────────────────
    in-out property <bool> library-header-focused:    false;
    in-out property <int> library-focused:           0;
    in-out property <[CardItem]> library-display:           [];
    in-out property <string> library-query:             "";
    in-out property <int> library-query-cursor:      -1; // caret, see text_field.rs (-1 = end)
    in-out property <int> library-cols:              6;   // written by MainWindow on resize
    // sort: 0=Name A–Z  1=Name Z–A  2=Year ↓  3=Year ↑  4=Random
    in-out property <int> library-sort:              0;
    in-out property <bool> library-filter-unwatched:  false;
    in-out property <bool> library-filter-favorites:  false;
    in-out property <bool> library-sort-focused:      false;
    in-out property <int> library-sort-cursor:       0;
    in-out property <bool> library-back-focused:      false;
    in-out property <int> library-focused-row:       0;     // row that drives vertical scroll; only updated on Up/Down
    in-out property <bool> library-scrubber-focused:  false;
    in-out property <int> library-scrubber-cursor:   0;
    // 27 flat item indices (A=0..Z=25, #=26); -1 means no items for that letter
    in-out property <[int]> library-alpha-offsets:     [];
    // false for Collections library (hides Unwatched/Favorites filter toggles)
    in-out property <bool> library-has-filters:       true;
    // Music library view: 0=Artists  1=Albums
    in-out property <int> library-music-view:        0;
    in-out property <length> dash-cw:                140px; // written by MainWindow on resize
    in-out property <length> dash-ch:                224px; // written by MainWindow on resize

    // ── Browse list state ─────────────────────────────────────────────────────
    in property <string> status:        "";
    in property <[StandardListViewItem]> media-items:   [];
    in-out property <int> current-item:  -1;
    in-out property <string> browse-query:  ""; // tracks keyboard search text
    in-out property <int> browse-query-cursor: -1; // caret, see text_field.rs (-1 = end)
    in-out property <bool> browse-header-focused: false;

    // ── Home / dashboard data rows ────────────────────────────────────────────
    in property <[CardItem]> continue-watching:        [];
    in property <[CardItem]> next-up:                  [];
    in property <[CardItem]> recently-added:           [];
    in property <[CardItem]> continue-watching-movies: [];
    in property <[CardItem]> recently-added-movies:    [];
    in property <[CardItem]> not-watched-movies:       [];
    in property <[CardItem]> continue-watching-tv:        [];
    in property <[CardItem]> recently-added-tv:           [];
    in property <[CardItem]> not-watched-tv:              [];
    in property <[CardItem]> recently-added-collections:  [];
    in property <[CardItem]> unwatched-collections:       [];
    in property <[CardItem]> recently-added-albums:       [];
    in property <[CardItem]> recently-played-albums:      [];
    in property <[CardItem]> favorite-movies:             [];
    in property <[CardItem]> favorite-series:             [];
    in property <[CardItem]> favorite-albums:             [];
    in property <[CardItem]> all-movies:               [];
    in property <[CardItem]> all-series:               [];
    in property <[CardItem]> all-collections:          [];
    in property <[CardItem]> all-artists:              [];
    in property <[CardItem]> all-albums:               [];
    in property <[CardItem]> all-playlists:            [];
    in property <[CardItem]> music-playlists:          [];   // Music dashboard "Playlists" row (section 3)

    // ── Up Next banner (shown during credits / last 30 s) ────────────────────
    in-out property <bool> show-next-ep-banner:    false;
    in-out property <string> next-ep-title:           "";
    in-out property <string> next-ep-ends-at:         "";  // "HH:MM" wall-clock end of next episode
    in-out property <int> next-ep-secs:             30;
    in-out property <int> next-ep-banner-focused:   0;  // 0=Play Now, 1=Skip

    // ── Volume overlay (transient, ~1.5 s) ───────────────────────────────────
    in-out property <bool> show-volume-overlay:      false;
    in-out property <int> volume-level:             100;
    in-out property <bool> audio-passthrough-active: false; // true when iec61937 passthrough detected

    // ── Segment skip prompts (Intro Skipper: Intro / Recap / Preview / Commercial) ──
    // ask mode:      single "Skip →" button
    in-out property <bool> show-skip-segment:  false;
    in-out property <string> skip-segment-label: "Skip Intro →";
    // ask-timed mode: two-button overlay ("Skip" + "Don't Skip") with countdown
    in-out property <bool> show-skip-timed:    false;
    in-out property <string> skip-timed-label:   "Skip Intro →";
    in-out property <int> skip-timed-secs:    8;
    in-out property <int> skip-timed-focused: 0;  // 0=Skip, 1=Don't Skip
    callback dismiss-skip-timed;
    // Drives player.slint's fade-to-black around a skip-segment seek: set the moment
    // a skip is decided (always-skip, ask-timed expiry, manual Skip), before the seek;
    // the playback tick clears it once the delayed seek has happened. Sequencing:
    // VideoState.pending_skip_seek.
    in-out property <bool> skip-fade-active:   false;

    // ── Player state ──────────────────────────────────────────────────────────
    in property <image> video-frame;
    // HDR Stage 5 (2026-10-05) — video on its own Wayland subsurface below
    // the window (video_surface.rs). video-surface-active: set by Rust once
    // the current player's frames are drawn there (cleared on stop) — the
    // window then goes transparent and the four video Images give way to
    // VideoSpots. video-rect-*: where each spot is, reported by VideoSpot.
    // window-bg: the background the subsurface fills around the video.
    in-out property <bool> video-surface-active: false;
    in-out property <VideoRect> video-rect-player;
    in-out property <VideoRect> video-rect-bg;
    in-out property <VideoRect> video-rect-thumb;
    out property <color> window-bg: Theme.bg;
    in-out property <string> playing-artist:        "";   // artist name shown in controls bar for audio tracks

    // ── Music player bar ──────────────────────────────────────────────────────
    in-out property <bool> is-audio-playing:    false; // music bar active (audio-only playback)
    in-out property <string> music-bar-title:     "";
    in-out property <string> music-bar-artist:    "";
    in-out property <string> music-bar-album-id:  "";   // for album art fetch + open-album nav
    in-out property <image> music-bar-art;
    in-out property <bool> music-bar-has-art:   false;
    in-out property <float> music-bar-pos:       0;    // 0–1 playback position
    in-out property <string> music-bar-elapsed:   "0:00";
    in-out property <string> music-bar-total:     "0:00";
    in-out property <bool> music-bar-paused:    false;
    // -1=none 0=art/title 1=⏸/▶ 2=⏹ 3=timeline 4=⏮Prev 5=⏭Next 6=⇌Shuffle 7=↺Repeat 8=⋮Queue 9=♪Lyrics
    in-out property <int> music-bar-focused:   -1;
    callback music-bar-play-pause();
    callback music-bar-stop();
    callback music-bar-open-album();
    callback music-bar-seek(ratio: float);
    callback music-bar-seek-rel(secs: float); // relative seek in seconds (±10)

    // ── Now Playing (fullscreen music screen) ─────────────────────────────────
    in-out property <bool> show-now-playing:          false;
    in-out property <bool> now-playing-back-focused:   false; // top-left Back button focused
    in-out property <bool> now-playing-in-strip:       false; // false=transport row, true=up-next strip
    in-out property <int> now-playing-ctrl-focused:   2;     // 0=Album 1=Prev 2=Play/Pause 3=Next 4=Shuffle 5=Repeat 6=VolDown 7=VolUp
    in-out property <int> now-playing-strip-focused:  0;     // index into queue-items
    callback open-now-playing(); // Rust resets focus state then sets show-now-playing=true
    callback play-album-all();

    in-out property <int> app-logo-idx:         1;    // 1-10, randomised at startup
    in-out property <bool> is-paused:            false;
    in-out property <string> playing-title:         "";
    in-out property <bool> stats-visible:         false;
    in-out property <float> playback-pos:           0;
    in-out property <string> playback-time:          "0:00";
    in-out property <string> playback-total:         "0:00";
    in-out property <float> playback-total-secs:    0.0;   // total duration in seconds; used by seek-hover time calc
    in-out property <string> playback-ends-at:       "";
    in-out property <string> seek-hover-time:        "";    // formatted time at hover position on the seek bar
    in-out property <bool> buffering-active:       false; // true when mpv is stalled waiting for cache
    in-out property <int> buffering-pct:          0;     // cache-buffering-state 0-100
    // True when the stall-recovery watchdog has detected position not
    // advancing for 5s+ (not paused, not cache-buffering) and is attempting
    // a stream reload — distinct from buffering-active, which only reflects
    // mpv's own paused-for-cache state and never engages during a real
    // network/connection failure (mpv is actively erroring/retrying, not
    // calmly waiting). See CLAUDE.md's Playback resilience section.
    in-out property <bool> playback-stalled:       false;
    in-out property <float> buffered-pos:           0.0;  // demuxer cache end as fraction 0-1; shown on seek bar
    callback update-seek-hover(float);                      // hover fraction 0-1 → Rust formats and sets seek-hover-time
    in-out property <bool> controls-visible:       true;
    in-out property <bool> pause-bar-visible:      false; // minimal bar shown on keyboard pause; cleared on resume
    in-out property <bool> seek-osd-visible:       false; // seek accumulation active; minimal bar uses seek-bar-* values
    in-out property <float> seek-bar-pos:           0.0;   // target seek position (0-1); used by minimal bar thumb when seek-osd-visible
    in-out property <string> seek-bar-time:          "";    // target seek time string; used by minimal bar left-time when seek-osd-visible
    in-out property <string> seek-delta-text:        "";    // formatted seek delta e.g. "+30s" or "-1:30"; shown in centered pill
    in-out property <bool> seek-dragging:          false; // true while seek bar button is held; blocks PausePlay
    in-out property <length> player-cursor-x:        0;   // last cursor position in player coords
    in-out property <length> player-cursor-y:        0;
    in-out property <int> player-open-panel:      0;
    in-out property <int> player-panel-cursor:    0;

    in-out property <[TrackEntry]> sub-tracks;
    in-out property <[TrackEntry]> audio-tracks;
    in-out property <[TrackEntry]> video-tracks;
    in-out property <int> current-sub-id:   0;
    in-out property <int> current-audio-id: 1;
    in-out property <int> current-video-id: 1;

    // ── Chapter navigation ────────────────────────────────────────────────────
    in-out property <[float]> chapter-marks:      [];   // normalised 0-1 seek bar positions for each chapter
    in-out property <bool> chapter-osd-visible: false;
    in-out property <string> chapter-osd-text:    "";   // "Chapter N" or chapter title; shown for ~2 s
    in-out property <[TrackEntry]> chapter-entries:    [];    // id=index, label="M:SS · Title"; populated when chapters load
    in-out property <int> current-chapter:    -1;   // index of active chapter (-1 = none loaded)
    callback chapter-prev();
    callback chapter-next();
    callback chapter-jump(int);   // seek to chapter by index; called from Chapters panel click or kbd Enter

    // ── Sub / audio delay OSD + Sync panel ───────────────────────────────────
    in-out property <bool> delay-osd-visible: false;
    in-out property <string> delay-osd-text:    "";   // "Sub delay: +200 ms" / "Audio delay: −100 ms"; shown for ~2 s
    in-out property <int> sub-delay-ms:      0;    // live sub-delay in ms; shown in Sync panel
    in-out property <int> audio-delay-ms:    0;    // live audio-delay in ms; shown in Sync panel
    callback sub-delay-inc();    // z  (+100 ms)
    callback sub-delay-dec();    // Z  (−100 ms)
    callback audio-delay-inc();  // x  (+100 ms)
    callback audio-delay-dec();  // X  (−100 ms)

    in property <string> stat-vid-in:   "—";
    in property <string> stat-vid-out:  "—";
    // IN = the source file's mastering info, OUT = what goes to the display after
    // tone-mapping (an HDR file tone-mapped to SDR: "bt.2020 · pq" in, "bt.709 ·
    // bt.1886" out) — OUT is what a TV's HDR/gamut mode should match. See stats.rs.
    in property <string> stat-color-in:  "—";
    in property <string> stat-color-out: "—";
    // hdr branch, Stage 3 (2026-09-14) — real Wayland color-management
    // negotiation status (Idle/Disabled/Not applicable/Unavailable/
    // Negotiating…/Active (HDR10)/Failed), Fjord's own state, not an mpv
    // property — see hdr.rs's HdrStatus/status_text().
    in property <string> stat-hdr:      "—";
    in property <string> stat-hwdec:    "—";
    in property <string> stat-aud-in:   "—";
    in property <string> stat-aud-out:  "—";
    in property <string> stat-display:  "—";
    in property <string> stat-vsync:    "—";
    in property <string> stat-avsync:   "—";
    in property <string> stat-speed:    "—";
    in property <string> stat-drop:     "—";
    in property <string> stat-bitrate:  "—";
    in property <string> stat-cache:    "—";

    // ── Detail page state ─────────────────────────────────────────────────────
    in-out property <string> detail-id:            "";
    in-out property <string> detail-item-type:    "";    // item type cached from fetch (Movie, Episode, etc.)
    in-out property <float> detail-resume-secs:   0;    // resume position in seconds (cached from fetch)
    in-out property <bool> detail-loading:       false;
    in-out property <int> detail-focused-btn:      0;    // 0=Play 1=Resume 2=Series 3=Fav 4=Watched 5=Overview
    in-out property <bool> detail-overview-expanded: false;
    in-out property <string> detail-title:        "";
    in-out property <string> detail-tagline:      "";    // first tagline or ""
    in-out property <string> detail-studio:       "";    // first studio name or ""
    in-out property <string> detail-series-label: "";
    in-out property <string> detail-series-id:    "";    // series ID when detail item is an Episode; "" otherwise
    in-out property <string> detail-meta:         "";
    in-out property <string> detail-genres:       "";
    in-out property <string> detail-overview:     "";
    in-out property <string> detail-rating-label: "";
    in-out property <image> detail-poster;
    in-out property <bool> detail-has-poster:   false;
    in-out property <image> detail-backdrop;
    in-out property <bool> detail-has-backdrop: false;
    in-out property <bool> detail-can-resume:   false;
    in-out property <string> detail-resume-label: "";
    in-out property <string> detail-ends-at:      "";  // "HH:MM" wall-clock time playback ends; shown below buttons
    in-out property <bool> detail-is-favorite:  false;
    in-out property <bool> detail-has-played:   false;
    in-out property <float> detail-resume-pct:   0.0;
    in-out property <[CastMember]> detail-cast;
    in-out property <int> detail-focused-row:        0;   // 0=buttons 1=cast 2=collection 3=similar
    in-out property <int> detail-cast-focused:      -1;   // -1=none; ≥0=focused card in cast row
    in-out property <[CardItem]> detail-similar:           [];   // "More Like This" poster row
    in-out property <int> detail-similar-focused:   -1;   // focused card in "More Like This" row
    // "Recommended" row (2026-07-29, Deep Seerr integration) — Discover-sourced,
    // shown below More Like This; see detail.rs::DetailCtx::spawn_recommended.
    in-out property <[CardItem]> detail-recommended:          [];
    in-out property <int> detail-recommended-focused:  -1;
    in-out property <string> detail-collection-title:  "";   // BoxSet name when movie is in a collection
    in-out property <[CardItem]> detail-collection:        [];   // "Part of [collection]" poster row
    in-out property <int> detail-collection-focused: -1;  // focused card in collection row
    in-out property <length> detail-scroll:       0px;
    in-out property <bool> playback-from-detail: false;   // set by start_playback when play came from detail page; reset_playback_ui restores detail on stop
    in-out property <bool> playback-from-series: false;   // set by on_play_series_episode; reset_playback_ui restores series screen on stop
    in-out property <bool> playback-from-season: false;   // set alongside playback-from-series when season detail was also open

    // ── Series drill-down state ───────────────────────────────────────────────
    in-out property <string> series-id:                "";
    in-out property <bool> series-loading:           true;
    in-out property <string> series-title:             "";
    in-out property <string> series-overview:          "";
    in-out property <string> series-tagline:           "";
    in-out property <string> series-studio:            "";
    in-out property <string> series-meta:              "";  // "2023 · TV-MA · 3 Seasons · 24 Episodes"
    in-out property <string> series-genres:            "";  // "Drama, Crime"
    in-out property <string> series-rating-label:      "";  // "★ 8.9"
    in-out property <bool> series-is-favorite:       false;
    in-out property <bool> series-has-played:        false;
    in-out property <int> series-unplayed-count:    0;
    in-out property <image> series-poster;
    in-out property <bool> series-has-poster:        false;
    in-out property <image> series-backdrop;
    in-out property <bool> series-has-backdrop:      false;
    in-out property <[SeasonEntry]> series-seasons;
    in-out property <[CardItem]> series-episode-cards:     [];  // horizontal episode row
    in-out property <int> series-season-idx:        0;
    in-out property <int> series-focused-ep:        0;
    in-out property <bool> series-in-season-row:     false;
    // Next Up (single next unwatched episode for this series)
    in-out property <bool> series-next-up-focused:   false;  // true when keyboard focus is on the Next Up row
    in-out property <bool> series-has-next-up:       false;
    in-out property <string> series-next-up-id:            "";
    in-out property <string> series-next-up-section-title: "Next Up";  // "Next Up" or "Next Up  ·  Ends HH:MM"
    in-out property <float> series-next-up-resume-pct: 0;
    in-out property <bool> series-next-up-has-played: false;
    in-out property <[CardItem]> series-next-up-cards:     [];
    // Cast & Crew
    in-out property <[CastMember]> series-cast:              [];
    in-out property <int> series-cast-focused:      -1;
    // More Like This
    in-out property <[CardItem]> series-similar:           [];
    in-out property <int> series-similar-focused:   -1;
    // "Recommended" row (2026-07-29, Deep Seerr integration) — Discover-sourced,
    // shown below More Like This; see series.rs::spawn_recommended.
    in-out property <[CardItem]> series-recommended:          [];
    in-out property <int> series-recommended-focused:  -1;
    // "Missing Seasons" row (2026-07-29, Deep Seerr integration) — placed
    // between Episodes and Cast; see series.rs::spawn_missing_seasons.
    in-out property <[CardItem]> series-missing-seasons:          [];
    in-out property <int> series-missing-seasons-focused:  -1;
    // Fired on Confirm/click for a focused missing-season card — wired in
    // main.rs (needs state/rt, unavailable to keys.rs::handle_key directly).
    callback series-missing-season-activate(int);
    // Header button focus: -1=not focused, 0=Back, 1=♥ fav, 2=✓ Watched, 3=Overview
    in-out property <int> series-focused-btn:        -1;
    in-out property <bool> series-overview-expanded:  false;

    // ── Season detail state ───────────────────────────────────────────────────
    in-out property <bool> show-season:         false;
    in-out property <string> season-id:           "";
    in-out property <string> season-title:        "";
    in-out property <string> season-overview:     "";
    in-out property <string> season-meta:         "";
    in-out property <image> season-poster;
    in-out property <bool> season-has-poster:   false;
    in-out property <image> season-backdrop;
    in-out property <bool> season-has-backdrop: false;
    in-out property <[CastMember]> season-cast:         [];
    in-out property <int> season-cast-focused:    -1;
    in-out property <int> season-focused-ep:      0;
    // header button focus: -1=not focused, 0=Back, 1=♥ fav, 2=✓ watched, 3=Overview
    in-out property <int> season-focused-btn:        -1;
    in-out property <bool> season-overview-expanded:  false;
    in-out property <bool> season-is-favorite:        false;
    in-out property <bool> season-has-played:         false;
    in-out property <bool> season-loading:         false;
    callback toggle-season-fav();
    callback toggle-season-played();

    // ── Person detail state ───────────────────────────────────────────────────
    in-out property <bool> show-person:         false;
    in-out property <string> person-id:           "";
    in-out property <string> person-name:         "";
    in-out property <string> person-bio:          "";
    in-out property <image> person-portrait;
    in-out property <bool> person-has-portrait: false;
    in-out property <[CardItem]> person-filmography:  [];
    in-out property <int> person-film-focused: 0;
    in-out property <bool> person-in-film-row:  false;
    // "Other Work" row (2026-07-29, Deep Seerr integration) — Discover-sourced,
    // shows this person's work NOT already in the local library; see
    // person.rs::spawn_other_work.
    in-out property <[CardItem]> person-other-work:          [];
    in-out property <int> person-other-work-focused:  0;
    in-out property <bool> person-in-other-work-row:   false;

    // ── Collection screen state ───────────────────────────────────────────────
    in-out property <bool> show-collection:         false;
    in-out property <string> collection-id:           "";
    in-out property <string> collection-title:        "";
    in-out property <image> collection-poster;
    in-out property <bool> collection-has-poster:   false;
    in-out property <image> collection-backdrop;
    in-out property <bool> collection-has-backdrop: false;
    in-out property <[CardItem]> collection-items:        [];
    in-out property <int> collection-focused:      0;
    in-out property <bool> collection-back-focused: false;
    in-out property <int> collection-open-gen:     0;    // incremented on every open; stale closures abort
    in-out property <string> collection-overview:     "";
    in-out property <bool> collection-is-favorite:  false;
    in-out property <bool> collection-has-played:   false;
    in-out property <int> collection-btn-focused:  -1;   // -1=none, 0=♥, 1=✓, 2=⛔ (2026-08-06, Seerr Blocklist support)
    // "Missing From This Collection" row (2026-07-29, Deep Seerr integration) —
    // Discover-sourced, the first SectionRow on this screen; see
    // collection.rs::spawn_missing_items.
    in-out property <[CardItem]> collection-missing:          [];
    in-out property <int> collection-missing-focused:  -1;
    // Bulk-blocklist-this-collection confirm dialog (2026-08-06, Seerr
    // Blocklist support) — checked first in collection.rs::handle_key,
    // same "overlay on top of the screen" precedent as skip-segment
    // overlays/the Up Next banner elsewhere in this app.
    in-out property <bool> collection-blocklist-confirm-open:     false;
    in-out property <int> collection-blocklist-confirm-focused:  0; // 0=Cancel, 1=Confirm
    callback collection-blocklist-confirm();

    // ── Album detail state ────────────────────────────────────────────────────
    in-out property <bool> show-album:          false;
    in-out property <string> album-id:            "";
    in-out property <string> album-title:         "";
    in-out property <string> album-artist:        "";
    in-out property <string> album-meta:          "";   // "2020 · 12 tracks · 45:23"
    in-out property <string> album-overview:      "";
    in-out property <image> album-poster;
    in-out property <bool> album-has-poster:    false;
    in-out property <[TrackItem]> album-tracks:        [];
    in-out property <int> album-focused-track: 0;
    in-out property <bool> album-back-focused:  false;
    in-out property <bool> album-is-favorite:   false;
    in-out property <bool> album-has-played:    false;
    in-out property <int> album-open-gen:      0;   // stale-request guard
    in-out property <bool> album-is-playlist:    false; // AlbumScreen shows a playlist: pos numbering, ✕ remove, Delete key
    in-out property <int> album-btn-focused:   -1;  // -1=none, 0=♥, 1=✓
    in-out property <bool> album-overview-expanded: false;

    // ── Artist screen state ───────────────────────────────────────────────────
    in-out property <bool> show-artist:         false;
    in-out property <string> artist-id:           "";
    in-out property <string> artist-title:        "";
    in-out property <string> artist-overview:     "";
    in-out property <string> artist-meta:         "";   // "5 albums"
    in-out property <image> artist-portrait;
    in-out property <bool> artist-has-portrait: false;
    in-out property <[CardItem]> artist-albums:       [];
    in-out property <int> artist-focused:      0;
    in-out property <bool> artist-back-focused: false;
    in-out property <int> artist-open-gen:     0;   // stale-request guard
    in-out property <bool> artist-is-favorite:  false;
    in-out property <int> artist-btn-focused:  -1;  // -1=none, 0=▶ Play All, 1=♥
    in-out property <bool> artist-overview-expanded: false;

    callback toggle-artist-fav;
    callback play-artist-all;

    // ── Discover screen state (Seerr search + results grid, discover.rs) ─────
    // No show-discover flag — this screen is driven by active-nav == 6
    // directly, same pattern as the Home/Movies/TV dashboards, not a
    // separate boolean overlay flag.
    in-out property <string> discover-query:          "";
    // Caret in the search field (2026-10-04): grapheme index, drawn via
    // caret-text — see text_field.rs.
    in-out property <int> discover-query-cursor:   -1; // -1 = end
    in-out property <bool> discover-searching:       false;
    in-out property <[CardItem]> discover-results:         [];
    in-out property <int> discover-focused:         0;
    in-out property <int> discover-focused-row:     0;      // scroll anchor, mirrors library-focused-row
    in-out property <bool> discover-header-focused:  false;  // search field focused, mirrors browse-header-focused
    callback discover-search-append(string);
    callback discover-search-backspace();
    callback discover-search-delete();   // Delete key: letter after the caret (2026-10-04)
    callback discover-search-clear();
    // Fired when keyboard Down reaches the last row of discover-results —
    // fetches the next search-results page and appends it, if one exists.
    // Seerr/TMDB search commonly has far more than one page for a common
    // word; Fjord only ever fetched page 1 until this existed, capping
    // results well below what Seerr's own web UI shows for the same query.
    // No-ops quietly when there's no next page / one's already in flight /
    // there's no active search — see discover.rs::spawn_discover_search_more.
    callback discover-load-more();
    callback open-discover-item(string, string);   // media-type ("movie"|"tv"), tmdb-id (as string)

    // ── Discover landing rows (shown when discover-query == "") ──────────────
    // Fetched once per session (guarded in FjordState) when nav first lands
    // on Discover with a connection active. Fixed set of 5, always in this
    // order — focused-section (shared, same property Home/Movies/TV use)
    // picks which row, 0-4; discover-landing-card is the column within it
    // (a separate property from discover-focused, which is the FLAT grid's
    // row-major index used only when a search query is active — the two
    // views are mutually exclusive so there's no real overlap, but the index
    // math is different enough to need its own property).
    in-out property <[CardItem]> discover-trending:         [];
    in-out property <[CardItem]> discover-popular-movies:   [];
    in-out property <[CardItem]> discover-popular-tv:       [];
    in-out property <[CardItem]> discover-upcoming-movies:  [];
    in-out property <[CardItem]> discover-upcoming-tv:      [];
    // Requests still on the way — not declined, not already available/
    // deleted (fjord_seerr::SeerrClient::requested_not_available). Unlike
    // the other 5 rows, each card's poster/title comes from a per-item
    // detail fetch, not directly from the row's own listing endpoint (GET
    // /request carries only a tmdbId) — same CardItem shape either way.
    in-out property <[CardItem]> discover-requested:        [];
    // "New in Theaters" (2026-07-18) — an approximation (primary TMDB
    // release date in roughly the last 6 weeks), not a verified "still
    // showing" signal — see discover.rs::fetch_new_in_theaters's own doc
    // comment for why Seerr's /discover/movies can't filter by release
    // type directly.
    in-out property <[CardItem]> discover-new-in-theaters:  [];
    // "Coming Up" (2026-07-18, Watchlist + Release Calendar) — Watchlist +
    // Requested-but-not-yet-available items with a known future release/
    // air date, soonest first, capped (see build_calendar_entries). LAST
    // card is a poster-less sentinel ("Full Calendar") opening
    // CalendarScreen instead of an item detail — see handle_key_landing's
    // own explicit special-case for why this needs one, not the generic
    // per-card open/context-menu path every other row uses.
    in-out property <[CardItem]> discover-coming-up:        [];
    // Coming Up without the sentinel, split mixed/movies/tv for the Home/TV/Movies
    // dashboard rows (home.slint) — the same 3-way split as discover-watchlist-*;
    // discover.rs::push_coming_up_row builds all 4 models together.
    in-out property <[CardItem]> discover-coming-up-mixed:  [];
    in-out property <[CardItem]> discover-coming-up-movies: [];
    in-out property <[CardItem]> discover-coming-up-tv:     [];
    // "Watchlist": every item on the Seerr watchlist, mixed movies+TV, capped at 20
    // (discover.rs::fetch_and_store_watchlist). Not deduped against Coming Up (an item
    // with a known date belongs in both). Also feeds Home's Watchlist row; -movies/-tv
    // are client-side-filtered variants for the Movies/TV dashboards (like Continue
    // Watching's mixed/movies/tv, home.rs).
    in-out property <[CardItem]> discover-watchlist-mixed:  [];
    in-out property <[CardItem]> discover-watchlist-movies: [];
    in-out property <[CardItem]> discover-watchlist-tv:     [];
    in-out property <int> discover-landing-card:     0;

    // ── Discover filters ────────────────────────────────────────────────────────
    // Persisted (Config.discover_filter_*). Type/Sort/Rating/Year are single-value
    // pills shaped like a SettingsDropdown (desc = display string). SettingsDropdown
    // itself is mouse-only (Settings adds its own keyboard capture), so
    // discover-popup-open/-cursor below are Discover's own keyboard machinery.
    in-out property <string> discover-filter-type-desc:   "All";
    in-out property <string> discover-filter-sort-desc:   "Popularity";
    in-out property <string> discover-filter-rating-desc: "Any";
    in-out property <string> discover-filter-year-desc:   "Any";
    // Whether ANY of the 6 filter dimensions differs from its default. Set only by
    // Rust (discover::discover_filters_active) together with the *-desc values, never
    // recomputed in Slint, so the landing/filtered-browse switch can't disagree with
    // the fetch Rust triggers.
    in-out property <bool> discover-filters-active: false;
    callback discover-filter-type-selected(string);
    callback discover-filter-sort-selected(string);
    callback discover-filter-rating-selected(string);
    callback discover-filter-year-selected(string);

    // Genre/Provider are multi-select chip pickers (TMDB's with_genres/
    // with_watch_providers both take pipe-separated OR — see
    // fjord_seerr::DiscoverFilters' own doc comment), each row toggled by
    // index rather than driven by a single desc string. Populated once by
    // discover.rs::ensure_discover_filter_options.
    in-out property <[GenreItem]> discover-filter-genres:    [];
    in-out property <[ProviderItem]> discover-filter-providers: [];
    // Selected-row counts, kept in sync by Rust alongside the models above
    // (0 = "Any") — Slint's expression language has no `.filter()`/count-
    // matching builtin for `[T]`, so this is computed once on the Rust
    // side rather than re-derived per-frame in Slint.
    in-out property <int> discover-filter-genre-count:    0;
    in-out property <int> discover-filter-provider-count: 0;
    callback discover-filter-genre-toggle(int);      // index into discover-filter-genres
    callback discover-filter-provider-toggle(int);   // index into discover-filter-providers
    callback discover-filter-clear();

    // Filter bar's own keyboard zone (a 4th Discover keyboard mechanism,
    // alongside the search field's raw pre-dispatch, fs<0 sidebar, and
    // fs>=0 grid — see discover.rs's own notes on why this insertion is
    // real, non-trivial wiring, not a drop-in "nearest zone" hand-off).
    // discover-filter-bar-active: true while the bar itself has focus (vs
    // search field / grid). discover-filter-bar-focused: which pill (0=Type
    // 1=Genre 2=Sort 3=Rating 4=Year 5=Provider 6=Clear), Left/Right moves.
    in-out property <bool> discover-filter-bar-active:   false;
    in-out property <int> discover-filter-bar-focused:  0;
    // A single unified popup-open flag covers all 6 pills — only one can
    // ever be open at a time, so one string ("" | "type" | "genre" | "sort"
    // | "rating" | "year" | "provider") is simpler than tracking a separate
    // dropdown-vs-chip-popup state; discover-popup-cursor is reused across
    // both popup shapes the same way settings-dropdown-cursor is reused
    // across every Settings dropdown regardless of its own content.
    in-out property <string> discover-popup-open:   "";
    in-out property <int> discover-popup-cursor:  0;
    // Mouse-click equivalents of keyboard Confirm — reuse the exact same
    // Rust dispatch (`handle_key_discover_filter_bar`/`handle_key_discover_
    // popup`'s own Confirm arm) rather than a second, independently-
    // written click handler, so mouse and keyboard can never disagree
    // about what a given pill/option/chip does. Callers set -bar-focused
    // (or -popup-cursor) to the clicked index FIRST, then invoke the
    // matching one of these two.
    callback discover-filter-bar-confirm();
    callback discover-popup-confirm();

    // ── Request detail screen state (Seerr movie/TV detail + Request, discover.rs) ──
    in-out property <bool> show-request-detail:          false;
    in-out property <string> request-detail-media-type:    "";  // "movie" | "tv"
    in-out property <int> request-detail-tmdb-id:       0;
    in-out property <string> request-detail-title:         "";
    in-out property <string> request-detail-meta:          "";  // year · genres
    in-out property <string> request-detail-overview:      "";
    in-out property <bool> request-detail-overview-expanded: false;
    // "★ 7.9" (TMDB voteAverage, one decimal) or "" when absent/zero — fed
    // straight into MetaLine.rating-label, same as DetailPage's own
    // Jellyfin-community-rating badge.
    in-out property <string> request-detail-rating:        "";
    // ── Metadata panel (Status/dates/language/countries/network/streaming) ──
    // Purely-display, read-only content — no keyboard zone of its own
    // (reached by scrolling the page's existing Flickable, same as MetaLine's
    // genre/tagline text elsewhere in the app). request-detail-production-
    // status is TMDB's own production-status string ("Returning Series",
    // "Ended", "Released", ...) — deliberately a DIFFERENT property from
    // request-detail-status above, which is Seerr's own request/availability
    // state; conflating the two would silently break the Request button's
    // existing "" vs requested/processing/partial/available logic.
    in-out property <string> request-detail-production-status: "";
    in-out property <string> request-detail-date-label:    "";  // "Release Date" | "First Air Date"
    in-out property <string> request-detail-date-value:    "";  // "July 14, 2026"; "" if unknown
    in-out property <string> request-detail-next-air-date: "";  // TV only; "" if none/unknown
    in-out property <string> request-detail-original-language: "";  // display name, e.g. "English"
    // Multi-line "🇺🇸 United States\n🇬🇧 United Kingdom" — a plain Text with
    // wrap:word-wrap respects embedded \n as real line breaks (same
    // mechanism StorylineSection relies on), so this doesn't need a
    // separate list model just to stack a handful of country names.
    in-out property <string> request-detail-production-countries: "";
    in-out property <string> request-detail-network:       "";  // TV only; joined "Apple TV, BBC"
    in-out property <[StreamingProvider]> request-detail-providers: [];  // flatrate only, resolved region
    in-out property <image> request-detail-poster;
    in-out property <bool> request-detail-has-poster:    false;
    in-out property <image> request-detail-backdrop;
    in-out property <bool> request-detail-has-backdrop:  false;
    // 2K tier's display status: "" (requestable) | "Requested" | "Needs Approval" |
    // "Processing" | "Partially Available" | "Available" | "Declined" — final text from
    // discover::tier_status_label (fulfilment + approval status; not CardItem.availability's
    // codes). -4k is the same for the 4K tier; Seerr tracks the tiers independently. The
    // Request button (request_detail.slint) shows while EITHER is ""; the Request Options
    // modal's Quality toggle picks the tier.
    in-out property <string> request-detail-status:        "";
    in-out property <string> request-detail-status-4k:     "";
    // Same "" | "requested" | "processing" | "partial" | "available" |
    // "blocklisted" vocabulary as CardItem.availability, base/2K tier only
    // (2026-08-06, Seerr Blocklist support) — deliberately NOT the same
    // field as request-detail-status above, which mixes in request-
    // workflow labels ("Needs Approval"/"Declined") that have nothing to
    // do with Blocklist eligibility. This is what the Blocklist button
    // actually gates on.
    in-out property <string> request-detail-availability:  "";
    // The MediaRequest the ⋮ More button's context menu (View Request/Edit/
    // Cancel/Approve/Decline — the same one used by the Discover grid's
    // right-click menu) should act on — resolved by discover.rs's
    // pick_primary_request (prefers 4K when both tiers have an active
    // request). "" when neither tier has one — the More button itself is
    // hidden in that case (request_detail.slint), since every one of its
    // rows either doesn't apply or duplicates what's already on the page.
    in-out property <string> request-detail-request-id:      "";
    in-out property <bool> request-detail-request-pending: false;
    in-out property <bool> request-detail-request-mine:    false;
    // Watchlist + Release Calendar (2026-07-18) — from MovieDetails/
    // TvDetails.onUserWatchlist on open, kept in sync by
    // discover_toggle_watchlist's own patch when this exact page is open.
    // Independent of request state — always shown, unlike Request which
    // hides once a status pill replaces it.
    in-out property <bool> request-detail-on-watchlist:    false;
    callback request-detail-toggle-watchlist();
    // Blocklist (2026-08-06, Seerr Blocklist support) — same toggle shape
    // as Watchlist above, but "adding" is derived from request-detail-
    // availability != "blocklisted" rather than a separate bool, since
    // Blocklisted rides on the same field every other status pill uses.
    callback request-detail-toggle-blocklist();
    // Watch Trailer (Discover only — see CLAUDE.md's Seerr integration
    // section). "" = no trailer found in MovieDetails/TvDetails.
    // relatedVideos, button hidden. Independent of request-detail-status —
    // watching a trailer makes sense even for an already-requested/
    // available item, so it's its own sibling in the button row, not nested
    // inside either the Request-button or status-pill branch.
    in-out property <string> request-detail-trailer-url:   "";
    // Trailer button state (2026-10-04, discover::start_trailer_check):
    // "" = not loaded yet (hidden) | "checking" (greyed "Checking…") |
    // "ok" (trailer-url set, pressable) | "none" (greyed "No trailer").
    in-out property <string> request-detail-trailer-state: "";
    // Button-row focus as a "gaps are fine" slot index (like context_menu.rs's Discover
    // rows): 0=Request (while a tier is requestable), 1=Trailer (found + yt-dlp present),
    // 2=⋮ More (request-detail-request-id non-empty). discover::existing_detail_btn_slots
    // resolves which exist and clamps this on every zone-0 key. Every writer (zone
    // entry, each button's `clicked`) keeps it in sync — mouse and keyboard must agree.
    in-out property <int> request-detail-btn-focused:   0;
    // Cast + crew (director/writer/top-billed actors), same take(2)/take(3)/
    // take(12) cap as DetailPage's Jellyfin cast. item-selected is a no-op —
    // there's no TMDB-person detail screen to open — but the row stays
    // keyboard-focusable (Left/Right scroll) for consistency.
    in-out property <[CastMember]> request-detail-cast:          [];
    in-out property <int> request-detail-focused-cast:  -1;
    in-out property <[SeasonItem]> request-detail-seasons:       [];  // TV only, empty for movies
    in-out property <int> request-detail-focused-season: 0;
    in-out property <bool> request-detail-back-focused:  true;
    // Vertical flow below the back button: 0=button row, 1=storyline (if any overview),
    // 2=cast row, 3=tags row, 4=seasons row (TV) — each only when present. Up/Down step
    // to the nearest existing zone; discover.rs owns the "which zones exist" list.
    in-out property <int> request-detail-zone:          0;
    in-out property <int> request-detail-open-gen:      0;     // stale-async-response guard
    in-out property <bool> request-detail-requesting:    false;
    // want-4k maps to POST /request's `is4k` field — the only quality/
    // resolution knob Seerr's API exposes; there's no discrete HDR request
    // flag (that's a Radarr/Sonarr quality-profile concern, configured
    // server-side, not something a request itself specifies). Toggled from
    // the Request Options modal below, not inline on the page.
    in-out property <bool> request-detail-want-4k:       false;
    // Radarr (movie) / Sonarr (tv) tags on the default server — best-effort,
    // silently empty if the server has none configured or the fetch fails
    // (some Seerr accounts may not have permission to read /service/*; a tag
    // picker not appearing shouldn't block the request flow either way).
    in-out property <[TagItem]> request-detail-tags:          [];
    in-out property <int> request-detail-focused-tag:   0;
    // Quality profiles on the same default server, same best-effort-empty
    // rules as tags. Radio-select via selected-profile-id (0 = row 0 =
    // synthetic "Default" entry, meaning "don't send profileId at all" —
    // real Radarr/Sonarr profile ids are never 0) rather than a per-row
    // bool, since exactly one (or none) can be chosen, not several.
    in-out property <[ProfileItem]> request-detail-profiles:            [];
    in-out property <int> request-detail-focused-profile:     0;
    in-out property <int> request-detail-selected-profile-id: 0;
    // Tags/profiles/selection for the *other* quality tier — both tiers are
    // fetched up front (SeerrClient::available_request_options_both_tiers)
    // so toggling Quality in the Request Options modal swaps these in
    // instantly (request-detail-set-quality below) rather than re-fetching
    // live, which would need its own loading state and risk a race on rapid
    // toggling. Selections (t.selected / this id) travel with whichever set
    // they belong to, so switching tiers and back preserves what was picked.
    in-out property <[TagItem]> request-detail-tags-alt:                [];
    in-out property <[ProfileItem]> request-detail-profiles-alt:            [];
    in-out property <int> request-detail-selected-profile-id-alt: 0;
    // Slint click handlers call this instead of setting want-4k directly,
    // so the tier swap above happens for mouse input too, not just keyboard
    // (handle_key_request_options calls the same Rust helper directly).
    callback request-detail-set-quality(bool);
    callback request-detail-toggle-season(int);
    callback request-detail-toggle-tag(int);
    callback request-detail-request;
    // Watch Trailer — see request-detail-trailer-url's own doc comment.
    // Registered in main.rs (not discover.rs), since it needs VideoState,
    // which discover::wire_discover doesn't receive — see CLAUDE.md's Seerr
    // integration section for why.
    callback play-trailer();

    // ── Request Options modal (quality/profile/tags/seasons — opened from
    // the Request button instead of showing all four inline on the page) ──
    callback open-request-options();
    in-out property <bool> show-request-options:               false;
    // Edit Request mode (Discover context menu, 2026-07-18) — reuses this
    // same modal rather than a second one. When true: the Quality (2K/4K)
    // row is hidden (Seerr's PUT /request/{id} cannot change is4k — see
    // fjord-seerr::SeerrClient::update_request's own doc comment), and
    // Confirm calls update_request instead of create_request against
    // request-options-editing-request-id. Reset to false/"" whenever the
    // modal is closed or a fresh (non-edit) Request is opened.
    in-out property <bool> request-options-editing:            false;
    in-out property <string> request-options-editing-request-id: "";
    // 0=Quality row (2K/4K, always), 1=Profile row (if any configured),
    // 2=tags row (if any), 3=seasons row (if any, TV only), 4=confirm row
    // (Cancel/Request, always) — same skip-absent-zones navigation idiom as
    // request-detail-zone, but a separate numbering scheme (owned by
    // existing_option_zones()/handle_key_request_options in discover.rs)
    // since it's a different, independent vertical flow inside the modal.
    in-out property <int> request-options-zone:               0;
    in-out property <int> request-options-confirm-focused:    1; // 0=Cancel, 1=Request

    // ── Context menu state ────────────────────────────────────────────────────
    in-out property <bool> show-context-menu:        false;
    in-out property <string> context-menu-item-id:     "";
    in-out property <string> context-menu-title:       "";   // display name — set by every open site; queue rows use it
    in-out property <string> context-menu-item-type:   "";
    in-out property <string> context-menu-series-id:   "";   // series ID when item is an Episode; "" otherwise
    in-out property <bool> context-menu-has-played:  false;
    in-out property <bool> context-menu-is-favorite: false;
    in-out property <float> context-menu-resume-pct:  0;
    // Discover context menu only (2026-07-18) — "" everywhere else, same
    // zero-risk-elsewhere pattern as CardItem's own Discover-only fields.
    // context-menu-item-type starting with "Discover" is what selects the
    // entirely separate row family in context_menu.slint; these four only
    // matter within that branch. context-menu-availability mirrors
    // CardItem.availability ("" | "requested" | "processing" | "partial" |
    // "available" | "blocklisted" — the last added 2026-08-06, Seerr
    // Blocklist support); context-menu-request-id "" means "not yet requested".
    in-out property <string> context-menu-request-id:      "";
    in-out property <string> context-menu-availability:    "";
    in-out property <bool> context-menu-request-pending: false; // this tier's own MediaRequest.status == Pending
    in-out property <bool> context-menu-request-mine:    true;  // requested_by == the connected account (true unless a multi-user instance)
    // Watchlist + Release Calendar (2026-07-18) — CardItem.on-watchlist,
    // copied in by every Discover context-menu open site. Drives the
    // Watchlist row's Add/Remove label — always shown, unlike Request.
    in-out property <bool> context-menu-on-watchlist: false;
    // Jellyfin context menu's Watchlist row (row 8). "" = no TMDB id → row hidden;
    // resolved by open_context_menu_state from MediaItem.provider_ids["Tmdb"], Movie/
    // Series only (Seerr's Watchlist media types). -jf-media-type is "movie"/"tv" as
    // discover_toggle_watchlist expects; the Add/Remove label reuses
    // context-menu-on-watchlist (the two menu families never open together).
    in-out property <string> context-menu-jf-tmdb-id:     "";
    in-out property <string> context-menu-jf-media-type:  "";
    callback context-jf-toggle-watchlist();

    // ── Add-to-playlist picker (opened from context-menu row 7, music items) ──
    in-out property <bool> show-playlist-picker:   false;
    in-out property <[CardItem]> playlist-picker-items:  [];   // existing playlists (id, title, subtitle="N tracks")
    in-out property <int> playlist-picker-cursor: 0;    // 0 = "+ New playlist…", 1..N = items[cursor-1]
    in-out property <bool> playlist-picker-naming: false; // typing a new playlist name
    in-out property <string> playlist-picker-name:   "";
    in-out property <int> playlist-picker-name-cursor: -1; // caret, see text_field.rs (-1 = end)
    // Real callbacks (like discover-search-append/-backspace) rather than editing
    // playlist-picker-name from Slint, so the on-screen keyboard and physical typing
    // (handle_playlist_picker) share one grapheme-correct implementation.
    callback playlist-picker-name-append(string);
    callback playlist-picker-name-backspace();
    in-out property <int> context-menu-focused:     0;   // 0=Resume (if resume-pct>0 && !played) 1=Play from Start 2=Mark Played 3=Favourite 4=View Details

    // ── Key binding editor state ──────────────────────────────────────────────
    in-out property <[KeyBindingEntry]> keybinding-normal: [];
    in-out property <[KeyBindingEntry]> keybinding-player: [];
    in-out property <int> keybinding-focused:   -1;
    in-out property <bool> keybinding-rebinding: false;
    // Reset to Defaults confirmation. keybinding-focused stays on the Reset button's
    // value (keybinding-normal.length + keybinding-player.length) while it's open,
    // whether opened by keyboard or mouse — see settings.rs::dispatch_keybinding_nav.
    in-out property <bool> show-keybinding-reset-confirm:      false;
    in-out property <int> keybinding-reset-confirm-focused:   0; // 0=Cancel, 1=Confirm — Cancel is the safe default

    // Rebind-collision confirmation: rebinding a key another action uses doesn't steal
    // it silently — keys::rebind_action stashes the combo in
    // FjordState.pending_keybind_rebind and shows this; keybinding-collision-confirmed/
    // -cancelled (keys::wire_keybindings) resolve it.
    in-out property <bool> show-keybinding-collision-confirm:      false;
    in-out property <int> keybinding-collision-confirm-focused:   0; // 0=Cancel, 1=Confirm
    in-out property <string> keybinding-collision-message:           "";
    callback keybinding-collision-confirmed();
    callback keybinding-collision-cancelled();

    // ── Settings state ────────────────────────────────────────────────────────
    in-out property <bool> settings-launch-fullscreen:    false;
    in-out property <bool> settings-audio-spdif:          false;
    in-out property <bool> settings-spdif-ac3:            true;
    in-out property <bool> settings-spdif-eac3:           true;
    in-out property <bool> settings-spdif-dts:            true;
    in-out property <bool> settings-spdif-dts-hd:         true;
    in-out property <bool> settings-spdif-truehd:         true;
    in-out property <string> settings-hwdec:                "auto";
    in-out property <string> settings-vf:                   "";
    in-out property <string> settings-video-sync:           "audio";
    in-out property <bool> settings-opengl-early-flush:   false;
    in-out property <bool> settings-video-latency-hacks:  false;
    in-out property <bool> settings-interpolation:        false;
    in-out property <string> settings-tscale:               "oversample";
    in-out property <string> settings-tone-mapping:         "auto";
    in-out property <bool> settings-target-colorspace-hint: false;
    // Settings → Video → HDR → "Separate video surface" (HDR Stage 5,
    // 2026-10-05, default on) — row only shown on Wayland (is-wayland, set
    // by Rust once the window's Wayland handles are known).
    in-out property <bool> settings-separate-video-surface: true;
    // … → "Use Fjord's own 10-bit buffers" (2026-10-08, default off, opt-in):
    // the own-buffer path; read once per run when the subsurface is set up.
    in-out property <bool> settings-video-own-buffers: false;
    // … → "Turn off dithering (test)" (2026-10-08, default off): mpv
    // dither-depth=no, for comparing 8- and 10-bit output on a gradient.
    in-out property <bool> settings-video-dither-off: false;
    in-out property <bool> is-wayland: false;
    in-out property <string> settings-deinterlace:          "no";
    in-out property <int> settings-cache-secs:           60;
    in-out property <int> settings-cache-max-mb:         500;
    in-out property <bool> settings-video-behind:         false;
    in-out property <string> settings-log-level:            "info"; // applies on next launch, not live

    // ── display_sync — resolution/refresh-rate/HDR/WCG matched to the source ────
    // kscreen-doctor on KDE Plasma Wayland; design in DEVLOG → display_sync (including
    // why it has its own one-shot trigger in wire_mpv_timer). screen-options is fetched
    // once at startup (`kscreen-doctor -o`); screen-name is the persisted bare
    // connector name, never auto-re-detected (display_sync::detect_active_output);
    // screen-desc is the selected entry's annotated label (e.g. "HDMI-A-2 (Primary)"),
    // resolved back via FjordState.display_sync_outputs. resolution-/hz-options are
    // fetched for the selected output at startup and again whenever the output
    // changes (display_sync::supported_resolutions_and_hz).
    in-out property <bool> settings-display-sync-enabled:            false;
    in-out property <bool> settings-display-sync-trailers:           false; // Watch Trailer also switches the display (2026-10-04)
    in-out property <string> settings-display-sync-screen-name:        "";
    in-out property <string> settings-display-sync-screen-desc:        "";
    in-out property <[string]> settings-display-sync-screen-options:   [];
    in-out property <[string]> settings-display-sync-resolution-options: [];
    in-out property <[string]> settings-display-sync-hz-options:         [];
    in-out property <string> settings-display-sync-default-resolution: "1920x1080";
    in-out property <string> settings-display-sync-default-hz:         "59.94";
    in-out property <string> settings-display-sync-scale-4k:           "1.0";
    in-out property <string> settings-display-sync-scale-1080p:        "1.0";
    in-out property <bool> settings-display-sync-sync-resolution:    true;
    in-out property <bool> settings-display-sync-sync-refresh-rate:  true;
    in-out property <string> settings-display-sync-4k-odd-fps-mode:    "fallback";
    in-out property <string> settings-display-sync-hdr-mode:           "yes";
    in-out property <string> settings-display-sync-wcg-mode:           "auto";
    // Fired for both the dynamic dropdown's popup-confirm AND its plain
    // Left/Right cycle (same shape as e.g. default-profile-selected below) —
    // desc IS the value here (a kscreen-doctor connector name), so the
    // handler in main.rs just persists it directly, no name<->desc lookup
    // table needed the way audio-device/font-family need. The resolution/hz
    // pair below are the identical "desc is the value" shape, one per
    // dynamic dropdown, and additionally re-fetch resolution-options/
    // hz-options for the newly-selected screen.
    callback display-sync-screen-selected(string);
    callback display-sync-resolution-selected(string);
    callback display-sync-hz-selected(string);

    // ── Library prewarm progress (Phase 104) ──────────────────────────────────
    in-out property <bool> prewarm-metadata-running: false;
    in-out property <int> prewarm-metadata-total:   0;
    in-out property <int> prewarm-metadata-done:    0;
    in-out property <string> prewarm-metadata-summary: "";
    in-out property <bool> prewarm-image-running:    false;
    in-out property <int> prewarm-image-total:      0;
    in-out property <int> prewarm-image-done:       0;
    in-out property <string> prewarm-image-summary:    "";
    in-out property <bool> settings-sub-enabled:          true;
    in-out property <string> settings-sub-lang:             "";
    in-out property <string> settings-sub-lang2:            "";
    in-out property <string> settings-sub-type:             "";
    in-out property <int> settings-sub-scale-pct:          100;
    in-out property <int> settings-sub-pos-pct:            100;
    in-out property <bool> settings-sub-respect-ass-styling: true;
    in-out property <string> settings-sub-color:              "";
    in-out property <bool> settings-sub-background:         false;
    in-out property <string> settings-audio-lang:           "";
    in-out property <string> settings-audio-device:          "";
    in-out property <string> settings-audio-device-desc:     "";
    in-out property <string> settings-audio-channels:        "auto-safe"; // mpv --audio-channels
    in-out property <bool> settings-gapless-audio:         true; // preload next track into same mpv instance
    in-out property <bool> settings-now-playing-auto-open: true; // pop the fullscreen Now Playing screen after ~30s idle
    in-out property <string> settings-passthrough-device:      ""; // video output while SPDIF on ("" = same as audio output)
    in-out property <string> settings-passthrough-device-desc: "";
    in-out property <[string]> settings-audio-device-display:  [];
    in-out property <bool> settings-device-is-pipewire:    true;  // auto = pipewire by default
    in-out property <bool> settings-alsa-irq-scheduling:   false;
    // Whether the skip-segment fade mutes audio during SPDIF passthrough
    // (Settings → Audio → Passthrough, 2026-08-11 follow-up) — gates ONLY
    // the passthrough mute; the video fade and the PCM volume ramp stay
    // unconditional regardless of this toggle. See playback.rs's
    // arm_skip_fade and CLAUDE.md's Skip fade section.
    in-out property <bool> settings-skip-fade-mute-passthrough: true;
    callback audio-device-selected(string);
    callback passthrough-device-selected(string);

    // ── Intro Skipper skip modes ("always-skip"|"ask"|"ask-timed"|"never-skip") ──
    in-out property <string> settings-skip-intro-mode:      "ask";
    in-out property <int> settings-skip-intro-secs:       8;
    in-out property <string> settings-skip-recap-mode:      "ask";
    in-out property <int> settings-skip-recap-secs:       8;
    in-out property <string> settings-skip-preview-mode:    "ask";
    in-out property <int> settings-skip-preview-secs:     8;
    in-out property <string> settings-skip-commercial-mode: "ask";
    in-out property <int> settings-skip-commercial-secs:  8;
    // Credits mode: "always-skip"|"ask"|"never-skip" (no ask-timed — banner has its own countdown)
    in-out property <string> settings-skip-credits-mode:    "ask";
    in-out property <int> settings-skip-credits-secs:    30;

    // ── Player seek step (Settings → Player → Seeking) ───────────────────────
    in-out property <int> settings-seek-step-secs:       10;
    in-out property <int> settings-seek-step-long-secs:  30;
    // Base ms of the skip-segment fade-to-black + audio ramp/mute (2026-08-11),
    // before the settings-animation-speed multiplier — read live by both
    // player.slint's own `skip-fade` animate block and wire_mpv_timer's
    // Rust-side wait/ramp computation, so the two can never drift out of
    // sync with each other or with a live settings change. 0 = instant,
    // same hard cut as before this feature shipped.
    in-out property <int> settings-skip-fade-ms:        200;

    // ── UI animation speed (Settings → UI) — ratios (1.0 = 100%, hand-tuned
    // durations unchanged), not raw percentages, so every animate block can
    // multiply its duration directly without a /100 at each of ~119 sites.
    in-out property <int> settings-scroll-speed-pct:     100;
    in-out property <int> settings-animation-speed-pct:  100;
    in property <float> settings-scroll-speed:         1.0;
    in property <float> settings-animation-speed:      1.0;

    // ── Text font (Settings → UI) — same dynamic-dropdown shape as the audio
    // device rows above, fetched via fc-list instead of mpv. settings-font-family
    // is the actual value MainWindow.font-family binds to ("Inter" | "" | any
    // other installed family name); settings-font-family-desc is its human-
    // readable label; settings-font-family-display is the dropdown's list.
    in-out property <string> settings-font-family:          "Inter";
    in-out property <string> settings-font-family-desc:     "Inter (Fjord default)";
    in-out property <[string]> settings-font-family-display:  [];
    callback font-family-selected(string);

    // ── On-screen alphanumeric keyboard (Settings → UI) ─────────────────────────
    // Config.device.onscreen_keyboard_enabled, default true (Fjord must work without a
    // physical keyboard). Checked by open-onscreen-keyboard (nothing opens when off),
    // every QwertyKeyboard mount, and keys.rs's keyboard gate.
    in-out property <bool> settings-onscreen-keyboard-enabled: true;

    // ── Seerr integration (Settings → Integrations, discover/, seerr_auth.rs) ───
    // settings-seerr-enabled is the persisted toggle; seerr-connected (+ -label) is
    // live state pushed by seerr_auth::push_seerr_status on every connection change
    // AND toggle change (connected ANDs in seerr_enabled). Turning Seerr off hides and
    // pauses everything Seerr (client torn down) but keeps the saved credentials, so
    // turning it back on reconnects without re-auth.
    in-out property <bool> settings-seerr-enabled: false;
    in-out property <bool> seerr-connected:        false;
    in-out property <string> seerr-connected-label:  "Not connected";
    // Fetched async (GET /status, unauthenticated) after every successful
    // connect and again at startup if already connected — mirrors how
    // server-name/server-version are fetched fresh each session rather than
    // persisted, since it's cheap and this way it's never stale.
    in-out property <string> seerr-version:        "";
    callback open-connect-seerr;
    callback seerr-disconnect;
    // Confirmation before disconnecting Seerr (like Sign Out / Clear Queue). Only
    // reachable from the Integrations row, so settings.rs::dispatch_settings handles it
    // (no global tier needed). ConfirmDialog, declared last in settings.slint so it's on top.
    in-out property <bool> show-seerr-disconnect-confirm: false;
    in-out property <int> seerr-disconnect-confirm-focused: 0; // 0=Cancel, 1=Disconnect

    // Streaming Region (Settings → Integrations, only shown when
    // seerr-connected) — same dynamic-dropdown shape as settings-font-
    // family-display above, just fetched from Seerr (GET /watchproviders/
    // regions) instead of fc-list, and only once a connection exists rather
    // than always-available at startup. settings-streaming-region-desc is
    // the current selection's display string ("Sweden (SE)"); the actual
    // ISO code lives server-side in the connected user's own Seerr
    // settings, not mirrored into a Fjord Config field — see
    // discover.rs::resolve_streaming_region, which reads it fresh (then
    // caches it) rather than trusting a locally persisted copy that could
    // drift from what's actually set on the account.
    in-out property <string> settings-streaming-region-desc:    "";
    in-out property <[string]> settings-streaming-region-display: [];
    callback streaming-region-selected(string);

    // Display Language + Discover Language (Settings → Integrations, only
    // shown when seerr-connected, same gate + dynamic-dropdown shape as
    // Streaming Region — 2026-07-17). Both share one fetched list
    // (fjord_seerr::Language, GET /languages — TMDB's full ~180-entry list,
    // NOT Seerr's own smaller UI-translation locale set; see that struct's
    // doc comment for why). "Default (English)"/"Default (All Languages)"
    // are synthetic row-0 entries prepended client-side, matching Seerr's
    // own web UI wording exactly — selecting them writes "" (locale) /
    // "all" (originalLanguage, the literal sentinel Seerr's frontend uses,
    // NOT an empty string — see main.rs's write handlers).
    in-out property <string> settings-display-language-desc:     "Default (English)";
    in-out property <[string]> settings-display-language-display:  [];
    callback display-language-selected(string);
    in-out property <string> settings-discover-language-desc:    "Default (All Languages)";
    in-out property <[string]> settings-discover-language-display: [];
    callback discover-language-selected(string);

    // Discover Region (Settings → Integrations): not used by the /discover lists
    // (those read streamingRegion) but by the release-date lookup — Seerr's MovieDetails
    // picks theatrical/digital/physical dates by discoverRegion, and so does
    // discover::resolve_discover_region. Shares settings-streaming-region-display's
    // region list; only the selected value differs.
    in-out property <string> settings-discover-region-desc: "";
    callback discover-region-selected(string);

    // Whether the connected Seerr account has MANAGE_REQUESTS (2026-07-18) —
    // set alongside seerr-connected by spawn_seerr_settings_fetch, reset on
    // disconnect/sign-out. Gates Approve/Decline in the Discover context menu.
    in-out property <bool> seerr-is-admin: false;
    // Whether the connected Seerr account has MANAGE_BLOCKLIST (2026-08-06,
    // Seerr Blocklist support) — a genuinely SEPARATE permission bit from
    // MANAGE_REQUESTS/ADMIN above (see fjord_seerr::User::
    // can_manage_blocklist's own doc comment), set/reset the same way.
    // Gates the Discover context menu's Blocklist row, RequestDetailScreen's
    // Blocklist button, CollectionScreen's bulk blocklist button, and the
    // Settings -> Integrations -> Manage Blocklist row.
    in-out property <bool> seerr-can-manage-blocklist: false;

    // Trailer Quality (Settings → Integrations, shown when seerr-connected): a static
    // dropdown ("Best"/"1080p"/"720p"/"480p") through settings.rs's generic dropdown
    // path. Caps mpv's ytdl-format for trailers (trailer_ytdl_format); default "1080p"
    // (Config.trailer_quality), display values stored directly.
    in-out property <string> settings-trailer-quality: "1080p";

    // Whether `yt-dlp` was found on PATH at startup (main.rs::
    // detect_yt_dlp) — gates the Watch Trailer button's visibility
    // alongside request-detail-trailer-url being non-empty. A pure local-
    // machine fact, independent of seerr-enabled/seerr-connected.
    in-out property <bool> yt-dlp-available: false;

    // ── ConnectSeerrScreen (connect_seerr.slint / seerr_auth.rs) ────────────────
    // method: 0=API key, 1=Jellyfin login, 2=Quick Connect, 3=Local account. qc-* is
    // Quick Connect's sub-state (code shown, secret sent with each poll, polling gates
    // the Timer).
    //
    // connect-seerr-zone: "gaps are fine" zones recomputed from state
    // (seerr_auth::existing_connect_seerr_zones), dispatched in keys.rs's Connect Seerr
    // tier (keys/overlays.rs). -1 = ✕ (Up from 0), 0 = URL field (shared by all tabs),
    // 1 = tab row (Left/Right switch method and clear the error, like a click), 2+ =
    // the method's fields and button (a polling Quick Connect tab has none). Text-field
    // zones hold native LineEdit focus; their key-pressed hooks set the zone and
    // refocus() when leaving, since fs is a sibling of this overlay, not an ancestor.
    // Zone order follows the visual order (URL above tabs).
    in-out property <bool> show-connect-seerr:       false;
    in-out property <int> connect-seerr-zone:       0;
    in-out property <int> connect-seerr-method:     0;
    in-out property <string> connect-seerr-error:      "";
    in-out property <bool> connect-seerr-busy:       false;
    in-out property <string> connect-seerr-qc-code:    "";
    in-out property <string> connect-seerr-qc-secret:  "";
    in-out property <bool> connect-seerr-qc-polling: false;
    callback connect-seerr-api-key(string, string);              // url, key
    callback connect-seerr-jellyfin(string, string, string);     // url, username, password
    callback connect-seerr-local(string, string, string);        // url, email, password
    callback connect-seerr-quickconnect-start(string);           // url
    callback connect-seerr-quickconnect-poll(string, string);    // url, secret

    // ── Nav helper pure functions (used by MainWindow's keyboard handler) ───────
    // section-len and section-card-item are ternary chains keyed on `s == N` whose
    // trailing else covers the last row. Adding a dashboard row needs an EXPLICIT
    // branch for the previous last index before the new else, in all 3 nav branches of
    // both functions (otherwise the new row silently reads the previous row's data),
    // plus the find-first/next/prev-section bound. Self-check: the five-equality
    // comparison appears exactly 6 times (2 functions × 3 navs).
    public pure function section-len(s: int) -> int {
        if active-nav == 0 {
            s == 0 ? continue-watching.length :
                s == 1 ? next-up.length :
                s == 2 ? recently-added.length :
                s == 3 ? recently-added-movies.length :
                s == 4 ? recently-added-albums.length :
                s == 5 ? discover-watchlist-mixed.length :
                discover-coming-up-mixed.length
        } else if active-nav == 1 {
            // TV Shows dashboard
            s == 0 ? continue-watching-tv.length :
                s == 1 ? next-up.length :
                s == 2 ? recently-added-tv.length :
                s == 3 ? not-watched-tv.length :
                s == 4 ? favorite-series.length :
                s == 5 ? discover-watchlist-tv.length :
                discover-coming-up-tv.length
        } else if active-nav == 2 {
            // Movies dashboard
            s == 0 ? continue-watching-movies.length :
                s == 1 ? 0 :
                s == 2 ? recently-added-movies.length :
                s == 3 ? not-watched-movies.length :
                s == 4 ? favorite-movies.length :
                s == 5 ? discover-watchlist-movies.length :
                discover-coming-up-movies.length
        } else if active-nav == 3 {
            // Collections dashboard
            s == 0 ? recently-added-collections.length :
                s == 1 ? unwatched-collections.length :
                0
        } else if active-nav == 4 {
            // Music dashboard
            s == 0 ? recently-added-albums.length :
                s == 1 ? recently-played-albums.length :
                s == 2 ? favorite-albums.length :
                s == 3 ? music-playlists.length :
                0
        } else {
            0
        }
    }

    public pure function find-first-section() -> int {
        if section-len(0) > 0 { return 0; }
        if section-len(1) > 0 { return 1; }
        if section-len(2) > 0 { return 2; }
        if section-len(3) > 0 { return 3; }
        if section-len(4) > 0 { return 4; }
        if section-len(5) > 0 { return 5; }
        if section-len(6) > 0 { return 6; }
        return 0;
    }

    public pure function find-next-section(from: int) -> int {
        if from + 1 <= 6 && section-len(from + 1) > 0 { return from + 1; }
        if from + 2 <= 6 && section-len(from + 2) > 0 { return from + 2; }
        if from + 3 <= 6 && section-len(from + 3) > 0 { return from + 3; }
        if from + 4 <= 6 && section-len(from + 4) > 0 { return from + 4; }
        if from + 5 <= 6 && section-len(from + 5) > 0 { return from + 5; }
        if from + 6 <= 6 && section-len(from + 6) > 0 { return from + 6; }
        return from;
    }

    public pure function find-prev-section(from: int) -> int {
        if from - 1 >= 0 && section-len(from - 1) > 0 { return from - 1; }
        if from - 2 >= 0 && section-len(from - 2) > 0 { return from - 2; }
        if from - 3 >= 0 && section-len(from - 3) > 0 { return from - 3; }
        if from - 4 >= 0 && section-len(from - 4) > 0 { return from - 4; }
        if from - 5 >= 0 && section-len(from - 5) > 0 { return from - 5; }
        if from - 6 >= 0 && section-len(from - 6) > 0 { return from - 6; }
        return -1;
    }

    // Dashboard Confirm (keys.rs) reads the whole card via section-card-item (it
    // branches on item-type), so there's no separate section-card-id chain to keep in sync.
    public pure function section-card-item(s: int, c: int) -> CardItem {
        if active-nav == 0 {
            s == 0 ? continue-watching[c] :
                s == 1 ? next-up[c] :
                s == 2 ? recently-added[c] :
                s == 3 ? recently-added-movies[c] :
                s == 4 ? recently-added-albums[c] :
                s == 5 ? discover-watchlist-mixed[c] :
                discover-coming-up-mixed[c]
        } else if active-nav == 1 {
            // TV Shows
            s == 0 ? continue-watching-tv[c] :
                s == 1 ? next-up[c] :
                s == 2 ? recently-added-tv[c] :
                s == 3 ? not-watched-tv[c] :
                s == 4 ? favorite-series[c] :
                s == 5 ? discover-watchlist-tv[c] :
                discover-coming-up-tv[c]
        } else if active-nav == 2 {
            // Movies
            s == 0 ? continue-watching-movies[c] :
                s == 2 ? recently-added-movies[c] :
                s == 3 ? not-watched-movies[c] :
                s == 4 ? favorite-movies[c] :
                s == 5 ? discover-watchlist-movies[c] :
                discover-coming-up-movies[c]
        } else if active-nav == 3 {
            // Collections dashboard
            s == 0 ? recently-added-collections[c] :
                unwatched-collections[c]
        } else if active-nav == 4 {
            // Music dashboard
            s == 0 ? recently-added-albums[c] :
                s == 1 ? recently-played-albums[c] :
                s == 2 ? favorite-albums[c] :
                music-playlists[c]
        } else {
            {
                id: "",
                title: "",
                year: 0,
                item_type: "",
                poster: @image-url(""),
                has_played: false,
                resume_pct: 0,
                unplayed_count: 0,
                is_favorite: false,
                series_id: ""
            }
        }
    }

    // ── Callbacks — auth / nav ───────────────────────────────────────────────────
    // 4th bool: append ("+ Add Account") — keep every existing profile and add this
    // one, instead of replacing the active profile. 5th bool: "remember this login" →
    // ProfileSettings.remember_login (see should_show_picker_at_startup). LoginScreen
    // passes login-append-mode / login-remember verbatim.
    callback do-login(string, string, string, bool, bool);
    // Login screen D-pad zones: 0=server 1=username 2=password 3=Remember toggle
    // 4=Connect 5=Back/Cancel (append mode only) 6=Quit. Zones 0-2 hold native
    // LineEdit focus (Tab cycles them); login.slint's key-pressed hooks refocus() fs
    // when leaving zone 2 (and from zone 0 up to Back), and a changed login-zone
    // tracker calls the right field's .focus() when re-entering 0-2 (Rust can't call
    // a named element's method). Back hangs off Up from Server, Quit off Down from
    // Connect — see login.slint's header for the chain and Escape-at-Quit.
    in-out property <int> login-zone: 0;
    in-out property <bool> login-append-mode: false;
    // Which screen a successful/cancelled Add-Account login should return
    // to (2026-08-14) — "" (a plain first-time login, or Settings → Profiles'
    // own "Add Account" row, nothing to reopen) | "account_picker" (opened
    // from the account-tier picker's own "+ Add Account" tile).
    in-out property <string> login-append-source: "";
    // Pre-fills the server field (RequireLogin startup outcome: an account with
    // remember-login off keeps its known server; only the password, never stored, is asked).
    in-out property <string> login-server-prefill: "";
    // Pre-fills the username too (from the account's ProfileSettings.display_name,
    // which for a Jellyfin login is the login name). Cleared with
    // login-server-prefill whenever Add Account opens, so an earlier prefill can't
    // leak into a new account.
    in-out property <string> login-username-prefill: "";
    // Checkbox state — defaults to true, matching ProfileSettings.
    // remember_login's own default (today's actual behavior, unchanged
    // unless explicitly turned off).
    in-out property <bool> login-remember: true;
    callback cancel-add-account();  // LoginScreen's "← Back to Profiles" (append mode only)
    callback sign-out;
    // Sign Out confirmation. Reachable from 3 places (Settings → Profiles, the
    // sidebar quick-menu, OfflineScreen's Change Server), so it's a GLOBAL dialog
    // (main.slint top level) dispatched from keys.rs's pre-active_mode() tier, like
    // show-remember-login-confirm — it must catch keys whatever is underneath.
    in-out property <bool> show-sign-out-confirm: false;
    in-out property <int> sign-out-confirm-focused: 0; // 0=Cancel, 1=Sign Out
    callback prewarm-metadata;
    callback prewarm-images;
    callback nav-selected(int);
    callback toggle-fullscreen;
    callback quit;
    callback refocus; // re-grab keyboard focus after mouse interaction steals it

    // ── Callbacks — browse / library ──────────────────────────────────────────
    callback play-item(int);
    callback filter-changed(string);
    callback browse-search-append(string);
    callback browse-search-backspace();
    callback browse-search-clear();
    callback browse-search-delete();   // Delete key: letter after the caret (2026-10-05)
    callback library-search-append(string);
    callback library-search-backspace();
    callback library-search-clear();
    callback library-search-delete();  // Delete key: letter after the caret (2026-10-05)
    callback open-library(int);
    callback library-sort-apply(int, bool, bool);  // sort-idx, filter-unwatched, filter-favorites
    callback library-jump-to-letter(int);          // 0=A..25=Z, 26=#
    callback library-grid-scrolled(int);           // top-card index → update scrubber cursor
    callback library-music-view-changed(int);      // 0=Artists 1=Albums 2=Playlists
    callback playlist-remove-entry(int);           // track row index → remove entry from open playlist
    callback open-playlist-picker();               // context-menu "Add to Playlist" → Rust populates + shows picker
    callback playlist-picker-select(int);          // picker items index → add target item to that playlist
    callback playlist-picker-create();             // create playlist named playlist-picker-name with target item

    // ── Callbacks — item play / detail / series ───────────────────────────────
    callback item-play(string);
    callback open-detail(/* id */ string, /* item-type */ string);
    callback play-detail;
    callback resume-detail;
