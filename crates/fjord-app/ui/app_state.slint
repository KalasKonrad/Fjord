    callback minimize-player;
    callback resume-player;

    // ── Queue ─────────────────────────────────────────────────────────────────
    in-out property <int> queue-count:       0;     // upcoming: playlist tracks after current + queued items (set by push_queue_display)
    in-out property <int> queue-repeat-mode: 0;     // 0=Off 1=All 2=One
    in-out property <bool> queue-shuffle:     false; // shuffle active
    in-out property <bool> show-queue-panel:  false; // queue panel overlay visible
    in-out property <int> queue-panel-cursor: 0;    // focused row in queue panel
    in-out property <[QueueEntry]> queue-items:        [];   // Rust pushes after every mutation
    callback queue-add-item();               // add focused context-menu item to back of queue
    callback queue-play-next-item();         // insert after current in playlist / front of queue
    callback queue-prev-track();             // prev track (or restart if pos ≥ 2 s)
    callback queue-next-track();             // next track (respects shuffle/repeat)
    callback toggle-shuffle();               // flip shuffle on/off; re-seeds shuffle-order
    callback cycle-repeat();                 // cycle Off → All → One → Off
    callback queue-jump(int);               // jump to playlist index → start_playback
    callback queue-remove(int);             // splice item from playlist
    callback queue-clear();                 // clear playlist + queue
    // Clear Queue confirmation. Only reachable inside QueuePanel, so the
    // ConfirmDialog lives in QueuePanel (widgets.slint, declared last for z-order) and
    // keys::handle_key_queue_panel dispatches it.
    in-out property <bool> show-queue-clear-confirm: false;
    in-out property <int> queue-clear-confirm-focused: 0; // 0=Cancel, 1=Clear All
    callback refresh-queue-display();       // Rust rebuilds queue-items from VideoState
    callback open-queue-panel();            // mouse entry point (music-bar ⋮): refresh + focus grab, mirrors 'q'

    // ── Lyrics (Phase 52) ─────────────────────────────────────────────────────
    in-out property <bool> show-lyrics:      false; // lyrics overlay visible
    in-out property <bool> lyrics-available: false; // server returned lyric data
    in-out property <[LyricEntry]> lyrics-lines:     [];   // populated by Rust from get_lyrics
    in-out property <int> lyrics-active-idx: -1;  // currently-playing line (-1 = none)
    callback toggle-lyrics();                               // 9/♪ button or L key

    // ── Callbacks — context menu ──────────────────────────────────────────────
    callback open-context-menu(string, bool, bool, float, string, string); // id, played, fav, resume-pct, item-type, series-id
    callback open-context-menu-browse(int);                              // browse list index → Rust resolves
    callback open-context-menu-series-ep(string, bool, bool, float, string); // ep id, played, fav, resume-pct, series-id
    callback context-mark-played(string, bool);       // id, currently-played → Rust toggles
    callback context-toggle-fav(string, bool);        // id, currently-favorite → Rust toggles
    callback context-play-from-start(string);
    // Discover context menu (2026-07-18) — carries the whole card struct
    // rather than N new scalars, since every field the menu needs
    // (id/item-type/title/availability/request-id/requested-4k) is already
    // on CardItem. Right-click/C-key on any Discover card (search grid, the
    // 6 landing rows) routes here instead of open-context-menu.
    callback open-context-menu-discover(CardItem);
    callback context-discover-view-details();          // View Details row — same as Enter/click (find_local_item redirect included)
    callback context-discover-view-request();           // View Request row (requested only) — same fetch, but skips the find_local_item redirect so a partially-in-library item's Seerr request stays reachable
    callback context-discover-request();                // Request row — fetches detail then opens Request Options
    callback context-discover-edit-request();           // Edit Request row — opens Request Options pre-filled, PUT on confirm
    callback context-discover-cancel-request();          // Cancel Request row — opens show-cancel-request-confirm below, doesn't call DELETE directly
    callback context-discover-approve-request();         // Approve row — admin only
    // Confirmation before DELETE /request (no undo, unlike Approve/Decline).
    // context-discover-cancel-request() only opens it; cancel-request-confirmed() does
    // the delete. Reachable from the Discover context menu and RequestDetailScreen's
    // ⋮ More (which reuses that overlay), so it's GLOBAL (main.slint), like Sign Out's.
    in-out property <bool> show-cancel-request-confirm: false;
    in-out property <int> cancel-request-confirm-focused: 0; // 0=Keep, 1=Cancel Request
    in-out property <string> cancel-request-confirm-id: "";     // request id to DELETE on confirm
    callback cancel-request-confirmed();
    callback context-discover-decline-request();         // Decline row — admin only
    callback context-discover-toggle-watchlist();        // Add/Remove Watchlist row (2026-07-18, always visible, not gated on request state)
    callback context-discover-toggle-blocklist();        // Add/Remove Blocklist row (2026-08-06, Seerr Blocklist support — gated on seerr-can-manage-blocklist + eligible availability)
    // RequestDetailScreen's own ⋮ More button (2026-07-18) — populates the
    // SAME context-menu-* state open-context-menu-discover does, but sourced
    // from request-detail-* (tmdb id/media type/title/request info) since
    // this page has no CardItem of its own to pass. Reuses the existing
    // ContextMenu overlay/row set entirely — no separate menu built for
    // this page.
    callback open-discover-menu-from-detail();

    // ── Calendar screen state (Watchlist + Release Calendar, 2026-07-18) ──────
    // Opened from the Discover "Coming Up" landing row's trailing sentinel
    // card (handle_key_landing's own explicit special-case, discover.rs) —
    // a full-page overlay joining the FadeGate'd list in main.slint, same
    // floating "← Back" convention every other overlay uses.
    in-out property <bool> show-calendar: false;
    // Fired by both the "Coming Up" row's sentinel card (mouse, discover.slint)
    // and its keyboard equivalent (handle_key_landing, discover.rs) — Rust
    // resets to the current month and rebuilds calendar-days before showing,
    // rather than either call site setting show-calendar directly and
    // leaving stale data from a previous open on screen momentarily.
    callback open-calendar();
    // Currently viewed month — 1-indexed month, matching chrono's own
    // convention (no month-zero confusion at the Rust/Slint boundary).
    in-out property <int> calendar-year:  2026;
    in-out property <int> calendar-month: 1;
    // Keyboard grid position — fixed 7 columns (day-of-week never varies
    // with window width, unlike library-cols), up to 6 rows. Leading/
    // trailing blank cells (days outside the current month) are non-
    // interactive; Left/Right/Up/Down skip over them onto the nearest real
    // day or the adjacent month, same as a real calendar UI.
    in-out property <int> calendar-cursor-row: 0;
    in-out property <int> calendar-cursor-col: 0;
    // Rebuilt by Rust every time the visible month or its underlying data
    // changes — one CardItem per real day 1..N of the month (poster/title
    // left blank, only id/subtitle used: subtitle carries the day's own
    // entry count/badge summary text for the cell to render). Kept as a
    // flat CardItem list rather than a nested per-day model, matching this
    // app's existing "flat model + index math" convention elsewhere
    // (LibraryGrid's own library-display).
    in-out property <[CardItem]> calendar-days: [];
    // Grid layout math, computed in Rust (chrono) rather than replicated in
    // Slint — how many blank cells precede day 1 (0-6, which day-of-week it
    // falls on, Sunday-first) and how many real days the month has.
    // calendar-days.length always equals calendar-total-days; blank cells
    // are inert (no CardItem behind them) rather than clamped around by
    // keyboard nav, matching this app's existing "gaps are fine" tolerance
    // for empty grid cells elsewhere (the Coming Up row's own sentinel).
    in-out property <int> calendar-leading-blanks: 0;
    in-out property <int> calendar-total-days: 30;
    callback calendar-prev-month();
    callback calendar-next-month();
    // Day-detail popup — opened on Enter/click over a day cell that has at
    // least one entry, same small fixed-size dim-backdrop shape as
    // RequestOptionsOverlay/the Discover filter popups (see calendar.slint's
    // own header comment for the layout-risk reasoning).
    in-out property <bool> show-calendar-day-popup: false;
    in-out property <[CardItem]> calendar-day-popup-entries: [];
    in-out property <int> calendar-day-popup-cursor: 0;
    callback calendar-day-selected(int); // day-of-month, 1-based
    callback calendar-day-popup-entry-selected(int); // index into calendar-day-popup-entries

    // ── Manage Blocklist screen state (2026-08-06, Seerr Blocklist support) ───
    // Opened from Settings -> Integrations -> Manage Blocklist (settings.rs's
    // INT_MANAGE_BLOCKLIST row) — a full-page overlay, same FadeGate'd/
    // floating-Back-button shell shape as CalendarScreen, but plain text
    // rows (blocklist.rs, GET /blocklist carries no poster path at all)
    // instead of a month grid.
    in-out property <bool> show-blocklist: false;
    callback open-blocklist();
    in-out property <[BlocklistRow]> blocklist-items: [];
    in-out property <int> blocklist-focused:      0;
    in-out property <bool> blocklist-back-focused: false;
    // True while a load-more page fetch is in flight — guards a double-
    // fetch (mirrors discover-search-loading-more) and drives a small
    // loading indicator at the list's end.
    in-out property <bool> blocklist-loading-more: false;
    // Triggered by Down-past-the-last-row (blocklist.rs::handle_key), same
    // idiom as Discover's own load-more pagination. No-ops server-side (via
    // FjordState.blocklist_total_results) when there's nothing more to load.
    callback blocklist-load-more();
    // index into blocklist-items — resolves tmdb-id/media-type from that
    // row, calls discover_toggle_blocklist(...,adding:false), removes the
    // row locally.
    callback blocklist-remove-item(int);

    // ── Callbacks — misc overlays ─────────────────────────────────────────────
    callback cancel-auto-advance;
    callback play-next-ep;
    callback skip-segment;
    callback settings-changed;
    callback dropdown-pick; // mouse click on keyboard overlay item; cursor already set
    // Mouse click on a SettingsRow/section-list row (key already known to
    // the clicking element) — routes every settings-focused mutation
    // through Rust, same as the keyboard path, so
    // settings-focused-visual-index above never goes stale after a click.
    callback settings-row-focused(string);

    // ── Key dispatch ──────────────────────────────────────────────────────────
    // Called by the FocusScope key-pressed handler; Rust returns true → accept,
    // false → reject.  Replaces the 670-line Slint keyboard handler.
    callback handle-key(/* text */ string, /* shift */ bool, /* ctrl */ bool, /* repeat */ bool) -> bool;

    // Resets keybindings to compiled-in defaults and saves to keybindings.json.
    callback keybinding-reset-defaults();

    // Idle-lock mouse activity comes from a winit-level hook
    // (activity::FjordActivityHandler, installed before MainWindow::new()) that sees
    // every raw pointer event before Slint's hit-testing — no Slint callback needed.

    // ── Bonfire Group (cross-household groups) ──────────────────────────────────
    // Settings → Profiles → "Bonfire Group", master accounts only (the same
    // settings-is-master-profile gate as Manage Profiles; true while impersonating a
    // foreign group account too — profile.rs::is_true_master). Free-floating overlay
    // like ManageProfilesScreen, fade-gated in main.slint.
    in-out property <bool> show-bonfire-group: false;
    in-out property <bool> bonfire-group-loading: false;
    in-out property <string> bonfire-group-error: "";
    // Status fields, from BonfireGroupStatus — refreshed on every open and
    // after every mutating action (generate/join/kick/leave/delete/settings).
    in-out property <bool> bonfire-group-is-owner: false;
    in-out property <bool> bonfire-group-is-member: false;
    in-out property <string> bonfire-group-owned-code: "";
    in-out property <[BonfireGroupMemberTile]> bonfire-group-owned-members: [];
    in-out property <string> bonfire-group-joined-owner-name: "";
    in-out property <bool> bonfire-group-hide-my-sub-profiles: false;
    in-out property <bool> bonfire-group-hide-others-sub-profiles: false;
    // Bonfire's own docs: "a grant, not a convenience setting" — group
    // members can switch into THIS account from the LAN with no PIN when
    // true; "if the account is an administrator, anyone who switches into
    // it gets server and user management." The OFF->ON transition is
    // intercepted in Slint to show bonfire-group-lan-bypass-confirm first;
    // the real bonfire-group-settings-changed call only fires from that
    // dialog's own confirmed() handler (or directly for ON->OFF, which
    // needs no confirmation — only the dangerous direction is gated).
    in-out property <bool> bonfire-group-allow-lan-bypass: false;
    in-out property <bool> bonfire-group-is-administrator: false;
    in-out property <bool> bonfire-group-has-pin: false;

    // Join-code entry — a hand-drawn field + Rust-invokable append/backspace
    // callbacks, same shape as discover-search-append/-backspace (NOT a
    // LineEdit — Bonfire codes are alphanumeric, entered via the shared
    // QwertyKeyboard, not the numeric VirtualKeyboard).
    in-out property <string> bonfire-group-join-code: "";
    in-out property <int> bonfire-group-join-code-cursor: -1; // caret, see text_field.rs (-1 = end)
    callback bonfire-group-join-code-append(string);
    callback bonfire-group-join-code-backspace();
    callback bonfire-group-join-code-submit();

    // D-pad zone — the zone SET differs by state (neither/owner/member), so
    // this is resolved live via profile.rs::existing_bonfire_group_zones,
    // the same "gaps are fine, recomputed live" idiom as
    // existing-profile-edit-zones/existing-discover-menu-rows, not a fixed
    // enum. -1 = the floating "← Back" button (Up from zone 0 reaches it,
    // matching every other master-only screen's own Back-button convention).
    in-out property <int> bonfire-group-zone: 0;

    // Kick (owner only, per-member) / Leave (member only) / Delete Group
    // (owner only) all reuse the existing ConfirmDialog component, same
    // shape as show-profile-edit-delete-confirm.
    in-out property <bool> show-bonfire-kick-confirm: false;
    in-out property <string> bonfire-kick-target-id: "";
    in-out property <string> bonfire-kick-target-name: "";
    in-out property <int> bonfire-kick-confirm-focused: 0; // 0=Cancel, 1=Kick
    in-out property <bool> show-bonfire-leave-confirm: false;
    in-out property <int> bonfire-leave-confirm-focused: 0; // 0=Cancel, 1=Leave
    in-out property <bool> show-bonfire-delete-group-confirm: false;
    in-out property <int> bonfire-delete-group-confirm-focused: 0; // 0=Cancel, 1=Delete
    in-out property <bool> show-bonfire-lan-bypass-confirm: false;
    in-out property <int> bonfire-lan-bypass-confirm-focused: 0; // 0=Cancel, 1=Confirm

    callback open-bonfire-group();
    callback bonfire-group-generate();
    callback bonfire-group-kick(string /* member user_id */);
    callback bonfire-group-leave();
    callback bonfire-group-delete();
    // hide_my, hide_others, allow_lan_bypass — the full trio every time,
    // matching bonfire_settings' own request shape (client.rs sends all
    // three unconditionally); simpler than 3 separate single-field
    // callbacks for what's always one combined POST either way.
    callback bonfire-group-settings-changed(bool, bool, bool);

    // Jellyfin's own server-admin flag (not Bonfire's household master), not persisted,
    // re-fetched on every session start — see FjordState.jellyfin_is_server_admin.
    // Gates Settings → Profiles → "Bonfire Admin".
    in-out property <bool> jellyfin-is-server-admin: false;

    in-out property <bool> show-bonfire-admin: false;
    in-out property <bool> bonfire-admin-loading: false;
    in-out property <string> bonfire-admin-error: "";
    // Keyboard focus on BonfireAdminScreen's "← Back", like BlocklistScreen's: Up from
    // the tab switcher, Down returns, Confirm/Back activate; Up while focused returns
    // false so the mini-player bar's focus_bar_on_up can take it.
    in-out property <bool> bonfire-admin-back-focused: false;
    in-out property <int> bonfire-admin-tab: 0; // 0=Mappings, 1=Audit Logs
    // -1 = tab switcher focused (the sentinel every other zone reachable
    // via Up-from-row-0 in this app uses); 0+ = a row index within the
    // active tab's own list. bonfire-admin-back-focused (above) is a
    // separate, higher zone still — Up from here (cursor==-1) reaches it.
    in-out property <int> bonfire-admin-cursor: -1;
    // Which action within a MASTER row is focused (0=Reset PIN, 1=profile-
    // limit stepper) — meaningless on a sub-profile row, which has only
    // the one action. Mappings tab only.
    in-out property <int> bonfire-admin-col: 0;
    in-out property <[BonfireAdminRow]> bonfire-admin-rows: [];
    // Fetched lazily on first switch to the Audit Logs tab, not on open —
    // skips the extra request for the common case of someone who only
    // ever checks Mappings.
    in-out property <bool> bonfire-admin-audit-fetched: false;
    in-out property <[BonfireAuditRow]> bonfire-admin-audit-rows: [];

    // Reset PIN — reachable from BOTH a master row's and a sub-profile
    // row's own action, so this one shared ConfirmDialog needs to
    // remember which profile it's currently acting on (the same "stash
    // the target id" shape bonfire-kick-target-id above already uses).
    in-out property <bool> show-bonfire-admin-reset-confirm: false;
    in-out property <string> bonfire-admin-reset-confirm-target: "";
    in-out property <string> bonfire-admin-reset-confirm-name: "";
    in-out property <int> bonfire-admin-reset-confirm-focused: 0; // 0=Cancel, 1=Reset

    callback open-bonfire-admin();
    // Switching tabs (not just setting bonfire-admin-tab directly) needs
    // to also lazily trigger the Audit Logs fetch on first visit to that
    // tab — routed through a callback rather than a Slint `changed`
    // tracker, since the actual fetch needs `state`/`rt`, which only
    // main.rs's own callback registrations have in scope.
    callback bonfire-admin-tab-selected(int);
    callback bonfire-admin-reset-pin(string /* profile_user_id */);
    callback bonfire-admin-set-limit(string /* user_id */, int /* new value, -1 = server default */);
    // The profile-limit "stepper" is Enter/click-cycles-through-a-fixed-
    // sequence (see bonfire_admin.rs::handle_key's own doc comment for why
    // Left/Right-adjusts-a-value was rejected as a D-pad dead end) — one
    // callback computes "what's the next value" in Rust (bonfire_admin.rs's
    // own next_limit_step, the single place that sequence is defined) and
    // applies it, reachable identically by keyboard Confirm and a mouse
    // click on the control, so the two paths can never compute a different
    // "next" value from each other.
    callback bonfire-admin-cycle-limit(string /* user_id */);
}
