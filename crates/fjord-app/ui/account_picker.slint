// ── fjord-app · account_picker.slint ─────────────────────────────────────────
//   AccountTileCard      account tile: avatar, "N profiles", "LINKED" badge (tile.is-group-account
//                        — another master's account through a Bonfire group), lock badge (has-pin,
//                        single-profile accounts only)
//   AccountPickerScreen  the tier above ProfilePickerScreen, shown when 2+ ACCOUNTS are known (a
//                        plain login, or a Bonfire household via its master — profile.rs's
//                        AccountGroup). Centered tile row (no scrolling) + "+ Add Account" tile +
//                        a loading overlay while a switch runs. A single-profile account switches
//                        directly (or opens ProfilePickerScreen's PIN modal — no account-level
//                        PIN); 2+ profiles open ProfilePickerScreen scoped to it. Kept separate from
//                        ProfilePickerScreen on purpose (different data and per-tile behaviour).
//                        Keyboard: Down from the tiles → Quit; Up → Back, shown only when opened
//                        from a live session (account-picker-cancelable); Enter/Escape/Backspace on
//                        Back close the picker and refocus() `fs`.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme, AccountTile } from "theme.slint";
import { AppState } from "app_state.slint";
import { FjordButton, PressPulse, LoadingSpinner } from "widgets.slint";

component AccountTileCard inherits VerticalLayout {
    in property <AccountTile> tile;
    in property <bool> kbd-focused;
    in property <bool> is-add-tile: false;
    callback activated();

    spacing: 8px;
    width: 132px;

    Rectangle {
        width: 108px;
        height: 108px;
        x: (parent.width - self.width) / 2;
        border-radius: self.width / 2;
        background: root.is-add-tile ? Theme.surface-overlay : root.tile.avatar-color;
        // Focus zoom (AppState.focus-scale), a render transform; tiles have room around them.
        transform-scale-x: AppState.zoom(root.kbd-focused);
        transform-scale-y: AppState.zoom(root.kbd-focused);
        transform-origin: { x: self.width * 0.5, y: self.height / 2 };
        animate transform-scale-x, transform-scale-y {
            duration: 150ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
        border-width: AppState.glow-ring-width(root.kbd-focused, ta.pressed || tile-pulse.pulsing);
        drop-shadow-blur: AppState.glow-blur(root.kbd-focused);
        drop-shadow-color: AppState.focus-color;
        border-color: AppState.focus-color;
        clip: true;
        animate border-width {
            duration: 90ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
        tile-pulse := PressPulse {
            trigger: AppState.kb-activate-pulse;
            active: root.kbd-focused;
        }

        Text {
            text: root.is-add-tile ? "+" : root.tile.avatar-initial;
            color: Theme.text;
            font-size: root.is-add-tile ? 40px : 42px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }

        ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.activated(); }
        }

        // Lock badge, like ProfileTileCard's (U+1F512, Noto Sans Symbols2). Only for
        // profile-count == 1 — see AccountTile.has-pin in theme.slint.
        if !root.is-add-tile && root.tile.has-pin: Rectangle {
            width: 30px;
            height: 30px;
            x: parent.width - self.width - 2px;
            y: parent.height - self.height - 2px;
            border-radius: self.width / 2;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-strong;
            Text {
                text: "🔒";
                font-family: "Noto Sans Symbols 2";
                font-size: 14px * AppState.text-scale;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
    }

    Text {
        text: root.is-add-tile ? "Add Account" : root.tile.display-name;
        color: root.kbd-focused ? Theme.accent : Theme.text;
        font-size: 14px * AppState.text-scale;
        font-weight: root.kbd-focused ? 700 : 400;
        horizontal-alignment: center;
        overflow: elide;
    }

    // Subtitle — "N profiles" for a Bonfire household with more than just
    // its own master; nothing at all for a standalone plain account or a
    // Bonfire master with no sub-profiles configured yet (profile-count
    // == 1 either way, since the master itself always counts as 1).
    if !root.is-add-tile && root.tile.profile-count > 1: Text {
        text: AppState.plural(root.tile.profile-count, "profile", "profiles");
        color: Theme.text-subtle;
        font-size: 11px * AppState.text-scale;
        horizontal-alignment: center;
    }

    // "LINKED" badge: another master's account reached through a Bonfire group, so it doesn't
    // look like one of the user's own accounts. Independent of the "N profiles" line. Text only
    // (Bonfire's flame glyph U+1F525 isn't in the bundled fonts).
    if !root.is-add-tile && root.tile.is-group-account: Rectangle {
        // Width from the content: unset, the Rectangle would stretch to the full tile width in this
        // VerticalLayout.
        width: badge-content.preferred-width;
        // Centered explicitly, like the avatar above (the layout doesn't center a narrower child).
        x: (parent.width - self.width) / 2;
        height: 18px;
        border-radius: self.height / 2;
        background: Theme.accent-muted;
        badge-content := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: "LINKED";
                color: Theme.accent;
                font-size: 9px * AppState.text-scale;
                font-weight: 700;
                letter-spacing: 1px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}

export component AccountPickerScreen inherits Rectangle {
    background: Theme.bg;

    property <int> tile-count: AppState.account-picker-accounts.length;

    // Same standalone-logo-centered-in-the-empty-region shape
    // ProfilePickerScreen already established (see that file's own doc
    // comment for the 4-report history behind this exact math) — no need
    // to re-derive it independently here.
    logo-img := Image {
        // Size doesn't affect the centering (same as profile_picker.slint).
        width: 180px;
        height: 180px;
        x: (parent.width - self.width) / 2;
        y: main-block.y / 2 - self.height / 2;
        source: AppState.app-logo-idx == 1 ? @image-url("../../../assets/fjord_01.svg") :
            AppState.app-logo-idx == 2 ? @image-url("../../../assets/fjord_02.svg") :
            AppState.app-logo-idx == 4 ? @image-url("../../../assets/fjord_04.svg") :
            AppState.app-logo-idx == 5 ? @image-url("../../../assets/fjord_05.svg") :
            AppState.app-logo-idx == 9 ? @image-url("../../../assets/fjord_09.svg") :
            @image-url("../../../assets/fjord_10.svg");
    }

    main-block := VerticalLayout {
        // Same `height: self.preferred-height;` fix ProfilePickerScreen's
        // own `main-block` needed — a Layout element directly inside a
        // plain Rectangle with no explicit height doesn't reliably default
        // to its own natural content height; applied here from the start
        // rather than waiting for the identical bug to resurface live.
        height: self.preferred-height;
        y: parent.height / 2 - heading-text.preferred-height - Theme.sp-xl - tile-row.preferred-height / 2;
        width: parent.width;
        spacing: Theme.sp-xl;

        heading-text := Text {
            text: "Which account?";
            color: Theme.text;
            font-size: 32px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        tile-row := HorizontalLayout {
            alignment: center;
            spacing: 24px;

            for t[i] in AppState.account-picker-accounts: AccountTileCard {
                tile: t;
                // !quit-focused/!back-focused exclude the tile ring while
                // Quit or Back holds focus instead — same convention as
                // profile_picker.slint.
                kbd-focused: AppState.account-picker-cursor == i && !AppState.account-picker-quit-focused && !AppState.account-picker-back-focused;
                activated => {
                    AppState.account-picker-cursor = i;
                    AppState.account-picker-quit-focused = false;
                    AppState.account-picker-back-focused = false;
                    AppState.account-picker-select(t.root-id);
                }
            }
            AccountTileCard {
                is-add-tile: true;
                kbd-focused: AppState.account-picker-cursor == root.tile-count && !AppState.account-picker-quit-focused && !AppState.account-picker-back-focused;
                activated => {
                    AppState.account-picker-cursor = root.tile-count;
                    AppState.account-picker-quit-focused = false;
                    AppState.account-picker-back-focused = false;
                    AppState.account-picker-add-account();
                }
            }
        }

        if AppState.account-picker-error != "": Text {
            text: AppState.account-picker-error;
            color: Theme.error;
            font-size: 13px * AppState.text-scale;
            horizontal-alignment: center;
        }
    }

    FjordButton {
        text: "Quit";
        width: 90px * AppState.text-scale;
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        // 2026-08-16, same keyboard-reachability fix as
        // profile_picker.slint's own Quit button — Down from the tile row
        // focuses it, Up returns, Enter activates.
        kbd-focused: AppState.account-picker-quit-focused;
        clicked => {
            AppState.account-picker-quit-focused = false;
            AppState.quit();
        }
    }

    // Back — only when opened from a live session (account-picker-cancelable), never at cold
    // start. Like profile_picker.slint's "cancel" variant: closes the picker and keeps the
    // current session; refocus() hands keys back to `fs` (the keyboard path in keys.rs does the
    // same).
    if AppState.account-picker-cancelable: FjordButton {
        text: "← Back";
        width: 110px * AppState.text-scale;
        x: 16px;
        y: 16px;
        kbd-focused: AppState.account-picker-back-focused;
        clicked => {
            AppState.account-picker-back-focused = false;
            AppState.show-account-picker = false;
            AppState.refocus();
        }
    }

    // Same shape as ProfilePickerScreen's own loading overlay — a
    // single-profile account's tile click can go straight into
    // switch_to_profile, which is the same multi-second async flow.
    if AppState.account-picker-loading: Rectangle {
        background: #000000c0;

        VerticalLayout {
            alignment: center;
            spacing: 20px;

            LoadingSpinner { }

            Text {
                text: "Signing in…";
                color: Theme.text;
                font-size: 15px * AppState.text-scale;
                horizontal-alignment: center;
            }
        }
    }
}
