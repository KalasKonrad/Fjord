// ── fjord-app · artist.slint ──────────────────────────────────────────────────
//   ArtistScreen  MusicArtist detail: portrait + meta + album grid + Tracks (the folder's loose
//                 tracks: artist-tracks / -in-tracks / -track-focused, TrackRow); the page scrolls to
//                 the focused album row or track (kb-y from the laid-out positions)
//                 artist-focused: int (focused album card flat index)
//                 artist-back-focused: bool (Back button has focus)
//                 artist-btn-focused: int (-1=none, 0=▶ Play All, 1=♥, 2=bio)
//                 artist-overview-expanded: bool (collapsible bio below header)
//                 Enter on card → open-detail (open_item.rs); C → context menu; Back → close-artist
//                 ▶ Play All → play-artist-all; ♥ → toggle-artist-fav
//                 Title column: a plain Rectangle fixed at the portrait's 160px, width from
//                 root.width (not parent.width — binding loop), the button row pinned at
//                 y = parent.height - 38px.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import {
    StackPage,
    TrackRow,
    FjordButton,
    MediaCard,
    IconCircleButton,
    StorylineSection,
} from "widgets.slint";

export component ArtistScreen inherits StackPage {
    property <length> card-w: 145px * AppState.card-scale;
    property <length> card-h: 224px * AppState.card-scale;
    property <length> gap:    14px;
    property <length> grid-content-height:
        ((AppState.artist-albums.length + AppState.library-cols - 1) / AppState.library-cols)
        * (card-h + gap) + gap;

    property <length> track-h: 48px;

    // Keyboard scroll: the page follows the focused album row or track (the header → the top).
    // Positions come from the laid-out elements (fl-container, tracks-section), so the bio above
    // and the grid's row count are included. root.height, not fl.height (SLINT.md).
    property <length> focus-top: AppState.artist-in-tracks
        ? tracks-section.y + tracks-list.y + AppState.artist-track-focused * track-h
        : fl-container.y + gap + floor(AppState.artist-focused / AppState.library-cols) * (card-h + gap);
    property <length> focus-h: AppState.artist-in-tracks ? track-h : card-h;
    property <length> kb-y: AppState.artist-back-focused || AppState.artist-btn-focused >= 0 ? 0px
        : clamp(root.height / 2 - focus-top - focus-h / 2, min(0px, root.height - art-content.preferred-height), 0px);
    changed kb-y => { fl.content-y = kb-y; }

    fl := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: art-content.preferred-height;
        content-width: self.width;
        animate content-y {
            duration: 200ms * AppState.settings-scroll-speed;
            easing: ease-in-out;
        }

        art-content := VerticalLayout {

            // ── Header block ──────────────────────────────────────────────────
            Rectangle {
                background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;

                VerticalLayout {
                    HorizontalLayout {
                        padding-left: 48px;
                        padding-right: 48px;
                        padding-top: 68px;
                        padding-bottom: 24px;
                        spacing: 32px;
                        alignment: start;

                        // Portrait / placeholder
                        Rectangle {
                            width: 160px;
                            height: 160px;
                            border-radius: 80px;  // circle
                            background: Theme.surface-overlay;
                            clip: true;
                            if AppState.artist-has-portrait: Image {
                                width: parent.width;
                                height: parent.height;
                                image-fit: cover;
                                source: AppState.artist-portrait;
                            }
                            if !AppState.artist-has-portrait: Text {
                                text: "♪";
                                font-family: "Noto Sans Symbols 2";
                                color: Theme.text-subtle;
                                font-size: 64px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                        }

                        // Plain Rectangle fixed at 160px (the circular portrait): title/meta at the top, the
                        // ▶ Play All / ♥ row pinned at `y: parent.height - 38px` (IconCircleButton's 38px sets the
                        // row height) — neither depends on the other's size; top-anchored like the other detail
                        // screens (same fix as detail.slint).
                        Rectangle {
                            height: 160px;
                            // Width from root.width (see detail.slint): minus the padding (48+48), the 160px portrait
                            // and the spacing (32).
                            width: root.width - 48px - 48px - 160px - 32px;

                            VerticalLayout {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                spacing: 12px;
                                alignment: start;

                                Text {
                                    text: AppState.artist-title;
                                    color: Theme.text;
                                    font-size: 28px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }

                                if AppState.artist-meta != "": Text {
                                    text: AppState.artist-meta;
                                    color: Theme.text-muted;
                                    font-size: 14px * AppState.text-scale;
                                }
                            }

                            // ▶ Play All + ♥ action buttons
                            HorizontalLayout {
                                x: 0;
                                y: parent.height - 38px;
                                spacing: 10px;
                                alignment: start;
                                FjordButton {
                                    icon-left: "▶";
                                    text: "Play All";
                                    height: 34px;
                                    width: 110px * AppState.text-scale;
                                    kbd-focused: AppState.artist-btn-focused == 0;
                                    clicked => { AppState.play-artist-all(); }
                                }

                                IconCircleButton {
                                    icon: "❤";
                                    active: AppState.artist-is-favorite;
                                    kbd-focused: AppState.artist-btn-focused == 1;
                                    clicked => { AppState.toggle-artist-fav(); }
                                }
                            }
                        }
                    }
                }
            }

            // ── Overview / bio (collapsible) ──────────────────────────────────
            if AppState.artist-overview != "": StorylineSection {
                text: AppState.artist-overview;
                expanded <=> AppState.artist-overview-expanded;
                kbd-focused: AppState.artist-btn-focused == 2;
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // ── Album grid ────────────────────────────────────────────────────
            fl-container := Rectangle {
                height: grid-content-height;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: gap;
                    spacing: gap;

                    for row-idx in (AppState.artist-albums.length + AppState.library-cols - 1) / AppState.library-cols: HorizontalLayout {
                            // The focused card's row draws above the next one (its zoom reaches into the gap).
                            z: floor(AppState.artist-focused / AppState.library-cols) == row-idx ? 1 : 0;
                        alignment: start;
                        spacing: gap;
                        height: card-h;

                        for col-idx in AppState.library-cols: MediaCard {
                            property <int> idx: row-idx * AppState.library-cols + col-idx;
                                // Edge cards zoom inward so the grid's edges don't cut them off.
                                zoom-anchor-x: col-idx == 0 ? 0 : col-idx == AppState.library-cols - 1 ? 1 : 0.5;
                            zoom-anchor-y: row-idx == 0 ? 0 : row-idx == floor((AppState.artist-albums.length - 1) / AppState.library-cols) ? 1 : 0.5;
                            visible: idx < AppState.artist-albums.length;
                            item: AppState.artist-albums[idx];
                            width: card-w;
                                // Not while the header or the Tracks have the keys.
                                focused: idx == AppState.artist-focused && !AppState.artist-back-focused
                                && AppState.artist-btn-focused < 0 && !AppState.artist-in-tracks;
                            clicked => {
                                    // Single click opens (grid-wide convention);
                                    // focus syncs so Back returns the cursor here.
                                    AppState.artist-focused = idx;
                                AppState.artist-back-focused = false;
                                AppState.artist-btn-focused = -1;
                                AppState.artist-in-tracks = false;
                                let c = AppState.artist-albums[idx];
                                AppState.open-detail(c.id, c.item-type);
                            }
                            right-clicked => {
                                let c = AppState.artist-albums[idx];
                                AppState.context-menu-title = c.title;
                                AppState.open-context-menu(c.id, c.has-played, c.is-favorite, c.resume-pct, c.item-type, c.series-id);
                            }
                        }
                    }
                }
            }

            // ── Tracks: files lying directly in the artist's folder, in no album (untagged files —
            // artist.rs). Height 0 when there are none (an invisible layout child still takes room).
            tracks-section := VerticalLayout {
                visible: AppState.artist-tracks.length > 0;
                height: AppState.artist-tracks.length > 0 ? self.preferred-height : 0px;
                padding-left: gap;
                padding-right: gap;
                padding-top: gap;
                spacing: 8px;

                Text {
                    text: "Tracks";
                    color: Theme.text;
                    font-size: 16px * AppState.text-scale;
                    font-weight: 700;
                }

                tracks-list := Rectangle {
                    height: AppState.artist-tracks.length * track-h;

                    for trk[i] in AppState.artist-tracks: TrackRow {
                        x: 0px;
                        y: trk.row-y-px * 1px;
                        width: parent.width;
                        height: track-h;
                        track: trk;
                        index: i;
                        focused: AppState.artist-in-tracks && i == AppState.artist-track-focused
                            && !AppState.artist-back-focused && AppState.artist-btn-focused < 0;
                        page-artist: AppState.artist-title;
                        clicked => {
                            AppState.artist-in-tracks = true;
                            AppState.artist-track-focused = i;
                            AppState.artist-back-focused = false;
                            AppState.artist-btn-focused = -1;
                        }
                        double-clicked => { AppState.play-artist-track(trk.id); }
                    }
                }
            }

            Rectangle {
                height: gap;
            }
        }
    }

    // Floating Back button
    FjordButton {
        x: 16px;
        y: 16px;
        text: "← Back";
        width: 88px * AppState.text-scale;
        kbd-focused: AppState.artist-back-focused;
        clicked => { AppState.close-artist(); }
    }
}
