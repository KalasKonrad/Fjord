// ── fjord-app · detail.slint ─────────────────────────────────────────────────
//   DetailPage  header: backdrop (cover, dark gradient; muted Theme.text-soft over it), PosterBlock,
//               title column — a plain Rectangle fixed at 240px, width from root.width (not
//               parent.width — binding loop), title/meta at its top and the button row pinned at
//               y = parent.height - 38px: Play / Resume / "Series →" / Trailer (movies: greyed
//               "Checking…"/"No trailer" until detail-trailer-state "ok"; hidden without yt-dlp unless
//               a server trailer file is ok), ♥ favourite and ✓ watched IconCircleButtons; "Ends
//               HH:MM" below, centered under Play.
//               Then CastRow, the collection row, "More Like This", "Recommended" (Seerr), and the
//               scrollable overview. Keyboard scroll (kb-y): a focused row comes to the middle from
//               its 0-height anchor (cast-/collection-/similar-/recommended-anchor), as on the series
//               page; the header area uses detail-scroll.
//               Button focus: detail-focused-btn (-1 Back, 0 Play, 1 Resume, 2 Series, 6 Trailer,
//               3 Fav, 4 Watched — Left/Right order in detail.rs's existing_detail_buttons; 5 =
//               Overview, below); cast focus: detail-cast-focused.
//               Shown only once metadata + poster + backdrop have loaded (detail.rs spawn_main;
//               app-content-loading covers the previous screen meanwhile). Back with a minimized
//               background player clears playback-from-detail, so stopping won't reopen this.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme, CastMember } from "theme.slint";
import { AppState } from "app_state.slint";
import {
    FjordButton,
    IconCircleButton,
    PosterBlock,
    MetaLine,
    CastRow,
    StorylineSection,
} from "widgets.slint";
import { SectionRow } from "home.slint";

export component DetailPage inherits Rectangle {
    background: Theme.bg;
    // Keyboard scroll: a focused row (cast / collection / similar / recommended) is brought to the
    // middle from its real position — the 0-height anchors before each section, as on the series
    // page; the header (buttons, overview) uses detail-scroll (0, or detail.rs's small nudge when
    // there's nothing below). Mouse-wheel still works: content-y is only assigned in `changed`.
    property <length> kb-y: {
        let row = AppState.detail-focused-row;
        let lo = min(0px, self.height - detail-content.preferred-height);
        row == 1 ? clamp(self.height / 2 - cast-anchor.y, lo, 0px)
            : row == 2 ? clamp(self.height / 2 - collection-anchor.y, lo, 0px)
            : row == 3 ? clamp(self.height / 2 - similar-anchor.y, lo, 0px)
            : row == 4 ? clamp(self.height / 2 - recommended-anchor.y, lo, 0px)
            : clamp(-AppState.detail-scroll, lo, 0px)
    };
    changed kb-y => { detail-fl.content-y = kb-y; }

    detail-fl := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: detail-content.preferred-height;
        content-width: self.width;
        animate content-y {
            duration: 200ms * AppState.settings-scroll-speed;
            easing: ease-in-out;
        }

        detail-content := VerticalLayout {

            // ── Header: backdrop image fills entire poster+text block ─────────
            Rectangle {
                background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;

                // Backdrop image — fills this Rectangle; height driven by inner layout
                if AppState.detail-has-backdrop: Image {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                    source: AppState.detail-backdrop;
                }
                // Overlay — darkens backdrop so text remains readable
                if AppState.detail-has-backdrop: Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    background: @linear-gradient(180deg, Theme.hero-fade-top 0%, Theme.hero-fade-bottom 100%);
                }

                VerticalLayout {
                    HorizontalLayout {
                        padding-left: 48px;
                        padding-right: 48px;
                        padding-top: 68px;
                        padding-bottom: 24px;
                        spacing: 32px;
                        alignment: start;

                        if AppState.detail-has-poster: PosterBlock {
                            source: AppState.detail-poster;
                            has-image: true;
                            has-played: AppState.detail-has-played;
                            resume-pct: AppState.detail-resume-pct;
                        }

                        VerticalLayout {
                            spacing: 8px;
                            alignment: start;

                            // A plain (non-Layout) Rectangle fixed at 240px (PosterBlock's height) with two
                            // independently positioned children: the title/meta stack at the top (sized to its content)
                            // and the button row at `y: parent.height - 38px` (FjordButton and IconCircleButton are
                            // 38px). Neither depends on the other's size, so the buttons always sit at the same y — a
                            // spacer-based layout let the text height push them around.
                        Rectangle {
                                height: 240px;
                            // Width from root.width (DetailPage's own, from a completed layout pass): a plain
                            // Rectangle doesn't take a width from the HorizontalLayout (collapsed to ~0 and wrapped
                            // every line), horizontal-stretch doesn't work on it, and parent.width is a binding loop.
                            // Minus the layout padding (48+48), PosterBlock (160) and the spacing (32).
                            width: root.width - 48px - 48px - 160px - 32px;

                                VerticalLayout {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    spacing: 8px;
                                    alignment: start;

                                    Text {
                                        text: AppState.detail-title;
                                        color: Theme.text;
                                        font-size: 28px;
                                        font-weight: 700;
                                        wrap: word-wrap;
                                    }

                                    if AppState.detail-tagline != "": Text {
                                        text: AppState.detail-tagline;
                                        color: AppState.detail-has-backdrop ? Theme.text-bright : Theme.text-muted;
                                        font-size: 15px * AppState.text-scale;
                                        font-italic: true;
                                        wrap: word-wrap;
                                    }

                                    if AppState.detail-series-label != "": Text {
                                        text: AppState.detail-series-label;
                                        color: Theme.accent;
                                        font-size: 14px * AppState.text-scale;
                                        wrap: word-wrap;
                                    }

                                    MetaLine {
                                        meta: AppState.detail-meta;
                                        rating-label: AppState.detail-rating-label;
                                    }

                                    if AppState.detail-genres != "": Text {
                                        text: AppState.detail-genres;
                                        color: AppState.detail-has-backdrop ? Theme.text-bright : Theme.text-muted;
                                        font-size: 13px * AppState.text-scale;
                                    }

                                    if AppState.detail-studio != "": Text {
                                        text: AppState.detail-studio;
                                        color: AppState.detail-has-backdrop ? Theme.text-bright : Theme.text-muted;
                                        font-size: 13px * AppState.text-scale;
                                    }
                                }

                                HorizontalLayout {
                                    x: 0;
                                    y: parent.height - 38px;
                                    spacing: 12px;
                                    alignment: start;
                                    FjordButton {
                                        icon-left: "▶";
                                        text: "Play";
                                        width: 110px * AppState.text-scale;
                                        kbd-focused: AppState.detail-focused-btn == 0 && AppState.detail-cast-focused < 0;
                                        clicked => { AppState.play-detail(); }
                                    }

                                    if AppState.detail-can-resume: FjordButton {
                                        icon-left: "⏩";
                                        text: AppState.detail-resume-label;
                                        kbd-focused: AppState.detail-focused-btn == 1 && AppState.detail-cast-focused < 0;
                                        clicked => { AppState.resume-detail(); }
                                    }
                                    if AppState.detail-series-id != "": FjordButton {
                                        text: "Series →";
                                        width: 100px * AppState.text-scale;
                                        kbd-focused: AppState.detail-focused-btn == 2 && AppState.detail-cast-focused < 0;
                                        clicked => {
                                            AppState.detail-scroll = 0px;
                                            AppState.detail-focused-btn = 0;
                                            AppState.close-detail();
                                            AppState.open-series(AppState.detail-series-id);
                                        }
                                    }
                                    // Trailer (movies): greyed while checking / when none plays; hidden
                                    // without yt-dlp unless a trailer file on the server is "ok".
                                    if AppState.detail-trailer-state != "" && (AppState.yt-dlp-available || AppState.detail-trailer-state == "ok"): FjordButton {
                                        enabled: AppState.detail-trailer-state == "ok";
                                        icon-left: AppState.detail-trailer-state == "ok" ? "▶" : "";
                                        text: AppState.detail-trailer-state == "ok" ? "Trailer"
                                            : AppState.detail-trailer-state == "checking" ? "Checking…"
                                            : "No trailer";
                                        width: 130px * AppState.text-scale;
                                        kbd-focused: AppState.detail-focused-btn == 6 && AppState.detail-cast-focused < 0;
                                        clicked => { AppState.play-detail-trailer(); }
                                    }
                                // ♥ favourite — gray when not fav, accent when fav
                                IconCircleButton {
                                        icon: "❤";
                                        active: AppState.detail-is-favorite;
                                        kbd-focused: AppState.detail-focused-btn == 3 && AppState.detail-cast-focused < 0;
                                        clicked => { AppState.toggle-detail-fav(); }
                                    }
                                // ✓ watched — gray when not watched, accent when watched
                                IconCircleButton {
                                        icon: "✓";
                                        active: AppState.detail-has-played;
                                        kbd-focused: AppState.detail-focused-btn == 4 && AppState.detail-cast-focused < 0;
                                        clicked => { AppState.toggle-detail-played(); }
                                    }
                                }
                            }

                            // Ends HH:MM — below the buttons, centered under the Play button (110px, Play's width).
                        if AppState.detail-ends-at != "": Text {
                                text: "Ends " + AppState.detail-ends-at;
                                color: AppState.detail-has-backdrop ? #eeeeee : Theme.text-muted;
                                font-size: 13px * AppState.text-scale;
                                width: 110px * AppState.text-scale;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if AppState.detail-overview != "": StorylineSection {
                        text: AppState.detail-overview;
                        expanded <=> AppState.detail-overview-expanded;
                        kbd-focused: AppState.detail-focused-btn == 5 && AppState.detail-focused-row == 0;
                    }
                }
            }

            cast-anchor := Rectangle {
                height: 0px;
            }

            if AppState.detail-cast.length > 0: VerticalLayout {
                padding-left: 48px;
                padding-right: 48px;
                padding-bottom: 24px;

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                Rectangle {
                    height: 12px;
                }

                CastRow {
                    cast: AppState.detail-cast;
                    focused-idx: AppState.detail-cast-focused;
                    item-selected(idx) => {
                        AppState.open-person(AppState.detail-cast[idx].id, AppState.detail-cast[idx].name);
                    }
                }
            }

            collection-anchor := Rectangle {
                height: 0px;
            }

            if AppState.detail-collection.length > 0: VerticalLayout {
                padding-left: 48px;
                padding-right: 48px;
                padding-bottom: 40px;

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                SectionRow {
                    section-title: AppState.detail-collection-title;
                    items: AppState.detail-collection;
                    section-focused: AppState.detail-focused-row == 2;
                    focused-card: AppState.detail-collection-focused;
                    item-play(id, itype) => { AppState.open-detail(id, itype); }
                    item-context(id, played, fav, rpct, itype, sid) => {
                        AppState.open-context-menu(id, played, fav, rpct, itype, sid);
                    }
                }
            }

            similar-anchor := Rectangle {
                height: 0px;
            }

            if AppState.detail-similar.length > 0: VerticalLayout {
                padding-left: 48px;
                padding-right: 48px;
                padding-bottom: 40px;

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                SectionRow {
                    section-title: "More Like This";
                    items: AppState.detail-similar;
                    section-focused: AppState.detail-focused-row == 3;
                    focused-card: AppState.detail-similar-focused;
                    item-play(id, itype) => { AppState.open-detail(id, itype); }
                    item-context(id, played, fav, rpct, itype, sid) => {
                        AppState.open-context-menu(id, played, fav, rpct, itype, sid);
                    }
                }
            }

            recommended-anchor := Rectangle {
                height: 0px;
            }

            if AppState.detail-recommended.length > 0: VerticalLayout {
                padding-left: 48px;
                padding-right: 48px;
                padding-bottom: 40px;

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                SectionRow {
                    section-title: "Recommended";
                    items: AppState.detail-recommended;
                    section-focused: AppState.detail-focused-row == 4;
                    focused-card: AppState.detail-recommended-focused;
                    item-play(id, it) => { AppState.open-discover-item(it == "DiscoverMovie" ? "movie" : "tv", id); }
                    item-context-full(itm) => { AppState.open-context-menu-discover(itm); }
                }
            }
        }
    }

    FjordButton {
        x: 16px;
        y: 16px;
        text: "← Back";
        width: 88px * AppState.text-scale;
        kbd-focused: AppState.detail-focused-btn == -1 && AppState.detail-cast-focused < 0;
        clicked => {
            AppState.detail-scroll = 0px;
            AppState.detail-focused-btn = 0;
            AppState.detail-focused-row = 0;
            AppState.detail-cast-focused = -1;
            AppState.detail-collection-focused = -1;
            AppState.detail-similar-focused = -1;
            AppState.detail-recommended-focused = -1;
            if AppState.has-background-player {
                AppState.playback-from-detail = false;
            }
            AppState.close-detail();
        }
    }
}
