// ── fjord-app · now_playing.slint ────────────────────────────────────────────
//   NowPlayingScreen   fullscreen music view: 70px top bar (← Back at x/y 16 like every
//                      screen's), the cover (sized from the window: what's left after the
//                      bar, the strip and the column's text/controls, 240–640px) + the whole
//                      title (wraps), artist (only when there is one), format, progress, then
//                      two control rows — ⏮ ⏯ ⏭ (⏯ 68px, filled) / ⇌ ↻ 🔉 🔊 ☾ Open Album —
//                      (left), synced lyrics (right), "Up Next" strip (bottom: 104px covers,
//                      the title on up to two lines, the artist when there is one; its Flickable
//                      spans the strip over the label so the focused cover's glow shows all
//                      round — the strip grows for a glow wider than the label's room).
//                      Settings → Audio "Now Playing background": the cover
//                      blurred (music-bar-art-blur) under a Soft/Strong scrim, the bars see-
//                      through over it. Keys (keys/player.rs): now-playing-back-focused (top
//                      bar), now-playing-in-strip, now-playing-ctrl-focused (1-3 ⏮⏯⏭ / 4 ⇌ 5 ↻
//                      6 🔉 7 🔊 8 ☾ (only with the screensaver on) 0 Open Album),
//                      now-playing-strip-focused (index into queue-items).
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import {
    FocusGlow,
    FjordButton,
    IconCircleButton,
    PressPulse,
} from "widgets.slint";

export component NowPlayingScreen inherits Rectangle {
    background: Theme.bg;

    // Sizes come from the window (and Settings → Interface → Text size), so the screen fills a TV.
    property <length> bar-h: 70px; // the top bar: Back at x/y 16 like every other screen's
    property <length> pad: 32px;
    // Up Next: the label, 104px covers, then title + artist.
    property <length> strip-card: 104px;
    property <length> strip-step: 138px; // a card's width (124) + the gap between cards (14)
    // Room above the covers: the label's (16px + its height + 8px, under the 1px top line), or the
    // focus glow's reach where that is more (Strong/Very strong) — the strip grows by the difference.
    property <length> strip-label-room: 23px + up-next-label.preferred-height;
    property <length> strip-cover-top: max(root.strip-label-room, ceil(AppState.glow-reach / 1px) * 1px);
    property <length> strip-h: 148px + 66px * AppState.text-scale + root.strip-cover-top - root.strip-label-room; // the title up to two lines
    // The left column without the cover: title (up to two lines) + artist + format, the
    // progress bar + times, the two control rows (68 + 12 + 38), the gaps between them.
    property <length> info-h: 117px * AppState.text-scale + 198px;
    property <length> cover-size: clamp(root.height - root.bar-h - root.strip-h - 2 * root.pad - root.info-h, 240px, 640px);
    property <length> col-w: max(root.cover-size, 440px * AppState.text-scale);
    // Settings → Audio "Now Playing background": the cover blurred behind everything.
    property <bool> blur-on: AppState.settings-now-playing-background != "plain" && AppState.music-bar-has-art;
    property <bool> np-ctrl: !AppState.now-playing-back-focused && !AppState.now-playing-in-strip;

    // The song's cover as a 24px image stretched over the screen (reads as a blur — the Music
    // hero's way), under a scrim: Soft darker (colours only hinted), Strong brighter.
    if root.blur-on: Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: AppState.music-bar-art-blur;
        image-fit: cover;
    }
    if root.blur-on: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: AppState.settings-now-playing-background == "strong" ? Theme.scrim : Theme.scrim-solid;
    }

    VerticalLayout {
        spacing: 0px;

        // ── Top bar: Back ───────────────────────────────────────────────────
        Rectangle {
            height: root.bar-h;
            background: root.blur-on ? Theme.osd-panel : Theme.surface;
            FjordButton {
                x: 16px;
                y: 16px;
                text: "← Back";
                width: 88px * AppState.text-scale;
                kbd-focused: AppState.now-playing-back-focused;
                clicked => {
                    AppState.show-now-playing = false;
                }
            }

            Text {
                x: 16px + 88px * AppState.text-scale + Theme.sp;
                y: (parent.height - self.height) / 2;
                text: "Now Playing";
                color: Theme.text;
                font-size: 17px * AppState.text-scale;
                font-weight: 700;
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: parent.width;
                background: Theme.border;
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            padding: root.pad;
            padding-left: 48px;
            padding-right: 48px;
            spacing: 48px;

            // ── Left: cover + title/artist/format + progress + controls ──────
            VerticalLayout {
                width: root.col-w;
                alignment: center;
                spacing: 20px;

                Rectangle {
                    height: root.cover-size;
                    art := Rectangle {
                        x: (parent.width - self.width) / 2;
                        width: root.cover-size;
                        height: root.cover-size;
                        border-radius: Theme.radius-lg;
                        background: Theme.surface-raised;
                        clip: true;
                        if AppState.music-bar-has-art: Image {
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            source: AppState.music-bar-art;
                        }
                        if !AppState.music-bar-has-art: Text {
                            text: "♫";
                            font-family: "Noto Sans Symbols 2";
                            color: Theme.text-subtle;
                            font-size: root.cover-size / 4;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }

                // The whole title (it wraps), the artist only when there is one, the format.
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: AppState.music-bar-title;
                        color: Theme.text;
                        font-size: 26px * AppState.text-scale;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    if AppState.music-bar-artist != "": Text {
                        text: AppState.music-bar-artist;
                        color: Theme.text-muted;
                        font-size: 16px * AppState.text-scale;
                        horizontal-alignment: center;
                        overflow: elide;
                    }

                    // Format + quality: "FLAC · 16-bit / 44.1 kHz", "MP3 · 256 kbps · 44.1 kHz"
                    if AppState.music-bar-quality-long != "": Text {
                        text: AppState.music-bar-quality-long;
                        color: Theme.text-subtle;
                        font-size: 13px * AppState.text-scale;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    prog-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        height: 6px;
                        clicked => {
                            AppState.music-bar-seek(self.mouse-x / self.width);
                        }
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.border;
                            Rectangle {
                                x: 0;
                                width: parent.width * AppState.music-bar-pos;
                                height: parent.height;
                                border-radius: 3px;
                                background: Theme.accent;
                            }
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: AppState.music-bar-elapsed;
                            color: Theme.text-muted;
                            font-size: 13px * AppState.text-scale;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: AppState.music-bar-total;
                            color: Theme.text-muted;
                            font-size: 13px * AppState.text-scale;
                        }
                    }
                }

                // Two rows (keys/player.rs: Up/Down between them): the transport — ⏮ ⏯ ⏭, play/pause
                // the largest and filled — then ⇌ ↻ 🔉 🔊 ☾ Open Album. Indices
                // (now-playing-ctrl-focused): 1 ⏮, 2 ⏯, 3 ⏭ / 4 ⇌, 5 ↻, 6 🔉, 7 🔊, 8 ☾, 0 Open Album.
                VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 28px;
                        // A HorizontalLayout puts fixed-height children at its top — centre the
                        // smaller ones on the big one.
                        VerticalLayout {
                            alignment: center;
                            IconCircleButton {
                                size: 52px;
                                icon: "⏮";
                                kbd-focused: root.np-ctrl && AppState.now-playing-ctrl-focused == 1;
                                clicked => {
                                    AppState.queue-prev-track();
                                }
                            }
                        }

                        IconCircleButton {
                            size: 68px;
                            icon: AppState.music-bar-paused ? "▶" : "⏸";
                            active: true;
                            kbd-focused: root.np-ctrl && AppState.now-playing-ctrl-focused == 2;
                            clicked => {
                                AppState.music-bar-play-pause();
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            IconCircleButton {
                                size: 52px;
                                icon: "⏭";
                                kbd-focused: root.np-ctrl && AppState.now-playing-ctrl-focused == 3;
                                clicked => {
                                    AppState.queue-next-track();
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 12px;
                        IconCircleButton {
                            icon: "⇌";
                            active: AppState.queue-shuffle;
                            kbd-focused: root.np-ctrl && AppState.now-playing-ctrl-focused == 4;
                            clicked => {
                                AppState.toggle-shuffle();
                            }
                        }

                        IconCircleButton {
                            icon: AppState.queue-repeat-mode == 2 ? "↺¹" : "↺";
                            active: AppState.queue-repeat-mode > 0;
                            kbd-focused: root.np-ctrl && AppState.now-playing-ctrl-focused == 5;
                            clicked => {
                                AppState.cycle-repeat();
                            }
                        }

                        IconCircleButton {
                            icon: "🔉";
                            kbd-focused: root.np-ctrl && AppState.now-playing-ctrl-focused == 6;
                            clicked => {
                                AppState.volume-down();
                            }
                        }

                        IconCircleButton {
                            icon: "🔊";
                            kbd-focused: root.np-ctrl && AppState.now-playing-ctrl-focused == 7;
                            clicked => {
                                AppState.volume-up();
                            }
                        }

                        // Screensaver: lit while it will come on; turns it off for this playback.
                        if AppState.screensaver-enabled: IconCircleButton {
                            icon: "☾";
                            active: !AppState.screensaver-paused;
                            kbd-focused: root.np-ctrl && AppState.now-playing-ctrl-focused == 8;
                            clicked => {
                                AppState.toggle-screensaver();
                            }
                        }

                        FjordButton {
                            text: "Open Album";
                            width: 130px * AppState.text-scale;
                            kbd-focused: root.np-ctrl && AppState.now-playing-ctrl-focused == 0;
                            clicked => {
                                AppState.music-bar-open-album();
                                AppState.show-now-playing = false;
                            }
                        }
                    }
                }
            }

            // ── Right: lyrics ────────────────────────────────────────────────
            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                if !AppState.lyrics-available: Text {
                    text: "No lyrics available";
                    color: Theme.text-subtle;
                    font-size: 14px * AppState.text-scale;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                // kb-y + changed-handler (not a direct content-y binding) keeps
                // native mouse-wheel scroll working alongside the auto-follow.
                if AppState.lyrics-available: lyr-fl := Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: max(parent.height, lyr-list.preferred-height);

                    property <length> kb-y: clamp(
                        -(AppState.lyrics-active-idx * 76px) + parent.height / 2 - 38px,
                        min(0px, parent.height - lyr-list.preferred-height),
                        0px);
                    changed kb-y => { lyr-fl.content-y = kb-y; }
                    animate content-y {
                        duration: 450ms * AppState.settings-scroll-speed;
                        easing: ease-in-out;
                    }

                    lyr-list := VerticalLayout {
                        alignment: start;
                        spacing: 0px;
                        padding: 32px;

                        // Text.width bound to parent.width directly here would
                        // self-reference lyr-list's own layout computation
                        // (width -> layoutinfo -> min-width -> content-width
                        // -> ... -> width), the same class of binding-loop
                        // gotcha documented in CLAUDE.md for content-y. The
                        // TouchArea wrapper (as in widgets.slint's LyricsView,
                        // whose structure this mirrors) isn't layout-sized
                        // from its child, so it breaks the cycle.
                        // min-height (not a fixed height) lets a long line wrap
                        // instead of being elided with "…" — see the matching
                        // comment in widgets.slint's LyricsView, which this mirrors.
                        // `sizer` reserves the row height a line would need once
                        // highlighted (measured at the active font/weight) so
                        // activating a line doesn't also trigger a 1-line -> 2-line
                        // reflow on top of the font-size jump.
                        for line[i] in AppState.lyrics-lines: TouchArea {
                            min-height: max(76px, sizer.preferred-height);
                            sizer := Text {
                                visible: false;
                                height: 0px;
                                text: line.text;
                                font-size: 40px;
                                font-weight: 700;
                                width: parent.width;
                                wrap: word-wrap;
                            }

                            Text {
                                text: line.text;
                                color: i == AppState.lyrics-active-idx ? Theme.accent
                                    : (i == AppState.lyrics-active-idx + 1 || i == AppState.lyrics-active-idx - 1)
                                    ? Theme.text-muted
                                    : Theme.text-subtle;
                                font-size: i == AppState.lyrics-active-idx ? 40px : 24px;
                                font-weight: i == AppState.lyrics-active-idx ? 700 : 400;
                                horizontal-alignment: center;
                                width: parent.width;
                                // Centre within the (possibly taller, sizer-reserved)
                                // row manually — see the matching comment in
                                // widgets.slint's LyricsView.
                                y: (parent.height - self.height) / 2;
                                wrap: word-wrap;
                                animate color, font-size {
                                    duration: 350ms * AppState.settings-animation-speed;
                                    easing: ease-in-out;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Up Next strip ────────────────────────────────────────────────────
        Rectangle {
            height: root.strip-h;
            background: root.blur-on ? Theme.osd-panel : Theme.surface;
            Rectangle {
                y: 0;
                height: 1px;
                width: parent.width;
                background: Theme.border;
            }

            up-next-label := Text {
                x: 16px;
                y: 16px;
                width: self.preferred-width;
                height: self.preferred-height;
                text: "Up Next";
                color: Theme.text-muted;
                font-size: 13px * AppState.text-scale;
                font-weight: 600;
            }

            // From just under the top line and edge to edge, over the label: a Flickable clips at
            // its own bounds, so the focused cover's glow (AppState.glow-reach) needs room above
            // and beside the covers inside it. The covers stay where the label's spacing puts them.
            strip-fl := Flickable {
                // Where the covers start: below the label (or lower for a wide glow), and far enough
                // from the left for the glow (a cover sits 10px inside its 124px card).
                property <length> cover-top: root.strip-cover-top;
                property <length> side: max(16px, ceil(AppState.glow-reach / 1px) * 1px - (124px - root.strip-card) / 2);
                x: 0;
                y: 1px;
                width: parent.width;
                height: self.cover-top + root.strip-card + 4px + 51px * AppState.text-scale;
                content-width: max(self.width, strip-row.preferred-width);
                content-height: self.height;

                // The focused card centered (a card is 124px wide), clamped to the row's ends.
                property <length> kb-x: clamp(
                    self.width / 2 - (self.side + AppState.now-playing-strip-focused * root.strip-step + 62px),
                    min(0px, self.width - strip-row.preferred-width),
                    0px);
                changed kb-x => {
                    strip-fl.content-x = kb-x;
                }
                animate content-x {
                    duration: 150ms * AppState.settings-scroll-speed;
                    easing: ease-out-expo;
                }

                strip-row := HorizontalLayout {
                    padding-left: strip-fl.side;
                    padding-right: strip-fl.side;
                    padding-top: strip-fl.cover-top;
                    spacing: root.strip-step - 124px;
                    alignment: start;

                    for entry[i] in AppState.queue-items: chip-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        width: 124px;
                            // The focused card over its neighbours: a strong glow reaches past the gap.
                            z: !AppState.now-playing-back-focused && AppState.now-playing-in-strip && i == AppState.now-playing-strip-focused ? 1 : 0;
                        clicked => {
                            AppState.queue-jump(entry.index);
                        }

                        VerticalLayout {
                            spacing: 4px;
                                // The glow holder (FocusGlow); the cover inside it is clipped, its ring over the picture.
                                FocusGlow {
                                width: root.strip-card;
                                height: root.strip-card;
                                x: (parent.width - self.width) / 2;
                                chip-pulse := PressPulse {
                                    trigger: AppState.kb-activate-pulse;
                                    active: !AppState.now-playing-back-focused && AppState.now-playing-in-strip && i == AppState.now-playing-strip-focused;
                                }

                                radius: Theme.radius;
                                glowing: !AppState.now-playing-back-focused && AppState.now-playing-in-strip && i == AppState.now-playing-strip-focused;

                                Rectangle {
                                    border-radius: Theme.radius;
                                    background: Theme.surface-overlay;
                                    border-width: AppState.glow-ring-width(!AppState.now-playing-back-focused && AppState.now-playing-in-strip && i == AppState.now-playing-strip-focused, chip-ta.pressed || chip-pulse.pulsing);
                                    border-color: AppState.focus-color;
                                    clip: true;
                                    animate border-width {
                                        duration: 90ms * AppState.settings-animation-speed;
                                        easing: ease-out-expo;
                                    }

                                    if entry.has-poster: Image {
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: cover;
                                        source: entry.poster;
                                    }
                                    if !entry.has-poster: Text {
                                        text: "♫";
                                        font-family: "Noto Sans Symbols 2";
                                        color: Theme.text-subtle;
                                        font-size: 30px * AppState.text-scale;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }

                            // The title on up to two lines, then "…"; the artist only when there is
                                // one (the playing one in the accent colour).
                                Text {
                                text: entry.title;
                                color: entry.is-current ? Theme.accent : Theme.text;
                                font-size: 13px * AppState.text-scale;
                                font-weight: entry.is-current ? 700 : 600;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                                overflow: elide;
                                    // Two lines at most (max-height alone loses to a wrapped text's
                                    // minimum height, which is all of it).
                                    height: min(self.preferred-height, 34px * AppState.text-scale);
                            }

                            if entry.artist != "": Text {
                                text: entry.artist;
                                color: Theme.text-muted;
                                font-size: 12px * AppState.text-scale;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
