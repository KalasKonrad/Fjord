// ── fjord-app · context_menu.slint ───────────────────────────────────────────
//   DiscoverMenuRow  file-local reusable row (icon+label, focus ring, press-pulse — same
//                    chrome as the 8 Jellyfin rows below, extracted since the Discover
//                    row family below has 5 near-identical rows); row-index picks which
//                    context-menu-focused value activates it; activated() callback
//   ContextMenu      overlay, entirely different row family depending on
//                    context-menu-item-type (is-discover-item): Jellyfin cards get the
//                    original 8-row set (Resume if resume-pct>0, Play from Start, Play
//                    Next, Add to Queue, Mark Played/Unplayed, Favourite/Unfavourite,
//                    View Details, Add to Playlist row 7 Audio/MusicAlbum only) PLUS a 9th,
//                    Watchlist row 8 (2026-07-19, real gap live-reported — "you cant add
//                    anyting from the library to the watchlist": an already-in-library
//                    item redirects straight to THIS menu family, which never had a
//                    Watchlist row before), gated on a resolvable TMDB provider id
//                    (Movie/Series only, resolved by context_menu.rs::
//                    resolve_tmdb_for_jellyfin_item) AND seerr-connected — reuses
//                    discover_toggle_watchlist (discover.rs) verbatim, the identical
//                    function the Discover-card menu's own Watchlist row calls; Discover
//                    cards (search grid/6 landing rows, 2026-07-18) get View Details(0),
//                    Request(1, not yet requested) OR Edit Request(1, requested+(mine||
//                    admin) — the two never coexist so share an index), Cancel Request(2,
//                    requested+(admin||(mine&&pending))), Approve(3)/Decline(4, requested+
//                    admin) — mirrors Seerr's real per-endpoint permission checks, not a
//                    blanket "pending" gate (PUT/approve/decline need no pending status,
//                    only a non-admin's own DELETE does), Watchlist toggle(6, 2026-07-18,
//                    always visible — unlike Request/Edit/Cancel/Approve/Decline this isn't
//                    gated on request state at all) — fixed index scheme,
//                    existing_discover_menu_rows() in context_menu.rs resolves which
//                    indices exist for Up/Down looping, same "gaps are fine" idiom the
//                    Jellyfin row 0 (Resume) already uses. **These 4 `if` conditions must
//                    stay in lockstep with existing_discover_menu_rows()'s own logic by
//                    hand — real bug, live-reported 2026-07-18: the Rust-side row-index
//                    resolver was fixed to the real permission model but this file's own
//                    separately-written conditions were never touched in that pass, so
//                    keyboard Up/Down could reach a row (e.g. Cancel Request, via the
//                    Rust-only index list) that never actually rendered — the menu looked
//                    unchanged while the underlying focus silently pointed at nothing.**
//                    Blocklist toggle(7, 2026-08-06, Seerr Blocklist support) — gated on
//                    seerr-can-manage-blocklist (a genuinely separate permission from
//                    admin/MANAGE_REQUESTS) AND the item being untouched or already
//                    blocklisted, mirroring Seerr's own real UI gate; same lockstep-by-hand
//                    warning as rows 0-6 above applies to this 5th `if` condition too.
//                    triggered by C key or right-click on any card
//                    keyboard: Up/Down loop; Enter confirms; Esc closes
//   PlaylistPicker  add-to-playlist modal: + New playlist… (name input) + playlist list;
//                   cursor 0 = new row, 1..N = items; keyboard in keys.rs handle_playlist_picker
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import { PressPulse, QwertyKeyboard } from "widgets.slint";

component DiscoverMenuRow inherits Rectangle {
    in property <string> icon-text;
    in property <string> icon-font-family: ""; // "" = system default (matches ASCII/ℹ rows below)
    in property <string> label;
    in property <int>    row-index;
    callback activated();

    height: 44px;
    border-radius: Theme.radius;
    background: AppState.context-menu-focused == row-index ? Theme.accent-muted : transparent;
    border-width: (ta.pressed || pulse.pulsing) ? 3px : 0px;
    border-color: Theme.focus-border;
    animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
    pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.context-menu-focused == row-index; }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 10px;
        alignment: start;
        Text {
            text:        root.icon-text;
            font-family: root.icon-font-family;
            color:       AppState.context-menu-focused == row-index ? Theme.accent : Theme.text-muted;
            font-size:   14px; vertical-alignment: center; width: 18px;
        }
        Text {
            text:      root.label;
            color:     AppState.context-menu-focused == row-index ? Theme.text : Theme.text-muted;
            font-size: 14px; vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.activated(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.move { AppState.context-menu-focused = row-index; }
        }
    }
}

export component ContextMenu inherits Rectangle {
    background: #00000088;
    property <bool> is-discover-item:
        AppState.context-menu-item-type == "DiscoverMovie" || AppState.context-menu-item-type == "DiscoverTv";

    // Close on backdrop click
    TouchArea {
        width: parent.width; height: parent.height;
        clicked => { AppState.show-context-menu = false; }
    }

    // Menu box — centred
    Rectangle {
        x: (parent.width  - self.width)  / 2;
        y: (parent.height - self.height) / 2;
        width:         240px;
        height:        menu-layout.preferred-height + 16px;
        border-radius: Theme.radius-lg;
        background:    Theme.surface-raised;
        border-width:  1px;
        border-color:  Theme.border-strong;
        drop-shadow-blur:     20px;
        drop-shadow-color:    #000000aa;
        drop-shadow-offset-y: 6px;

        // Stop backdrop click from propagating through the box
        TouchArea { width: parent.width; height: parent.height; }

        menu-layout := VerticalLayout {
            x: 0; y: 8px;
            width: parent.width;
            spacing: 2px;
            padding-left:  8px;
            padding-right: 8px;

            if !root.is-discover-item: VerticalLayout {
            spacing: 2px;
            // Row 0 — Resume (only when there is a saved position)
            if AppState.context-menu-resume-pct > 0 && !AppState.context-menu-has-played: Rectangle {
                height: 44px;
                border-radius: Theme.radius;
                background: AppState.context-menu-focused == 0 ? Theme.accent-muted : transparent;
                border-width:  (ta0.pressed || pulse0.pulsing) ? 3px : 0px;
                border-color:  Theme.focus-border;
                animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                pulse0 := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.context-menu-focused == 0; }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                    alignment: start;
                    Text {
                        text: "⏵";
                        font-family: "Noto Sans Symbols 2";
                        color: AppState.context-menu-focused == 0 ? Theme.accent : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center; width: 18px;
                    }
                    Text {
                        text: "Resume";
                        color: AppState.context-menu-focused == 0 ? Theme.text : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center;
                    }
                }
                ta0 := TouchArea {
                    clicked => {
                        AppState.item-play(AppState.context-menu-item-id);
                        AppState.show-context-menu = false;
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.move { AppState.context-menu-focused = 0; }
                    }
                }
            }

            // Row 1 — Play from Start (not applicable to a Season — no
            // /Videos/{id}/stream for a season, only its episodes; gated
            // out 2026-08-12 alongside rows 2/3, matching the Rust-side
            // existing_jellyfin_menu_rows exclusion — see its own comment)
            if AppState.context-menu-item-type != "Season": Rectangle {
                height: 44px;
                border-radius: Theme.radius;
                background: AppState.context-menu-focused == 1 ? Theme.accent-muted : transparent;
                border-width:  (ta1.pressed || pulse1.pulsing) ? 3px : 0px;
                border-color:  Theme.focus-border;
                animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                pulse1 := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.context-menu-focused == 1; }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                    alignment: start;
                    Text {
                        text: "▶";
                        font-family: "Noto Sans Symbols 2";
                        color: AppState.context-menu-focused == 1 ? Theme.accent : Theme.text-muted;
                        font-size: 12px; vertical-alignment: center; width: 18px;
                    }
                    Text {
                        text: "Play from Start";
                        color: AppState.context-menu-focused == 1 ? Theme.text : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center;
                    }
                }
                ta1 := TouchArea {
                    clicked => {
                        AppState.context-play-from-start(AppState.context-menu-item-id);
                        AppState.show-context-menu = false;
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.move { AppState.context-menu-focused = 1; }
                    }
                }
            }

            // Row 2 — Play Next (insert at front of queue; not applicable to
            // a Season, see row 1's comment)
            if AppState.context-menu-item-type != "Season": Rectangle {
                height: 44px;
                border-radius: Theme.radius;
                background: AppState.context-menu-focused == 2 ? Theme.accent-muted : transparent;
                border-width:  (ta2.pressed || pulse2.pulsing) ? 3px : 0px;
                border-color:  Theme.focus-border;
                animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                pulse2 := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.context-menu-focused == 2; }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                    alignment: start;
                    Text {
                        text: "⏭";
                        font-family: "Noto Sans Symbols 2";
                        color: AppState.context-menu-focused == 2 ? Theme.accent : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center; width: 18px;
                    }
                    Text {
                        text: "Play Next";
                        color: AppState.context-menu-focused == 2 ? Theme.text : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center;
                    }
                }
                ta2 := TouchArea {
                    clicked => {
                        AppState.queue-play-next-item();
                        AppState.show-context-menu = false;
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.move { AppState.context-menu-focused = 2; }
                    }
                }
            }

            // Row 3 — Add to Queue (append to back; not applicable to a
            // Season, see row 1's comment)
            if AppState.context-menu-item-type != "Season": Rectangle {
                height: 44px;
                border-radius: Theme.radius;
                background: AppState.context-menu-focused == 3 ? Theme.accent-muted : transparent;
                border-width:  (ta3.pressed || pulse3.pulsing) ? 3px : 0px;
                border-color:  Theme.focus-border;
                animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                pulse3 := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.context-menu-focused == 3; }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                    alignment: start;
                    Text {
                        text: "+";
                        color: AppState.context-menu-focused == 3 ? Theme.accent : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center; width: 18px;
                    }
                    Text {
                        text: "Add to Queue";
                        color: AppState.context-menu-focused == 3 ? Theme.text : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center;
                    }
                }
                ta3 := TouchArea {
                    clicked => {
                        AppState.queue-add-item();
                        AppState.show-context-menu = false;
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.move { AppState.context-menu-focused = 3; }
                    }
                }
            }

            // Row 4 — Mark Played / Unplayed
            Rectangle {
                height: 44px;
                border-radius: Theme.radius;
                background: AppState.context-menu-focused == 4 ? Theme.accent-muted : transparent;
                border-width:  (ta4.pressed || pulse4.pulsing) ? 3px : 0px;
                border-color:  Theme.focus-border;
                animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                pulse4 := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.context-menu-focused == 4; }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                    alignment: start;
                    Text {
                        text: AppState.context-menu-has-played ? "✓" : "○";
                        // ✓ is hard-pinned to Adwaita Sans (matches IconCircleButton's own ✓/♥
                        // rule); ○ isn't one of the two pinned glyphs, so it uses the ordinary
                        // Noto Sans Symbols2 fallback.
                        font-family: AppState.context-menu-has-played ? "Adwaita Sans" : "Noto Sans Symbols 2";
                        color: AppState.context-menu-focused == 4 ? Theme.accent : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center; width: 18px;
                    }
                    Text {
                        text: AppState.context-menu-has-played ? "Mark as Unplayed" : "Mark as Played";
                        color: AppState.context-menu-focused == 4 ? Theme.text : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center;
                    }
                }
                ta4 := TouchArea {
                    clicked => {
                        AppState.context-mark-played(AppState.context-menu-item-id, AppState.context-menu-has-played);
                        AppState.show-context-menu = false;
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.move { AppState.context-menu-focused = 4; }
                    }
                }
            }

            // Row 5 — Favourite / Unfavourite
            Rectangle {
                height: 44px;
                border-radius: Theme.radius;
                background: AppState.context-menu-focused == 5 ? Theme.accent-muted : transparent;
                border-width:  (ta5.pressed || pulse5.pulsing) ? 3px : 0px;
                border-color:  Theme.focus-border;
                animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                pulse5 := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.context-menu-focused == 5; }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                    alignment: start;
                    Text {
                        text: AppState.context-menu-is-favorite ? "♥" : "♡";
                        // ♥ is hard-pinned to Adwaita Sans; ♡ isn't one of the two pinned
                        // glyphs, so it uses the ordinary Noto Sans Symbols2 fallback.
                        font-family: AppState.context-menu-is-favorite ? "Adwaita Sans" : "Noto Sans Symbols 2";
                        color: AppState.context-menu-focused == 5 ? Theme.accent : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center; width: 18px;
                    }
                    Text {
                        text: AppState.context-menu-is-favorite ? "Remove from Favourites" : "Add to Favourites";
                        color: AppState.context-menu-focused == 5 ? Theme.text : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center;
                    }
                }
                ta5 := TouchArea {
                    clicked => {
                        AppState.context-toggle-fav(AppState.context-menu-item-id, AppState.context-menu-is-favorite);
                        AppState.show-context-menu = false;
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.move { AppState.context-menu-focused = 5; }
                    }
                }
            }

            // Row 6 — View Details
            Rectangle {
                height: 44px;
                border-radius: Theme.radius;
                background: AppState.context-menu-focused == 6 ? Theme.accent-muted : transparent;
                border-width:  (ta6.pressed || pulse6.pulsing) ? 3px : 0px;
                border-color:  Theme.focus-border;
                animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                pulse6 := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.context-menu-focused == 6; }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                    alignment: start;
                    Text {
                        text: "ℹ";
                        color: AppState.context-menu-focused == 6 ? Theme.accent : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center; width: 18px;
                    }
                    Text {
                        text: "View Details";
                        color: AppState.context-menu-focused == 6 ? Theme.text : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center;
                    }
                }
                ta6 := TouchArea {
                    clicked => {
                        // "Season" is a genuinely separate screen/callback
                        // (season.rs::open_season_screen, keyed by
                        // season-id + series-id — DetailPage has no concept
                        // of a season) rather than routing through the
                        // generic open-detail(id, item-type) path every
                        // other item type uses. Added 2026-08-12 for the
                        // season-tab context menu's View Details row.
                        if AppState.context-menu-item-type == "Season" {
                            AppState.open-season-detail(AppState.context-menu-item-id, AppState.context-menu-series-id);
                        } else {
                            AppState.open-detail(AppState.context-menu-item-id, AppState.context-menu-item-type);
                        }
                        AppState.show-context-menu = false;
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.move { AppState.context-menu-focused = 6; }
                    }
                }
            }

            // Row 7 — Add to Playlist (music items only)
            if AppState.context-menu-item-type == "Audio" || AppState.context-menu-item-type == "MusicAlbum": Rectangle {
                height: 44px;
                border-radius: Theme.radius;
                background: AppState.context-menu-focused == 7 ? Theme.accent-muted : transparent;
                border-width:  (ta7.pressed || pulse7.pulsing) ? 3px : 0px;
                border-color:  Theme.focus-border;
                animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                pulse7 := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.context-menu-focused == 7; }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                    alignment: start;
                    Text {
                        text: "≡";
                        font-family: "Noto Sans Symbols 2";
                        color: AppState.context-menu-focused == 7 ? Theme.accent : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center; width: 18px;
                    }
                    Text {
                        text: "Add to Playlist";
                        color: AppState.context-menu-focused == 7 ? Theme.text : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center;
                    }
                }
                ta7 := TouchArea {
                    clicked => {
                        AppState.open-playlist-picker();
                        AppState.show-context-menu = false;
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.move { AppState.context-menu-focused = 7; }
                    }
                }
            }

            // Row 8 — Watchlist (2026-07-19, real gap live-reported: "you
            // cant add anyting from the library to the watchlist" — an
            // already-in-library item redirects straight to THIS Jellyfin-
            // flavored menu, which never had a Watchlist row at all before).
            // Gated on context-menu-jf-tmdb-id being resolvable (Movie/
            // Series with a real TMDB provider id, resolved server-side by
            // open_context_menu_state) AND seerr-connected — same "☆"/"★"
            // glyphs as the Discover menu's own Watchlist row, reuses
            // context-menu-on-watchlist for the label/icon state too.
            // **This condition must stay in lockstep with
            // context_menu.rs::existing_jellyfin_menu_rows()'s own row-8
            // check by hand** — the exact same two-copies-of-one-rule risk
            // that already caused a real bug once for the Discover menu
            // family above (see its own header comment) — there is no
            // shared source of truth between the two files.
            if AppState.context-menu-jf-tmdb-id != "" && AppState.seerr-connected: Rectangle {
                height: 44px;
                border-radius: Theme.radius;
                background: AppState.context-menu-focused == 8 ? Theme.accent-muted : transparent;
                border-width:  (ta8.pressed || pulse8.pulsing) ? 3px : 0px;
                border-color:  Theme.focus-border;
                animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                pulse8 := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.context-menu-focused == 8; }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                    alignment: start;
                    Text {
                        text: AppState.context-menu-on-watchlist ? "★" : "☆";
                        color: AppState.context-menu-focused == 8 ? Theme.accent : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center; width: 18px;
                    }
                    Text {
                        text: AppState.context-menu-on-watchlist ? "Remove from Watchlist" : "Add to Watchlist";
                        color: AppState.context-menu-focused == 8 ? Theme.text : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center;
                    }
                }
                ta8 := TouchArea {
                    clicked => {
                        AppState.context-menu-focused = 8;
                        AppState.context-jf-toggle-watchlist();
                        AppState.show-context-menu = false;
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.move { AppState.context-menu-focused = 8; }
                    }
                }
            }
            } // end !is-discover-item

            // ── Discover row family (2026-07-18) — see this file's own
            // header comment for the full index scheme.
            if root.is-discover-item: VerticalLayout {
                spacing: 2px;

                DiscoverMenuRow {
                    row-index: 0;
                    icon-text: "ℹ"; // matches the Jellyfin "View Details" row's own icon/font choice above
                    label: "View Details";
                    activated => { AppState.context-discover-view-details(); }
                }
                // View Request (2026-07-18, row-index 5 — see this file's own
                // header comment for why the numeric index is highest despite
                // being visually/traversal-order second): only shown once a
                // request exists. Reuses View Details' own "ℹ" glyph rather
                // than introducing a new one — same reuse-an-existing-icon-
                // for-a-related-action precedent as Cancel/Decline sharing
                // "✕" below.
                if AppState.context-menu-request-id != "": DiscoverMenuRow {
                    row-index: 5;
                    icon-text: "ℹ";
                    label: "View Request";
                    activated => { AppState.context-discover-view-request(); }
                }
                if AppState.context-menu-request-id == "": DiscoverMenuRow {
                    row-index: 1;
                    icon-text: "+";
                    label: "Request";
                    activated => { AppState.context-discover-request(); }
                }
                if AppState.context-menu-request-id != "" && (AppState.context-menu-request-mine || AppState.seerr-is-admin): DiscoverMenuRow {
                    row-index: 1;
                    icon-text: "✎";
                    icon-font-family: "Noto Sans Symbols 2";
                    label: "Edit Request";
                    activated => { AppState.context-discover-edit-request(); }
                }
                if AppState.context-menu-request-id != "" && (AppState.seerr-is-admin || (AppState.context-menu-request-mine && AppState.context-menu-request-pending)): DiscoverMenuRow {
                    row-index: 2;
                    icon-text: "✕";
                    icon-font-family: "Noto Sans Symbols 2";
                    label: "Cancel Request";
                    activated => { AppState.context-discover-cancel-request(); }
                }
                if AppState.context-menu-request-id != "" && AppState.seerr-is-admin: DiscoverMenuRow {
                    row-index: 3;
                    icon-text: "✓";
                    icon-font-family: "Adwaita Sans";
                    label: "Approve";
                    activated => { AppState.context-discover-approve-request(); }
                }
                if AppState.context-menu-request-id != "" && AppState.seerr-is-admin: DiscoverMenuRow {
                    row-index: 4;
                    icon-text: "✕";
                    icon-font-family: "Noto Sans Symbols 2";
                    label: "Decline";
                    activated => { AppState.context-discover-decline-request(); }
                }
                // Watchlist (2026-07-18) — row-index 6, appended after the
                // existing 0-5 scheme rather than renumbering (same
                // append-don't-insert reasoning as every other row-index
                // choice in this file). Always visible, unlike Request —
                // watchlisting isn't gated on availability. "☆"/"★"
                // (outline/filled, both confirmed covered by Noto Sans
                // Symbols2 via fc-query) toggle with on-watchlist state,
                // matching the label.
                DiscoverMenuRow {
                    row-index: 6;
                    icon-text: AppState.context-menu-on-watchlist ? "★" : "☆";
                    icon-font-family: "Noto Sans Symbols 2";
                    label: AppState.context-menu-on-watchlist ? "Remove from Watchlist" : "Add to Watchlist";
                    activated => { AppState.context-discover-toggle-watchlist(); }
                }
                // Blocklist (2026-08-06, Seerr Blocklist support) — row-index
                // 7, same append-don't-insert reasoning as Watchlist above.
                // Gated on seerr-can-manage-blocklist (a permission
                // genuinely separate from admin/MANAGE_REQUESTS) AND the
                // item being untouched or already blocklisted — mirrors
                // Seerr's own real UI gate (never shown for Requested/
                // Processing/Partial/Available). Must be kept in lockstep
                // by hand with existing_discover_menu_rows's own copy of
                // this same condition (context_menu.rs) — no shared source
                // of truth between the two files, see that function's own
                // warning.
                if AppState.seerr-can-manage-blocklist
                        && (AppState.context-menu-availability == "" || AppState.context-menu-availability == "blocklisted"):
                    DiscoverMenuRow {
                        row-index: 7;
                        icon-text: AppState.context-menu-availability == "blocklisted" ? "✕" : "⛔";
                        icon-font-family: "Noto Sans Symbols 2";
                        label: AppState.context-menu-availability == "blocklisted" ? "Remove from Blocklist" : "Add to Blocklist";
                        activated => { AppState.context-discover-toggle-blocklist(); }
                    }
            }
        }
    }
}

// ── PlaylistPicker ────────────────────────────────────────────────────────────
// "Add to Playlist" modal: row 0 = + New playlist… (turns into a name input),
// then the existing audio playlists. Cursor semantics: 0 = new row,
// 1..N = playlist-picker-items[cursor-1]. Keyboard handled in keys.rs
// (handle_playlist_picker); mouse clicks rows directly.
export component PlaylistPicker inherits Rectangle {
    background: #00000088;

    // Close on backdrop click. Real gap, code review, 2026-08-23: a mouse
    // close while the on-screen keyboard was still open (naming mode)
    // would have left show-onscreen-keyboard stuck true, the same
    // critical-lockout bug class already found and fixed once for
    // LoginScreen — checked here specifically (not blindly cleared) so a
    // coincidentally-mounted OTHER screen's own keyboard interaction is
    // never stomped on.
    TouchArea {
        width: parent.width; height: parent.height;
        clicked => {
            AppState.show-playlist-picker = false;
            if AppState.onscreen-keyboard-target == "playlist-picker-name" {
                AppState.show-onscreen-keyboard = false;
            }
        }
    }

    dialog := Rectangle {
        x: (parent.width  - self.width)  / 2;
        y: (parent.height - self.height) / 2;
        width:         320px;
        height:        head-h + new-h + 1px + list-h + 16px;
        border-radius: Theme.radius-lg;
        background:    Theme.surface-raised;
        border-width:  1px;
        border-color:  Theme.border-strong;
        drop-shadow-blur:     20px;
        drop-shadow-color:    #000000aa;
        drop-shadow-offset-y: 6px;

        property <length> head-h: 30px;
        property <length> new-h:  44px;
        property <length> row-h:  48px;
        property <length> list-h: min(5 * row-h, AppState.playlist-picker-items.length * row-h);
        // Keep the cursor row visible (kb-y pattern — no viewport-y binding).
        property <length> kb-y: clamp(
            -(AppState.playlist-picker-cursor - 1) * row-h + list-h / 2 - row-h / 2,
            min(0px, list-h - AppState.playlist-picker-items.length * row-h),
            0px);
        changed kb-y => { fl.viewport-y = self.kb-y; }

        // Stop backdrop click from propagating through the box
        TouchArea { width: parent.width; height: parent.height; }

        VerticalLayout {
            x: 0; y: 8px;
            width: parent.width;
            padding-left:  8px;
            padding-right: 8px;

            Text {
                text:               "ADD TO PLAYLIST";
                color:              Theme.text-muted;
                font-size:          11px;
                height:             head-h;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            // Row 0 — + New playlist… / name input
            Rectangle {
                height:        new-h;
                border-radius: Theme.radius;
                background:    AppState.playlist-picker-cursor == 0 ? Theme.accent-muted : (new-ta.has-hover ? Theme.surface : transparent);
                border-width:  (new-ta.pressed || new-pulse.pulsing) ? 3px : 0px;
                border-color:  Theme.focus-border;
                animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                new-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.playlist-picker-cursor == 0; }
                if !AppState.playlist-picker-naming: HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                    alignment: start;
                    Text {
                        text: "+";
                        color: AppState.playlist-picker-cursor == 0 ? Theme.accent : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center; width: 18px;
                    }
                    Text {
                        text: "New playlist…";
                        color: AppState.playlist-picker-cursor == 0 ? Theme.text : Theme.text-muted;
                        font-size: 14px; vertical-alignment: center;
                    }
                }
                if AppState.playlist-picker-naming: HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Name:";
                        color: Theme.text-muted;
                        font-size: 13px; vertical-alignment: center;
                    }
                    Text {
                        text: AppState.playlist-picker-name + "|";
                        color: Theme.text;
                        font-size: 14px; vertical-alignment: center;
                        overflow: elide;
                    }
                }
                new-ta := TouchArea {
                    clicked => {
                        AppState.playlist-picker-cursor = 0;
                        if !AppState.playlist-picker-naming {
                            AppState.playlist-picker-name   = "";
                            AppState.playlist-picker-naming = true;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border; }

            fl := Flickable {
                height:          list-h;
                viewport-height: AppState.playlist-picker-items.length * row-h;
                VerticalLayout {
                    alignment: start;
                    for p[i] in AppState.playlist-picker-items: Rectangle {
                        height:        row-h;
                        border-radius: Theme.radius;
                        background:    AppState.playlist-picker-cursor == i + 1 ? Theme.accent-muted : (p-ta.has-hover ? Theme.surface : transparent);
                        border-width:  (p-ta.pressed || p-pulse.pulsing) ? 3px : 0px;
                        border-color:  Theme.focus-border;
                        animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
                        p-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: AppState.playlist-picker-cursor == i + 1; }
                        p-ta := TouchArea {
                            clicked => { AppState.playlist-picker-select(i); }
                        }
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            VerticalLayout {
                                alignment: center;
                                spacing:   2px;
                                Text {
                                    text:      p.title;
                                    color:     AppState.playlist-picker-cursor == i + 1 ? Theme.text : Theme.text-muted;
                                    font-size: 14px;
                                    overflow:  elide;
                                }
                                if p.subtitle != "": Text {
                                    text:      p.subtitle;
                                    color:     Theme.text-subtle;
                                    font-size: 11px;
                                    overflow:  elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // On-screen alphanumeric keyboard (2026-08-23, full rollout beyond
    // Login). Target-guarded (not just show-onscreen-keyboard alone) the
    // same way Discover/Browse are — PlaylistPicker is reachable as an
    // overlay from either of those screens' own grids, both of which now
    // have their own keyboard interaction too, so this and their trackers
    // must never fire for a different screen's field.
    if AppState.show-onscreen-keyboard && AppState.settings-onscreen-keyboard-enabled && AppState.onscreen-keyboard-target == "playlist-picker-name": QwertyKeyboard {
        x: (parent.width - self.width) / 2;
        // Anchored below the dialog itself, not window-centered (real
        // reasoning, not copied from Discover/Browse/Library-search
        // unchecked, 2026-08-25): this dialog is ITSELF roughly centered
        // in the window, with its own naming input near ITS top — a
        // window-centered keyboard would land almost exactly on top of the
        // dialog's own vertical range instead of clearing it. Matches
        // Login/ConnectSeerr's own "anchor below the card" precedent,
        // clamped so it can't render off the bottom of a short window.
        y: min(dialog.y + dialog.height + 16px, parent.height - self.height - 16px);
        cursor: AppState.onscreen-keyboard-cursor;
        active: AppState.show-onscreen-keyboard;
        key-pressed(k) => {
            if k == "done" { AppState.show-onscreen-keyboard = false; }
            else if k == "backspace" { AppState.playlist-picker-name-backspace(); }
            else { AppState.playlist-picker-name-append(k); }
        }
    }

    property <int> _physical-key-mirror: AppState.onscreen-keyboard-physical-key-seq;
    changed _physical-key-mirror => {
        if AppState.show-onscreen-keyboard && AppState.onscreen-keyboard-target == "playlist-picker-name" {
            if AppState.onscreen-keyboard-physical-key == "backspace" { AppState.playlist-picker-name-backspace(); }
            else { AppState.playlist-picker-name-append(AppState.onscreen-keyboard-physical-key); }
        }
    }
}
