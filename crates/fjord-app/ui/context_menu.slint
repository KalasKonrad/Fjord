// ── fjord-app · context_menu.slint ───────────────────────────────────────────
//   MenuRowItem      one menu row (icon + label, focus ring, press pulse; hover moves the focus)
//   ContextMenu      overlay (C key or right-click on a card): one `for` over AppState.context-
//                    menu-rows() — context_menu.rs menu_rows builds them (Jellyfin or Discover
//                    family, ids with gaps, View Details last; see existing_*_menu_rows), and a
//                    click runs context-menu-activate(id), the same Rust function as Enter.
//                    Keyboard: Up/Down loop, Enter confirms, Esc closes; focus starts on the
//                    first row.
//   PlaylistPicker   add-to-playlist modal: row 0 "+ New playlist…" (turns into a name input),
//                    then the audio playlists (cursor 1..N = items[cursor-1]); keyboard in
//                    keys.rs's handle_playlist_picker; on-screen keyboard docked below it
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import { FocusHalo, PressPulse, QwertyKeyboard } from "widgets.slint";

component MenuRowItem inherits Rectangle {
    in property <string> icon-text;
    in property <string> icon-font-family: ""; // "" = the text font (ASCII and glyphs it covers)
    in property <string> label;
    in property <int> row-index;
    callback activated();

    height: 44px;
    border-radius: Theme.radius;
    background: AppState.context-menu-focused == row-index ? Theme.accent-muted : transparent;
    border-width: AppState.ring-width(pulse.active, ta.pressed || pulse.pulsing);
    border-color: AppState.focus-color;
    animate border-width {
        duration: 90ms * AppState.settings-animation-speed;
        easing: ease-out-expo;
    }
    FocusHalo {
        glowing: pulse.active;
        radius: Theme.radius;
    }

    pulse := PressPulse {
        trigger: AppState.kb-activate-pulse;
        active: AppState.context-menu-focused == row-index;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;
        Text {
            text: root.icon-text;
            font-family: root.icon-font-family;
            color: AppState.context-menu-focused == row-index ? Theme.accent : Theme.text-muted;
            font-size: 14px * AppState.text-scale;
            vertical-alignment: center;
            width: 18px * AppState.text-scale;
        }

        Text {
            text: root.label;
            color: AppState.context-menu-focused == row-index ? Theme.text : Theme.text-muted;
            font-size: 14px * AppState.text-scale;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.move { AppState.context-menu-focused = row-index; }
        }
    }
}

export component ContextMenu inherits Rectangle {
    background: Theme.scrim;
    // Close on backdrop click
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { AppState.show-context-menu = false; }
    }

    // Menu box — centred
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 240px * AppState.text-scale;
        height: menu-layout.preferred-height + 16px;
        border-radius: Theme.radius-lg;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 20px;
        drop-shadow-color: Theme.shadow-strong;
        drop-shadow-offset-y: 6px;

        // Stop backdrop click from propagating through the box
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        menu-layout := VerticalLayout {
            x: 0;
            y: 8px;
            width: parent.width;
            spacing: 2px;
            padding-left: 8px;
            padding-right: 8px;

            // Rows from context_menu.rs menu_rows (both families: Jellyfin and Discover) — the same
            // list Up/Down walk; a click runs the row through Rust's activate, like Enter.
            for row in AppState.context-menu-rows(): MenuRowItem {
                row-index: row.id;
                icon-text: row.icon;
                icon-font-family: row.icon-font;
                label: row.label;
                activated => { AppState.context-menu-activate(row.id); }
            }
        }
    }
}

// ── PlaylistPicker ────────────────────────────────────────────────────────────
// "Add to Playlist" modal: row 0 = + New playlist… (turns into a name input),
// then the existing audio playlists. Cursor semantics: 0 = new row,
// 1..N = playlist-picker-items[cursor-1]. Keyboard handled in keys.rs
// (handle_playlist_picker); mouse clicks rows directly.
export component PlaylistPicker inherits Rectangle {
    background: Theme.scrim;

    // Close on backdrop click — and close the on-screen keyboard if it's this picker's (a stray
    // show-onscreen-keyboard swallows all input); another screen's keyboard is left alone.
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            AppState.show-playlist-picker = false;
            if AppState.onscreen-keyboard-target == "playlist-picker-name" {
                AppState.show-onscreen-keyboard = false;
            }
        }
    }

    dialog := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 320px;
        height: head-h + new-h + 1px + list-h + 16px;
        border-radius: Theme.radius-lg;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 20px;
        drop-shadow-color: Theme.shadow-strong;
        drop-shadow-offset-y: 6px;

        property <length> head-h: 30px;
        property <length> new-h:  44px;
        property <length> row-h:  48px;
        property <length> list-h: min(5 * row-h, AppState.playlist-picker-items.length * row-h);
        // Keep the cursor row visible (kb-y pattern — no content-y binding).
        property <length> kb-y: clamp(
            -(AppState.playlist-picker-cursor - 1) * row-h + list-h / 2 - row-h / 2,
            min(0px, list-h - AppState.playlist-picker-items.length * row-h),
            0px);
        changed kb-y => { fl.content-y = self.kb-y; }

        // Stop backdrop click from propagating through the box
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        VerticalLayout {
            x: 0;
            y: 8px;
            width: parent.width;
            padding-left: 8px;
            padding-right: 8px;

            Text {
                text: "ADD TO PLAYLIST";
                color: Theme.text-muted;
                font-size: 11px * AppState.text-scale;
                height: head-h;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            // Row 0 — + New playlist… / name input
            Rectangle {
                height: new-h;
                border-radius: Theme.radius;
                background: AppState.playlist-picker-cursor == 0 ? Theme.accent-muted : (new-ta.has-hover ? Theme.surface : transparent);
                border-width: AppState.ring-width(new-pulse.active, new-ta.pressed || new-pulse.pulsing);
                border-color: AppState.focus-color;
                animate border-width {
                    duration: 90ms * AppState.settings-animation-speed;
                    easing: ease-out-expo;
                }
                FocusHalo {
                    glowing: new-pulse.active;
                    radius: Theme.radius;
                }

                new-pulse := PressPulse {
                    trigger: AppState.kb-activate-pulse;
                    active: AppState.playlist-picker-cursor == 0;
                }

                if !AppState.playlist-picker-naming: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: "+";
                        color: AppState.playlist-picker-cursor == 0 ? Theme.accent : Theme.text-muted;
                        font-size: 14px * AppState.text-scale;
                        vertical-alignment: center;
                        width: 18px * AppState.text-scale;
                    }

                    Text {
                        text: "New playlist…";
                        color: AppState.playlist-picker-cursor == 0 ? Theme.text : Theme.text-muted;
                        font-size: 14px * AppState.text-scale;
                        vertical-alignment: center;
                    }
                }
                if AppState.playlist-picker-naming: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Name:";
                        color: Theme.text-muted;
                        font-size: 13px * AppState.text-scale;
                        vertical-alignment: center;
                    }

                    Text {
                        text: AppState.caret-text(AppState.playlist-picker-name, AppState.playlist-picker-name-cursor, "|");
                        color: Theme.text;
                        font-size: 14px * AppState.text-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                new-ta := TouchArea {
                    clicked => {
                        AppState.playlist-picker-cursor = 0;
                        if !AppState.playlist-picker-naming {
                            AppState.playlist-picker-name = "";
                            AppState.playlist-picker-naming = true;
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            fl := Flickable {
                height: list-h;
                content-height: AppState.playlist-picker-items.length * row-h;
                VerticalLayout {
                    alignment: start;
                    for p[i] in AppState.playlist-picker-items: Rectangle {
                        height: row-h;
                        border-radius: Theme.radius;
                        background: AppState.playlist-picker-cursor == i + 1 ? Theme.accent-muted : (p-ta.has-hover ? Theme.surface : transparent);
                        border-width: AppState.ring-width(p-pulse.active, p-ta.pressed || p-pulse.pulsing);
                        border-color: AppState.focus-color;
                        animate border-width {
                            duration: 90ms * AppState.settings-animation-speed;
                            easing: ease-out-expo;
                        }
                        FocusHalo {
                            glowing: p-pulse.active;
                            radius: Theme.radius;
                        }

                        p-pulse := PressPulse {
                            trigger: AppState.kb-activate-pulse;
                            active: AppState.playlist-picker-cursor == i + 1;
                        }

                        p-ta := TouchArea {
                            clicked => { AppState.playlist-picker-select(i); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: p.title;
                                    color: AppState.playlist-picker-cursor == i + 1 ? Theme.text : Theme.text-muted;
                                    font-size: 14px * AppState.text-scale;
                                    overflow: elide;
                                }

                                if p.subtitle != "": Text {
                                    text: p.subtitle;
                                    color: Theme.text-subtle;
                                    font-size: 11px * AppState.text-scale;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // On-screen alphanumeric keyboard, target-guarded: the picker opens over Discover/Browse,
    // which have keyboard targets of their own.
    if AppState.show-onscreen-keyboard && AppState.settings-onscreen-keyboard-enabled && AppState.onscreen-keyboard-target == "playlist-picker-name": QwertyKeyboard {
        x: (parent.width - self.width) / 2;
        // Below the dialog, not window-centered (the dialog itself is centered with its name input
        // near its top), clamped to the window bottom — like Login/ConnectSeerr.
        y: min(dialog.y + dialog.height + 16px, parent.height - self.height - 16px);
        cursor: AppState.onscreen-keyboard-cursor;
        active: AppState.show-onscreen-keyboard;
        key-pressed(k) => {
            if k == "done" { AppState.show-onscreen-keyboard = false; }
            else if k == "backspace" { AppState.playlist-picker-name-backspace(); }
            else if k == "left" || k == "right" { AppState.text-field-caret("playlist-picker-name", k == "left" ? -1 : 1); }
            else { AppState.playlist-picker-name-append(k); }
        }
    }

    property <int> _physical-key-mirror: AppState.onscreen-keyboard-physical-key-seq;
    changed _physical-key-mirror => {
        if AppState.show-onscreen-keyboard && AppState.onscreen-keyboard-target == "playlist-picker-name" {
            if AppState.onscreen-keyboard-physical-key == "backspace" { AppState.playlist-picker-name-backspace(); }
            else { AppState.playlist-picker-name-append(AppState.onscreen-keyboard-physical-key); }
        }
    }
}
