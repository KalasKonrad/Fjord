// ── fjord-app · request_detail.slint ─────────────────────────────────────────
//   MetaRow                file-local label/value line for the Details panel (StatRow is sized
//                          for the stats overlay)
//   RequestDetailScreen    Seerr movie/TV detail, the shared detail-screen shape: full-bleed
//                          backdrop + gradient, floating "← Back", PosterBlock (with request-
//                          status badge), title column, Details panel (status/dates/language/
//                          countries/network/streaming — display only, no keyboard zone),
//                          StorylineSection, Cast & Crew (CastRow, TMDB photos). Mounted by a
//                          FadeGate in main.slint. Title column: a plain Rectangle fixed at
//                          PosterBlock's 240px, width from root.width (not parent.width — binding
//                          loop), button row pinned at a fixed y.
//                          Button row slots (request-detail-btn-focused, gaps allowed —
//                          discover/keys.rs existing_detail_btn_slots): 0 Request (a tier still
//                          requestable; 2K and 4K tracked independently, one pill per requested
//                          tier), 1 Trailer (greyed "Checking…"/"No trailer" until
//                          request-detail-trailer-state == "ok"), 2 ⋮ More (a request exists),
//                          3 Watchlist ★/☆ (always), 4 Blocklist.
//                          Keyboard: opens on the button row; Up reaches Back; request-detail-
//                          zone 0 = buttons, 1 = storyline, 2 = cast (existing_zones/
//                          handle_key_request_detail). Mouse clicks sync zone/back-focused.
//   RequestOptionsOverlay  modal from the Request button or the Discover context menu's
//                          Request/Edit Request: Quality 2K/4K pair (hidden while editing —
//                          Seerr can't change the tier), quality profile (radio chips, "Default"
//                          first), tag chips, season cards, Cancel/Request. Keyboard:
//                          request-options-zone 0 quality, 1 profile, 2 tags, 3 seasons,
//                          4 confirm (existing_option_zones/handle_key_request_options).
// ─────────────────────────────────────────────────────────────────────────────
import { Theme } from "theme.slint";
import { AppState } from "app_state.slint";
import {
    FjordButton,
    PosterBlock,
    MetaLine,
    PressPulse,
    CastRow,
    StorylineSection,
} from "widgets.slint";

// One label/value line in the Details panel below — file-local, not
// promoted to widgets.slint since nothing else needs this exact sizing
// (StatRow, widgets.slint's existing label/value row, is styled for the
// small dark stats overlay: 11px text, 60px label column, hardcoded
// colors — a poor fit for this larger, theme-colored panel).
component MetaRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    padding-top: 4px;
    padding-bottom: 4px;
    spacing: 16px;
    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: 14px;
        font-weight: 600;
        width: 160px;
        wrap: word-wrap;
        vertical-alignment: top;
    }

    Text {
        text: root.value;
        color: Theme.text;
        font-size: 14px;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

export component RequestDetailScreen inherits Rectangle {
    background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;

    property <bool> has-cast: AppState.request-detail-cast.length > 0;
    // Purely-display metadata panel (Status/dates/language/countries/
    // network/streaming) — no keyboard zone of its own, reached by
    // scrolling the page's existing Flickable like MetaLine's genre text
    // elsewhere in the app. Guarded so a sparse TMDB entry with none of
    // this data doesn't render an empty heading + divider for nothing.
    property <bool> has-details:
        AppState.request-detail-production-status != ""
        || AppState.request-detail-date-value != ""
        || AppState.request-detail-next-air-date != ""
        || AppState.request-detail-original-language != ""
        || AppState.request-detail-production-countries != ""
        || AppState.request-detail-network != ""
        || AppState.request-detail-providers.length > 0;

    fl := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: content.preferred-height;
        content-width: self.width;
        animate content-y {
            duration: 200ms * AppState.settings-scroll-speed;
            easing: ease-in-out;
        }

        content := VerticalLayout {

            // ── Header: backdrop image fills entire poster+text block ─────────
            // Same full-bleed-Image + gradient-overlay pattern as DetailPage/
            // SeasonScreen/CollectionScreen (see file header comment) —
            // deliberately NOT BackdropHero, which put the backdrop in its
            // own separate 300px band above plain background content.
            Rectangle {
                background: (AppState.video-behind-ui && AppState.has-background-player) ? transparent : Theme.bg;

                if AppState.request-detail-has-backdrop: Image {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                    source: AppState.request-detail-backdrop;
                }
                if AppState.request-detail-has-backdrop: Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    background: @linear-gradient(180deg, #00000080 0%, #000000cc 100%);
                }

                VerticalLayout {
                    HorizontalLayout {
                        padding-left: 48px;
                        padding-right: 48px;
                        padding-top: 68px;
                        padding-bottom: 24px;
                        spacing: 32px;
                        alignment: start;

                        // request-status: prefers the 4K label when both tiers
                    // have one (matching pick_primary_request's own tiebreak
                    // in discover.rs, for consistency), tier-prefixed only
                    // for 4K — mirrors MediaCard's own availability-pill
                    // wording convention exactly.
                    PosterBlock {
                            source: AppState.request-detail-poster;
                            has-image: AppState.request-detail-has-poster;
                            request-status: AppState.request-detail-status-4k != "" ? "4K " + AppState.request-detail-status-4k
                                : AppState.request-detail-status;
                        }

                        // A plain Rectangle fixed at 240px (PosterBlock's height): title/meta at the top, req-row
                        // pinned at `parent.height - 38px` (FjordButton is 38px) — neither depends on the other's
                        // size, so the buttons sit at a fixed y (same fix as detail.slint).
                    Rectangle {
                            height: 240px;
                        // Width computed from root.width (horizontal-stretch doesn't work on a plain Rectangle;
                        // parent.width is a binding loop): minus the layout's padding (48+48), PosterBlock (160) and
                        // spacing (32), and with has-details also the Details column (32 + 420).
                        width: root.width - 48px - 48px - 160px - 32px - (has-details ? 452px : 0px);

                            VerticalLayout {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: AppState.request-detail-title;
                                    color: Theme.text;
                                    font-size: 28px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }

                                MetaLine {
                                    meta: AppState.request-detail-meta;
                                    rating-label: AppState.request-detail-rating;
                                }
                            }

                            // ── Status / Request / Trailer / More buttons ─────────
                            // Request opens the Request Options modal (quality/tags/seasons, see RequestOptionsOverlay)
                            // rather than submitting directly. Trailer is independent of request status.
                            //
                            // 2K and 4K are tracked independently (see submit_request): Request stays while EITHER tier
                            // is still unrequested, and each requested tier gets its own pill — both can show at once.
                            // A Flickable, not a bare HorizontalLayout: up to 5 elements (~500 px) overflow a narrow
                            // window; mouse-wheel scroll reaches them (no keyboard auto-scroll — variable widths).
                        req-row := Flickable {
                                x: 0;
                                y: parent.height - 38px;
                                width: parent.width;
                                height: 38px;
                                content-width: req-hbox.preferred-width;
                                animate content-x {
                                    duration: 150ms * AppState.settings-scroll-speed;
                                    easing: ease-out-expo;
                                }

                                req-hbox := HorizontalLayout {
                                    alignment: start;
                                    spacing: 12px;
                            // FjordButton has no internal horizontal padding
                            // (see widgets.slint) — every other call site sets
                            // an explicit width (Play: 110px) for exactly this
                            // reason; this one didn't, so it sized down to the
                            // bare text with no breathing room. 130px fits the
                            // longer "Requesting…" label too, so the button
                            // doesn't resize when a request starts.
                            if AppState.request-detail-status == "" || AppState.request-detail-status-4k == "": FjordButton {
                                        text: AppState.request-detail-requesting ? "Requesting…" : "Request";
                                        enabled: !AppState.request-detail-requesting;
                                        width: 130px;
                                        kbd-focused: !AppState.request-detail-back-focused && AppState.request-detail-zone == 0 && AppState.request-detail-btn-focused == 0;
                                // Mouse clicks sync the keyboard focus state too (else Left/Right/Enter act on stale
                                // focus).
                                clicked => {
                                            AppState.request-detail-zone = 0;
                                            AppState.request-detail-back-focused = false;
                                            AppState.request-detail-btn-focused = 0;
                                            AppState.open-request-options();
                                        }
                                    }
                                    if AppState.request-detail-status != "": Rectangle {
                                        height: 32px;
                                        width: status2k-txt.preferred-width + 20px;
                                        border-radius: Theme.radius;
                                        background: AppState.request-detail-status == "Available" ? Theme.accent
                                            : AppState.request-detail-status == "Blocklisted" ? Theme.error
                                            : Theme.surface-overlay;
                                        status2k-txt := Text {
                                            text: "2K " + AppState.request-detail-status;
                                            color: #ffffff;
                                            font-size: 13px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if AppState.request-detail-status-4k != "": Rectangle {
                                        height: 32px;
                                        width: status4k-txt.preferred-width + 20px;
                                        border-radius: Theme.radius;
                                        background: AppState.request-detail-status-4k == "Available" ? Theme.accent
                                            : AppState.request-detail-status-4k == "Blocklisted" ? Theme.error
                                            : Theme.surface-overlay;
                                        status4k-txt := Text {
                                            text: "4K " + AppState.request-detail-status-4k;
                                            color: #ffffff;
                                            font-size: 13px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                            // Watch Trailer: shown once the title has loaded if yt-dlp is installed; greyed while the
                            // background check runs ("Checking…") or when no listed trailer plays ("No trailer") — see
                            // discover::start_trailer_check. Only "ok" is pressable and a D-pad stop.
                            if AppState.request-detail-trailer-state != "" && AppState.yt-dlp-available: FjordButton {
                                // icon-left/text as separate properties, not one
                                // combined string — Noto Sans Symbols2 (every
                                // icon glyph's pinned font) has zero Latin-
                                // alphabet coverage, so "▶ Trailer" in one
                                // `text` would leave the word falling through
                                // to an uncontrolled system font.
                                enabled: AppState.request-detail-trailer-state == "ok";
                                        icon-left: AppState.request-detail-trailer-state == "ok" ? "▶" : "";
                                        text: AppState.request-detail-trailer-state == "ok" ? "Trailer"
                                            : AppState.request-detail-trailer-state == "checking" ? "Checking…"
                                            : "No trailer";
                                        width: 130px;
                                        kbd-focused: !AppState.request-detail-back-focused && AppState.request-detail-zone == 0 && AppState.request-detail-btn-focused == 1;
                                        clicked => {
                                            AppState.request-detail-zone = 0;
                                            AppState.request-detail-back-focused = false;
                                            AppState.request-detail-btn-focused = 1;
                                            AppState.play-trailer();
                                        }
                                    }
                            // ⋮ More: the Discover context menu (View Request/Edit/Cancel/Approve/Decline, gated by
                            // mine/admin/pending) sourced from request-detail-request-id/-pending/-mine. Only once a
                            // request exists. "☰" because ⋮ is only in the Math fallback font.
                            if AppState.request-detail-request-id != "": FjordButton {
                                        icon-left: "☰";
                                        text: "";
                                        width: 44px;
                                        kbd-focused: !AppState.request-detail-back-focused && AppState.request-detail-zone == 0 && AppState.request-detail-btn-focused == 2;
                                        clicked => {
                                            AppState.request-detail-zone = 0;
                                            AppState.request-detail-back-focused = false;
                                            AppState.request-detail-btn-focused = 2;
                                            AppState.open-discover-menu-from-detail();
                                        }
                                    }
                            // Watchlist (slot 3): always visible, icon-only 44px like ⋮ More to keep the row narrow;
                            // "☆"/"★" (Noto Sans Symbols2).
                            FjordButton {
                                        icon-left: AppState.request-detail-on-watchlist ? "★" : "☆";
                                        text: "";
                                        width: 44px;
                                        kbd-focused: !AppState.request-detail-back-focused && AppState.request-detail-zone == 0 && AppState.request-detail-btn-focused == 3;
                                        clicked => {
                                            AppState.request-detail-zone = 0;
                                            AppState.request-detail-back-focused = false;
                                            AppState.request-detail-btn-focused = 3;
                                            AppState.request-detail-toggle-watchlist();
                                        }
                                    }
                            // Blocklist (slot 4): icon-only 44px; seerr-can-manage-blocklist and the item untouched or
                            // already blocklisted (same rule as the Discover context menu's row 7). "⛔"/"✕" (Noto
                            // Sans Symbols2).
                            if AppState.seerr-can-manage-blocklist
                                        && (AppState.request-detail-availability == "" || AppState.request-detail-availability == "blocklisted"):
                                FjordButton {
                                        icon-left: AppState.request-detail-availability == "blocklisted" ? "✕" : "⛔";
                                        text: "";
                                        width: 44px;
                                        kbd-focused: !AppState.request-detail-back-focused && AppState.request-detail-zone == 0 && AppState.request-detail-btn-focused == 4;
                                        clicked => {
                                            AppState.request-detail-zone = 0;
                                            AppState.request-detail-back-focused = false;
                                            AppState.request-detail-btn-focused = 4;
                                            AppState.request-detail-toggle-blocklist();
                                        }
                                    }
                                }
                            }
                        }

                        // ── Details (status/dates/language/countries/network/streaming), in the backdrop's empty
                        // right side. A fixed 420px width, not horizontal-stretch: it contains a nested Flickable,
                        // and a stretch-derived width risks the "Recursion detected" crash (SLINT.md).
                    if has-details: VerticalLayout {
                            width: 420px;
                            spacing: 0px;
                            alignment: start;

                            if AppState.request-detail-production-status != "":
                            MetaRow {
                                label: "Status";
                                value: AppState.request-detail-production-status;
                            }
                            if AppState.request-detail-date-value != "":
                            MetaRow {
                                label: AppState.request-detail-date-label;
                                value: AppState.request-detail-date-value;
                            }
                            if AppState.request-detail-next-air-date != "":
                            MetaRow {
                                label: "Next Air Date";
                                value: AppState.request-detail-next-air-date;
                            }
                            if AppState.request-detail-original-language != "":
                            MetaRow {
                                label: "Original Language";
                                value: AppState.request-detail-original-language;
                            }
                            if AppState.request-detail-production-countries != "":
                            MetaRow {
                                label: "Production Countries";
                                value: AppState.request-detail-production-countries;
                            }
                            if AppState.request-detail-network != "":
                            MetaRow {
                                label: "Network";
                                value: AppState.request-detail-network;
                            }

                            if AppState.request-detail-providers.length > 0: VerticalLayout {
                                padding-top: 8px;
                                spacing: 8px;

                                Text {
                                    text: "Currently Streaming On";
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    font-weight: 600;
                                }

                                // Plain Flickable, content-x left unbound so
                            // native mouse-wheel/touch scroll works (Slint
                            // gotcha in CLAUDE.md). width: parent.width here
                            // is safe specifically because its ancestor
                            // chain up to the has-details column is all
                            // plain fixed/arithmetic widths (420px), not a
                            // stretch-derived or self-referential one — see
                            // the has-details column's own doc comment.
                            Flickable {
                                    width: parent.width;
                                    height: 56px;
                                    content-width: providers-hbox.preferred-width;

                                    providers-hbox := HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;

                                        for p in AppState.request-detail-providers: Rectangle {
                                            width: 48px;
                                            height: 48px;
                                            border-radius: Theme.radius;
                                            clip: true;
                                            background: Theme.surface-overlay;

                                            if p.has-logo: Image {
                                                source: p.logo;
                                                width: parent.width;
                                                height: parent.height;
                                                image-fit: cover;
                                            }
                                            if !p.has-logo: Text {
                                                text: p.name;
                                                color: Theme.text-muted;
                                                font-size: 9px;
                                                wrap: word-wrap;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                width: parent.width - 6px;
                                                height: parent.height;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if AppState.request-detail-overview != "": StorylineSection {
                        text: AppState.request-detail-overview;
                        expanded <=> AppState.request-detail-overview-expanded;
                        kbd-focused: AppState.request-detail-zone == 1 && !AppState.request-detail-back-focused;
                        clicked-header() => {
                            AppState.request-detail-zone = 1;
                            AppState.request-detail-back-focused = false;
                        }
                    }
                }
            }

            // ── Cast & Crew (director/writer/top-billed cast, TMDB photos) ──
            if has-cast: VerticalLayout {
                padding-left: 48px;
                padding-right: 48px;
                padding-bottom: 24px;

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                Rectangle {
                    height: 12px;
                }

                CastRow {
                    cast: AppState.request-detail-cast;
                    focused-idx: AppState.request-detail-zone == 2 ? AppState.request-detail-focused-cast : -1;
                    // request-detail-cast[idx].id is a TMDB person id: open-discover-person resolves a local
                    // Jellyfin person first, else opens a TMDB-only screen. Enter (handle_key_request_detail,
                    // zone 2) calls the same callback.
                    item-selected(idx) => {
                        AppState.open-discover-person(AppState.request-detail-cast[idx].id, AppState.request-detail-cast[idx].name);
                    }
                }
            }

            Rectangle {
                height: Theme.sp-lg;
            }
        }
    }

    FjordButton {
        x: 16px;
        y: 16px;
        text: "← Back";
        width: 88px;
        kbd-focused: AppState.request-detail-back-focused;
        clicked => { AppState.show-request-detail = false; }
    }
}

// ── Request Options modal ─────────────────────────────────────────────────────
// Quality toggle + profile/tag chips + season cards + Cancel/Request, opened from
// RequestDetailScreen's Request button. Dim backdrop + centered box like PlaylistPicker
// (context_menu.slint). The chip/card strips are `min(dialog-w - 64px,
// *-hbox.preferred-width)` wide so a server with 1–3 chips doesn't get a wide empty box;
// every chip has a fixed width, so preferred-width doesn't depend on the Flickable (no
// binding loop).
export component RequestOptionsOverlay inherits Rectangle {
    background: #00000088;

    property <bool> has-profiles: AppState.request-detail-profiles.length > 0;
    property <bool> has-tags:     AppState.request-detail-tags.length > 0;
    property <bool> has-seasons:  AppState.request-detail-media-type == "tv" && AppState.request-detail-seasons.length > 0;
    // Fixed width for the dialog content, read by the Flickables below instead of a
    // layout-derived width ("Recursion detected" avoidance, see SLINT.md).
    property <length> dialog-w: 480px;

    // Close on backdrop click (Cancel, same as Escape/Back)
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { AppState.show-request-options = false; }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.dialog-w;
        height: dialog-content.preferred-height + 32px;
        border-radius: Theme.radius-lg;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 20px;
        drop-shadow-color: #000000aa;
        drop-shadow-offset-y: 6px;

        // Stop backdrop click from propagating through the box
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        dialog-content := VerticalLayout {
            x: 20px;
            y: 20px;
            width: parent.width - 40px;
            // A Layout directly in a plain Rectangle needs an explicit height: without it, this
            // layout's height and the outer box's `preferred-height + 32px` disagreed and the confirm
            // row fell outside the box with many rows mounted (same fix as ConfirmDialog). Reading a
            // child's geometry instead was a binding loop.
            height: self.preferred-height;
            spacing: 20px;

            Text {
                text: "Request Options";
                color: Theme.text;
                font-size: 17px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            // ── Quality (2K / 4K) ─────────────────────────────────────────────
            // A pair, exactly one selected (an on/off toggle read as "no quality"). Left/Right set it
            // directly — the selected button is the keyboard position. Hidden while editing an existing
            // request: Seerr's PUT /request/{id} can't change the tier (see
            // SeerrClient::update_request).
            if !AppState.request-options-editing: VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Quality";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    twok-btn := Rectangle {
                        width: 90px;
                        height: 40px;
                        border-radius: Theme.radius;
                        background: !AppState.request-detail-want-4k ? Theme.accent : Theme.surface-overlay;
                        border-width: (twok-ta.pressed || twok-pulse.pulsing) ? 4px
                            : (AppState.request-options-zone == 0 && !AppState.request-detail-want-4k ? 2px : 1px);
                        border-color: !AppState.request-detail-want-4k ? #ffffff99 : Theme.border-strong;
                        animate border-width, background {
                            duration: 90ms * AppState.settings-animation-speed;
                            easing: ease-out-expo;
                        }
                        twok-pulse := PressPulse {
                            trigger: AppState.kb-activate-pulse;
                            active: AppState.request-options-zone == 0 && !AppState.request-detail-want-4k;
                        }

                        twok-ta := TouchArea {
                            clicked => {
                                AppState.request-options-zone = 0;
                                AppState.request-detail-set-quality(false);
                            }
                        }

                        Text {
                            text: "2K";
                            color: !AppState.request-detail-want-4k ? #ffffff : Theme.text-muted;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    fourk-btn := Rectangle {
                        width: 90px;
                        height: 40px;
                        border-radius: Theme.radius;
                        background: AppState.request-detail-want-4k ? Theme.accent : Theme.surface-overlay;
                        border-width: (fourk-ta.pressed || fourk-pulse.pulsing) ? 4px
                            : (AppState.request-options-zone == 0 && AppState.request-detail-want-4k ? 2px : 1px);
                        border-color: AppState.request-detail-want-4k ? #ffffff99 : Theme.border-strong;
                        animate border-width, background {
                            duration: 90ms * AppState.settings-animation-speed;
                            easing: ease-out-expo;
                        }
                        fourk-pulse := PressPulse {
                            trigger: AppState.kb-activate-pulse;
                            active: AppState.request-options-zone == 0 && AppState.request-detail-want-4k;
                        }

                        fourk-ta := TouchArea {
                            clicked => {
                                AppState.request-options-zone = 0;
                                AppState.request-detail-set-quality(true);
                            }
                        }

                        Text {
                            text: "4K";
                            color: AppState.request-detail-want-4k ? #ffffff : Theme.text-muted;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ── Quality profile (Radarr/Sonarr, radio-select) ────────────────
            // Same Flickable/kb-x shape as Tags below, but exactly one chip is selected; row 0 is the
            // synthetic "Default" that Rust prepends (the way back to no override).
            if has-profiles: VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Profile";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                }

                property <length> kb-profile-x: AppState.request-detail-focused-profile <= 0 ? 0px
                    : clamp(-(AppState.request-detail-focused-profile * 146px + 65px - profile-fl.width / 2),
                            min(0px, profile-fl.width - profile-hbox.preferred-width), 0px);
                changed kb-profile-x => { profile-fl.content-x = kb-profile-x; }

                profile-fl := Flickable {
                    width: min(root.dialog-w - 64px, profile-hbox.preferred-width);
                    height: 44px;
                    content-width: profile-hbox.preferred-width;
                    animate content-x {
                        duration: 150ms * AppState.settings-scroll-speed;
                        easing: ease-out-expo;
                    }

                    profile-hbox := HorizontalLayout {
                        spacing: 16px;
                        alignment: start;

                        for p[i] in AppState.request-detail-profiles: Rectangle {
                            width: 130px;
                            height: 36px;
                            border-radius: self.height / 2;
                            background: p.id == AppState.request-detail-selected-profile-id ? Theme.accent : Theme.surface-overlay;
                            border-width: (profile-ta.pressed || profile-pulse.pulsing) ? 4px
                                : (AppState.request-options-zone == 1 && AppState.request-detail-focused-profile == i ? 2px : 1px);
                            // Focused or selected → Theme.focus-border (the app-wide focus colour); the focused state
                            // used to only thicken the gray border, too hard to see.
                            border-color: (p.id == AppState.request-detail-selected-profile-id
                                || (AppState.request-options-zone == 1 && AppState.request-detail-focused-profile == i))
                                ? Theme.focus-border : Theme.border-strong;
                            animate border-width, background {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                            profile-pulse := PressPulse {
                                trigger: AppState.kb-activate-pulse;
                                active: AppState.request-options-zone == 1 && AppState.request-detail-focused-profile == i;
                            }

                            profile-ta := TouchArea {
                                clicked => {
                                    AppState.request-options-zone = 1;
                                    AppState.request-detail-focused-profile = i;
                                    AppState.request-detail-selected-profile-id = p.id;
                                }
                            }

                            Text {
                                text: p.name;
                                color: p.id == AppState.request-detail-selected-profile-id ? #ffffff : Theme.text-muted;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width - 16px;
                                x: 8px;
                            }
                        }
                    }
                }
            }

            // ── Tags (Radarr/Sonarr default-server tags, movie or TV) ────────
            // Horizontal Flickable strip of fixed-width chips, same kb-x
            // scroll idiom as CastRow (fixed width chosen deliberately over
            // size-to-content — a variable-width chip breaks the fixed-stride
            // kb-x math every scrollable row in this app relies on; long
            // labels elide instead).
            if has-tags: VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Tags";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                }

                property <length> kb-tag-x: AppState.request-detail-focused-tag <= 0 ? 0px
                    : clamp(-(AppState.request-detail-focused-tag * 126px + 55px - tag-fl.width / 2),
                            min(0px, tag-fl.width - tag-hbox.preferred-width), 0px);
                changed kb-tag-x => { tag-fl.content-x = kb-tag-x; }

                tag-fl := Flickable {
                    width: min(root.dialog-w - 64px, tag-hbox.preferred-width);
                    height: 44px;
                    content-width: tag-hbox.preferred-width;
                    animate content-x {
                        duration: 150ms * AppState.settings-scroll-speed;
                        easing: ease-out-expo;
                    }

                    tag-hbox := HorizontalLayout {
                        spacing: 16px;
                        alignment: start;

                        // Pill chips with an always-visible border (subtle idle, focus-border when focused or
                        // selected) — borderless chips read as gray blobs.
                        for t[i] in AppState.request-detail-tags: Rectangle {
                            width: 110px;
                            height: 36px;
                            border-radius: self.height / 2;
                            background: t.selected ? Theme.accent : Theme.surface-overlay;
                            border-width: (tag-ta.pressed || tag-pulse.pulsing) ? 4px
                                : (AppState.request-options-zone == 2 && AppState.request-detail-focused-tag == i ? 2px : 1px);
                            border-color: (t.selected || (AppState.request-options-zone == 2 && AppState.request-detail-focused-tag == i))
                                ? Theme.focus-border : Theme.border-strong;
                            animate border-width, background {
                                duration: 90ms * AppState.settings-animation-speed;
                                easing: ease-out-expo;
                            }
                            tag-pulse := PressPulse {
                                trigger: AppState.kb-activate-pulse;
                                active: AppState.request-options-zone == 2 && AppState.request-detail-focused-tag == i;
                            }

                            tag-ta := TouchArea {
                                clicked => {
                                    AppState.request-options-zone = 2;
                                    AppState.request-detail-focused-tag = i;
                                    AppState.request-detail-toggle-tag(i);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                spacing: 4px;
                                if t.selected: Text {
                                    text: "✓";
                                    font-family: "Adwaita Sans";
                                    color: #ffffff;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: t.label;
                                    color: t.selected ? #ffffff : Theme.text-muted;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }

            // ── Seasons (TV only) ─────────────────────────────────────────────
            // Horizontal Flickable strip of season cards (poster + name +
            // episode count + ✓ badge when selected) — same fixed-width
            // kb-x idiom as the tag strip and CastRow, just with a poster
            // instead of a chip label.
            if has-seasons: VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Seasons";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                }

                property <length> kb-season-x: AppState.request-detail-focused-season <= 0 ? 0px
                    : clamp(-(AppState.request-detail-focused-season * 158px + 55px - season-fl.width / 2),
                            min(0px, season-fl.width - season-hbox.preferred-width), 0px);
                changed kb-season-x => { season-fl.content-x = kb-season-x; }

                season-fl := Flickable {
                    width: min(root.dialog-w - 64px, season-hbox.preferred-width);
                    height: 210px;
                    content-width: season-hbox.preferred-width;
                    animate content-x {
                        duration: 150ms * AppState.settings-scroll-speed;
                        easing: ease-out-expo;
                    }

                    season-hbox := HorizontalLayout {
                        spacing: 16px;
                        alignment: start;

                        for s[i] in AppState.request-detail-seasons: VerticalLayout {
                            width: 110px;
                            spacing: 4px;

                            Rectangle {
                                height: 165px;
                                border-radius: Theme.radius;
                                clip: true;
                                background: Theme.surface-overlay;
                                border-width: (season-ta.pressed || season-pulse.pulsing) ? 4px
                                    : (AppState.request-options-zone == 3 && AppState.request-detail-focused-season == i ? 2px : 0px);
                                border-color: Theme.focus-border;
                                animate border-width {
                                    duration: 90ms * AppState.settings-animation-speed;
                                    easing: ease-out-expo;
                                }
                                season-pulse := PressPulse {
                                    trigger: AppState.kb-activate-pulse;
                                    active: AppState.request-options-zone == 3 && AppState.request-detail-focused-season == i;
                                }

                                if s.has-poster: Image {
                                    source: s.poster;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }
                                if !s.has-poster: Text {
                                    text: s.season-number;
                                    color: Theme.text-muted;
                                    font-size: 28px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }

                                // ✓ selected badge (top-right), same idiom as PosterBlock's played badge
                                if s.selected: Rectangle {
                                    x: parent.width - 26px;
                                    y: 6px;
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: Theme.accent;
                                    Text {
                                        text: "✓";
                                        font-family: "Adwaita Sans";
                                        color: white;
                                        font-size: 10px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }

                                season-ta := TouchArea {
                                    clicked => {
                                        AppState.request-options-zone = 3;
                                        AppState.request-detail-focused-season = i;
                                        AppState.request-detail-toggle-season(i);
                                    }
                                }
                            }

                            Text {
                                text: s.name;
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            Text {
                                text: "\{s.episode-count} episodes";
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // ── Confirm row ───────────────────────────────────────────────────
            // Cancel is an outlined (ghost) button, not a FjordButton (always filled accent): it reads
            // as the secondary, safe action next to Request.
            confirm-row := HorizontalLayout {
                spacing: 12px;
                alignment: center;
                cancel-btn := Rectangle {
                    width: 100px;
                    height: 38px;
                    border-radius: Theme.radius;
                    background: transparent;
                    border-width: (cancel-ta.pressed || cancel-pulse.pulsing) ? 4px
                        : (AppState.request-options-zone == 4 && AppState.request-options-confirm-focused == 0 ? 2px : 1px);
                    border-color: AppState.request-options-zone == 4 && AppState.request-options-confirm-focused == 0 ? Theme.focus-border : Theme.border-strong;
                    animate border-width {
                        duration: 90ms * AppState.settings-animation-speed;
                        easing: ease-out-expo;
                    }
                    cancel-pulse := PressPulse {
                        trigger: AppState.kb-activate-pulse;
                        active: AppState.request-options-zone == 4 && AppState.request-options-confirm-focused == 0;
                    }

                    cancel-ta := TouchArea {
                        clicked => {
                            AppState.request-options-zone = 4;
                            AppState.request-options-confirm-focused = 0;
                            AppState.show-request-options = false;
                        }
                    }

                    Text {
                        text: "Cancel";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                FjordButton {
                    text: AppState.request-detail-requesting ? "Requesting…" : "Request";
                    enabled: !AppState.request-detail-requesting;
                    width: 100px;
                    kbd-focused: AppState.request-options-zone == 4 && AppState.request-options-confirm-focused == 1;
                    clicked => {
                        AppState.request-options-zone = 4;
                        AppState.request-options-confirm-focused = 1;
                        AppState.show-request-options = false;
                        AppState.request-detail-request();
                    }
                }
            }
        }
    }
}
