// ── fjord-app · manage_profiles.slint ────────────────────────────────────────
//   ManageProfilesScreen  Settings → Profiles → Manage Profiles (master accounts only): the
//                         profile-picker tile row + "+" (reuses ProfileTile), but a tile opens
//                         ProfileEditScreen in edit mode and "+" in create mode. A free-floating
//                         overlay mounted by a main.slint FadeGate (reached mid-session). Keyboard:
//                         manage-profiles-cursor drives each tile's kbd-focused (Left/Right/Enter
//                         in keys.rs); Up → the ✕ close button (manage-profiles-close-focused),
//                         Down back; Enter/Escape/Backspace close.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme, ProfileTile } from "theme.slint";
import { AppState } from "app_state.slint";
import { FjordButton, PressPulse } from "widgets.slint";

component ManageProfileTile inherits VerticalLayout {
    in property <ProfileTile> tile;
    in property <bool> is-add-tile: false;
    // Keyboard focus from AppState.manage-profiles-cursor (Left/Right/Enter in keys.rs), the
    // same tile-row pattern as the pickers.
    in property <bool> kbd-focused: false;
    callback activated();

    spacing: 8px;
    width: 120px;

    Rectangle {
        width: 96px;
        height: 96px;
        x: (parent.width - self.width) / 2;
        border-radius: self.width / 2;
        background: root.is-add-tile ? Theme.surface-overlay : root.tile.avatar-color;
        border-width: (ta.pressed || tile-pulse.pulsing) ? 4px : (root.kbd-focused ? 3px : 0px);
        border-color: Theme.focus-border;
        clip: true;
        animate border-width {
            duration: 90ms * AppState.settings-animation-speed;
            easing: ease-out-expo;
        }
        tile-pulse := PressPulse {
            trigger: AppState.kb-activate-pulse;
            active: root.kbd-focused;
        }

        Text {
            text: root.is-add-tile ? "+" : root.tile.avatar-initial;
            color: Theme.text;
            font-size: root.is-add-tile ? 36px : 38px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }

        if !root.is-add-tile && root.tile.has-pin: Rectangle {
            width: 26px;
            height: 26px;
            x: parent.width - self.width - 2px;
            y: parent.height - self.height - 2px;
            border-radius: self.width / 2;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-strong;
            Text {
                text: "🔒";
                font-family: "Noto Sans Symbols 2";
                font-size: 12px * AppState.text-scale;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        ta := TouchArea {
            clicked => { root.activated(); }
        }
    }

    Text {
        text: root.is-add-tile ? "Add Profile" : root.tile.display-name;
        color: root.kbd-focused ? Theme.accent : Theme.text;
        font-size: 13px * AppState.text-scale;
        font-weight: root.kbd-focused ? 700 : 400;
        horizontal-alignment: center;
        overflow: elide;
    }
}

export component ManageProfilesScreen inherits Rectangle {
    background: Theme.scrim-strong;

    close-ta := TouchArea {
        clicked => { AppState.show-manage-profiles = false; AppState.refocus(); }
    }

    card := Rectangle {
        // Width from the content (capped at the window): 5 tiles alone are 680px, more than a fixed
        // box — and nothing clips. Height derives from inner.preferred-height the same way.
        width: min(inner.preferred-width, parent.width - 48px);
        height: inner.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        drop-shadow-blur: 28px;
        drop-shadow-color: Theme.shadow;

        card-ta := TouchArea { }

        inner := VerticalLayout {
            padding: Theme.sp-xl;
            spacing: Theme.sp-lg;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Manage Profiles";
                    color: Theme.text;
                    font-size: 20px * AppState.text-scale;
                    font-weight: 700;
                }

                FjordButton {
                    text: "";
                    icon-left: "✕";
                    width: 32px * AppState.text-scale;
                    height: 32px;
                    // Real gap, live-reported 2026-08-21 — see
                    // manage-profiles-close-focused's own doc comment in
                    // app_state.slint.
                    kbd-focused: AppState.manage-profiles-close-focused;
                    clicked => {
                        AppState.manage-profiles-close-focused = false;
                        AppState.show-manage-profiles = false;
                        AppState.refocus();
                    }
                }
            }

            Text {
                text: "Profiles under this household — Bonfire caps a master account at "
                    + AppState.manage-profiles-max-sub-profiles + ".";
                color: Theme.text-muted;
                font-size: 12px * AppState.text-scale;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 20px;

                for t[i] in AppState.manage-profiles-list: ManageProfileTile {
                    tile: t;
                    // !close-focused excludes the tile ring while the ✕
                    // button holds focus instead — same convention as
                    // profile_picker.slint/account_picker.slint's own
                    // Back/Quit exclusions.
                    kbd-focused: AppState.manage-profiles-cursor == i && !AppState.manage-profiles-close-focused;
                    activated => {
                        // Mouse click syncs the same cursor keyboard
                        // dispatch reads, so a keypress right after a
                        // click acts on what was actually clicked.
                        AppState.manage-profiles-cursor = i;
                        AppState.manage-profiles-close-focused = false;
                        AppState.manage-profiles-select(t.user-id);
                    }
                }
                if AppState.manage-profiles-list.length < AppState.manage-profiles-max-sub-profiles: ManageProfileTile {
                    is-add-tile: true;
                    kbd-focused: AppState.manage-profiles-cursor == AppState.manage-profiles-list.length && !AppState.manage-profiles-close-focused;
                    activated => {
                        AppState.manage-profiles-cursor = AppState.manage-profiles-list.length;
                        AppState.manage-profiles-close-focused = false;
                        AppState.manage-profiles-add();
                    }
                }
            }

            if AppState.manage-profiles-list.length == 0: Text {
                text: "No sub-profiles yet — add one to get started";
                color: Theme.text-subtle;
                font-size: 12px * AppState.text-scale;
                horizontal-alignment: center;
            }

            if AppState.manage-profiles-error != "": Text {
                text: AppState.manage-profiles-error;
                color: Theme.error;
                font-size: 12px * AppState.text-scale;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
