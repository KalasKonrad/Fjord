// ── fjord-app · manage_profiles.slint ────────────────────────────────────────
//   ManageProfilesScreen  Bonfire Phase 2 (2026-08-09) — reached from Settings →
//                         Profiles → Manage Profiles (master accounts only).
//                         Same tile-row + "+" shape as ProfilePickerScreen
//                         (profile_picker.slint) — literally reuses ProfileTile
//                         — but selecting a tile opens ProfileEditScreen in
//                         edit mode instead of switching sessions, and the "+"
//                         tile opens it in create mode. Free-floating overlay,
//                         mounted + fade-gated by main.slint (ConnectSeerrScreen's
//                         own precedent), not a full-screen replacement like
//                         ProfilePickerScreen — this is reached mid-session, not
//                         at startup. Keyboard-navigable (2026-08-16, code review —
//                         was mouse-only: AppState.manage-profiles-cursor was
//                         declared from Phase 2 but never wired to anything; now
//                         drives each ManageProfileTile's kbd-focused prop, Left/
//                         Right/Enter dispatched from keys.rs). The "✕" close
//                         button got the identical fix 2026-08-21 (was mouse-only
//                         too, only Escape reached the same action) —
//                         manage-profiles-close-focused, Up from the tile row,
//                         Down back, Enter/Escape/Backspace close.
// ─────────────────────────────────────────────────────────────────────────────
import { Theme, ProfileTile } from "theme.slint";
import { AppState } from "app_state.slint";
import { FjordButton, PressPulse } from "widgets.slint";

component ManageProfileTile inherits VerticalLayout {
    in property <ProfileTile> tile;
    in property <bool> is-add-tile: false;
    // Real bug, code-review 2026-08-16: this screen had NO keyboard
    // navigation at all — tile-pulse.active was hardcoded to `false`
    // below, and nothing anywhere set a per-tile focus ring, even though
    // AppState.manage-profiles-cursor already existed for exactly this
    // (declared, never wired). Mirrors AccountPickerScreen/
    // ProfilePickerScreen's own tile-row kbd-focused pattern.
    in property <bool> kbd-focused: false;
    callback activated();

    spacing: 8px;
    width: 120px;

    Rectangle {
        width:  96px;
        height: 96px;
        x:      (parent.width - self.width) / 2;
        border-radius: self.width / 2;
        background: root.is-add-tile ? Theme.surface-overlay : root.tile.avatar-color;
        border-width: (ta.pressed || tile-pulse.pulsing) ? 4px : (root.kbd-focused ? 3px : 0px);
        border-color: Theme.focus-border;
        clip: true;
        animate border-width { duration: 90ms * AppState.settings-animation-speed; easing: ease-out-expo; }
        tile-pulse := PressPulse { trigger: AppState.kb-activate-pulse; active: root.kbd-focused; }

        Text {
            text:                 root.is-add-tile ? "+" : root.tile.avatar-initial;
            color:                Theme.text;
            font-size:            root.is-add-tile ? 36px : 38px;
            font-weight:          700;
            horizontal-alignment: center;
            vertical-alignment:   center;
            width:                parent.width;
            height:               parent.height;
        }

        if !root.is-add-tile && root.tile.has-pin: Rectangle {
            width:  26px;
            height: 26px;
            x:      parent.width - self.width - 2px;
            y:      parent.height - self.height - 2px;
            border-radius: self.width / 2;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-strong;
            Text {
                text: "🔒";
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        ta := TouchArea {
            clicked => { root.activated(); }
        }
    }

    Text {
        text:                 root.is-add-tile ? "Add Profile" : root.tile.display-name;
        color:                root.kbd-focused ? Theme.accent : Theme.text;
        font-size:            13px;
        font-weight:          root.kbd-focused ? 700 : 400;
        horizontal-alignment: center;
        overflow:             elide;
    }
}

export component ManageProfilesScreen inherits Rectangle {
    background: #000000aa;

    close-ta := TouchArea {
        clicked => { AppState.show-manage-profiles = false; AppState.refocus(); }
    }

    card := Rectangle {
        // Real bug, live-reported 2026-08-17: "the manage profile box do
        // not rezise" — width was a bare fixed 640px cap, unrelated to how
        // many tiles are actually on screen. The tile row (5 tiles alone:
        // 5*120px + 4*20px spacing = 680px) already overflows a 640px box
        // before the trailing "+" tile is even counted, and this Rectangle
        // has no `clip: true`, so the overflow just spilled visibly past
        // the box edges instead of the box growing to fit. Height already
        // correctly derives from inner.preferred-height (below) — width
        // gets the identical treatment, same established
        // read-a-child-Layout's-preferred-size pattern.
        width:         min(inner.preferred-width, parent.width - 48px);
        height:        inner.preferred-height;
        x:             (parent.width  - self.width)  / 2;
        y:             (parent.height - self.height) / 2;
        background:    Theme.surface;
        border-radius: Theme.radius-lg;
        drop-shadow-blur:  28px;
        drop-shadow-color: #00000070;

        card-ta := TouchArea {}

        inner := VerticalLayout {
            padding: Theme.sp-xl;
            spacing: Theme.sp-lg;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Manage Profiles";
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 700;
                }
                FjordButton {
                    text: "✕";
                    width: 32px;
                    height: 32px;
                    // Real gap, live-reported 2026-08-21 — see
                    // manage-profiles-close-focused's own doc comment in
                    // app_state.slint.
                    kbd-focused: AppState.manage-profiles-close-focused;
                    clicked => {
                        AppState.manage-profiles-close-focused = false;
                        AppState.show-manage-profiles = false;
                        AppState.refocus();
                    }
                }
            }

            Text {
                text: "Profiles under this household — Bonfire caps a master account at "
                    + AppState.manage-profiles-max-sub-profiles + ".";
                color: Theme.text-muted;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 20px;

                for t[i] in AppState.manage-profiles-list: ManageProfileTile {
                    tile:        t;
                    // !close-focused excludes the tile ring while the ✕
                    // button holds focus instead — same convention as
                    // profile_picker.slint/account_picker.slint's own
                    // Back/Quit exclusions.
                    kbd-focused: AppState.manage-profiles-cursor == i && !AppState.manage-profiles-close-focused;
                    activated => {
                        // Mouse click syncs the same cursor keyboard
                        // dispatch reads, so a keypress right after a
                        // click acts on what was actually clicked.
                        AppState.manage-profiles-cursor = i;
                        AppState.manage-profiles-close-focused = false;
                        AppState.manage-profiles-select(t.user-id);
                    }
                }
                if AppState.manage-profiles-list.length < AppState.manage-profiles-max-sub-profiles: ManageProfileTile {
                    is-add-tile: true;
                    kbd-focused: AppState.manage-profiles-cursor == AppState.manage-profiles-list.length && !AppState.manage-profiles-close-focused;
                    activated => {
                        AppState.manage-profiles-cursor = AppState.manage-profiles-list.length;
                        AppState.manage-profiles-close-focused = false;
                        AppState.manage-profiles-add();
                    }
                }
            }

            if AppState.manage-profiles-list.length == 0: Text {
                text: "No sub-profiles yet — add one to get started.";
                color: Theme.text-subtle;
                font-size: 12px;
                horizontal-alignment: center;
            }

            if AppState.manage-profiles-error != "": Text {
                text: AppState.manage-profiles-error;
                color: Theme.error;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
