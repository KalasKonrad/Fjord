# Maintainer: KalasKonrad <25062046+KalasKonrad@users.noreply.github.com>
# shellcheck shell=bash
# shellcheck disable=SC2034,SC2154,SC2164
#
# Pre-built release: the fjord-x86_64.tar.gz attached to the GitHub release
# v$pkgver, built by .github/workflows/build-release.yml from that tag — the
# same code ../PKGBUILD builds from source. `makepkg -si` in this directory,
# no Rust toolchain needed. Development builds: ../fjord-bin-nightly/.
# Bumped as the last step of every release: pkgver, then sha256sums
# (`updpkgsums`, or `sha256sum` of the downloaded tarball).
pkgname=fjord-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="Jellyfin media frontend with smooth mpv playback on NVIDIA legacy hardware (pre-built release)"
arch=('x86_64')
url="https://github.com/KalasKonrad/Fjord"
license=('GPL-3.0-only')
depends=('mpv' 'fontconfig' 'freetype2' 'libxkbcommon')
optdepends=('yt-dlp: play YouTube trailers')
provides=("fjord=$pkgver")
conflicts=('fjord' 'fjord-git' 'fjord-bin-nightly')
install=../fjord.install
options=('!debug' '!strip') # already stripped by CI
source=("fjord-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/fjord-x86_64.tar.gz")
sha256sums=('e411157f988e42e3692fad3c7538dafa00ab501e32d9ca9b0b0923dae06fe274')

package() {
    cd "$srcdir/fjord-bin"
    install -Dm755 "fjord" "$pkgdir/usr/bin/fjord"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    local icons=(01 02 04 05 09 10)
    local n=${icons[$((RANDOM % ${#icons[@]}))]}
    printf 'fjord: installing icon fjord_%s.svg\n' "$n"
    install -Dm644 "assets/fjord_${n}.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/fjord.svg"

    install -dm755 "$pkgdir/usr/share/applications"
    cat > "$pkgdir/usr/share/applications/fjord.desktop" << 'EOF'
[Desktop Entry]
Name=Fjord
GenericName=Media Player
Comment=Jellyfin media frontend
Exec=fjord
Icon=fjord
Type=Application
Categories=AudioVideo;Video;Player;
Keywords=Jellyfin;mpv;media;
EOF
}
